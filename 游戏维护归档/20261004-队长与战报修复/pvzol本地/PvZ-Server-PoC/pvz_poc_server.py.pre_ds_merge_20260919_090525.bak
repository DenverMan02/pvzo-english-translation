#!/usr/bin/env python3
"""
PvZ Online — Phase-A proof-of-concept server.

Goal of this file: get the *real* Flash client to open a socket to us, log
exactly what it sends, and push the opening handshake back so we can watch how
far the client gets. It is NOT a real game server yet — it is a listening post
that speaks the wire protocol correctly.

Protocol (reverse-engineered from Assets/src), all big-endian:

  TWeb packet:
    Magic     : 1  byte  = 202 (0xCA)
    PkgLen    : uint32    = total packet length, INCLUDING the magic byte
    BodyLen   : uint32    = length of the Body
    Version   : 1  byte  = 1
    Cmd       : 1  byte  = transport type: 1=STOP, 2=UPLOAD(c->s), 3=DOWNLOAD(s->c)
    UserType  : 1  byte  = 0=UNKNOWN, 1=QQSIMPLE, 2=COMMON
    User      : QQUserSimp when UserType==1:
                    Uin    : uint32
                    SKeyLen: uint32  (= len(skey)+1, includes null terminator)
                    SKey   : SKeyLen bytes (utf8 + trailing 0x00)
                (UserType==0 -> no User bytes)
    [Ext]     : only present when Cmd==STOP
    Body      : BodyLen bytes  = a CmdCommon protobuf message
                (client->server the Body is wrapped by msgCheckFunc / anti-cheat;
                 server->client it is plain — the client never decrypts inbound.)

  CmdCommon (protobuf):
    1: cmdName  string   e.g. "PVZ.Cmd.Cmd_Init_SC"   <-- this is the routing key
    2: cmdData  bytes    the inner per-command protobuf message
    3: errorCode uint32
    4: seqId    uint32
    5: cmdId    uint32

Because BodyLen is explicit, we extract the body as the LAST BodyLen bytes of the
packet without needing to perfectly parse the variable-length User block.

Run:  python pvz_poc_server.py
Then point the Flash client's `server` flashvar at  <this machine>:9001
(see boot/boot.html and README.md).
"""

import asyncio
import logging
import os
import random
import re
import sys
import struct
import time
import functools

import player_store as store

# ---- config ---------------------------------------------------------------
GAME_HOST = "0.0.0.0"
# We tell the client to use 9001 (via the `server` flashvar), but the client may
# fall back to its built-in reconnect ports [443, 80, 8001] or override our value.
# So we listen on ALL of them and log which port the connection actually arrives on.
GAME_PORTS = [9001, 8001, 443, 80]
POLICY_PORT = 843         # Flash socket-policy port (Flash asks here before connecting)

# Canned identity we hand the client so it walks the "returning player" path.
FAKE_ROLE_NAME = "Dave"

logging.basicConfig(
    level=logging.DEBUG,
    format="%(asctime)s  %(levelname)-5s  %(message)s",
    datefmt="%H:%M:%S",
)
log = logging.getLogger("pvz")

TWEB_MAGIC = 202
CMD_STOP, CMD_UPLOAD, CMD_DOWNLOAD = 1, 2, 3

# The client's "anti-cheat" msgCheckFunc (Msgcheck.swf) is simply: XOR every byte
# of the CmdCommon body with 0x07. Applied to client->server bodies only; the client
# does NOT decrypt inbound, so our server->client bodies stay plain.
MSGCHECK_XOR = 0x07


def xor7(data: bytes) -> bytes:
    return bytes(b ^ MSGCHECK_XOR for b in data)


# ---- minimal protobuf helpers --------------------------------------------
def uvarint(n: int) -> bytes:
    out = bytearray()
    while True:
        b = n & 0x7F
        n >>= 7
        if n:
            out.append(b | 0x80)
        else:
            out.append(b)
            return bytes(out)


def read_uvarint(buf: bytes, pos: int):
    shift = 0
    result = 0
    while True:
        b = buf[pos]
        pos += 1
        result |= (b & 0x7F) << shift
        if not (b & 0x80):
            return result, pos
        shift += 7


def pb_tag(field: int, wire: int) -> bytes:
    return uvarint(field << 3 | wire)


def pb_string(field: int, s: str) -> bytes:
    data = s.encode("utf-8")
    return pb_tag(field, 2) + uvarint(len(data)) + data


def pb_bytes(field: int, data: bytes) -> bytes:
    return pb_tag(field, 2) + uvarint(len(data)) + data


def pb_float_field(field: int, value: float) -> bytes:
    """Encode protobuf TYPE_FLOAT (fixed32, little-endian)."""
    return pb_tag(field, 5) + struct.pack("<f", float(value))


def pb_varint_field(field: int, value: int) -> bytes:
    return pb_tag(field, 0) + uvarint(value)


def pb_bool(field: int, value: bool) -> bytes:
    return pb_varint_field(field, 1 if value else 0)


def pb_int64_field(field: int, value: int) -> bytes:
    """protobuf TYPE_INT64/INT32: a plain varint, but NEGATIVE values are 64-bit two's complement
    (10 bytes). uvarint() can't take negatives, so mask to 64 bits first. Used for changeHp/changeRage
    (damage is a NEGATIVE changeHp)."""
    return pb_tag(field, 0) + uvarint(value & 0xFFFFFFFFFFFFFFFF)


def parse_varint_fields(data: bytes) -> dict:
    """Read a protobuf message's varint (wire 0) fields into {field_num: value}.
    Length-delimited/fixed fields are skipped. Enough to read simple request messages."""
    out = {}
    pos = 0
    try:
        while pos < len(data):
            key, pos = read_uvarint(data, pos)
            field, wire = key >> 3, key & 7
            if wire == 0:
                out[field], pos = read_uvarint(data, pos)
            elif wire == 2:
                ln, pos = read_uvarint(data, pos)
                pos += ln
            elif wire == 5:
                pos += 4
            elif wire == 1:
                pos += 8
            else:
                break
    except (IndexError, ValueError):
        pass
    return out


def parse_repeated_submessages(data: bytes, field_num: int):
    """Return the raw bytes of every occurrence of a length-delimited (wire 2) field.
    Used to walk a `repeated SubMessage` field (e.g. Cmd_Card_RawAttribute_CS.allCard)."""
    out = []
    pos = 0
    try:
        while pos < len(data):
            key, pos = read_uvarint(data, pos)
            fnum, wire = key >> 3, key & 7
            if wire == 2:
                ln, pos = read_uvarint(data, pos)
                if fnum == field_num:
                    out.append(data[pos:pos + ln])
                pos += ln
            elif wire == 0:
                _, pos = read_uvarint(data, pos)
            elif wire == 5:
                pos += 4
            elif wire == 1:
                pos += 8
            else:
                break
    except (IndexError, ValueError):
        pass
    return out


def parse_repeated_varint(data: bytes, field_num: int):
    """Collect every value of a repeated varint field, handling BOTH the packed
    (wire 2: one length-delimited block of varints) and unpacked (wire 0: repeated
    tag+varint) encodings. parse_varint_fields() only keeps the last, so use this for
    repeated fields like Cmd_TD_ReportLevelResult_CS.achievementList."""
    out = []
    pos = 0
    try:
        while pos < len(data):
            key, pos = read_uvarint(data, pos)
            fnum, wire = key >> 3, key & 7
            if wire == 0:
                v, pos = read_uvarint(data, pos)
                if fnum == field_num:
                    out.append(v)
            elif wire == 2:
                ln, pos = read_uvarint(data, pos)
                end = pos + ln
                if fnum == field_num:
                    while pos < end:
                        v, pos = read_uvarint(data, pos)
                        out.append(v)
                else:
                    pos = end
            elif wire == 5:
                pos += 4
            elif wire == 1:
                pos += 8
            else:
                break
    except (IndexError, ValueError):
        pass
    return out


def parse_string_field(data: bytes, field_num: int, default=""):
    """Read the first UTF-8 length-delimited protobuf field with the given number."""
    values = parse_repeated_submessages(data, field_num)
    if not values:
        return default
    return values[0].decode("utf-8", "replace")


def parse_cmdcommon(body: bytes):
    """Pull cmdName / cmdData out of a CmdCommon protobuf. Returns dict or None."""
    out = {"cmdName": None, "cmdData": b"", "errorCode": 0, "seqId": 0}
    pos = 0
    try:
        while pos < len(body):
            key, pos = read_uvarint(body, pos)
            field, wire = key >> 3, key & 7
            if wire == 2:  # length-delimited
                ln, pos = read_uvarint(body, pos)
                chunk = body[pos:pos + ln]
                pos += ln
                if field == 1:
                    out["cmdName"] = chunk.decode("utf-8", "replace")
                elif field == 2:
                    out["cmdData"] = chunk
            elif wire == 0:  # varint
                val, pos = read_uvarint(body, pos)
                if field == 3:
                    out["errorCode"] = val
                elif field == 4:
                    out["seqId"] = val
            elif wire == 5:
                pos += 4
            elif wire == 1:
                pos += 8
            else:
                return out
        return out
    except (IndexError, UnicodeDecodeError):
        return None


# ---- TWeb framing ---------------------------------------------------------
def build_cmdcommon(cmd_name: str, cmd_data: bytes, error_code: int = 0) -> bytes:
    body = pb_string(1, cmd_name) + pb_bytes(2, cmd_data)
    if error_code:
        body += pb_varint_field(3, error_code)
    return body


def wrap_tweb_download(cmdcommon: bytes) -> bytes:
    """Server->client packet: Cmd=DOWNLOAD, UserType=0 (no user block)."""
    body_len = len(cmdcommon)
    pkg_len = 12 + body_len  # 1 + 4 + 4 + 1 + 1 + 1 header, then body
    return (
        bytes([TWEB_MAGIC])
        + pkg_len.to_bytes(4, "big")
        + body_len.to_bytes(4, "big")
        + bytes([1, CMD_DOWNLOAD, 0])
        + cmdcommon
    )


def send_message(writer, cmd_name: str, cmd_data: bytes = b"", error_code: int = 0):
    pkt = wrap_tweb_download(build_cmdcommon(cmd_name, cmd_data, error_code))
    writer.write(pkt)
    log.info("  -> S2C  %-45s  (%d body bytes, %d total)",
             cmd_name, len(cmd_data), len(pkt))


# ---- opening-handshake payloads ------------------------------------------
def make_check_old_user(is_old_user=True, role_name=FAKE_ROLE_NAME):
    # Cmd_CheckOldUser_SC: 1 isOldUser(bool), 2 roleName(str), 3 qqName(str), 4 playStartFlash(bool)
    data = pb_bool(1, is_old_user)
    if role_name is not None:
        data += pb_string(2, role_name)
    return data


