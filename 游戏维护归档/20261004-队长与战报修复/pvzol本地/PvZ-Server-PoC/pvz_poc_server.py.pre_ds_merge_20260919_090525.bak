def make_init_sc(player):
    """Cmd_Init_SC — the player snapshot, loaded from the persistent store.
    All fields optional; field numbers per Cmd_Init_SC.as."""
    now = int(time.time())
    d = b""
    d += pb_string(1, player["name"])                    # name
    d += pb_varint_field(2, player["exp"])               # exp
    d += pb_varint_field(3, player["level"])             # level
    d += pb_varint_field(4, player["sun"])               # sun
    d += pb_varint_field(5, player["coin"])              # coin
    d += pb_varint_field(8, now)                         # now (server time)
    d += pb_varint_field(9, player["role_id"])           # roleID (Int64 varint)
    d += pb_varint_field(10, current_energy(player))     # energy (with offline regen folded in)
    d += pb_varint_field(11, player["friend_point"])     # friendPoint
    d += pb_varint_field(13, player["face_id"])          # faceId
    d += pb_varint_field(15, player["ticket"])           # ticket (gold diamond)
    d += pb_varint_field(16, player["fame"])             # fame
    d += pb_varint_field(17, player["buy_energy_num"])   # buyEnergyNum
    d += pb_bool(18, False)                              # hasNewFormationPos
    d += pb_varint_field(20, 100)                        # townDurability
    d += pb_varint_field(21, 100)                        # townDurabilityMax
    d += pb_varint_field(22, player["present_ticket"])   # presentTicket
    d += pb_varint_field(24, player["zone_id"])          # zoneId
    d += pb_bool(25, False)                              # isMiniClient
    d += pb_varint_field(26, 1)                          # seqId
    d += pb_bool(27, False)                              # newOfflineReward
    d += pb_varint_field(28, player["reg_time"])         # regTime
    d += pb_varint_field(29, player["server_open_time"]) # serverOpenTime
    d += pb_varint_field(30, player["reg_time"])         # regRoleSystemOpenTime
    d += pb_varint_field(32, player["foster_ticket"])    # fosterTicket
    d += pb_bool(33, True)                               # isEquipAttachEnabled
    d += pb_bool(34, False)                              # isPlayZoneTask
    d += pb_bool(35, False)                              # forbidCardAwaken
    d += pb_varint_field(36, player["lucky"])            # lucky
    d += pb_varint_field(37, player["contrib_val"])      # contribVal
    d += pb_varint_field(38, player["light"])            # light
    d += pb_varint_field(39, player["last_pay_time"])    # lastPayTime
    d += pb_varint_field(40, 0)                          # puppetSkillVal
    d += pb_varint_field(41, 0)                          # puppetEnergy
    d += pb_varint_field(44, player["prestige"])         # prestige
    # field 7: latestTDLevel. New accounts must start at the dedicated tutorial
    # map (0-1-1); normal accounts retain their saved story position.
    td_stage = 0 if player.get("tutorial_active") else player["td_stage"]
    td_level = 1 if player.get("tutorial_active") else player["td_level"]
    td_sub = 1 if player.get("tutorial_active") else player["td_sub"]
    td = (pb_varint_field(1, td_stage) + pb_varint_field(2, td_level)
          + pb_varint_field(3, td_sub))
    d += pb_tag(7, 2) + uvarint(len(td)) + td
    # field 12: faceAvatar (Dto_PlantInfo) — player's avatar plant.
    av = (pb_varint_field(1, player["avatar_plant_id"]) + pb_varint_field(2, 0)
          + pb_varint_field(3, 0) + pb_varint_field(4, 0))
    d += pb_tag(12, 2) + uvarint(len(av)) + av
    # field 14: unlockPlantList (repeated Dto_PlantInfo) — the player's normal-mode plants.
    for pid in player.get("plants", []):
        pl = pb_varint_field(1, pid) + pb_varint_field(2, 0)  # plantId, isNew=0
        d += pb_tag(14, 2) + uvarint(len(pl)) + pl
    d += make_server_config_entries(player)   # field 19 (repeated) — config table (per-player: VIP plant)
    return d


# ---- connection handling --------------------------------------------------
def frame_packets(buffer: bytearray):
    """Yield complete TWeb packets from an accumulating buffer; keep the remainder."""
    packets = []
    while len(buffer) >= 5:
        if buffer[0] != TWEB_MAGIC:
            # desync — drop one byte and resync (shouldn't happen on a clean stream)
            log.warning("bad magic 0x%02X, resyncing", buffer[0])
            del buffer[0]
            continue
        pkg_len = int.from_bytes(buffer[1:5], "big")
        if pkg_len < 12 or pkg_len > 8_000_000:
            log.warning("implausible PkgLen=%d, resyncing", pkg_len)
            del buffer[0]
            continue
        if len(buffer) < pkg_len:
            break  # wait for more
        packets.append(bytes(buffer[:pkg_len]))
        del buffer[:pkg_len]
    return packets


def describe_c2s(packet: bytes):
    body_len = int.from_bytes(packet[5:9], "big")
    version, cmd, user_type = packet[9], packet[10], packet[11]
    uin = skey = None
    off = 12
    if user_type == 1 and len(packet) >= 20:
        uin = int.from_bytes(packet[12:16], "big")
        skey_len = int.from_bytes(packet[16:20], "big")
        skey = packet[20:20 + max(skey_len - 1, 0)].decode("latin1", "replace")
        off = 20 + skey_len
    body = packet[len(packet) - body_len:]  # robust: last BodyLen bytes
    # client->server bodies are XOR-7 "encrypted"; decrypt before parsing.
    body = xor7(body)
    parsed = parse_cmdcommon(body)
    return {
        "cmd": cmd, "user_type": user_type, "uin": uin, "skey": skey,
        "body_len": body_len, "parsed": parsed, "body": body,
    }


async def handle_client(reader, writer):
    peer = writer.get_extra_info("peername")
    sock = writer.get_extra_info("sockname")
    local_port = sock[1] if sock else "?"
    log.info("=== client connected on PORT %s from %s ===", local_port, peer)
    buffer = bytearray()
    tgw_stripped = False
    step = 0
    player = None
    try:
        while True:
            data = await reader.read(65536)
            if not data:
                break
            buffer.extend(data)

            # (0) Flash socket-policy FALLBACK. Before opening the game socket, Flash Player
            # fetches a socket policy from port 843; if 843 is unreachable (failed to bind, or
            # blocked by a firewall/AV on the player's machine), Flash then requests the policy
            # from the GAME port itself, sending '<policy-file-request/>\0' first. If we don't
            # answer it, the socket stays unauthorized and the client hangs at the loading screen
            # even though every HTTP asset loaded. A leading '<' is unambiguous here (the TGW
            # preamble starts with 't', a TWeb frame with the 0xCA magic).
            if not tgw_stripped and buffer[:1] == b"<":
                log.info("  [policy] inline socket-policy request on game port %s from %s "
                         "(master policy on 843 was unreachable for this client)", local_port, peer)
                writer.write(POLICY_XML)
                await writer.drain()
                break   # policy served on its own connection; Flash opens the real one next

            # (1) Strip the one-time TGW gateway preamble the client sends on the
            # "zone" port: 'tgw_l7_forward\r\nHost: ...\r\n\r\n' then the binary data.
            if not tgw_stripped:
                if buffer[:1] == bytes([TWEB_MAGIC]):
                    tgw_stripped = True  # no preamble present
                else:
                    idx = buffer.find(b"\r\n\r\n")
                    if idx == -1:
                        continue  # wait for the rest of the preamble
                    preamble = bytes(buffer[:idx])
                    del buffer[:idx + 4]
                    log.info("  (stripped TGW preamble: %r)",
                             preamble.decode("latin1", "replace"))
                    tgw_stripped = True

            # (2) Frame + drive the login handshake.
            for packet in frame_packets(buffer):
                info = describe_c2s(packet)
                # Load (or create) this player's save the first time we see their uin.
                if player is None:
                    uin = info.get("uin") or 0
                    player, is_new = store.get_or_create_player(uin)
                    player["plants"] = store.get_player_plants(uin)
                    # Rebuild the TD roster from what was actually EARNED in TD (starters + cleared-level
                    # bonusPlants), dropping plants that leaked in from old card draws/recruits — a card is
                    # adventure-only and must not appear in the TD chooser. Drawn CARDS stay in the
                    # collection for adventure.
                    leaked = rebuild_td_roster(player)
                    if leaked:
                        log.info("    cleaned %d leaked non-TD plant(s) from TD roster: %s",
                                 len(leaked), leaked)
                    ensure_player_cards(player)   # a battle card per owned plant (the collection)
                    sanitize_td_progress(player)  # clamp latestTDLevel so the town can't #1009
                    # Fold any accumulated exp into levels so Init_SC sends the right level
                    # (and the town/feature locks evaluate correctly for it).
                    if normalize_level(player):
                        store.save_player(uin, level=player["level"], exp=player["exp"])
                        log.info("    login level-up: -> level %d (exp %d)",
                                 player["level"], player["exp"])
                    log.info("    %s player uin=%s name=%r level=%d coin=%d plants=%s",
                             "CREATED new" if is_new else "loaded existing",
                             uin, player["name"], player["level"], player["coin"],
                             player["plants"])
                name = (info["parsed"] or {}).get("cmdName")
                log.info("<- C2S  uin=%s cmd=%d bodyLen=%d cmdName=%s",
                         info["uin"], info["cmd"], info["body_len"],
                         name if name else "<encrypted>")

                if step == 0:
                    step = 1
                    rolename = player["name"] if player else FAKE_ROLE_NAME
                    # isOldUser controls only role creation/name entry. Tutorial routing
                    # is a separate persisted state carried by Init_SC.latestTDLevel.
                    is_old_user = bool(player.get("role_created"))
                    log.info("    step 1 -> Cmd_CheckOldUser_SC (new=%s, name=%r)",
                             not is_old_user, rolename)
                    send_message(writer, "PVZ.Cmd.Cmd_CheckOldUser_SC",
                                 make_check_old_user(is_old_user=is_old_user, role_name=rolename))
                    await writer.drain()
                elif step == 1:
                    # The new-player branch may first submit a chosen role name. Acknowledge
                    # it, retain it, and wait for its subsequent Cmd_Init_CS instead of
                    # prematurely forcing the returning-player init sequence.
                    if name == "PVZ.Cmd.Cmd_SetRoleName_CS":
                        cmd_data = (info["parsed"] or {}).get("cmdData") or b""
                        role_name = parse_string_field(cmd_data, 1, player["name"]).strip()
                        sex = parse_varint_fields(cmd_data).get(2, 0)
                        if role_name:
                            player["name"] = role_name
                            player["role_created"] = 1
                            store.save_player(player["uin"], name=role_name, role_created=1)
                        body = pb_string(1, player["name"]) + pb_varint_field(2, sex)
                        log.info("    new-player role name saved: %r", player["name"])
                        send_message(writer, "PVZ.Cmd.Cmd_SetRoleName_SC", body)
                        await writer.drain()
                        continue
                    # Some client builds create the role by putting roleName/sex in
                    # Cmd_Init_CS instead of sending Cmd_SetRoleName_CS first.
                    if name == "PVZ.Cmd.Cmd_Init_CS" and not player.get("role_created"):
                        cmd_data = (info["parsed"] or {}).get("cmdData") or b""
                        role_name = parse_string_field(cmd_data, 10, player["name"]).strip()
                        if role_name:
                            player["name"] = role_name
                        player["role_created"] = 1
                        store.save_player(player["uin"], name=player["name"], role_created=1)
                        log.info("    new-player role creation completed: %r", player["name"])
                    step = 2
                    log.info("    step 2 -> Cmd_Init_SC (from save)")
                    send_message(writer, "PVZ.Cmd.Cmd_Init_SC", make_init_sc(player))
                    # VIP: push the privilege list + VIP info so hasPrivilege() is populated and the badge/
                    # UI reflect the account's tier from the very start (non-VIP => empty list + cardId 0).
                    for sc_name, body in vip_login_messages(player):
                        log.info("    -> %s (%d body bytes)", sc_name, len(body))
                        send_message(writer, sc_name, body)
                    if int(player.get("vip_level") or 0):
                        log.info("    VIP tier %d active: %d privileges",
                                 player["vip_level"], len(vip_privileges(player)))
                    # TD privilege (塔防特权): push Cmd_TD_OpenPrivilege_SC if active so the
                    # client's TD modules unlock the player's premium plant roster for every
                    # TD activity at once. Skipped silently when the toggle is off.
                    for sc_name, body in td_privilege_login_messages(player):
                        log.info("    -> %s (%d body bytes)", sc_name, len(body))
                        send_message(writer, sc_name, body)
                    if td_privilege_active(player):
                        log.info("    TD privilege active: %d premium plants",
                                 len(td_privilege_plants(player)))
                    # Diamond card (钻石卡): always push Cmd_Vip_SyncVipInfo_SC so ModuleBlueDiamond
                    # has its state from the very start (sends an all-zero Dto_DiamondInfo when the
                    # GM has the card turned off, which clears any previously-shown card).
                    for sc_name, body in diamond_login_messages(player):
                        log.info("    -> %s (%d body bytes)", sc_name, len(body))
                        send_message(writer, sc_name, body)
                    await writer.drain()
                elif name and name.endswith("_CS"):
                    sc = name[:-3] + "_SC"
                    if name in REQUEST_HANDLERS:
                        # Read the request; may return bytes (one _SC) or a list of
                        # (sc_name, body) messages to send (e.g. reply + SyncCoin/Exp).
                        # A handler bug must NOT tear down the whole connection: on any
                        # exception, log it and fall back to the generic empty _SC.
                        cmd_data = (info["parsed"] or {}).get("cmdData") or b""
                        try:
                            result = REQUEST_HANDLERS[name](cmd_data, player or {})
                            messages = result if isinstance(result, list) else [(sc, result)]
                        except Exception:
                            log.exception("handler %s crashed; sending generic %s", name, sc)
                            messages = [(sc, response_for(sc))]
                    else:
                        # Generic: matching _SC with nested fields present (no null-crash).
                        messages = [(sc, response_for(sc))]
                    for sc_name, body in messages:
                        log.info("    -> %s (%d body bytes)", sc_name, len(body))
                        send_message(writer, sc_name, body)
                    await writer.drain()
                else:
                    log.debug("    (unhandled msg: %s)", name)
    except ConnectionResetError:
        pass
    finally:
        log.info("=== client disconnected: %s ===", peer)
        try:
            writer.close()
        except Exception:
            pass


# ---- Flash socket-policy server (port 843) --------------------------------
# Socket MASTER policy (served on 843). Textbook form: no DOCTYPE, explicit port
# range (some Flash builds reject to-ports="*").
POLICY_XML = (
    b'<?xml version="1.0"?>'
    b'<cross-domain-policy>'
    b'<allow-access-from domain="*" to-ports="1-65535"/>'
    b'</cross-domain-policy>\x00'
)


async def handle_policy(reader, writer):
    peer = writer.get_extra_info("peername")
    try:
        # Canonical: wait for '<policy-file-request/>\0', then send the policy once.
        try:
            req = await asyncio.wait_for(reader.read(128), timeout=3)
        except asyncio.TimeoutError:
            req = b""  # some clients connect and wait for us to speak first
        writer.write(POLICY_XML)
        await writer.drain()
        log.info("[policy] served policy to %s (req=%r)", peer, req[:40])
    except (ConnectionResetError, BrokenPipeError):
        pass
    finally:
        try:
            writer.close()
        except Exception:
            pass


async def main():
    log.info("player store: %s", store.init_db())
    game_servers = []
    for port in GAME_PORTS:
        try:
            srv = await asyncio.start_server(handle_client, GAME_HOST, port)
            game_servers.append(srv)
            log.info("game server listening on %s:%d", GAME_HOST, port)
        except OSError as e:
            log.warning("could not bind game port %d (%s) - skipping "
                        "(another program may own it; not fatal)", port, e)

    if not game_servers:
        log.error("!!! Could NOT bind ANY game port %s.", GAME_PORTS)
        log.error("!!! A stale server is running. Kill it: taskkill /F /IM python.exe")
        return

    try:
        policy_srv = await asyncio.start_server(handle_policy, GAME_HOST, POLICY_PORT)
        log.info("socket-policy server listening on %s:%d", GAME_HOST, POLICY_PORT)
    except (PermissionError, OSError) as e:
        policy_srv = None
        log.warning("could NOT bind port 843 (%s). Flash will refuse the socket. "
                    "Kill any stale server (taskkill /F /IM python.exe) and re-run.", e)

    await asyncio.gather(*(s.serve_forever() for s in game_servers))


if __name__ == "__main__":
    if sys.platform == "win32":
        asyncio.set_event_loop_policy(asyncio.WindowsSelectorEventLoopPolicy())
    try:
        asyncio.run(main())
    except KeyboardInterrupt:
        log.info("shutting down")
