# Config ids that need a specific value (the generic "1" would be wrong/crash). e.g.
# iVIPSpecialPlant is the plant displayed by the VIP UI. Access to the plant remains
# gated by privilege 41; the display id must not be substituted for non-VIP accounts.
SERVER_CONFIG_OVERRIDES = {
    # The client CardItemVO.isMaxForgeLv gate compares forgeLevel against this
    # server config before it will even enter/submit a forge attempt.  The
    # generic integer fallback is "1", which hard-blocks every card at +1 even
    # though CardForgeTemplate and the server handler both support levels 1-5.
    "iCardMaxForgeLevel": "5",
    # Equipment is an ordinary stack of individual bag objects, not a single unique slot.
    # The generic fallback of "1" made the client's creation dialog reject a second item.
    "iEquipNumLmt": "100",
    # Minimum town level for the four equipment positions, indexed by EquipType.
    "sEquipmentUnlock": "1,1;2,1;3,1;4,1",
    "iVIPSpecialPlant": "6900",   # Winter Melon
    # Mystery Card Pack (神秘卡包): sMysteryCardItem feeds CardBarProxy's ItemVO.createByString (needs
    # a valid "itemId:num"); the luck-bar max + price drive the HUD.
    "sMysteryCardItem": "1103:1",       # 神秘抽奖券 (MysteriousTicket)
    "iMysteryCardLuckValueMax": "100",  # luck/pity bar denominator
    "iMysteryCardPrice": "1",
    "iGeneTestDailyChallengeTimes": "3",  # keep the trial HUD in sync with its persisted retry count
    # Laboratory VIP-bottle tooltip. Read as a String and .replace(/\\n/g,"\n")'d into the tooltip,
    # so literal "\n" become line breaks. Any non-empty string clears the null-template #1009.
    "iVIPLabTechDesc": "VIP专属科技\\n开通VIP即可解锁专属实验室科技\\n大幅提升全体上阵植物的属性",
    # Energy (体力) regen: the client's tooltip reads these (interval is SECONDS, shown as /60 min). The
    # server regenerates on the same schedule (see _ENERGY_REGEN_*). Tune here to make energy faster/slower.
    "iRecoverEnergyInterval": "120",        # 1 energy every 120s (2 min)
    "iRecoverEnergyPerInterval": "1",
    "iEnergyBuyTimes": "5",                  # base diamond energy-buys per day (VIP priv 4 adds more)
}


def _cfg_value(cid, player=None):
    # The VIP panel must always identify its featured plant as Winter Melon. Whether the
    # player can use it is independently controlled by VIP privilege 41.
    if cid == "iVIPSpecialPlant":
        return str(_VIP_PLANT)
    if cid in SERVER_CONFIG_OVERRIDES:
        return SERVER_CONFIG_OVERRIDES[cid]
    return "" if cid.startswith("s") else "1"


def make_server_config_entries(player=None):
    """Encode each config id as a Dto_ServerConfig {1:id, 2:value} sub-message,
    wrapped as repeated field 19 of Cmd_Init_SC. Player-aware for per-account config (iVIPSpecialPlant)."""
    out = b""
    for cid in SERVER_CONFIG_IDS:
        dto = pb_string(1, cid) + pb_string(2, _cfg_value(cid, player))
        out += pb_tag(19, 2) + uvarint(len(dto)) + dto
    return out


def make_battle_formation_sc():
    """Cmd_Battle_GetFormation_SC with one minimal attack formation.
    Needed so getAttackBattleTeam() is non-empty AND has totalPower>0 — otherwise
    refreshFightPower()'s best-team stays null and the role/HUD panel crashes.
    Dto_FormationInfo fields: cardPos(1), formationId(2), leaderUid(3), totalPower(4),
    teamId(5), status(6), recoverHpCost(7), isDefend(8)."""
    # BattleCardFormationVO.totalPower is COMPUTED from cardPos[].powerEle[] entries
    # whose ele == E_PowerEle_total(0) — the totalPower field is ignored. So give the
    # formation one cardPos with a 'total' power element, else the VO's power is 0 and
    # refreshFightPower picks a null best-team.
    power = pb_varint_field(1, 0) + pb_varint_field(2, 100)   # Dto_CardPower{ele=total, value=100}
    cardpos = (pb_varint_field(1, 0)                          # Dto_CardPosInfo.posIndex=0
               + pb_tag(6, 2) + uvarint(len(power)) + power)  # .powerEle[0]
    formation = (pb_tag(1, 2) + uvarint(len(cardpos)) + cardpos  # Dto_FormationInfo.cardPos[0]
                 + pb_varint_field(2, 1)     # formationId
                 + pb_varint_field(4, 100)   # totalPower (VO ignores this; harmless)
                 + pb_varint_field(5, 1)      # teamId (matches defaultTeamId)
                 + pb_varint_field(6, 1)      # status = home
                 + pb_varint_field(8, 0))     # isDefend = 0 -> attack team
    team = pb_tag(2, 2) + uvarint(len(formation)) + formation  # repeated team, field 2
    return team + pb_varint_field(3, 1) + pb_varint_field(4, 1)  # teamMaxNum=1, defaultTeamId=1


def make_signin_getinfo_sc():
    """Cmd_SignIn_GetInfo_SC. Must include signInInfo (field 1 = Dto_SignIn_Info) or the
    client's loadSignInInfo() dereferences null."""
    dto = (pb_varint_field(1, 0) + pb_varint_field(2, 0) + pb_varint_field(3, 0)
           + pb_varint_field(4, 0) + pb_varint_field(5, 0))
    return pb_tag(1, 2) + uvarint(len(dto)) + dto


def make_td_getstageinfo_sc():
    """Cmd_TD_GetStageInfo_SC. stageId must match actorLatestTDLevel.stageId(=1) so the
    client's loadCmd_TD_GetStageInfo_SC builds stage-1 levels from its template; otherwise
    onCmd_TD_RequestStageInfo_SC's getLevelByLevelId(2,1) returns null and crashes."""
    return pb_varint_field(1, 1)  # stageId = 1


# Messages that crash the client when empty — send populated responses instead.
# (Battle needs a non-empty team OR defaultTeamId!=0; the generic populator can't
#  know an array gets indexed, so this one stays explicit.)
SPECIAL_SC = {
    # Cmd_Battle_GetFormation is now a request handler (needs the player's real team/cards).
    # Cmd_TD_GetStageInfo_SC is now a request handler (needs the player's passed levels).
}


# --- generic response populator ------------------------------------------------
# Most init handlers crash on an EMPTY _SC because they dereference a nested message
# field (e.g. roleGuildInfo.guildId) that is null. Fix: read the _SC's field defs from
# the decompiled source and emit every single (non-repeated) TYPE_MESSAGE field as an
# empty-but-present sub-message, recursively. Scalars default fine; arrays stay [].
CMD_DIR = os.path.abspath(os.path.join(
    os.path.dirname(os.path.abspath(__file__)), "..", "Assets", "src", "PVZ", "Cmd"))

_MSG_FIELD_RE = re.compile(
    r'(?<!Repeated)FieldDescriptor\$TYPE_MESSAGE\("[^"]+","[A-Za-z0-9_]+",'
    r'(\d+) << 3 \| WireType\.LENGTH_DELIMITED,([A-Za-z0-9_]+)')
# Int64/UInt64 fields are OBJECTS in AS3 (have .low/.high) -> null-crash like messages.
_I64_FIELD_RE = re.compile(
    r'(?<!Repeated)FieldDescriptor\$TYPE_(?:INT64|UINT64)\("[^"]+","[A-Za-z0-9_]+",'
    r'(\d+) << 3')


@functools.lru_cache(maxsize=None)
def _fields(class_name):
    """(single message fields [(num,dto)], single int64/uint64 fields [num])."""
    path = os.path.join(CMD_DIR, class_name + ".as")
    if not os.path.isfile(path):
        return (), ()
    txt = open(path, encoding="utf-8", errors="replace").read()
    msgs = tuple((int(n), dto) for n, dto in _MSG_FIELD_RE.findall(txt))
    i64s = tuple(int(n) for n in _I64_FIELD_RE.findall(txt))
    return msgs, i64s


def populate_message(class_name, depth=5):
    """Bytes for a message with every nested message field present-but-empty and every
    Int64/UInt64 field set to 0 (both are objects that null-crash when accessed)."""
    if depth <= 0:
        return b""
    msgs, i64s = _fields(class_name)
    out = b""
    for num, dto in msgs:
        sub = populate_message(dto, depth - 1)
        out += pb_tag(num, 2) + uvarint(len(sub)) + sub
    for num in i64s:
        out += pb_varint_field(num, 0)
    return out


def response_for(sc_name):
    """Body bytes for a server->client _SC message name."""
    if sc_name in SPECIAL_SC:
        return SPECIAL_SC[sc_name]()
    return populate_message(sc_name.rsplit(".", 1)[-1])


# --- level rewards (from clientDB levelselectInfo.txt) ----------------------------
# Each TD level defines its own rewards; we grant those instead of a flat amount.
#   firstCoin  = coins on FIRST clear      bonusCoin = coins on a repeat clear
#   bonusExp   = exp reward                bonusPlant= a plantId unlocked on first clear
#   bonusItems = "itemId:amt;..." (needs the bag system — deferred)
_LEVEL_REWARDS = None
_CLIENTDB_PATH = os.path.abspath(os.path.join(
    os.path.dirname(os.path.abspath(__file__)), "..", "webroot", "clientDB.txt"))


def load_level_rewards():
    """Parse levelselectInfo.txt out of the clientDB archive once; cache the result.
    Returns {(stage, level, sub): {firstCoin, bonusCoin, bonusExp, bonusPlant, bonusItems}}."""
    global _LEVEL_REWARDS
    if _LEVEL_REWARDS is not None:
        return _LEVEL_REWARDS
    _LEVEL_REWARDS = {}
    if not os.path.isfile(_CLIENTDB_PATH):
        log.warning("clientDB.txt not found (%s) — TD rewards fall back to defaults",
                    _CLIENTDB_PATH)
        return _LEVEL_REWARDS
    data = open(_CLIENTDB_PATH, "rb").read()
    pos, body = 0, None
    while pos + 4 <= len(data):                       # big-endian [len][name][len][tsv] archive
        nlen = int.from_bytes(data[pos:pos + 4], "big"); pos += 4
        name = data[pos:pos + nlen].decode("utf-8", "replace"); pos += nlen
        dlen = int.from_bytes(data[pos:pos + 4], "big"); pos += 4
        chunk = data[pos:pos + dlen]; pos += dlen
        if name == "levelselectInfo.txt":
            body = chunk
            break
    if body is None:
        return _LEVEL_REWARDS
    rows = [r for r in body.decode("utf-8", "replace").replace("\r", "").split("\n") if r.strip()]
    hdr = rows[0].split("\t"); ci = {c: i for i, c in enumerate(hdr)}

    def col(c, k, d=""):
        i = ci.get(k)
        return c[i] if i is not None and i < len(c) else d

    def num(c, k):
        try:
            return int(col(c, k, "0"))
        except ValueError:
            return 0

    for r in rows[1:]:
        c = r.split("\t")
        if col(c, "challengeLevelId", "0") not in ("0", ""):
            continue  # main levels only (challenges handled separately)
        key = (num(c, "stageId"), num(c, "levelId"), num(c, "subLevelId"))
        _LEVEL_REWARDS[key] = {
            "firstCoin": num(c, "firstCoin"), "bonusCoin": num(c, "bonusCoin"),
            "bonusExp": num(c, "bonusExp"), "bonusPlant": num(c, "bonusPlant"),
            "bonusItems": col(c, "bonusItems", ""),
        }
    log.info("loaded %d TD level reward templates from clientDB", len(_LEVEL_REWARDS))
    return _LEVEL_REWARDS


def level_reward(stage, level, sub):
    return load_level_rewards().get((stage, level, sub), {})


# --- latestTDLevel sanitizer (prevents the town #1009) -----------------------------
# The town's CityProxy.onCmd_TD_RequestStageInfo_SC reads
#   getLevelByLevelId(actorLatestTDLevel.levelId + 1, 1).unlocked
# with NO null check. If the player's saved latestTDLevel is out of range for the real
# level templates (e.g. a GM-set td_stage=11 that doesn't exist, or a td_level past the
# stage's last level), that lookup returns null and the whole town crashes on load.
# We clamp the saved value into a valid template range at login so the client can't null-deref.
_TD_STAGE_MAXES = None


def td_stage_maxes():
    """(stages, subs): {stageId: max main levelId}, {(stage,level): max subLevelId} from the
    level templates. Real story stages only (stageId>0)."""
    global _TD_STAGE_MAXES
    if _TD_STAGE_MAXES is None:
        stages, subs = {}, {}
        for (stage, level, sub) in load_level_rewards():
            if stage > 0:
                stages[stage] = max(stages.get(stage, 0), level)
                subs[(stage, level)] = max(subs.get((stage, level), 0), sub)
        _TD_STAGE_MAXES = (stages, subs)
    return _TD_STAGE_MAXES


def sanitize_td_progress(player):
    """Clamp the player's latestTDLevel (td_stage/td_level/td_sub) to real template ranges
    and persist any correction. Returns True if it changed. Out-of-range values crash the
    town (#1009) via CityProxy's unguarded getLevelByLevelId(levelId+1,1)."""
    # Stage 0 is intentionally outside the normal TD template table. While the
    # account is in the new-player guide, leave it untouched so Init_SC can route
    # the client to the tutorial map.
    if player.get("tutorial_active"):
        return False
    stages, subs = td_stage_maxes()
    if not stages:
        return False
    stage = player.get("td_stage", 1) or 1
    level = player.get("td_level", 1) or 1
    sub = player.get("td_sub", 1) or 1
    orig = (stage, level, sub)
    if stage not in stages:                       # unknown stage -> highest real stage
        stage = max(stages)
    level = max(1, min(level, stages[stage]))     # 1 .. this stage's last level
    sub = max(1, min(sub, subs.get((stage, level), 1)))  # 1 .. that level's last sub
    if (stage, level, sub) != orig:
        player["td_stage"], player["td_level"], player["td_sub"] = stage, level, sub
        store.save_player(player["uin"], td_stage=stage, td_level=level, td_sub=sub)
        log.info("    sanitized latestTDLevel %s -> %s (out-of-range would crash the town)",
                 orig, (stage, level, sub))
        return True
    return False


def _read_clientdb_table(table_name):
    """Return the tab-separated rows (list of list of str) of a clientDB table, or []."""
    if not os.path.isfile(_CLIENTDB_PATH):
        return []
    data = open(_CLIENTDB_PATH, "rb").read()
    pos, body = 0, None
    while pos + 4 <= len(data):
        nlen = int.from_bytes(data[pos:pos + 4], "big"); pos += 4
        name = data[pos:pos + nlen].decode("utf-8", "replace"); pos += nlen
        dlen = int.from_bytes(data[pos:pos + 4], "big"); pos += 4
        chunk = data[pos:pos + dlen]; pos += dlen
        if name == table_name:
            body = chunk
            break
    if body is None:
        return []
    return [r.split("\t") for r in body.decode("utf-8", "replace").replace("\r", "").split("\n")
            if r.strip()]


# Role leveling: levelInfo.txt.needExp[L] = exp to advance from level L to L+1. actorExp is
# the exp WITHIN the current level (the client's bar is actorExp / needExp[actorLevel]).
_LEVEL_EXP = None


def need_exp(level):
    """Exp required to advance FROM `level` to level+1 (0 if at/above the table's max)."""
    global _LEVEL_EXP
    if _LEVEL_EXP is None:
        _LEVEL_EXP = {}
        rows = _read_clientdb_table("levelInfo.txt")
        if rows:
            hdr = rows[0]; ci = {c: i for i, c in enumerate(hdr)}
            for c in rows[1:]:
                try:
                    _LEVEL_EXP[int(c[ci["id"]])] = int(c[ci["needExp"]])
                except (ValueError, KeyError, IndexError):
                    pass
        log.info("loaded %d role-level exp thresholds", len(_LEVEL_EXP))
    return _LEVEL_EXP.get(int(level), 0)


def normalize_level(player):
    """Consume the player's accumulated exp into level-ups. exp is kept as the progress
    within the current level. Only ever levels UP (a gm-set high level with low exp is
    safe). Returns True if the level increased."""
    level = int(player.get("level", 1))
    exp = int(player.get("exp", 0))
    start = level
    guard = 0
    while guard < 500:
        need = need_exp(level)
        if need <= 0 or exp < need:
            break
        exp -= need
        level += 1
        guard += 1
    player["level"], player["exp"] = level, exp
    return level > start


# --- role-exp economy -------------------------------------------------------------
# clientDB levelselectInfo.bonusExp is empty for almost every level (only 3 stage-1 levels,
# 200 total) — the original game computed role exp SERVER-side. So we grant a computed amount
# per clear from BOTH normal-mode TD and adventure/fuben, first-clear + a reduced replay amount,
# scaled by content depth. Tune these two constants to speed up / slow down leveling.
_ROLE_EXP_BASE = 120        # role exp for a first clear at depth 1
_ROLE_EXP_PER_DEPTH = 45    # extra per difficulty tier (TD stage / fuben chapter)


def role_exp_for_clear(depth, is_first):
    """Role exp for clearing a level/stage. depth = difficulty tier (TD stage 1..5 or fuben
    chapter 1..13); deeper gives more. Replays give ~1/3 so grinding still levels you (slowly)."""
    base = _ROLE_EXP_BASE + _ROLE_EXP_PER_DEPTH * max(0, int(depth) - 1)
    return base if is_first else max(30, base // 3)


def grant_role_exp(player, exp):
    """Add role exp, fold it into level-ups, persist, and return the sync messages: Cmd_SyncExp_SC
    always, plus Cmd_SyncLevel_SC + live building unlocks on a level-up. Used by paths that don't
    already do their own leveling (e.g. fuben/adventure wins)."""
    exp = int(exp)
    if exp <= 0:
        return []
    old_level = int(player.get("level", 1))
    player["exp"] = int(player.get("exp", 0)) + exp
    leveled = normalize_level(player)
    store.save_player(player["uin"], exp=player["exp"], level=player["level"])
    msgs = [("PVZ.Cmd.Cmd_SyncExp_SC", pb_varint_field(1, player["exp"]))]
    if leveled:
        msgs.append(("PVZ.Cmd.Cmd_SyncLevel_SC", pb_varint_field(1, player["level"])))
        msgs += building_unlock_messages(old_level, player["level"])
    return msgs


# --- bag / items -----------------------------------------------------------------
def parse_bonus_items(spec):
    """"id:num;id:num" -> [(item_id, num)]  (level bonusItems / gate needItems format)."""
    out = []
    for part in (spec or "").split(";"):
        if ":" in part:
            a, b = part.split(":", 1)
            try:
                out.append((int(a), int(b)))
            except ValueError:
                pass
    return out


def build_item_dto(item_id, count):
    """Dto_ItemInfo{uid(1), id(2), num(3)}. We use uid = item_id (one stack per item type),
    which is stable so Cmd_Item_Update_SC updates the same stack (BagProxy keys by uid)."""
    return (pb_varint_field(1, item_id)      # uid (Int64) — reuse item_id as a stable stack id
            + pb_varint_field(2, item_id)    # id (the item template id)
            + pb_varint_field(3, count))     # num (stack count)


def make_bag_info(player):
    """Cmd_Item_GetBagInfo_SC: all(1)=every stack, bNext omitted(=false) so it's the last
    page (client then runs initItems + finishes the Init_BagItemInfo init task)."""
    d = b""
    for item_id, count in store.get_items(player["uin"]):
        dto = build_item_dto(item_id, count)
        d += pb_tag(1, 2) + uvarint(len(dto)) + dto   # all (field 1, repeated Dto_ItemInfo)
    for equipment in store.get_equipments(player["uin"]):
        dto = build_equipment_item_dto(equipment)
        d += pb_tag(1, 2) + uvarint(len(dto)) + dto
    return d


def grant_items(player, changes):
    """Apply [(item_id, delta)] to the bag; return a Cmd_Item_Update_SC (name, body) that
    syncs the NEW counts to the client, or None if nothing changed."""
    dtos = b""
    for item_id, delta in changes:
        if not delta:
            continue
        new_count = store.add_item(player["uin"], item_id, delta)
        dto = build_item_dto(item_id, new_count)      # num<=0 -> client removes the stack
        dtos += pb_tag(1, 2) + uvarint(len(dto)) + dto  # changeItems (field 1)
    if not dtos:
        return None
    return ("PVZ.Cmd.Cmd_Item_Update_SC", dtos)


def handle_get_bag_info(cmd_data, player):
    """Cmd_Item_GetBagInfo_CS -> Cmd_Item_GetBagInfo_SC (the player's whole bag)."""
    items = store.get_items(player["uin"])
    equipment = store.get_equipments(player["uin"])
    log.info("    bag info: %d item stack(s), %d equipment object(s)", len(items), len(equipment))
    return make_bag_info(player)


# --- card equipment -----------------------------------------------------------
# Equipment is a proper BagItemVO, not a stack of a normal material: its stable uid and Dto_EquipInfo
# are what the Flash client uses to populate the card slots, equipment bag, leveling and rank panels.
_EQUIPMENT_TABLES = None


def _load_equipment_tables():
    global _EQUIPMENT_TABLES
    if _EQUIPMENT_TABLES is None:
        tables = {}
        for name in ("EquipmentItem.txt", "EquipmentLevel.txt", "EquipmentRank.txt",
                     "EquipmentPool.txt", "EquipmentPart.txt", "EquipmentBead.txt"):
            rows = _read_clientdb_table(name)
            if not rows:
                tables[name] = {}
                continue
            headers = rows[0]
            tables[name] = {
                tuple(row[i] if i < len(row) else "" for i in range(len(headers))):
                dict(zip(headers, row)) for row in rows[1:]
            }
        _EQUIPMENT_TABLES = tables
    return _EQUIPMENT_TABLES


def _equip_row(table, **keys):
    rows = _load_equipment_tables().get(table, {}).values()
    for row in rows:
        try:
            if all(str(row.get(key, "")) == str(value) for key, value in keys.items()):
                return row
        except (TypeError, ValueError):
            continue
    return None


def _equip_int(row, key, default=0):
    try:
        return int(float((row or {}).get(key) or default))
    except (TypeError, ValueError):
        return int(default)


def _equip_properties(equipment):
    """Final equipment attributes expected by Dto_EquipEffect.

    Item base properties are already in display units. Level/rank template values for the four
    primary stats are stored in hundredths, matching the client's EquipmentAttribute transform.
    """
    item = next((r for r in _load_equipment_tables()["EquipmentItem.txt"].values()
                 if _equip_int(r, "id") == int(equipment["item_id"])), None)
    if not item:
        return {}
    props = {}

    def add_spec(spec, separator, scale_primary=False):
        for part in (spec or "").split(";"):
            if separator not in part:
                continue
            try:
                attr, value = part.split(separator, 1)
                attr, value = int(attr), float(value)
                if scale_primary and attr in (1, 2, 3, 5):
                    value /= 100.0
                props[attr] = props.get(attr, 0.0) + value
            except (TypeError, ValueError):
                continue

    add_spec(item.get("originalProperty"), ",")
    equip_type = _equip_int(item, "equipType")
    rank = _equip_int(item, "rank", 1)
    level = int(equipment.get("level") or 0)
    rank_row = _equip_row("EquipmentRank.txt", type=equip_type, rank=rank)
    level_row = _equip_row("EquipmentLevel.txt", type=equip_type, level=level)
    if rank_row:
        add_spec(rank_row.get("originalProperty"), ":", True)
    if level_row:
        add_spec(level_row.get("originalProperty"), ":", True)
    return {key: value for key, value in props.items() if value}


def _apply_card_equipment_bonus(stats, uin, card_uid):
    """Fold equipped gear's flat attributes into the card snapshot sent to the client/battle."""
    attr_to_stat = {1: "atk", 2: "def_", 3: "hp", 4: "shield", 5: "ability",
                    6: "hit", 7: "dodge", 8: "critical", 9: "tough", 10: "immune"}
    for equipment in store.get_equipments(uin):
        if int(equipment.get("card_uid") or 0) != int(card_uid):
            continue
        for attr, value in _equip_properties(equipment).items():
            stat = attr_to_stat.get(attr)
            if stat:
                total = stats.get(stat, 0) + value
                stats[stat] = int(round(total)) if attr <= 5 else float(total)
    return stats


def _equipment_info_dto(equipment):
    item = next((r for r in _load_equipment_tables()["EquipmentItem.txt"].values()
                 if _equip_int(r, "id") == int(equipment["item_id"])), None)
    rank = _equip_int(item, "rank", 1)
    d = (pb_varint_field(2, rank)                                  # quality
         + pb_int64_field(3, int(equipment.get("card_uid") or 0)) # iCardUId (0 = in bag)
         + pb_varint_field(4, int(equipment.get("level") or 0))
         + pb_varint_field(5, int(equipment.get("exp") or 0))
         + pb_varint_field(6, int(equipment.get("grade_percent") or 0))
         + pb_varint_field(7, int(equipment.get("is_clone") or 0)))
    # The shipped EquipmentLevelViewCE has exactly two current/next property rows.  The
    # rank/level templates can introduce a third effect type (e.g. ability or HP), and the
    # decompiled client mediator iterates every effect then dereferences a nonexistent row,
    # raising ActionScript Error #1009 whenever the equipment screen opens or refreshes.
    # Keep the two primary attributes in the client DTO; _equip_properties remains complete
    # for server-side card stats and combat calculations.
    for attr, value in sorted(_equip_properties(equipment).items()):
        if attr not in (1, 2):
            continue
        effect = pb_varint_field(1, attr) + pb_float_field(2, float(value))
        d += pb_tag(1, 2) + uvarint(len(effect)) + effect
    return d


def build_equipment_item_dto(equipment):
    info = _equipment_info_dto(equipment)
    return (pb_int64_field(1, int(equipment["uid"]))
            + pb_varint_field(2, int(equipment["item_id"]))
            + pb_varint_field(3, 1)
            + pb_tag(4, 2) + uvarint(len(info)) + info)


def _equipment_item_update(equipments=(), removed=()):
    body = b""
    for equipment in equipments:
        dto = build_equipment_item_dto(equipment)
        body += pb_tag(1, 2) + uvarint(len(dto)) + dto
    for equipment in removed:
        dto = (pb_int64_field(1, int(equipment["uid"]))
               + pb_varint_field(2, int(equipment["item_id"]))
               + pb_varint_field(3, 0))
        body += pb_tag(1, 2) + uvarint(len(dto)) + dto
    return ("PVZ.Cmd.Cmd_Item_Update_SC", body) if body else None


def _equipment_costs(spec):
    return [(item_id, amount) for item_id, amount in parse_bonus_items(spec) if item_id and amount > 0]


def _equipment_afford(player, costs):
    return all(store.get_item_count(player["uin"], item_id) >= amount
               for item_id, amount in costs)


def _equipment_template(item_id):
    return next((r for r in _load_equipment_tables()["EquipmentItem.txt"].values()
                 if _equip_int(r, "id") == int(item_id)), None)


def _equipment_pool_state(player):
    state = store.get_equipment_state(player["uin"])
    pool = _equip_row("EquipmentPool.txt", id=state["pool_id"]) or _equip_row(
        "EquipmentPool.txt", id=1)
    now = int(time.time())
    if pool:
        cap = _equip_int(pool, "capability")
        elapsed = max(0, now - int(state.get("last_energy_at") or now))
        regen_per_second = _equip_int(pool, "recover") / 100.0 / 60.0
        energy = min(cap, int(state["current_energy"] + elapsed * regen_per_second))
        state["current_energy"] = energy
        state["last_energy_at"] = now
        store.update_equipment_state(player["uin"], current_energy=energy, last_energy_at=now)
    return state, pool


def _equipment_energy_info(player):
    state, pool = _equipment_pool_state(player)
    part = _equip_row("EquipmentPart.txt", id=state["part_id"])
    bead_num = store.get_item_count(player["uin"], 2046)
    return ("PVZ.Cmd.Cmd_Equip_EnergyInfo_SC",
            pb_varint_field(1, state["pool_id"])
            + pb_varint_field(2, state["current_energy"])
            + pb_varint_field(3, bead_num)
            + pb_varint_field(4, state["part_id"])
            + pb_varint_field(5, state["auto_use_bead"])
            + pb_varint_field(6, state["current_exp"])
            + pb_varint_field(7, state["buy_count"]))


def _equipment_part_info(player):
    state = store.get_equipment_state(player["uin"])
    part = _equip_row("EquipmentPart.txt", id=state["part_id"])
    if not part:
        return ("PVZ.Cmd.Cmd_Equip_AttachInfo_SC", b"")
    today = time.strftime("%Y%m%d")
    # The client uses canTakeFirst itself to decide whether the clickable reward icon is
    # visible; keeping the template amount here after a claim leaves a dead, re-clickable icon.
    first_available = 0 if state["first_claimed"] else _equip_int(part, "firstReward")
    daily_available = _equip_int(part, "dailyReward")
    d = (pb_varint_field(1, state["part_id"])
         + pb_varint_field(2, daily_available)
         + pb_varint_field(3, state.get("daily_claim_day") == today)
         + pb_varint_field(4, first_available)
         + pb_varint_field(5, state["first_claimed"])
         + pb_varint_field(6, state["buy_count"]))
    return ("PVZ.Cmd.Cmd_Equip_AttachInfo_SC", d)


def _equipment_updates_for_rows(uin, uids):
    return [row for uid in sorted(set(int(x) for x in uids))
            if (row := store.get_equipment(uin, uid)) is not None]


def _equipment_set_energy(player, state, amount):
    """Persist bounded pool energy; energy spent also advances the pool's lifetime upgrade XP."""
    _, pool = _equipment_pool_state(player)
    if not pool:
        return state
    cap = _equip_int(pool, "capability")
    new_energy = max(0, min(cap, int(amount)))
    spent = max(0, int(state["current_energy"]) - new_energy)
    state["current_energy"] = new_energy
    state["last_energy_at"] = int(time.time())
    if spent:
        state["current_exp"] = int(state["current_exp"]) + spent
    store.update_equipment_state(player["uin"], current_energy=new_energy,
                                 last_energy_at=state["last_energy_at"],
                                 current_exp=state["current_exp"])
    return state


def _equipment_upgrade_level(equipment, exp_gain):
    item = _equipment_template(equipment["item_id"])
    equip_type = _equip_int(item, "equipType")
    rank = _equip_int(item, "rank", 1)
    rank_template = _equip_row("EquipmentRank.txt", type=equip_type, rank=rank)
    max_level = _equip_int(rank_template, "levelLimit", 10)
    level = int(equipment["level"])
    exp = int(equipment["exp"]) + int(exp_gain)
    while level < max_level:
        level_template = _equip_row("EquipmentLevel.txt", type=equip_type, level=level)
        need = _equip_int(level_template, "needExp")
        if need <= 0 or exp < need:
            break
        exp -= need
        level += 1
    if level >= max_level:
        exp = 0
    equipment["level"], equipment["exp"] = level, exp
    return equipment


def _equipment_rank_upgrade(equipment):
    item = _equipment_template(equipment["item_id"])
    equip_type = _equip_int(item, "equipType")
    rank = _equip_int(item, "rank", 1)
    next_rank = rank + 1
    if not item or not _equip_row("EquipmentRank.txt", type=equip_type, rank=rank):
        return False
    next_item = 30000 + (equip_type - 1) * 100 + next_rank
    if not _equipment_template(next_item):
        return False
    equipment["grade_percent"] = int(equipment["grade_percent"]) + 20
    if equipment["grade_percent"] >= 100:
        equipment["item_id"] = next_item
        equipment["grade_percent"] = 0
    return True


def handle_equip_energy_info(cmd_data, player):
    return _equipment_energy_info(player)[1]


def handle_equip_attach_info(cmd_data, player):
    return _equipment_part_info(player)[1]


def handle_equip_create(cmd_data, player):
    item_id = parse_varint_fields(cmd_data).get(1, 0)
    template = _equipment_template(item_id)
    if not template or _equip_int(template, "rank") != 1:
        return []
    costs = _equipment_costs(template.get("originalMaterial"))
    if not costs or not _equipment_afford(player, costs):
        log.info("    equipment craft denied: item=%d missing material(s)", item_id)
        return []
    item_updates = [grant_items(player, [(iid, -amount) for iid, amount in costs])]
    uid = store.next_equipment_uid(player["uin"])
    store.add_equipment(player["uin"], uid, item_id)
    equipment = store.get_equipment(player["uin"], uid)
    item_updates.append(_equipment_item_update([equipment]))
    # Send the complete new bag object BEFORE Create_SC: the client's Create event immediately
    # issues the automatic wear request, so that request and the subsequent card refresh can see it.
    item_updates.append(("PVZ.Cmd.Cmd_Equip_Create_SC",
                         pb_varint_field(1, item_id) + pb_int64_field(2, uid)))
    log.info("    equipment crafted: uid=%d item=%d (%s)", uid, item_id, template.get("id"))
    return [message for message in item_updates if message]


def handle_equip_wear(cmd_data, player):
    fields = parse_varint_fields(cmd_data)
    card_uid, equip_uid = fields.get(1, 0), fields.get(2, 0)
    equipment = store.get_equipment(player["uin"], equip_uid)
    cards = {uid: (card_id, level) for uid, card_id, level, _exp in store.get_cards(player["uin"])}
    item = _equipment_template(equipment["item_id"]) if equipment else None
    if not equipment or card_uid not in cards or not item:
        return []
    if _equip_int(item, "plantType") not in (0, cards[card_uid][0] // 10 * 10):
        # Most existing templates are plantType=0; restricted gear must match its template's card.
        card_info = _BATTLE_CARDS.get(cards[card_uid][0], {})
        if _equip_int(item, "plantType") not in (0, int(card_info.get("tdId") or 0)):
            return []
    position = _equip_int(item, "position")
    changed = []
    for other in store.get_equipments(player["uin"]):
        other_item = _equipment_template(other["item_id"])
        if (int(other["uid"]) != int(equip_uid) and int(other["card_uid"]) == int(card_uid)
                and _equip_int(other_item, "position") == position):
            store.update_equipment(player["uin"], other["uid"], card_uid=0)
            changed.append(other["uid"])
    store.update_equipment(player["uin"], equip_uid, card_uid=card_uid)
    changed.append(equip_uid)
    rows = _equipment_updates_for_rows(player["uin"], changed)
    update = _equipment_item_update(rows)
    sc = ("PVZ.Cmd.Cmd_Equip_WearEquip_SC",
          pb_int64_field(1, card_uid) + pb_int64_field(2, equip_uid))
    load_battle_cards()
    card_sync = build_card_sync_sc(player["uin"], card_uid, cards[card_uid][0], 0)
    return [message for message in (update, card_sync, sc) if message]


def handle_equip_takeoff(cmd_data, player):
    equip_uid = parse_varint_fields(cmd_data).get(1, 0)
    equipment = store.get_equipment(player["uin"], equip_uid)
    if not equipment or not equipment["card_uid"]:
        return []
    card_uid = int(equipment["card_uid"])
    card = next((row for row in store.get_cards(player["uin"]) if row[0] == card_uid), None)
    store.update_equipment(player["uin"], equip_uid, card_uid=0)
    load_battle_cards()
    card_sync = build_card_sync_sc(player["uin"], card_uid, card[1], 0) if card else None
    return [message for message in (_equipment_item_update([store.get_equipment(player["uin"], equip_uid)]),
            card_sync, ("PVZ.Cmd.Cmd_Equip_TakeoffEquip_SC", pb_int64_field(1, equip_uid))) if message]


def _equipment_card_sync(player, equipment):
    """Refresh the owning card whenever worn equipment changes its computed attributes."""
    card_uid = int(equipment.get("card_uid") or 0)
    if not card_uid:
        return None
    card = next((row for row in store.get_cards(player["uin"]) if row[0] == card_uid), None)
    if not card:
        return None
    load_battle_cards()
    return build_card_sync_sc(player["uin"], card_uid, card[1], 0)


def _equipment_add_exp(player, equip_uid, all_available=False):
    equipment = store.get_equipment(player["uin"], equip_uid)
    if not equipment:
        return []
    state, _ = _equipment_pool_state(player)
    exp_messages = []
    auto_bead_update = None
    while True:
        item = _equipment_template(equipment["item_id"])
        if not item:
            break
        equip_type = _equip_int(item, "equipType")
        rank = _equip_int(item, "rank", 1)
        rank_template = _equip_row("EquipmentRank.txt", type=equip_type, rank=rank)
        level = int(equipment["level"])
        if level >= _equip_int(rank_template, "levelLimit", 10):
            break
        level_template = _equip_row("EquipmentLevel.txt", type=equip_type, level=level)
        cost = max(1, _equip_int(level_template, "costEnergy"))
        if state["current_energy"] < cost and state.get("auto_use_bead"):
            bead_count = store.get_item_count(player["uin"], 2046)
            pool = _equip_row("EquipmentPool.txt", id=state["pool_id"])
            bead_value = max(1, _equip_int(pool, "recover"))
            needed = (cost - int(state["current_energy"]) + bead_value - 1) // bead_value
            used = min(bead_count, needed)
            if used:
                state["current_energy"] += used * bead_value
                state["last_energy_at"] = int(time.time())
                store.update_equipment_state(player["uin"], current_energy=state["current_energy"],
                                             last_energy_at=state["last_energy_at"])
                auto_bead_update = grant_items(player, [(2046, -used)])
        if state["current_energy"] < cost:
            break
        state = _equipment_set_energy(player, state, int(state["current_energy"]) - cost)
        equipment = _equipment_upgrade_level(equipment, cost)
        info = pb_varint_field(1, cost) + pb_varint_field(2, 0)  # addExp, criticalTimes
        exp_messages.append(info)
        if not all_available:
            break
    if not exp_messages:
        return []
    store.update_equipment(player["uin"], equip_uid,
                           level=equipment["level"], exp=equipment["exp"])
    equipment = store.get_equipment(player["uin"], equip_uid)
    info = _equipment_info_dto(equipment)
    if all_available:
        add_exp = b"".join(pb_tag(2, 2) + uvarint(len(entry)) + entry for entry in exp_messages)
        main = ("PVZ.Cmd.Cmd_Equip_AddAllExp_SC",
                pb_int64_field(1, equip_uid) + add_exp
                + pb_tag(3, 2) + uvarint(len(info)) + info)
    else:
        entry = exp_messages[0]
        main = ("PVZ.Cmd.Cmd_Equip_AddExp_SC",
                pb_int64_field(1, equip_uid)
                + pb_tag(2, 2) + uvarint(len(entry)) + entry
                + pb_tag(3, 2) + uvarint(len(info)) + info)
    return [message for message in (_equipment_item_update([equipment]),
                                    _equipment_card_sync(player, equipment), auto_bead_update,
                                    main, _equipment_energy_info(player)) if message]


def handle_equip_add_exp(cmd_data, player):
    return _equipment_add_exp(player, parse_varint_fields(cmd_data).get(1, 0), False)


def handle_equip_add_all_exp(cmd_data, player):
    return _equipment_add_exp(player, parse_varint_fields(cmd_data).get(1, 0), True)


def handle_equip_upgrade(cmd_data, player):
    equip_uid = parse_varint_fields(cmd_data).get(1, 0)
    equipment = store.get_equipment(player["uin"], equip_uid)
    if not equipment:
        return []
    item = _equipment_template(equipment["item_id"])
    equip_type, rank = _equip_int(item, "equipType"), _equip_int(item, "rank", 1)
    recipe = _equip_row("EquipmentRank.txt", type=equip_type, rank=rank)
    costs = _equipment_costs(recipe.get("originalMaterial") if recipe else "")
    energy_cost = _equip_int(recipe, "costEnergy")
    state, _ = _equipment_pool_state(player)
    if (not recipe or _equip_int(recipe, "upgradeCount") <= 0 or not costs
            or not _equipment_afford(player, costs) or state["current_energy"] < energy_cost):
        return []
    if not _equipment_rank_upgrade(equipment):
        return []
    store.update_equipment(player["uin"], equip_uid, item_id=equipment["item_id"],
                           grade_percent=equipment["grade_percent"])
    updates = [grant_items(player, [(iid, -amount) for iid, amount in costs])]
    state = _equipment_set_energy(player, state, int(state["current_energy"]) - energy_cost)
    equipment = store.get_equipment(player["uin"], equip_uid)
    info = _equipment_info_dto(equipment)
    sc = ("PVZ.Cmd.Cmd_Equip_Upgrade_SC",
          pb_int64_field(1, equip_uid)
          + pb_varint_field(2, equipment["grade_percent"])
          + pb_tag(3, 2) + uvarint(len(info)) + info
          + pb_varint_field(4, equipment["item_id"]))
    updates.extend([_equipment_item_update([equipment]), _equipment_card_sync(player, equipment),
                    sc, _equipment_energy_info(player)])
    return [message for message in updates if message]


def handle_equip_use_bead(cmd_data, player):
    state, pool = _equipment_pool_state(player)
    if not pool or state["current_energy"] >= _equip_int(pool, "capability"):
        return []
    count = store.get_item_count(player["uin"], 2046)
    if count <= 0:
        return []
    bead_value = max(1, _equip_int(pool, "recover"))
    missing = _equip_int(pool, "capability") - state["current_energy"]
    used = min(count, max(1, (missing + bead_value - 1) // bead_value))
    state["current_energy"] = min(_equip_int(pool, "capability"),
                                  int(state["current_energy"]) + used * bead_value)
    state["last_energy_at"] = int(time.time())
    store.update_equipment_state(player["uin"], current_energy=state["current_energy"],
                                 last_energy_at=state["last_energy_at"])
    item_update = grant_items(player, [(2046, -used)])
    return [message for message in (item_update,
            ("PVZ.Cmd.Cmd_Equip_UseBead_SC", b""), _equipment_energy_info(player)) if message]


def handle_equip_auto_use_bead(cmd_data, player):
    enabled = parse_varint_fields(cmd_data).get(1, 0)
    store.update_equipment_state(player["uin"], auto_use_bead=1 if enabled else 0)
    return [_equipment_energy_info(player)]


def handle_equip_part_reward(cmd_data, player, first=False):
    state = store.get_equipment_state(player["uin"])
    part = _equip_row("EquipmentPart.txt", id=state["part_id"])
    if not part:
        return []
    if first:
        if state["first_claimed"]:
            return []
        amount = _equip_int(part, "firstReward")
        if amount <= 0:
            return []
        store.update_equipment_state(player["uin"], first_claimed=1)
    else:
        today = time.strftime("%Y%m%d")
        if state.get("daily_claim_day") == today:
            return []
        amount = _equip_int(part, "dailyReward")
        if amount <= 0:
            return []
        store.update_equipment_state(player["uin"], daily_claim_day=today)
    item_update = grant_items(player, [(2046, amount)])
    log.info("    equipment %s bead reward: %d", "first" if first else "daily", amount)
    return [message for message in (item_update, _equipment_part_info(player),
                                     _equipment_energy_info(player)) if message]


def handle_equip_first_bead(cmd_data, player):
    return handle_equip_part_reward(cmd_data, player, True)


def handle_equip_daily_bead(cmd_data, player):
    return handle_equip_part_reward(cmd_data, player, False)


def handle_equip_part_upgrade(cmd_data, player):
    fields = parse_varint_fields(cmd_data)
    use_ticket = bool(fields.get(1, 0))
    state = store.get_equipment_state(player["uin"])
    part = _equip_row("EquipmentPart.txt", id=state["part_id"])
    next_part = _equip_row("EquipmentPart.txt", id=int(state["part_id"]) + 1)
    if not part or not next_part:
        return []
    costs = _equipment_costs(part.get("originalMaterial"))
    short = [(iid, max(0, amount - store.get_item_count(player["uin"], iid)))
             for iid, amount in costs]
    short = [(iid, amount) for iid, amount in short if amount]
    ticket_cost = sum(amount for _iid, amount in short) * _equip_int(part, "cost")
    if short and (not use_ticket or int(player.get("ticket") or 0) < ticket_cost
                  or int(player.get("vip_level") or 0) < _equip_int(part, "needVIP")):
        return []
    consume = [(iid, -min(amount, store.get_item_count(player["uin"], iid)))
               for iid, amount in costs
               if min(amount, store.get_item_count(player["uin"], iid)) > 0]
    updates = [grant_items(player, consume)] if consume else []
    if short:
        player["ticket"] = int(player.get("ticket") or 0) - ticket_cost
        store.save_player(player["uin"], ticket=player["ticket"])
        updates.append(("PVZ.Cmd.Cmd_SyncTicket_SC", pb_varint_field(1, player["ticket"])))
    store.update_equipment_state(player["uin"], part_id=int(next_part["id"]),
                                 first_claimed=0)
    updates.extend([_equipment_part_info(player), _equipment_energy_info(player)])
    return [message for message in updates if message]


def handle_equip_pool_upgrade(cmd_data, player):
    state, pool = _equipment_pool_state(player)
    next_pool = _equip_row("EquipmentPool.txt", id=int(state["pool_id"]) + 1)
    if (not pool or not next_pool or state["current_exp"] < _equip_int(pool, "needExp")
            or state["part_id"] < _equip_int(pool, "needPartID")):
        return []
    store.update_equipment_state(player["uin"], pool_id=int(next_pool["id"]), current_exp=0,
                                 current_energy=min(int(state["current_energy"]),
                                                    _equip_int(next_pool, "capability")),
                                 last_energy_at=int(time.time()))
    return [("PVZ.Cmd.Cmd_Equip_PoolUp_SC", b""), _equipment_energy_info(player)]


def handle_equip_clone(cmd_data, player):
    """Clone a selected equipment object into a bag-only copy (client marks it as disposable)."""
    equip_uid = parse_varint_fields(cmd_data).get(1, 0)
    equipment = store.get_equipment(player["uin"], equip_uid)
    if not equipment:
        return []
    clones = [item for item in store.get_equipments(player["uin"]) if item["is_clone"]]
    if len(clones) >= 24:
        return []
    uid = store.next_equipment_uid(player["uin"])
    store.add_equipment(player["uin"], uid, equipment["item_id"], 0, equipment["level"],
                        equipment["exp"], equipment["grade_percent"], 1)
    item_update = _equipment_item_update([store.get_equipment(player["uin"], uid)])
    return [message for message in (item_update, ("PVZ.Cmd.Cmd_Equip_CloneEquip_SC", b"")) if message]


def handle_equip_sell_clones(cmd_data, player):
    clones = [item for item in store.get_equipments(player["uin"]) if item["is_clone"]]
    if not clones:
        return []
    for item in clones:
        store.remove_equipment(player["uin"], item["uid"])
    update = _equipment_item_update(removed=clones)
    return [message for message in (update, ("PVZ.Cmd.Cmd_Equip_SellAllClone_SC", b"")) if message]


def handle_equip_buy_bead(cmd_data, player):
    """Buy the next configured pack using the client's explicit paid action."""
    state = store.get_equipment_state(player["uin"])
    template = _equip_row("EquipmentBead.txt", id=int(state["buy_count"]) + 1)
    if not template:
        return []
    cost, count = _equip_int(template, "cost"), _equip_int(template, "count")
    # The bead-buy dialog uses paid diamonds. Prefer gift diamonds, then paid diamonds, matching
    # other client purchase flows while never allowing a negative balance.
    gift = int(player.get("present_ticket") or 0)
    paid = int(player.get("ticket") or 0)
    if gift + paid < cost:
        return []
    spend_gift = min(gift, cost)
    spend_paid = cost - spend_gift
    if spend_gift:
        player["present_ticket"] = gift - spend_gift
        store.save_player(player["uin"], present_ticket=player["present_ticket"])
    if spend_paid:
        player["ticket"] = paid - spend_paid
        store.save_player(player["uin"], ticket=player["ticket"])
    store.update_equipment_state(player["uin"], buy_count=int(state["buy_count"]) + 1)
    bag_update = grant_items(player, [(2046, count)])
    messages = [bag_update]
    messages.extend([("PVZ.Cmd.Cmd_SyncTicket_SC", pb_varint_field(1, player["ticket"])),
                     ("PVZ.Cmd.Cmd_SyncPresentTicket_SC", pb_varint_field(1, player["present_ticket"]))])
    messages.extend([_equipment_energy_info(player), _equipment_part_info(player)])
    return [message for message in messages if message]


# --- gate templates (needStars / needItems) from clientDB levelselectGateInfo.txt ------
_GATE_TEMPLATES = None


_BUILDINGS = None
# buildingInfo marks event-only buildings with unlockRoleLv=999.  Building 150 is the actual
# 捉小偷/护农田 entrance and must remain visible for this restored activity.
_RESTORED_EVENT_BUILDINGS = {150}


def load_buildings():
    """[(buildingId, unlockRoleLv)] from clientDB buildingInfo.txt (the town buildings)."""
    global _BUILDINGS
    if _BUILDINGS is None:
        _BUILDINGS = []
        rows = _read_clientdb_table("buildingInfo.txt")
        if rows:
            hdr = rows[0]; ci = {c: i for i, c in enumerate(hdr)}
            for c in rows[1:]:
                try:
                    _BUILDINGS.append((int(c[ci["id"]]), int(c[ci["unlockRoleLv"]])))
                except (ValueError, KeyError, IndexError):
                    pass
        log.info("loaded %d town buildings", len(_BUILDINGS))
    return _BUILDINGS


def handle_get_building_info(cmd_data, player):
    """Cmd_City_GetBuildingInfo_CS -> Cmd_City_GetBuildingInfo_SC. The town renders EXACTLY the
    buildings we list (CityData.buildingList -> CityMapView). Send every building the player's
    level has unlocked (buildingInfo.txt unlockRoleLv <= level); leveling up reveals more.
    (The two unlockRoleLv=999 buildings are event-only and never qualify.)"""
    level = int(player.get("level", 1))
    unlocked = [bid for bid, need in load_buildings()
                if need <= level or bid in _RESTORED_EVENT_BUILDINGS]
    log.info("    town buildings: level=%d -> %d unlocked %s", level, len(unlocked), unlocked)
    d = b""
    for bid in unlocked:
        dto = pb_varint_field(1, bid)                    # Dto_BuildingInfo{buildingType}
        d += pb_tag(1, 2) + uvarint(len(dto)) + dto      # buildingInfo (field 1, repeated)
    return d


def building_unlock_messages(old_level, new_level):
    """[(Cmd_SyncBuildingInfo_SC, body)] for every building whose unlockRoleLv is crossed going
    old_level -> new_level. The client (LoginService) reacts to each by cityData.addNewBuilding(type)
    + ChangeBuilding, so a newly-unlocked building appears LIVE in the town instead of only after a
    restart (which is when the town otherwise re-requests the whole list)."""
    msgs = []
    if new_level <= old_level:
        return msgs
    for bid, need in load_buildings():
        if old_level < need <= new_level:
            dto = pb_varint_field(1, bid)                # Dto_BuildingInfo{buildingType}
            body = pb_tag(1, 2) + uvarint(len(dto)) + dto  # buildingInfo (field 1)
            msgs.append(("PVZ.Cmd.Cmd_SyncBuildingInfo_SC", body))
    if msgs:
        log.info("    live-unlocked buildings (lvl %d->%d): %s", old_level, new_level,
                 [b for b, n in load_buildings() if old_level < n <= new_level])
    return msgs


# --- adventure / fuben (副本) ------------------------------------------------------
_FUBEN_CHAPTERS = None
_FUBEN_STAGES = None


def load_fuben_chapters():
    """[(chapterId, levelNeed)] sorted, from clientDB FubenChapterTemplate.txt."""
    global _FUBEN_CHAPTERS
    if _FUBEN_CHAPTERS is None:
        _FUBEN_CHAPTERS = []
        rows = _read_clientdb_table("FubenChapterTemplate.txt")
        if rows:
            hdr = rows[0]; ci = {c: i for i, c in enumerate(hdr)}
            for c in rows[1:]:
                try:
                    _FUBEN_CHAPTERS.append((int(c[ci["id"]]), int(c[ci["levelNeed"]])))
                except (ValueError, KeyError, IndexError):
                    pass
        _FUBEN_CHAPTERS.sort()
        log.info("loaded %d fuben chapters", len(_FUBEN_CHAPTERS))
    return _FUBEN_CHAPTERS


def load_fuben_stages():
    """{(chapterId, mode): [stageId,...]} from clientDB fuben.txt."""
    global _FUBEN_STAGES
    if _FUBEN_STAGES is None:
        _FUBEN_STAGES = {}
        rows = _read_clientdb_table("fuben.txt")
        if rows:
            hdr = rows[0]; ci = {c: i for i, c in enumerate(hdr)}
            for c in rows[1:]:
                try:
                    ch, st, md = (int(c[ci["chapterId"]]), int(c[ci["stageId"]]),
                                  int(c[ci["mode"]]))
                    _FUBEN_STAGES.setdefault((ch, md), []).append(st)
                except (ValueError, KeyError, IndexError):
                    pass
        for k in _FUBEN_STAGES:
            _FUBEN_STAGES[k].sort()
        log.info("loaded fuben stages for %d chapter/mode combos", len(_FUBEN_STAGES))
    return _FUBEN_STAGES


# itemId -> (player field, Cmd_Sync_SC) for the currencies we persist + push to the HUD.
# Everything else in a reward (keys, plant fragments, armor materials, puzzle pieces) is a bag
# item. Two "exp-type" currencies — 2 小镇繁荣度 (town prosperity) and 5 植物经验 (plant exp) —
# have no system yet; the client auto-hides them from the win chest, so we show them in the
# report but don't persist them.
_CURRENCY_SYNC = {
    1: ("coin", "PVZ.Cmd.Cmd_SyncCoin_SC"),
    3: ("sun", "PVZ.Cmd.Cmd_SyncSun_SC"),
    4: ("present_ticket", "PVZ.Cmd.Cmd_SyncPresentTicket_SC"),  # 钻石/gift diamond (ItemID.GiftDiamond1)
    6: ("friend_point", "PVZ.Cmd.Cmd_SyncFriendPoint_SC"),
    7: ("fame", "PVZ.Cmd.Cmd_SyncFame_SC"),
}
_UNMODELED_CURRENCIES = {2, 5}   # town prosperity / plant exp — displayed, not persisted

_FUBEN_REWARDS = None
_FUBEN_ENERGY = {}          # {(chapterId, mode, stageId): energyCost} — populated by load_fuben_rewards


def load_fuben_rewards():
    """{(chapterId, mode, stageId): (required, first, optional)} from clientDB fuben.txt.
    required/first = [(itemId, num)] — bonusRequired is granted every clear, bonusFirst only on
    the first clear. optional = [(itemId, num, chance)] rolled per clear (chance out of 10000)."""
    global _FUBEN_REWARDS
    if _FUBEN_REWARDS is None:
        _FUBEN_REWARDS = {}
        rows = _read_clientdb_table("fuben.txt")
        if rows:
            hdr = rows[0]; ci = {c: i for i, c in enumerate(hdr)}

            def col(c, k):
                i = ci.get(k)
                return c[i] if i is not None and i < len(c) else ""
            for c in rows[1:]:
                try:
                    key = (int(col(c, "chapterId")), int(col(c, "mode")), int(col(c, "stageId")))
                except ValueError:
                    continue
                optional = []
                for part in (col(c, "bonusOptional") or "").split(";"):
                    bits = part.split(":")
                    if len(bits) == 3:
                        try:
                            optional.append((int(bits[0]), int(bits[1]), int(bits[2])))
                        except ValueError:
                            pass
                _FUBEN_REWARDS[key] = (parse_bonus_items(col(c, "bonusRequired")),
                                       parse_bonus_items(col(c, "bonusFirst")), optional)
                try:
                    _FUBEN_ENERGY[key] = int(float(col(c, "energyCost") or 0))
                except ValueError:
                    pass
        log.info("loaded fuben rewards for %d stages", len(_FUBEN_REWARDS))
    return _FUBEN_REWARDS


def fuben_energy_cost(chapter, mode, stage):
    """The energy (体力) an adventure stage costs to fight, from clientDB fuben.txt (5 for ch1)."""
    load_fuben_rewards()
    return _FUBEN_ENERGY.get((chapter, mode, stage), 0)


def fuben_stage_reward(chapter, mode, stage, is_first):
    """Merged loot [(itemId, num)] for clearing a stage: bonusRequired (always) + bonusFirst
    (first clear only) + rolled bonusOptional. Duplicate ids are summed."""
    required, first, optional = load_fuben_rewards().get((chapter, mode, stage), ([], [], []))
    merged = {}

    def add(pairs):
        for iid, num in pairs:
            merged[iid] = merged.get(iid, 0) + num
    add(required)
    if is_first:
        add(first)
    for iid, num, chance in optional:
        if random.randint(1, 10000) <= chance:
            merged[iid] = merged.get(iid, 0) + num
    return sorted(merged.items())


def grant_fuben_reward(player, reward_items):
    """Apply a fuben reward: known currencies -> player fields (+ HUD Cmd_Sync_SC with the new
    total), unmodeled exp-type currencies (2/5) -> skipped, everything else -> the bag
    (Cmd_Item_Update_SC). Returns the (sc_name, body) sync messages to append."""
    msgs, bag_changes = [], []
    for iid, num in reward_items:
        if iid in _CURRENCY_SYNC:
            field, sc = _CURRENCY_SYNC[iid]
            player[field] = int(player.get(field, 0)) + num
            store.save_player(player["uin"], **{field: player[field]})
            msgs.append((sc, pb_varint_field(1, player[field])))
        elif iid in _UNMODELED_CURRENCIES:
            continue
        else:
            bag_changes.append((iid, num))
    upd = grant_items(player, bag_changes)   # sends NEW absolute counts (no double-count)
    if upd:
        msgs.append(upd)
    return msgs


# --- energy (体力) — consumed to fight adventure stages, regenerates over time, capped by role level --
# Must match the client-facing regen config (SERVER_CONFIG_OVERRIDES iRecoverEnergy*). The server is the
# source of truth: `energy` + `energy_time` (when that value was current); on any access we lazily add the
# energy that regenerated since. Cap = the role level's energyMax (levelInfo.txt) + the VIP cap privilege.
_ENERGY_REGEN_INTERVAL = 120   # seconds per +_ENERGY_REGEN_PER (keep == iRecoverEnergyInterval config)
_ENERGY_REGEN_PER = 1
_VIP_ENERGY_MAX_PRIV = 19      # VIP "体力上限增加" — adds its param to the energy cap
_LEVEL_ENERGY_MAX = None


def _load_level_energy_max():
    """{roleLevel: energyMax} from clientDB levelInfo.txt (100 @ lvl1, +~1/level)."""
    global _LEVEL_ENERGY_MAX
    if _LEVEL_ENERGY_MAX is None:
        _LEVEL_ENERGY_MAX = {}
        rows = _read_clientdb_table("levelInfo.txt")
        if rows:
            hdr = rows[0]; ci = {c: i for i, c in enumerate(hdr)}
            for r in rows[1:]:
                try:
                    _LEVEL_ENERGY_MAX[int(r[ci["id"]])] = int(r[ci["energyMax"]])
                except (ValueError, KeyError, IndexError):
                    pass
        log.info("loaded energyMax for %d role levels", len(_LEVEL_ENERGY_MAX))
    return _LEVEL_ENERGY_MAX


def energy_cap(player):
    """Max energy for this player: role level's energyMax + the VIP cap privilege (priv 19) param."""
    lvl = int(player.get("level", 1))
    base = _load_level_energy_max().get(lvl) or (99 + lvl)   # fallback tracks the ~+1/level curve
    return base + vip_privileges(player).get(_VIP_ENERGY_MAX_PRIV, 0)


def current_energy(player):
    """The player's energy right now, lazily folding in time-based regen since energy_time. Persists the
    new value + energy_time when they change. Energy ABOVE the cap (e.g. from a gift) is left as-is (no
    regen, not clamped down)."""
    now = int(time.time())
    cur = int(player.get("energy") or 0)
    cap = energy_cap(player)
    last = int(player.get("energy_time") or 0) or now
    if cur >= cap:
        if int(player.get("energy_time") or 0) != now:     # at/over cap: park the clock at now
            player["energy_time"] = now
            store.save_player(player["uin"], energy_time=now)
        return cur
    ticks = (now - last) // _ENERGY_REGEN_INTERVAL if _ENERGY_REGEN_INTERVAL > 0 else 0
    if ticks > 0:
        cur = min(cap, cur + ticks * _ENERGY_REGEN_PER)
        # advance the clock by exactly the consumed ticks (keep the remainder), or park at now if full.
        player["energy"] = cur
        player["energy_time"] = now if cur >= cap else last + ticks * _ENERGY_REGEN_INTERVAL
        store.save_player(player["uin"], energy=cur, energy_time=player["energy_time"])
    return cur


def consume_energy(player, amount):
    """Spend `amount` energy (from the regen-current value); returns True if it could be paid. Starts the
    regen clock from now (you just dropped below cap). Caller sends the sync + processes the action."""
    cur = current_energy(player)
    if amount <= 0:
        return True
    if cur < amount:
        return False
    player["energy"] = cur - amount
    player["energy_time"] = int(time.time())     # regen counts from the moment of spending
    store.save_player(player["uin"], energy=player["energy"], energy_time=player["energy_time"])
    return True


def energy_sync_msg(player):
    """('Cmd_SyncEnergy_SC', current-energy) — push whenever energy changes so the HUD bar updates."""
    return ("PVZ.Cmd.Cmd_SyncEnergy_SC", pb_varint_field(1, current_energy(player)))


# --- buy energy (spend diamonds for +energy, escalating cost, daily-limited) --------
_ENERGY_BUY = None
_ENERGY_BUY_TIMES_BASE = 5     # base diamond energy-buys/day (== iEnergyBuyTimes config); VIP priv 4 adds more
_VIP_ENERGY_BUY_PRIV = 4       # VIP "每日体力购买次数增加" — adds its param to the daily buy limit


def load_energy_buy():
    """{buyNum: (costItemId, costAmount, energyAdd)} from FubenEnargysTemplate.txt — the Nth diamond buy of
    the day costs needRes (item4=gift diamond, 50..400) for enargyAdd (80) energy."""
    global _ENERGY_BUY
    if _ENERGY_BUY is None:
        _ENERGY_BUY = {}
        rows = _read_clientdb_table("FubenEnargysTemplate.txt")
        if rows:
            hdr = rows[0]; ci = {c: i for i, c in enumerate(hdr)}
            for r in rows[1:]:
                try:
                    res = r[ci["needRes"]].split(":")
                    _ENERGY_BUY[int(r[ci["id"]])] = (int(res[0]), int(res[1]), int(r[ci["enargyAdd"]]))
                except (ValueError, KeyError, IndexError):
                    pass
        log.info("loaded %d energy-buy tiers", len(_ENERGY_BUY))
    return _ENERGY_BUY


def _energy_buy_reset(player):
    """Reset today's diamond energy-buy counter on a new day."""
    today = time.strftime("%Y%m%d")
    if (player.get("buy_energy_day") or "") != today:
        player["buy_energy_num"], player["buy_energy_day"] = 0, today
        store.save_player(player["uin"], buy_energy_num=0, buy_energy_day=today)


def energy_buy_limit(player):
    """Diamond energy-buys allowed per day: base + the VIP buy-count privilege (priv 4)."""
    return _ENERGY_BUY_TIMES_BASE + vip_privileges(player).get(_VIP_ENERGY_BUY_PRIV, 0)


def handle_market_buyenergy(cmd_data, player):
    """Cmd_Market_BuyEnergy_CS -> spend diamonds for +energy (FubenEnargysTemplate: Nth buy = cost/amount),
    up to energy_buy_limit/day. -> Cmd_Market_BuyEnergy_SC{buyNum} + SyncEnergy (+ diamond sync)."""
    _energy_buy_reset(player)
    uin = player["uin"]
    n = int(player.get("buy_energy_num") or 0) + 1              # this would be the Nth buy today
    tbl = load_energy_buy()
    tpl = tbl.get(n) or (tbl.get(max(tbl)) if tbl else None)
    buynum_sc = ("PVZ.Cmd.Cmd_Market_BuyEnergy_SC", pb_varint_field(1, int(player.get("buy_energy_num") or 0)))
    if not tpl or n > energy_buy_limit(player):
        return [buynum_sc]                                     # over the daily limit — the client blocks first
    cost_item, cost_amt, add = tpl
    field = _CURRENCY_SYNC.get(cost_item, ("present_ticket", ""))[0]
    if int(player.get(field, 0)) < cost_amt:
        return [buynum_sc]                                     # can't afford (client blocks first)
    charge = grant_fuben_reward(player, [(cost_item, -cost_amt)])   # deduct the diamonds (+ HUD sync)
    player["buy_energy_num"] = n
    player["energy"] = current_energy(player) + add            # fold regen in, then add (may overflow cap)
    store.save_player(uin, buy_energy_num=n, energy=player["energy"])
    log.info("    BUY ENERGY: +%d energy for %dx item %d (buy #%d/%d, uin=%d)",
             add, cost_amt, cost_item, n, energy_buy_limit(player), uin)
    return [("PVZ.Cmd.Cmd_Market_BuyEnergy_SC", pb_varint_field(1, n)),
            ("PVZ.Cmd.Cmd_SyncEnergy_SC", pb_varint_field(1, player["energy"]))] + charge


# --- TD cart purchase (spend gold diamonds) ---------------------------------
_TD_CART_COST_GOLD_DIAMOND = 1  # iBuyCartCostTicket


def _handle_td_buycart(cmd_data, player, response_name):
    """Buy one lawn mower for the current TD battle with gold diamonds only.

    The Flash client already enforces iBuyCartTimesLimit for the battle.  The
    server must still acknowledge the purchase and sync ticket, otherwise the
    client leaves the mower locked even though the player has gold diamonds.
    """
    cart_id = int(parse_varint_fields(cmd_data).get(5, 0))
    if cart_id <= 0 or int(player.get("ticket") or 0) < _TD_CART_COST_GOLD_DIAMOND:
        return []
    player["ticket"] -= _TD_CART_COST_GOLD_DIAMOND
    store.save_player(player["uin"], ticket=player["ticket"])
    log.info("    TD BUY CART: cart %d for %d gold diamond (uin=%d)",
             cart_id, _TD_CART_COST_GOLD_DIAMOND, player["uin"])
    body = pb_varint_field(1, cart_id) + pb_varint_field(2, 0)  # cartId, remainTimes
    return [(response_name, body),
            ("PVZ.Cmd.Cmd_SyncTicket_SC", pb_varint_field(1, player["ticket"]))]


def handle_td_buycart(cmd_data, player):
    return _handle_td_buycart(cmd_data, player, "PVZ.Cmd.Cmd_TD_BuyCart_SC")


def handle_dailytd_buycart(cmd_data, player):
    return _handle_td_buycart(cmd_data, player, "PVZ.Cmd.Cmd_DailyTD_BuyCart_SC")


def handle_noendtd_buycart(cmd_data, player):
    return _handle_td_buycart(cmd_data, player, "PVZ.Cmd.Cmd_NoEndTD_BuyCart_SC")


_FUBEN_BONUS = None


def load_fuben_bonus():
    """{(chapterId, mode): (starsMax, itemId, amount)} from clientDB FubenBonusTemplate.txt — the
    per-chapter star-reward chest (bonus = "itemId:amount", claimable once starsMax stars earned)."""
    global _FUBEN_BONUS
    if _FUBEN_BONUS is None:
        _FUBEN_BONUS = {}
        rows = _read_clientdb_table("FubenBonusTemplate.txt")
        if rows:
            hdr = rows[0]; ci = {c: i for i, c in enumerate(hdr)}

            def col(c, k):
                i = ci.get(k)
                return c[i] if i is not None and i < len(c) else ""
            for c in rows[1:]:
                try:
                    ch, md = int(col(c, "id")), int(col(c, "mode"))
                    stars_max = int(float(col(c, "starsMax") or 0))
                    iid, amount = col(c, "bonus").split(":")
                    _FUBEN_BONUS[(ch, md)] = (stars_max, int(iid), int(amount))
                except (ValueError, KeyError, IndexError):
                    pass
        log.info("loaded %d fuben bonus-chest templates", len(_FUBEN_BONUS))
    return _FUBEN_BONUS


def _fuben_box_taken_flag(uin, chapter, mode):
    """1 if the player has claimed this chapter+mode star-chest, else 0 (for GetStageInfo)."""
    return 1 if store.is_fuben_box_taken(uin, chapter, mode) else 0


def handle_fuben_requestrewardbox(cmd_data, player):
    """Cmd_Fuben_RequestRewardBox_CS{chapterid(1), mode(2)} -> Cmd_Fuben_RequestRewardBox_SC
    {chapterid(1), mode(2)}. The client reads the chest's item from its own FubenBonusTemplate and
    flies it to the bag on retCode==0; we grant it authoritatively (gift diamond -> HUD sync) and
    record the claim so it won't re-open. Claimable = starsMax stars earned in that chapter+mode and
    not already taken; an invalid/duplicate request is a silent no-op (no fake grant)."""
    f = parse_varint_fields(cmd_data)
    chapter, mode = f.get(1, 0), f.get(2, 0)
    uin = player["uin"]
    stars_max, item_id, amount = load_fuben_bonus().get((chapter, mode), (0, 0, 0))
    have = sum(store.get_fuben_passed(uin, chapter, mode).values())
    if (not chapter or not mode or stars_max <= 0 or have < stars_max
            or store.is_fuben_box_taken(uin, chapter, mode)):
        log.info("    fuben reward box DENIED: chapter=%d mode=%d have=%d/%d taken=%s",
                 chapter, mode, have, stars_max, store.is_fuben_box_taken(uin, chapter, mode))
        return []                      # silent no-op — the client only asks when legitimately open
    store.take_fuben_box(uin, chapter, mode)
    sc = pb_varint_field(1, chapter) + pb_varint_field(2, mode)   # echo -> setTakenReward + itemFly
    messages = [("PVZ.Cmd.Cmd_Fuben_RequestRewardBox_SC", sc)]
    messages += grant_fuben_reward(player, [(item_id, amount)])   # gift diamond -> field + sync
    log.info("    fuben reward box CLAIMED: chapter=%d mode=%d -> item %d x%d (stars %d/%d)",
             chapter, mode, item_id, amount, have, stars_max)
    return messages


def _fuben_chapter_cleared(uin, chapter):
    """True if every normal-mode stage of a chapter has been beaten (gates the next chapter)."""
    normal_stages = load_fuben_stages().get((chapter, 1), [])
    return bool(normal_stages) and len(store.get_fuben_passed(uin, chapter, 1)) >= len(normal_stages)


def handle_fuben_getchapterinfo(cmd_data, player):
    """Cmd_Fuben_GetChapterInfo_CS -> Cmd_Fuben_GetChapterInfo_SC. Unlock chapters by PROGRESS,
    contiguously: chapter N+1 opens only once N is fully cleared (and level >= levelNeed). A
    chapter with a Dto becomes unlocked (FubenChapterVO.loadDto). This keeps the set contiguous
    AND makes getLastUnlockedFubenStageVo() return the player's real FRONTIER chapter (so the
    map opens there, not the highest level-gated one). Dto_Fuben_ChapterInfo{chapterid(1),
    star(2), lastEasyStageId(3), lastHardStageId(4)}."""
    level = int(player.get("level", 1))
    uin = player["uin"]
    d, n = b"", 0
    for ch, need in load_fuben_chapters():
        if need > level:
            break                          # level gate — can't reach this chapter yet
        normal = store.get_fuben_passed(uin, ch, 1)   # {stage: star}
        elite = store.get_fuben_passed(uin, ch, 2)
        star = sum(normal.values()) + sum(elite.values())
        dto = (pb_varint_field(1, ch) + pb_varint_field(2, star)
               + pb_varint_field(3, max(normal) if normal else 0)     # lastEasyStageId
               + pb_varint_field(4, max(elite) if elite else 0))      # lastHardStageId
        d += pb_tag(1, 2) + uvarint(len(dto)) + dto
        n += 1
        if not _fuben_chapter_cleared(uin, ch):
            break                          # frontier reached — stop unlocking further chapters
    log.info("    fuben chapters: level=%d -> %d unlocked (progress-gated)", level, n)
    return d


def handle_fuben_getstageinfo(cmd_data, player):
    """Cmd_Fuben_GetStageInfo_CS{chapterid, modeid} -> Cmd_Fuben_GetStageInfo_SC. Send a
    Dto_Fuben_StageInfo ONLY for the cleared stages (loadDto -> unlocked+star); the client then
    setUnlocked()s the next stage after the highest cleared, and un-reached stages stay locked.
    If none are cleared yet, send just stage 1 so it appears unlocked (and to avoid the client's
    empty-list null-deref). Dto_Fuben_StageInfo{chapterid(1),modeid(2),stageid(3),star(4)}."""
    f = parse_varint_fields(cmd_data)
    chapter, mode = f.get(1, 1), f.get(2, 1)
    all_stages = load_fuben_stages().get((chapter, mode), [])
    passed = store.get_fuben_passed(player["uin"], chapter, mode)   # {stageId: star}
    send = sorted(passed) if passed else (all_stages[:1] if all_stages else [])
    taken = _fuben_box_taken_flag(player["uin"], chapter, mode)
    log.info("    fuben stage info: chapter=%d mode=%d -> send %s (%d cleared of %d) boxTaken=%d",
             chapter, mode, send, len(passed), len(all_stages), taken)
    d = b""
    for st in send:
        dto = (pb_varint_field(1, chapter) + pb_varint_field(2, mode)
               + pb_varint_field(3, st) + pb_varint_field(4, passed.get(st, 0)))
        d += pb_tag(1, 2) + uvarint(len(dto)) + dto     # stageinfo (field 1, repeated)
    d += pb_varint_field(2, taken)                      # hasTakeReward (field 2) — chest claimed?
    return d


# --- battle cards (the card-RPG combat units) from clientDB battleCard.txt -------------
# Plants and zombies are both "battle cards": id=cardId, tdId maps a card to its TD plant
# (0 for zombies), planClassName = the plan-machine animation, initial*/grow* = stats.
_BATTLE_CARDS = None
_TD_TO_CARD = None

# battleCard.txt stats are the COLLECTIBLE-card scale (endgame numbers: sunflower 36k HP, mummy
# 270k HP). The ADVENTURE display uses a much smaller scale — the wiki Day-1 mummy is ~2970 HP =
# the mummy card (270000) compressed ~91x. Raw card stats made the player's combat power ~170x the
# zombies; the intended balance (early-version screenshot) is only ~2x. We divide every card's
# hp/atk/def/ability by this one factor at load time, so ALL consumers — almanac (raw-attribute),
# collection (card package), formation (lineup 战力), and the plant battle units — shrink together
# and stay consistent. Zombies keep their own hand-tuned wiki stats in build_battle_units (they don't
# read these), so this only brings the PLANT side down. D=80 => 4 starters ~1.35x, a fuller 6-plant
# team ~2x the zombie total (990) — "a little higher, not drastically higher".
_ADV_STAT_SCALE = 80


def load_battle_cards():
    """{cardId: {tdId,name,type,plan,hp,atk,def_,star,skill1,skill2}} + {tdPlantId: base star-1
    cardId} from battleCard.txt. Stats are the card's star-1 base (level 1); good enough for v1."""
    global _BATTLE_CARDS, _TD_TO_CARD
    if _BATTLE_CARDS is None:
        _BATTLE_CARDS, _TD_TO_CARD = {}, {}
        rows = _read_clientdb_table("battleCard.txt")
        if rows:
            hdr = rows[0]; ci = {c: i for i, c in enumerate(hdr)}

            def col(c, k, d="0"):
                i = ci.get(k)
                return c[i] if i is not None and i < len(c) else d
            for c in rows[1:]:
                try:
                    cid = int(col(c, "id"))
                except ValueError:
                    continue
                td = int(col(c, "tdId") or 0)
                # Store RAW (unscaled) initial + grow-per-level so stats can be computed at ANY card
                # level (card_stats_at_level). The `hp/atk/def_/ability` keys stay the LEVEL-1 scaled
                # values (adventure scale, see _ADV_STAT_SCALE) for callers that want the base.
                s = _ADV_STAT_SCALE
                _BATTLE_CARDS[cid] = {
                    "tdId": td, "name": col(c, "name", ""), "type": int(col(c, "type") or 0),
                    "fruitType": int(col(c, "fruitType") or 0),
                    "rarity": int(col(c, "rarity") or 1),
                    "awakeLevel": int(col(c, "awakeLevel") or 0),
                    "recycleItemId": int((col(c, "recycleItemString", "0,0").split(",") + ["0"])[0] or 0),
                    "recycleItemNum": int((col(c, "recycleItemString", "0,0").split(",") + ["0", "0"])[1] or 0),
                    "plan": col(c, "planClassName", ""),
                    "hp": max(1, int(col(c, "initialHp") or 0) // s),
                    "atk": int(col(c, "initialAttack") or 0) // s,
                    "def_": int(col(c, "initialDefense") or 0) // s, "star": int(col(c, "star") or 1),
                    "skill1": int(col(c, "skillId1") or 0), "skill2": int(col(c, "skillId2") or 0),
                    "quality": int(col(c, "quality") or 1),
                    "ability": int(col(c, "initialAbility") or 0) // s,
                    "maxLv": int(col(c, "maxLv") or 1),
                    "init_hp": int(col(c, "initialHp") or 0), "grow_hp": int(col(c, "growHp") or 0),
                    "init_atk": int(col(c, "initialAttack") or 0), "grow_atk": int(col(c, "growAttack") or 0),
                    "init_def": int(col(c, "initialDefense") or 0), "grow_def": int(col(c, "growDefense") or 0),
                    "init_abi": int(col(c, "initialAbility") or 0), "grow_abi": int(col(c, "growAbility") or 0),
                    "hit": int(col(c, "initialHit") or 0) // s,
                    "dodge": int(col(c, "initialDodge") or 0) // s,
                    "critical": int(col(c, "initialCritical") or 0) // s,
                    "tough": int(col(c, "initialTough") or 0) // s,
                    "init_hit": int(col(c, "initialHit") or 0),
                    "grow_hit": int(col(c, "growHit") or 0),
                    "init_dodge": int(col(c, "initialDodge") or 0),
                    "grow_dodge": int(col(c, "growDodge") or 0),
                    "init_critical": int(col(c, "initialCritical") or 0),
                    "grow_critical": int(col(c, "growCritical") or 0),
                    "init_tough": int(col(c, "initialTough") or 0),
                    "grow_tough": int(col(c, "growTough") or 0),
                }
                # base card for a TD plant = the lowest cardId sharing that tdId (star-1, quality-1).
                if td and (td not in _TD_TO_CARD or cid < _TD_TO_CARD[td]):
                    _TD_TO_CARD[td] = cid
        log.info("loaded %d battle cards (%d TD-plant mappings)", len(_BATTLE_CARDS), len(_TD_TO_CARD))
    return _BATTLE_CARDS


def card_stats_at_level(card_id, level):
    """A card's adventure-scaled stats at a given card LEVEL. stat = (initial + grow*(level-1)) /
    _ADV_STAT_SCALE. Returns a dict shaped like a _BATTLE_CARDS entry (hp/atk/def_/ability + name/
    skill1/skill2/quality/star), so it drops into card_power / build_* unchanged. Level 1 == the base."""
    load_battle_cards()
    b = _BATTLE_CARDS.get(card_id)
    if not b:
        return {"hp": 1, "atk": 0, "def_": 0, "ability": 0, "skill1": 0, "skill2": 0,
                "hit": 0, "dodge": 0, "critical": 0, "tough": 0,
                "quality": 1, "star": 1, "name": "?"}
    lv = max(1, int(level or 1))
    s = _ADV_STAT_SCALE
    def at(init, grow):
        return (init + grow * (lv - 1)) // s
    return {
        "hp": max(1, at(b["init_hp"], b["grow_hp"])), "atk": at(b["init_atk"], b["grow_atk"]),
        "def_": at(b["init_def"], b["grow_def"]), "ability": at(b["init_abi"], b["grow_abi"]),
        "hit": at(b["init_hit"], b["grow_hit"]), "dodge": at(b["init_dodge"], b["grow_dodge"]),
        "critical": at(b["init_critical"], b["grow_critical"]),
        "tough": at(b["init_tough"], b["grow_tough"]),
        "skill1": b["skill1"], "skill2": b["skill2"], "quality": b["quality"], "star": b["star"],
        "name": b["name"], "level": lv,
    }


_CARD_FRUIT_INFO = None


def load_card_fruit_info():
    """Index cardFruitInfo.txt by (plant fruitType, fruit-slot quality, level)."""
    global _CARD_FRUIT_INFO
    if _CARD_FRUIT_INFO is None:
        _CARD_FRUIT_INFO = {}
        rows = _read_clientdb_table("cardFruitInfo.txt")
        if rows:
            hdr = rows[0]; ci = {c: i for i, c in enumerate(hdr)}
            for row in rows[1:]:
                try:
                    key = (int(row[ci["cardType"]]), int(row[ci["quilty"]]),
                           int(row[ci["level"]]))
                    _CARD_FRUIT_INFO[key] = {
                        "attack": int(row[ci["attack"]]), "defence": int(row[ci["defence"]]),
                        "life": int(row[ci["life"]]), "ability": int(row[ci["ability"]]),
                        "hit": int(row[ci["hit"]]), "dodge": int(row[ci["dodge"]]),
                        "critical": int(row[ci["critical"]]), "tough": int(row[ci["tough"]]),
                        "intitate": int(row[ci["intitate"]]), "needItems": row[ci["needItems"]],
                        "isSuperCatalytic": int(row[ci["isSuperCatalytic"]]),
                        "openLevel": int(row[ci["openLevel"]]),
                        "totalFightPower": int(row[ci["totalFightPower"]]),
                    }
                except (KeyError, IndexError, TypeError, ValueError):
                    continue
        log.info("loaded %d card-fruit templates", len(_CARD_FRUIT_INFO))
    return _CARD_FRUIT_INFO


def _card_fruit_stat_bonus(uin, uid, card_id):
    """Return scaled battle stats from all of an owned plant's upgraded fruit slots."""
    load_battle_cards()
    fruit_type = int((_BATTLE_CARDS.get(card_id) or {}).get("fruitType", 0))
    if not fruit_type or not uid:
        return {"atk": 0, "def_": 0, "hp": 0, "ability": 0,
                "hit": 0, "dodge": 0, "critical": 0, "tough": 0}
    templates = load_card_fruit_info()
    bonus = {"atk": 0, "def_": 0, "hp": 0, "ability": 0,
             "hit": 0, "dodge": 0, "critical": 0, "tough": 0}
    for slot, level in store.get_card_fruits(uin, uid).items():
        info = templates.get((fruit_type, int(slot), int(level)))
        if not info:
            continue
        bonus["atk"] += info["attack"] // _ADV_STAT_SCALE
        bonus["def_"] += info["defence"] // _ADV_STAT_SCALE
        bonus["hp"] += info["life"] // _ADV_STAT_SCALE
        bonus["ability"] += info["ability"] // _ADV_STAT_SCALE
        for field in ("hit", "dodge", "critical", "tough"):
            bonus[field] += info[field] // _ADV_STAT_SCALE
    return bonus


def _apply_card_fruit_bonus(stats, uin, uid, card_id):
    bonus = _card_fruit_stat_bonus(uin, uid, card_id)
    for key, value in bonus.items():
        stats[key] = stats.get(key, 0) + value
    return stats


# --- card genes (植物基因) ----------------------------------------------------------
_CARD_DNA = None
_DNA_ATTR_STATS = {1: "atk", 2: "def_", 3: "hp", 5: "ability",
                   6: "hit", 7: "dodge", 8: "critical", 9: "tough"}


def load_card_dna():
    """Load the same gene-choice, enhancement, refund and trial tables used by ModuleCardDNA."""
    global _CARD_DNA
    if _CARD_DNA is not None:
        return _CARD_DNA
    data = {"info": {}, "choose": {}, "factor": {}, "param": {}, "reset": {},
            "test": {}, "test_reset": {}, "test_limit": {}}

    def rows_by_name(table):
        rows = _read_clientdb_table(table)
        if not rows:
            return []
        ci = {name: index for index, name in enumerate(rows[0])}
        return [(row, ci) for row in rows[1:]]

    def val(row, ci, key, default="0"):
        i = ci.get(key)
        return row[i] if i is not None and i < len(row) else default

    for row, ci in rows_by_name("cardDNAInfo.txt"):
        try:
            data["info"][(int(val(row, ci, "cardType")), int(val(row, ci, "quilty")))] = [
                int(x) for x in val(row, ci, "chooseListStr", "").split(",") if x]
        except ValueError:
            continue
    for row, ci in rows_by_name("cardDNAChooseInfo.txt"):
        try:
            key = (int(val(row, ci, "type")), int(val(row, ci, "level")))
            data["choose"][key] = {
                "type_name": int(val(row, ci, "typeNameID")),
                "add": int(val(row, ci, "addProp")),
                "total": int(val(row, ci, "totalAddProp")),
                "items": parse_bonus_items(val(row, ci, "needItemStr", "")),
                "clip": int(val(row, ci, "needClipNum")),
                "plant_level": int(val(row, ci, "needPlantLV")),
            }
        except ValueError:
            continue
    for row, ci in rows_by_name("cardDNAFactorInfo.txt"):
        try:
            key = (int(val(row, ci, "cardType")), int(val(row, ci, "quilty")),
                   int(val(row, ci, "level")))
            data["factor"][key] = {
                "attack": int(val(row, ci, "attack")), "defense": int(val(row, ci, "defence")),
                "hp": int(val(row, ci, "life")), "ability": int(val(row, ci, "ability")),
                "hit": int(val(row, ci, "hit")), "dodge": int(val(row, ci, "dodge")),
                "critical": int(val(row, ci, "critical")), "tough": int(val(row, ci, "tough")),
                "items": parse_bonus_items(val(row, ci, "needItemStr", "")),
                "plant_level": int(val(row, ci, "needPlantLV")),
                "probability": int(val(row, ci, "probability")),
                "fail_exp": int(val(row, ci, "failExp")),
                "max_probability": int(val(row, ci, "maxProbability")),
            }
        except ValueError:
            continue
    for row, ci in rows_by_name("cardDNAParamInfo.txt"):
        try:
            data["param"][int(val(row, ci, "id"))] = {
                "scale": int(val(row, ci, "param")) / 10000.0,
                "recycle_factor": parse_bonus_items(val(row, ci, "recycleFactorNeedItemStr", "")),
                "recycle_dna": parse_bonus_items(val(row, ci, "recycleDNANeedItemStr", "")),
            }
        except ValueError:
            continue
    for row, ci in rows_by_name("cardDNAResetInfo.txt"):
        try:
            data["reset"][int(val(row, ci, "id"))] = parse_bonus_items(val(row, ci, "needItemStr", ""))
        except ValueError:
            continue
    for row, ci in rows_by_name("cardDNATestLevelInfo.txt"):
        try:
            data["test"][(int(val(row, ci, "mode")), int(val(row, ci, "stageID")),
                          int(val(row, ci, "levelID")))] = {
                "power": int(val(row, ci, "monsterFP")),
                "reward_text": val(row, ci, "rewardItemStr", ""),
            }
        except ValueError:
            continue
    for table, target in (("cardDNATestReset.txt", "test_reset"),
                          ("cardDNATestLimit.txt", "test_limit")):
        for row, ci in rows_by_name(table):
            try:
                key = int(val(row, ci, "id"))
                if target == "test_reset":
                    target_cost = parse_bonus_items(val(row, ci, "needItemStr", ""))
                    data[target][key] = target_cost[0] if target_cost else (37, 0)
                else:
                    data[target][key] = {"open": int(val(row, ci, "isOpen")),
                                         "requirement": val(row, ci, "challengeLimit", ""),
                                         "tip": val(row, ci, "openLimitTip", "")}
            except ValueError:
                continue
    _CARD_DNA = data
    log.info("loaded gene templates: %d plant-stage choices, %d attribute levels, %d factor levels, %d trial levels",
             len(data["info"]), len(data["choose"]), len(data["factor"]), len(data["test"]))
    return data


def _dna_scale(card_info):
    return load_card_dna()["param"].get(int(card_info.get("rarity", 1)), {"scale": 1.0})["scale"]


def _dna_scaled_cost(costs, scale):
    return [(int(iid), max(0, int(int(amount) * scale))) for iid, amount in costs if amount]


def _dna_gene_proto(gene_id, gene):
    return (pb_varint_field(1, gene_id) + pb_varint_field(2, gene["factor_level"])
            + pb_varint_field(3, gene["factor_exp"]) + pb_varint_field(4, gene["attribute"])
            + pb_varint_field(5, gene["level"]))


def _dna_default_gene(gene_id):
    return {"factor_level": 0, "factor_exp": 0, "attribute": 0, "level": 0}


def _dna_gene_info_body(uid, card, gene_rows):
    """Build GetGeneInfo_SC including non-null base/percent Dto_CardAttribute terms."""
    load_battle_cards()
    card_id = card[1]
    card_info = _BATTLE_CARDS.get(card_id, {})
    card_type = int(card_info.get("fruitType", 0))
    level = int(card[2])
    genes = b""
    for gene_id, gene in sorted(gene_rows.items()):
        dto = _dna_gene_proto(gene_id, gene)
        genes += pb_bytes(2, dto)

    stats = card_stats_at_level(card_id, level)
    totals = {attr: 0 for attr in _DNA_ATTR_STATS}
    dna = load_card_dna()
    scale = _dna_scale(card_info)
    for gene_id, gene in gene_rows.items():
        attr = int(gene["attribute"])
        info = dna["choose"].get((attr, int(gene["level"])))
        if info and info["type_name"] in totals:
            totals[info["type_name"]] += int(info["total"] * scale)

    # Dto_CardAttribute uses hundredths for base and percentage terms; the client applies
    # base * 0.01 * percent * 0.0001. Always send both nested terms to avoid null access.
    base_fields = {1: "atk", 2: "def_", 3: "hp", 5: "ability", 6: "hit",
                   7: "dodge", 8: "critical", 9: "tough"}
    base = b""
    percent = b""
    for field, key in base_fields.items():
        base += pb_varint_field(field, int(stats.get(key, 0)) * 100)
        percent += pb_varint_field(field, int(totals.get(field, 0)) * 100)
    term_base, term_percent = pb_bytes(1, base), pb_bytes(2, percent)
    attribute = term_base + term_percent
    return (pb_int64_field(1, uid) + genes + pb_bytes(3, attribute))


def _card_gene_stat_bonus(uin, uid, card_id, card_level=None):
    """Resolve the card's persisted gene factors and chosen paths to combat stat additions."""
    load_battle_cards()
    card_info = _BATTLE_CARDS.get(int(card_id), {})
    card_type = int(card_info.get("fruitType", 0))
    if not card_type or not uid:
        return {key: 0 for key in ("atk", "def_", "hp", "ability", "hit", "dodge", "critical", "tough")}
    if card_level is None:
        owned = next((row for row in store.get_cards(uin) if int(row[0]) == int(uid)), None)
        card_level = int(owned[2]) if owned else 1
    dna = load_card_dna()
    scale = _dna_scale(card_info)
    bonus = {key: 0 for key in ("atk", "def_", "hp", "ability", "hit", "dodge", "critical", "tough")}
    for gene_id, gene in store.get_card_genes(uin, uid).items():
        for level in range(1, min(int(gene["factor_level"]), 10) + 1):
            factor = dna["factor"].get((card_type, gene_id, level))
            if factor:
                bonus["atk"] += int(factor["attack"] * 0.01 * scale)
                bonus["def_"] += int(factor["defense"] * 0.01 * scale)
                bonus["hp"] += int(factor["hp"] * 0.01 * scale)
                bonus["ability"] += int(factor["ability"] * 0.01 * scale)
                for key in ("hit", "dodge", "critical", "tough"):
                    bonus[key] += int(factor[key] * scale)
        attr = int(gene["attribute"])
        choice = dna["choose"].get((attr, int(gene["level"])))
        stat = _DNA_ATTR_STATS.get(choice["type_name"]) if choice else None
        if stat:
            current = card_stats_at_level(card_id, card_level).get(stat, 0)
            bonus[stat] += int(current * int(choice["total"] * scale) / 10000)
    return bonus


def _apply_card_gene_bonus(stats, uin, uid, card_id, card_level=None):
    for key, value in _card_gene_stat_bonus(uin, uid, card_id, card_level).items():
        stats[key] = stats.get(key, 0) + value
    return stats


_CARD_BAPTIZE_ACTIONS = None
_CARD_BAPTIZE_LIMITS = None
_REFINE_ATTRIBUTES = ((1, "attack"), (2, "defense"), (3, "hp"), (5, "ability"))


def load_card_baptize_templates():
    """Load the exact wash costs and caps from clientDB's baptizeAction/Limit tables."""
    global _CARD_BAPTIZE_ACTIONS, _CARD_BAPTIZE_LIMITS
    if _CARD_BAPTIZE_ACTIONS is None:
        _CARD_BAPTIZE_ACTIONS = {}
        rows = _read_clientdb_table("baptizeAction.txt")
        if rows:
            hdr = rows[0]; ci = {name: i for i, name in enumerate(hdr)}
            for row in rows[1:]:
                try:
                    mode = int(row[ci["actionType"]])
                    item_id, amount = (int(v) for v in row[ci["originalCost"]].split(":", 1))
                    _CARD_BAPTIZE_ACTIONS[mode] = (item_id, amount)
                except (IndexError, KeyError, TypeError, ValueError):
                    continue
    if _CARD_BAPTIZE_LIMITS is None:
        _CARD_BAPTIZE_LIMITS = {}
        rows = _read_clientdb_table("baptizeLimit.txt")
        if rows:
            hdr = rows[0]; ci = {name: i for i, name in enumerate(hdr)}
            for row in rows[1:]:
                try:
                    key = (int(row[ci["star"]]), int(row[ci["awakeLevel"]]))
                    _CARD_BAPTIZE_LIMITS[key] = {
                        "attack": int(row[ci["attack"]]), "defense": int(row[ci["defense"]]),
                        "hp": int(row[ci["hp"]]), "ability": int(row[ci["ability"]]),
                    }
                except (IndexError, KeyError, TypeError, ValueError):
                    continue
        log.info("loaded %d baptize action costs and %d star/awakening caps",
                 len(_CARD_BAPTIZE_ACTIONS), len(_CARD_BAPTIZE_LIMITS))
    return _CARD_BAPTIZE_ACTIONS, _CARD_BAPTIZE_LIMITS


def _card_refine_state(uin, uid):
    return store.get_card_refine(uin, uid)


def _apply_card_refine_bonus(stats, uin, uid):
    """Apply committed wash stats to combat values and expose their power/speed breakdown."""
    state = _card_refine_state(uin, uid)
    for _attr_type, key in _REFINE_ATTRIBUTES:
        stats[key] = int(stats.get(key, 0)) + int(state[key]) // 100
    stats["refine_power"] = (int(state["attack"]) // 100 // 2
                             + int(state["defense"]) // 100
                             + int(state["hp"]) // 100 // 6
                             + int(state["ability"]) // 100)
    stats["refine_speed"] = int(state["speed"])
    return stats


def _refine_attribute_dtos(attributes):
    body = b""
    for attr_type, key in _REFINE_ATTRIBUTES:
        dto = pb_varint_field(1, attr_type) + pb_varint_field(2, max(0, int(attributes.get(key, 0))))
        body += pb_bytes(2, dto)  # repeated attribute field on refine-info/refine responses
    return body


def _refine_operation_dto(result, attributes, speed):
    body = pb_varint_field(1, result)
    for attr_type, key in _REFINE_ATTRIBUTES:
        dto = pb_varint_field(1, attr_type) + pb_varint_field(2, max(0, int(attributes[key])))
        body += pb_bytes(2, dto)
    return body + pb_varint_field(3, max(0, int(speed)))


def _refine_power(attributes):
    return (int(attributes["attack"]) // 100 // 2
            + int(attributes["defense"]) // 100
            + int(attributes["hp"]) // 100 // 6
            + int(attributes["ability"]) // 100)


def _refine_caps_for_card(card):
    load_battle_cards()
    info = _BATTLE_CARDS.get(int(card[1]), {})
    _actions, limits = load_card_baptize_templates()
    return limits.get((int(info.get("star", 1)), int(info.get("awakeLevel", 0))))


def _roll_refine(attributes, speed, caps, mode):
    """Private-server roll: signed normal/advanced gains, guaranteed nonnegative lucky gains."""
    candidate = dict(attributes)
    if mode == 1:
        max_fraction, negative_chance = 0.035, 0.48
    elif mode == 2:
        max_fraction, negative_chance = 0.06, 0.42
    else:
        max_fraction, negative_chance = 0.05, 0.0
    for _attr_type, key in _REFINE_ATTRIBUTES:
        cap = max(0, int(caps[key]))
        current = max(0, int(attributes[key]))
        if current >= cap:
            candidate[key] = cap
            continue
        span = max(1, int(cap * max_fraction))
        if mode == 3:
            delta = random.randint(1, span)
        else:
            delta = random.randint(1, span)
            if random.random() < negative_chance:
                delta = -delta
        candidate[key] = min(cap, max(0, current + delta))
    candidate_speed = max(0, int(speed)) + random.randint(1, 5)
    if mode == 3:
        # The lucky option is explicitly described by the client as never reducing attributes.
        for _attr_type, key in _REFINE_ATTRIBUTES:
            candidate[key] = max(int(attributes[key]), candidate[key])
    return candidate, candidate_speed


def _refine_condition_met(old, new, condition):
    if not condition:
        return False
    for attr in condition:
        if attr == 0:
            if _refine_power(new) <= _refine_power(old):
                return False
        else:
            key = next((name for number, name in _REFINE_ATTRIBUTES if number == int(attr)), None)
            if key is None or int(new[key]) <= int(old[key]):
                return False
    return True


def deployed_stat_bonus(player):
    """The combined all-deployed-plant stat bonus from the Lab + World Tree + VIP (priv 25-28) + equipped
    Nutrition reagents, added to EVERY plant on the field (formation/battle). {atk,def_,hp,ability}. This is
    what turns Lab/Tree/VIP/Nutrition investment into real fighting power, so a developed/VIP account
    out-powers content a fresh one can't."""
    lab = lab_stat_bonus(player)
    tree = wt_stat_bonus(player)
    vip = vip_stat_bonus(player)
    nut = nutrition_stat_bonus(player)
    return {"atk": lab["atk"] + tree.get("atk", 0) + vip["atk"] + nut["atk"],
            "def_": lab["def_"] + tree.get("def_", 0) + vip["def_"] + nut["def_"],
            "hp": lab["hp"] + tree.get("hp", 0) + vip["hp"] + nut["hp"],
            "ability": lab["ability"] + vip["ability"] + nut["ability"]}


def effective_card_stats(player, card_id, level, bonus=None, uid=None):
    """A DEPLOYED plant's battle stats: its card-level stats plus the Lab + World Tree deployed bonus.
    Pass a precomputed `bonus` (deployed_stat_bonus) when stat-ing a whole team so it's only summed once."""
    st = dict(card_stats_at_level(card_id, level))
    b = bonus if bonus is not None else deployed_stat_bonus(player)
    st["atk"] = st.get("atk", 0) + b["atk"]
    st["def_"] = st.get("def_", 0) + b["def_"]
    st["hp"] = max(1, st.get("hp", 0) + b["hp"])
    st["ability"] = st.get("ability", 0) + b.get("ability", 0)
    # Card-local progression must follow the selected UID, not another duplicate plant.
    cards = store.get_cards(player["uin"])
    owned_uid = uid if uid is not None else next(
        (_uid for _uid, cid, _card_level, _exp in cards if cid == card_id), None)
    forge_level = 0
    if owned_uid is not None:
        puzzle_bonus = card_puzzle_finish_bonus(
            store.get_card_fill_quality(player["uin"], owned_uid))
        for field in ("atk", "def_", "hp", "ability"):
            st[field] += puzzle_bonus[field]
        forge_level = store.get_card_forge_level(player["uin"], owned_uid)
    if forge_level:
        for row in load_card_forge().get(card_id, []):
            if row["level"] <= forge_level:
                for field in ("atk", "def_", "hp", "ability"):
                    st[field] += row[field]
    if owned_uid is not None:
        _apply_card_fruit_bonus(st, player["uin"], owned_uid, card_id)
        _apply_card_gene_bonus(st, player["uin"], owned_uid, card_id, level)
        _apply_card_refine_bonus(st, player["uin"], owned_uid)
    return st


# --- card XP / leveling curve (cardLevel.txt) -------------------------------------
# totalExp[L] = cumulative XP to REACH level L; needLevel[L] = the ACCOUNT (role) level required to
# reach card level L (so a low-level account can't max a card). Stats grow per card level (above).
_CARD_LEVEL_CURVE = None       # sorted list of (level, totalExp, needLevel)


def load_card_level_curve():
    global _CARD_LEVEL_CURVE
    if _CARD_LEVEL_CURVE is None:
        _CARD_LEVEL_CURVE = []
        rows = _read_clientdb_table("cardLevel.txt")
        if rows:
            hdr = rows[0]; ci = {c: i for i, c in enumerate(hdr)}
            for r in rows[1:]:
                def col(k):
                    i = ci.get(k)
                    return r[i] if i is not None and i < len(r) else "0"
                try:
                    _CARD_LEVEL_CURVE.append((int(col("level")), int(col("totalExp")), int(col("needLevel"))))
                except ValueError:
                    continue
            _CARD_LEVEL_CURVE.sort()
        log.info("loaded card level curve (%d levels)", len(_CARD_LEVEL_CURVE))
    return _CARD_LEVEL_CURVE


def card_level_from_exp(total_exp, card_id, account_level):
    """The card level reached with `total_exp` cumulative XP, capped by the card's maxLv AND the
    account-level gate (cardLevel.needLevel). Returns (level, total_exp_kept). We never level past the
    gate, and we clamp stored exp to the cap's totalExp so the bar doesn't overflow a capped card."""
    load_card_level_curve()
    load_battle_cards()
    max_lv = _BATTLE_CARDS.get(card_id, {}).get("maxLv", 1)
    level, cap_total = 1, 0
    for lv, tot, need in _CARD_LEVEL_CURVE:
        if lv > max_lv or need > account_level:
            break
        cap_total = tot
        if total_exp >= tot:
            level = lv
        else:
            break
    return level, min(total_exp, cap_total)


def card_exp_within_level(total_exp, level):
    """XP earned INSIDE the current level (total_exp - the level's cumulative totalExp) — the bar fill."""
    load_card_level_curve()
    base = next((tot for lv, tot, _need in _CARD_LEVEL_CURVE if lv == level), 0)
    return max(0, total_exp - base)


# Exp items that add plant XP when fed to a card (小经验豆/经验豆/诱人经验豆, id 2002/2003/2004, ...).
# Parsed from ItemInfo.txt desc "增加植物<N>点经验" so ANY exp bean is covered automatically.
_CARD_EXP_ITEMS = None


def card_exp_items():
    """{itemId: expValue} for every 'adds N plant EXP' bean in ItemInfo.txt."""
    global _CARD_EXP_ITEMS
    if _CARD_EXP_ITEMS is None:
        _CARD_EXP_ITEMS = {}
        rows = _read_clientdb_table("ItemInfo.txt")
        if rows:
            hdr = rows[0]; ci = {c: i for i, c in enumerate(hdr)}
            for r in rows[1:]:
                def col(k):
                    i = ci.get(k)
                    return r[i] if i is not None and i < len(r) else ""
                m = re.search(r"增加植物(\d+)点经验", col("desc"))
                if m:
                    try:
                        _CARD_EXP_ITEMS[int(col("id"))] = int(m.group(1))
                    except ValueError:
                        pass
        log.info("loaded %d card-exp items %s", len(_CARD_EXP_ITEMS), _CARD_EXP_ITEMS)
    return _CARD_EXP_ITEMS


def add_card_exp(player, uid, card_id, gain):
    """Add `gain` plant XP to a card (by uid), recompute its level (capped by maxLv + the account level),
    and persist. Returns (old_level, new_level, new_total_exp, within_level_exp). No-op if gain<=0."""
    uin = player["uin"]
    card = next((c for c in store.get_cards(uin) if c[0] == uid), None)
    if not card or gain <= 0:
        return None
    _uid, cid, old_level, cur_exp = card
    account_level = int(player.get("level", 1))
    new_level, new_total = card_level_from_exp(cur_exp + gain, cid, account_level)
    store.set_card_level(uin, uid, new_level, new_total)
    return old_level, new_level, new_total, card_exp_within_level(new_total, new_level)


def build_card_sync_sc(uin, uid, card_id, action_from):
    """Cmd_Card_SyncFullInfo_SC{changeCardList(1)=[Dto_CardFullInfo], actionFrom(4)} for ONE changed
    card at its current stored level/exp — the client updates the card + plays the level-up feedback."""
    card = next((c for c in store.get_cards(uin) if c[0] == uid), None)
    if not card:
        return None
    _uid, cid, level, total_exp = card
    st = card_stats_at_level(cid, level)
    forge_level = store.get_card_forge_level(uin, uid)
    for row in load_card_forge().get(cid, []):
        if row["level"] <= forge_level:
            for field in ("atk", "def_", "hp", "ability"):
                st[field] += row[field]
    fill_stage = store.get_card_fill_quality(uin, uid)
    fill_quality, fill_evolve = _card_fill_display(fill_stage)
    puzzle_bonus = card_puzzle_finish_bonus(fill_stage)
    for field in ("atk", "def_", "hp", "ability"):
        st[field] += puzzle_bonus[field]
    _apply_card_fruit_bonus(st, uin, uid, cid)
    _apply_card_gene_bonus(st, uin, uid, cid, level)
    _apply_card_equipment_bonus(st, uin, uid)
    _apply_card_refine_bonus(st, uin, uid)
    info = build_card_full_info(
        uid, cid, level, st, card_exp_within_level(total_exp, level),
        forge_level, fill_quality, fill_evolve)
    body = pb_tag(1, 2) + uvarint(len(info)) + info + pb_varint_field(4, action_from)  # changeCardList, actionFrom
    return ("PVZ.Cmd.Cmd_Card_SyncFullInfo_SC", body)


def td_plant_to_card(plant_id):
    """(cardId, stats) for a TD plantId's base battle card, or (None, None) if unmapped."""
    load_battle_cards()
    cid = _TD_TO_CARD.get(int(plant_id))
    return (cid, _BATTLE_CARDS[cid]) if cid else (None, None)


_VALID_TD_PLANTS = None


def valid_td_plants():
    """The set of plantIds that are actually TOWER-DEFENSE plants (clientDB tdPlantInfo.txt) — i.e. can
    be planted on the TD lawn. Adventure/card-only plants are NOT in here. Used to keep the TD roster
    (player['plants']) clean: TD plants may be recruited as adventure cards, but drawing/recruiting an
    adventure card must NOT add a plant to TD (and a non-TD plant in unlockPlantList crashes the TD
    choose-card screen — TDBasicChooseCard.InitializeComponent #1009s with no valid plant template)."""
    global _VALID_TD_PLANTS
    if _VALID_TD_PLANTS is None:
        _VALID_TD_PLANTS = set()
        rows = _read_clientdb_table("tdPlantInfo.txt")
        if rows:
            hdr = rows[0]; idc = hdr.index("id") if "id" in hdr else 0
            for r in rows[1:]:
                if idc < len(r) and r[idc].isdigit():
                    _VALID_TD_PLANTS.add(int(r[idc]))
        log.info("loaded %d valid TD plants", len(_VALID_TD_PLANTS))
    return _VALID_TD_PLANTS


def rebuild_td_roster(player):
    """Rebuild the TD plant roster from what the player LEGITIMATELY earned in tower defense: the starter
    plants plus each cleared TD level's bonusPlant. Everything else is dropped — a drawn/recruited CARD is
    adventure-only and must NOT become a TD plant (that's how adventure plants leaked into the TD chooser).
    Persists the change (removes leaked, restores any missing earned plant); the drawn CARDS stay in the
    collection (cards table) for adventure. Returns the removed plant ids. Idempotent."""
    uin = player["uin"]
    legit = set(store.STARTER_PLANTS)
    for stg, lvl, sub in store.get_all_passed_levels(uin):
        bp = level_reward(stg, lvl, sub).get("bonusPlant") or 0
        if bp:
            legit.add(bp)
    # VIP3's exclusive plant (Winter Melon, priv 41) is a legitimate TD plant — grant + keep it (so it's
    # owned for getUnlockPlant + usable in TD). It's dropped again automatically if VIP is turned off.
    if _VIP_PLANT_PRIV in vip_privileges(player):
        legit.add(_VIP_PLANT)
    current = set(player.get("plants", []))
    removed = sorted(current - legit)
    for p in removed:
        store.remove_plant(uin, p)
    for p in sorted(legit - current):        # restore any earned plant that's missing (e.g. a starter)
        store.unlock_plant(uin, p)
    player["plants"] = sorted(legit)
    return removed


def card_power(stats):
    """A card's 战力 (battle power) — a single number summarising its stats for HUD/formation
    totals. Simple heuristic (nonzero, scales with the card): atk + def + hp/10."""
    return int(stats.get("atk", 0) + stats.get("def_", 0) + stats.get("hp", 0) // 10)


# A real owned card needs uid > 10000 — the client's checkIsRealCard() is `uid.toNumber() > 10000`;
# a smaller uid is treated as a not-owned "template" card, so getBattleCardFullInfo() returns null and
# the lineup crashes. We derive a stable, unique uid from the cardId with this offset.
_CARD_UID_BASE = 10_000_000


def ensure_player_cards(player):
    """Give the player a battle card for every TD plant they own (one per plant type, level 1). This is
    the card COLLECTION the player's house shows and that formations reference by uid. uid = base+cardId
    (>10000 so the client counts it as a REAL owned card). Idempotent by card_id; auto-migrates old rows
    that used uid==cardId (<=10000)."""
    uin = player["uin"]
    load_battle_cards()
    existing = store.get_cards(uin)
    # migrate: any card on the old scheme (uid <= 10000) -> wipe collection + formation and regenerate.
    if any(uid <= 10000 for uid, _cid, _lvl, _exp in existing):
        store.clear_cards_and_formation(uin)
        existing = []
        log.info("    migrated uin=%d card uids to real (>10000) scheme (wiped + regen)", uin)
    have = {cid for _uid, cid, _lvl, _exp in existing}
    # Repair historical star-up duplicates: one TD plant must have one owned
    # battle card.  Keep the highest-star card, then highest level/UID, and
    # move any formation slots before deleting the stale lower-star record.
    by_td = {}
    for row in existing:
        uid, cid, level, exp = row
        td = (_BATTLE_CARDS.get(cid) or {}).get("tdId", 0)
        if not td:
            continue
        by_td.setdefault(td, []).append(row)
    for td, rows in by_td.items():
        if len(rows) < 2:
            continue
        keep = max(rows, key=lambda row: (
            int((_BATTLE_CARDS.get(row[1]) or {}).get("star", 1)),
            int(row[2]), int(row[0])))
        for row in rows:
            if row[0] != keep[0]:
                store.remove_card(uin, row[0], keep[0])
                log.info("    removed duplicate card uid=%d for tdId=%d; kept uid=%d",
                         row[0], td, keep[0])
        existing = [row for row in existing if row[0] == keep[0] or
                    ((_BATTLE_CARDS.get(row[1]) or {}).get("tdId", 0) != td)]
        have = {cid for _uid, cid, _lvl, _exp in existing}
    # tdIds already covered by an owned card (e.g. a RECRUITED star-up card, cardId != the star-1 base):
    # don't also auto-grant the base card for that plant, or the plant would appear twice.
    have_td = {_BATTLE_CARDS[cid]["tdId"] for _uid, cid, _lvl, _exp in existing
               if _BATTLE_CARDS.get(cid) and _BATTLE_CARDS[cid].get("tdId")}
    granted = 0
    for pid in player.get("plants", []):
        if int(pid) in have_td:
            continue
        cid, _st = td_plant_to_card(pid)
        if cid and cid not in have and store.add_card(uin, _CARD_UID_BASE + cid, cid, 1):
            have.add(cid)
            have_td.add(int(pid))
            granted += 1
    if granted:
        log.info("    granted %d new battle card(s) from owned plants (uin=%d)", granted, uin)
    return granted


def build_card_full_info(uid, card_id, level, stats, exp=0, forge_level=0,
                         card_quality=None, evolve_level=0):
    """Dto_CardFullInfo{base(1)=Dto_CardBaseInfo, power(2), attack(3), defense(4), hp(5,U64),
    shield(6,U64), ability(7)}. Dto_CardBaseInfo{uid(1,I64), cardId(2), exp(3), level(4),
    forgeLevel(5), currentHp(6,U64), quality(10)}. exp = the card's XP WITHIN its current level (bar fill).
    This is one entry of Cmd_Card_GetPackage_SC.all (the collection)."""
    quality = int(card_quality if card_quality is not None else stats.get("quality", 1))
    stage = card_puzzle_stage_for_display(quality, evolve_level)
    base = (pb_int64_field(1, uid) + pb_varint_field(2, card_id) + pb_varint_field(3, exp)
            + pb_varint_field(4, level) + pb_varint_field(5, int(forge_level))
            + pb_varint_field(6, stats.get("hp", 0))   # currentHp (full)
            + pb_varint_field(10, quality)
            + pb_varint_field(11, int(evolve_level))
            + pb_varint_field(17, int(evolve_level)))
    fill_power = (pb_varint_field(1, 17) + pb_int64_field(2, _card_fill_power(stage))
                  + pb_int64_field(3, 0))
    fill_power_field = pb_tag(13, 2) + uvarint(len(fill_power)) + fill_power
    refine_power = int(stats.get("refine_power", 0) or 0)
    refine_speed = int(stats.get("refine_speed", 0) or 0)
    refine_power_field = b""
    if refine_power or refine_speed:
        refine = (pb_varint_field(1, 14) + pb_int64_field(2, refine_power)
                  + pb_int64_field(3, refine_speed))
        refine_power_field = pb_tag(13, 2) + uvarint(len(refine)) + refine
    return (pb_tag(1, 2) + uvarint(len(base)) + base
            + pb_varint_field(2, card_power(stats))         # power
            + pb_varint_field(3, stats.get("atk", 0))       # attack
            + pb_varint_field(4, stats.get("def_", 0))      # defense
            + pb_varint_field(5, stats.get("hp", 0))        # hp (U64)
            + pb_varint_field(6, 0)                         # shield (U64)
            + fill_power_field
            + refine_power_field
            + pb_varint_field(7, stats.get("ability", 0))   # ability
            + pb_float_field(8, stats.get("hit", 0))
            + pb_float_field(9, stats.get("dodge", 0))
            + pb_float_field(10, stats.get("critical", 0))
            + pb_float_field(11, stats.get("tough", 0)))


def handle_card_getpackage(cmd_data, player):
    """Cmd_Card_GetPackage_CS -> Cmd_Card_GetPackage_SC{all(1)=[Dto_CardFullInfo], leaderAddParam(2)}.
    The player's whole battle-card COLLECTION — loaded into battleCardModel at login
    (setBattleCardList). Without it the player owns no cards, so the house/lineup/formation are empty
    and anything that renders the team null-derefs. We build one card per owned plant (ensure_player_cards)."""
    ensure_player_cards(player)
    load_battle_cards()
    cards = store.get_cards(player["uin"])
    d = b""
    for uid, card_id, level, _exp in cards:
        if card_id not in _BATTLE_CARDS:
            continue
        st = card_stats_at_level(card_id, level)         # stats at the card's stored LEVEL
        forge_level = store.get_card_forge_level(player["uin"], uid)
        for row in load_card_forge().get(card_id, []):
            if row["level"] <= forge_level:
                for field in ("atk", "def_", "hp", "ability"):
                    st[field] += row[field]
        fill_stage = store.get_card_fill_quality(player["uin"], uid)
        fill_quality, fill_evolve = _card_fill_display(fill_stage)
        puzzle_bonus = card_puzzle_finish_bonus(fill_stage)
        for field in ("atk", "def_", "hp", "ability"):
            st[field] += puzzle_bonus[field]
        _apply_card_fruit_bonus(st, player["uin"], uid, card_id)
        _apply_card_gene_bonus(st, player["uin"], uid, card_id, level)
        _apply_card_equipment_bonus(st, player["uin"], uid)
        _apply_card_refine_bonus(st, player["uin"], uid)
        info = build_card_full_info(
            uid, card_id, level, st,
            forge_level=forge_level,
            card_quality=fill_quality, evolve_level=fill_evolve)
        d += pb_tag(1, 2) + uvarint(len(info)) + info        # all (field 1, repeated Dto_CardFullInfo)
    d += pb_varint_field(2, 0)                               # leaderAddParam
    log.info("    card package: %d card(s) in collection %s", len(cards),
             [(c[1], _BATTLE_CARDS.get(c[1], {}).get("name", "?")) for c in cards])
    return d


# --- card baptize/refine (洗炼) -----------------------------------------------
# The client keeps a pending result locally.  Normal and advanced washes therefore
# update only pending_* until ConfirmRefine(abandon=false); batch washes commit each
# accepted operation immediately.  Values in the protocol are hundredths, while
# the card's combat stats use whole displayed points.
def _sync_lucky_message(player):
    return ("PVZ.Cmd.Cmd_SyncLucky_SC",
            pb_varint_field(1, max(0, int(player.get("lucky") or 0))))


def _refine_info_body(uid, attributes, speed, total=0, left=9999):
    return (pb_int64_field(1, uid) + _refine_attribute_dtos(attributes)
            + pb_varint_field(3, max(0, int(speed)))
            + pb_varint_field(4, max(0, int(total)))
            + pb_varint_field(5, max(0, int(left))))


def _refine_response_body(uid, mode, attributes, speed):
    return (pb_int64_field(1, uid) + pb_varint_field(2, mode)
            + _refine_attribute_dtos(attributes)
            + pb_varint_field(4, max(0, int(speed))))


def _refine_attrs_from_state(state, pending=False):
    prefix = "pending_" if pending else ""
    return {key: int(state.get(prefix + key, 0) or 0)
            for _attr_type, key in _REFINE_ATTRIBUTES}


def _refine_cost(mode, count=1):
    actions, _limits = load_card_baptize_templates()
    cost = actions.get(int(mode))
    if not cost:
        return None
    return cost[0], cost[1] * max(1, int(count))


def _refine_can_pay(player, mode, count=1):
    cost = _refine_cost(mode, count)
    if not cost:
        return False
    item_id, amount = cost
    if int(mode) == 3:
        return int(player.get("lucky") or 0) >= amount
    return store.get_item_count(player["uin"], item_id) >= amount


def _refine_pay(player, mode, count=1):
    item_id, amount = _refine_cost(mode, count)
    if int(mode) == 3:
        player["lucky"] = max(0, int(player.get("lucky") or 0) - amount)
        store.save_player(player["uin"], lucky=player["lucky"])
        return [_sync_lucky_message(player)]
    item_update = grant_items(player, [(item_id, -amount)])
    return [item_update] if item_update else []


def handle_card_getrefineinfo(cmd_data, player):
    uid = int(parse_varint_fields(cmd_data).get(1, 0))
    card = _owned_card(player, uid)
    if not card:
        return []
    state = _card_refine_state(player["uin"], uid)
    attrs = _refine_attrs_from_state(state)
    return [("PVZ.Cmd.Cmd_Card_GetRefineInfo_SC",
             _refine_info_body(uid, attrs, state.get("speed", 0),
                               total=0, left=9999))]


def handle_card_refine(cmd_data, player):
    fields = parse_varint_fields(cmd_data)
    uid, mode = int(fields.get(1, 0)), int(fields.get(2, 0))
    card = _owned_card(player, uid)
    actions, _limits = load_card_baptize_templates()
    if not card or mode not in actions or not _refine_can_pay(player, mode):
        log.info("    card refine REJECTED: uid=%d mode=%d owned=%s", uid, mode, bool(card))
        return []
    caps = _refine_caps_for_card(card)
    if not caps:
        log.warning("    card refine has no cap template: uid=%d card=%d", uid, card[1])
        return []
    state = _card_refine_state(player["uin"], uid)
    old = _refine_attrs_from_state(state)
    new, speed = _roll_refine(old, state.get("speed", 0), caps, mode)
    pay_messages = _refine_pay(player, mode)
    store.save_card_refine(player["uin"], uid,
                           pending_attack=new["attack"], pending_defense=new["defense"],
                           pending_hp=new["hp"], pending_ability=new["ability"],
                           pending_speed=speed, pending_mode=mode)
    body = _refine_response_body(uid, mode, new, speed)
    log.info("    card refine: uid=%d mode=%d power %d->%d", uid, mode,
             _refine_power(old), _refine_power(new))
    return [("PVZ.Cmd.Cmd_Card_Refine_SC", body)] + pay_messages


def handle_card_confirmrefine(cmd_data, player):
    fields = parse_varint_fields(cmd_data)
    uid, abandon = int(fields.get(1, 0)), bool(fields.get(2, 0))
    card = _owned_card(player, uid)
    if not card:
        return []
    state = _card_refine_state(player["uin"], uid)
    mode = int(state.get("pending_mode", 0) or 0)
    messages = []
    if mode and not abandon:
        pending = _refine_attrs_from_state(state, pending=True)
        store.save_card_refine(
            player["uin"], uid,
            attack=pending["attack"], defense=pending["defense"], hp=pending["hp"],
            ability=pending["ability"], speed=state.get("pending_speed", 0),
            pending_attack=0, pending_defense=0, pending_hp=0, pending_ability=0,
            pending_speed=0, pending_mode=0)
        sync = build_card_sync_sc(player["uin"], uid, card[1],
                                  {1: 250, 2: 251, 3: 252}.get(mode, 250))
        if sync:
            messages.append(sync)
    elif mode and abandon:
        refund = 10 if mode == 2 else (1 if mode == 1 else 0)
        if refund:
            player["lucky"] = int(player.get("lucky") or 0) + refund
            store.save_player(player["uin"], lucky=player["lucky"])
            messages.append(_sync_lucky_message(player))
        store.save_card_refine(player["uin"], uid,
                               pending_attack=0, pending_defense=0, pending_hp=0,
                               pending_ability=0, pending_speed=0, pending_mode=0)
    messages.insert(0, ("PVZ.Cmd.Cmd_Card_ConfirmRefine_SC",
                        pb_int64_field(1, uid) + pb_bool(2, abandon)))
    log.info("    card refine %s: uid=%d mode=%d", "ABANDON" if abandon else "SAVED", uid, mode)
    return messages


def handle_card_batchrefine(cmd_data, player):
    fields = parse_varint_fields(cmd_data)
    uid = int(fields.get(1, 0)); mode = int(fields.get(2, 0))
    count = min(100, max(0, int(fields.get(3, 0))))
    conditions = [int(v) for v in parse_repeated_varint(cmd_data, 4)]
    card = _owned_card(player, uid)
    actions, _limits = load_card_baptize_templates()
    if not card or not count or mode not in actions or not conditions:
        return []
    caps = _refine_caps_for_card(card)
    if not caps or not _refine_can_pay(player, mode, count):
        log.info("    card batch refine REJECTED: uid=%d mode=%d count=%d", uid, mode, count)
        return []
    state = _card_refine_state(player["uin"], uid)
    current = _refine_attrs_from_state(state)
    speed = int(state.get("speed", 0) or 0)
    messages = _refine_pay(player, mode, count)
    operations = []
    accepted = 0
    for _ in range(count):
        candidate, candidate_speed = _roll_refine(current, speed, caps, mode)
        ok = _refine_condition_met(current, candidate, conditions)
        operations.append(_refine_operation_dto(1 if ok else 2, candidate, candidate_speed))
        if ok:
            current, speed = candidate, candidate_speed
            accepted += 1
    store.save_card_refine(player["uin"], uid, attack=current["attack"], defense=current["defense"],
                           hp=current["hp"], ability=current["ability"], speed=speed,
                           pending_attack=0, pending_defense=0, pending_hp=0, pending_ability=0,
                           pending_speed=0, pending_mode=0)
    body = (pb_int64_field(1, uid) + pb_varint_field(2, mode)
            + _wrap_repeated(3, operations))
    if accepted:
        sync = build_card_sync_sc(player["uin"], uid, card[1],
                                  {1: 250, 2: 251, 3: 252}.get(mode, 250))
        if sync:
            messages.insert(0, sync)
    messages.insert(0, ("PVZ.Cmd.Cmd_Card_BatchRefine_SC", body))
    log.info("    card batch refine: uid=%d mode=%d attempts=%d accepted=%d", uid, mode, count, accepted)
    return messages


# --- card recruiting (spend plant fragments to unlock a plant — the 酒吧/Bar) -----------
# The plant-specific fragments (碎片-<plant>, item ids 51xxx) are spent at the Bar to "recruit"
# (招募) that plant's battle card. RecruitCardInfoTemplate maps recruitCardId -> costItemID + count.
# WARNING: the template's `consumeReputation` column is misnamed — it is really the piece COUNT
# (the recruit UI shows have/consumeReputation of costItemID and enables recruit when have>=it).
_RECRUIT_RECIPES = None


def load_recruit_recipes():
    """{recruitCardId: (costItemId, count)} for every recruit row that costs fragments."""
    global _RECRUIT_RECIPES
    if _RECRUIT_RECIPES is None:
        _RECRUIT_RECIPES = {}
        rows = _read_clientdb_table("RecruitCardInfoTemplate.txt")
        if rows:
            hdr = rows[0]; ci = {c: i for i, c in enumerate(hdr)}

            def col(c, k, d="0"):
                i = ci.get(k)
                return c[i] if i is not None and i < len(c) else d
            for c in rows[1:]:
                try:
                    cid = int(col(c, "id"))
                    item = int(col(c, "costItemID") or 0)
                    cnt = int(col(c, "consumeReputation") or 0)   # really the fragment count
                except ValueError:
                    continue
                if cid and item and cnt:
                    _RECRUIT_RECIPES[cid] = (item, cnt)
        log.info("loaded %d card recruit recipes", len(_RECRUIT_RECIPES))
    return _RECRUIT_RECIPES


def handle_card_recruit(cmd_data, player):
    """Cmd_Card_Recruit_CS{cardId} -> spend the plant's fragments to recruit that plant card into the
    collection (this is how you unlock/craft a new plant). Recipe: costItemID x count. On success we
    deduct the fragments, add the battle card (uid=base+cardId), unlock its TD plant, and push
    Cmd_Card_SyncFullInfo_SC{addCardList, actionFrom=CardRecruit(26)} (client shows the success popup +
    CARD_ADDED) plus item/plant syncs. Rejects (no-op) if the recipe/card is unknown, the card is
    already owned, or the player lacks enough fragments."""
    load_battle_cards()
    f = parse_varint_fields(cmd_data)
    card_id = f.get(1, 0)
    uin = player["uin"]
    recipe = load_recruit_recipes().get(card_id)
    stats = _BATTLE_CARDS.get(card_id)
    if not recipe or not stats:
        log.info("    recruit REJECTED: cardId=%d has no recipe/stats", card_id)
        return []
    item_id, need = recipe
    new_star = stats.get("star", 1)
    td = stats.get("tdId") or 0
    # Does the player already own a card for this PLANT (any star)? A plant's fragment recipe can be a
    # higher star than the star-1 base they start with (e.g. sunflower's recipe is the ★2 card), so
    # recruiting = "acquire OR star-up in place" — never a duplicate second card for the same plant.
    owned = None  # (uid, cardId, star, level)
    for uid_, cid_, lvl_, _exp in store.get_cards(uin):
        st_ = _BATTLE_CARDS.get(cid_)
        if st_ and st_.get("tdId") == td:
            owned = (uid_, cid_, st_.get("star", 1), lvl_)
            break
    if owned and owned[2] >= new_star:
        log.info("    recruit REJECTED: already own %s at star %d (>= recruit star %d)",
                 stats.get("name", "?"), owned[2], new_star)
        return []
    have = store.get_item_count(uin, item_id)
    if have < need:
        log.info("    recruit REJECTED: %s needs %dx item %d, have %d",
                 stats.get("name", "?"), need, item_id, have)
        return []
    # Success: spend the fragments, then either star-up the existing card in place or add a new one.
    messages = []
    item_upd = grant_items(player, [(item_id, -need)])
    if owned:
        uid, level = owned[0], owned[3]
        store.upgrade_card(uin, uid, card_id)             # keep uid (formation stays valid), bump star
        dto = build_card_full_info(uid, card_id, level, stats)
        sync = pb_tag(1, 2) + uvarint(len(dto)) + dto     # changeCardList (field 1) -> CARD_PROP_UPDATED
        action = "STAR-UP %s ->star %d" % (stats.get("name", "?"), new_star)
    else:
        uid = _CARD_UID_BASE + card_id
        store.add_card(uin, uid, card_id, 1)
        dto = build_card_full_info(uid, card_id, 1, stats)
        sync = pb_tag(2, 2) + uvarint(len(dto)) + dto     # addCardList (field 2) -> CARD_ADDED + popup
        action = "RECRUITED %s (star %d)" % (stats.get("name", "?"), new_star)
    sync += pb_varint_field(4, 26)                        # actionFrom = ActionFrom_CardRecruit
    messages.append(("PVZ.Cmd.Cmd_Card_SyncFullInfo_SC", sync))
    # NOTE: recruiting an adventure CARD does NOT unlock the TD plant. TD plants -> adventure cards
    # (ensure_player_cards) is one-way; cards must not leak back into the TD roster (player['plants']).
    if item_upd:
        messages.append(item_upd)
    log.info("    %s uin=%d: -%dx item %d (had %d), uid=%d (card-only, no TD unlock)",
             action, uin, need, item_id, have, uid)
    return messages


# --- card-pack gacha (the 酒吧 draw shop = ModuleBattleCardMarket, Building_Bar) ----------
# 3 packs (BattleCardMarketConst): 1=OnePacket (single), 2=TenPacket (x10), 3=FriendPoint. Costs from
# BattleCardMarketSetting.txt costStr "item:amt": g1 240 diamond / 1 draw-ticket(2025), g2 2160 / 10
# tickets, g3 500 friend points. Draws roll star-1 PLANT base cards (tdId>=1000, cardId=tdId+star):
# NEW plant -> added to the collection (+ TD unlock); DUPLICATE -> a little coin "debris". Group 1 is
# a free single draw in our sandbox; a one-time 10 draw-ticket stash lets you try the ten-draw too.
_CARD_MARKET_POOL = None
_CARD_MARKET_COST = None
_CARD_MARKET_COUNT = {1: 1, 2: 10, 3: 5}        # cards per draw (must match the reveal's card slots:
                                                # OnePacket 1, TenPacket 5x2 rounds, FriendPoint 5)
_DRAW_TICKET_ITEM = 2025
_FRIEND_POINT_ITEM = 6
_CARD_DUPE_COIN = 200                            # consolation coins per duplicate pull
_CARD_MARKET_STARTER_TICKETS = 10               # one ten-draw's worth, granted once


def card_market_pool():
    """The draw pool as [(bagItemId, cardId)]. The gacha reveal renders BAG ITEMS (CardItemFactory.
    updateCardItemByBagItemId), so we must draw a card BAG-ITEM id (ItemInfo type=4 TYPE_CARD, id 2xxxx,
    with cardItemId='<cardId>:count'), not a raw battle cardId. Each maps to a plant battle card that we
    then add to the collection. ~121 plant card items exist (various stars)."""
    global _CARD_MARKET_POOL
    if _CARD_MARKET_POOL is None:
        load_battle_cards()
        _CARD_MARKET_POOL = []
        rows = _read_clientdb_table("ItemInfo.txt")
        if rows:
            hdr = rows[0]; ci = {c: i for i, c in enumerate(hdr)}
            for c in rows[1:]:
                try:
                    bid, typ, cit = int(c[ci["id"]]), int(c[ci["type"]]), c[ci["cardItemId"]]
                except (ValueError, KeyError, IndexError):
                    continue
                if typ != 4 or not cit or ":" not in str(cit):     # 4 = ItemType.TYPE_CARD
                    continue
                try:
                    card_id = int(str(cit).split(":")[0])
                except ValueError:
                    continue
                if card_id in _BATTLE_CARDS and (_BATTLE_CARDS[card_id].get("tdId") or 0) >= 1000:
                    _CARD_MARKET_POOL.append((bid, card_id))
    return _CARD_MARKET_POOL


def load_card_market_cost():
    """{groupId: {'pay':(itemId,amt), 'ticket':(itemId,amt)|None}} from BattleCardMarketSetting.txt."""
    global _CARD_MARKET_COST
    if _CARD_MARKET_COST is None:
        _CARD_MARKET_COST = {}
        rows = _read_clientdb_table("BattleCardMarketSetting.txt")
        if rows:
            hdr = rows[0]; ci = {c: i for i, c in enumerate(hdr)}

            def pair(sv):
                try:
                    a, b = sv.split(":"); return (int(a), int(b))
                except (ValueError, AttributeError):
                    return None
            for c in rows[1:]:
                try:
                    gid = int(c[ci["id"]])
                except (ValueError, KeyError, IndexError):
                    continue
                nc = ci.get("needCardNum")
                _CARD_MARKET_COST[gid] = {"pay": pair(c[ci["costStr"]]),
                                          "ticket": pair(c[nc]) if nc is not None and nc < len(c) else None}
    return _CARD_MARKET_COST


def _wrap_repeated(field, dtos):
    """Concatenate a list of message bodies as a repeated length-delimited field."""
    return b"".join(pb_tag(field, 2) + uvarint(len(d)) + d for d in dtos)


# groupId -> (freeTimes, freeCD). isFree = freeTimes!=0 && freeCD==0. Group 1 = a free single draw.
_CARD_MARKET_FREE = {1: (1, 0), 2: (0, 0), 3: (0, 0)}


def _card_market_freeinfo_dto(gid):
    """One Dto_Card_MarketFreeInfo{groupId(1), freeTimes(2), freeCD(3)}."""
    ft, cd = _CARD_MARKET_FREE.get(gid, (0, 0))
    return pb_varint_field(1, gid) + pb_varint_field(2, ft) + pb_varint_field(3, cd)


def _card_market_freeinfo_dtos():
    """All 3 packs' free-info DTOs (Cmd_Card_GetMarketInfo_SC.freeInfos is REPEATED)."""
    return [_card_market_freeinfo_dto(gid) for gid in (1, 2, 3)]


def handle_card_getmarketinfo(cmd_data, player):
    """Cmd_Card_GetMarketInfo_CS -> Cmd_Card_GetMarketInfo_SC{freeInfos(1), luckyFlowerNum(2),
    group1ExtractNum(5)}. Renders the 3 packs (so clicking one has non-null data). Also hands out a
    one-time stash of draw tickets so the ten-draw is testable."""
    uin = player["uin"]
    extra = []
    if not int(player.get("card_market_granted") or 0):
        upd = grant_items(player, [(_DRAW_TICKET_ITEM, _CARD_MARKET_STARTER_TICKETS)])
        player["card_market_granted"] = 1
        store.save_player(uin, card_market_granted=1)
        if upd:
            extra.append(upd)
        log.info("    card market: granted %d starter draw tickets to uin=%d", _CARD_MARKET_STARTER_TICKETS, uin)
    body = (_wrap_repeated(1, _card_market_freeinfo_dtos())
            + pb_varint_field(2, 0)                          # luckyFlowerNum
            + pb_varint_field(5, 0))                         # group1ExtractNum
    return [("PVZ.Cmd.Cmd_Card_GetMarketInfo_SC", body)] + extra


def _card_market_pay(player, gid):
    """Deduct a pack's cost (ticket-first then diamonds for g1/g2; friend points for g3). Returns the
    HUD sync messages, or None if unaffordable. Group 1 is free (empty list)."""
    if gid == 1:
        return []                                            # free single draw
    cost = load_card_market_cost().get(gid, {})
    uin = player["uin"]
    if gid == 2:
        ticket, pay = cost.get("ticket"), cost.get("pay")
        if ticket and store.get_item_count(uin, ticket[0]) >= ticket[1]:
            upd = grant_items(player, [(ticket[0], -ticket[1])])
            return [upd] if upd else []
        if pay and pay[0] == 4:                              # 4 = diamond
            return _spend_diamonds(player, pay[1])
        return None
    if gid == 3:                                             # friend points
        pay = cost.get("pay")
        if pay and pay[0] == _FRIEND_POINT_ITEM and int(player.get("friend_point") or 0) >= pay[1]:
            player["friend_point"] = int(player.get("friend_point") or 0) - pay[1]
            store.save_player(uin, friend_point=player["friend_point"])
            return [("PVZ.Cmd.Cmd_SyncFriendPoint_SC", pb_varint_field(1, player["friend_point"]))]
        return None
    return None


def handle_card_extract(cmd_data, player):
    """Cmd_Card_Extract_CS{groupId} -> draw the pack. Charge the cost, roll card BAG-ITEMS (new plant
    -> add the mapped battle card + TD unlock; dupe -> coin debris), and reply Cmd_Card_Extract_SC
    {items(1)=[Dto_IdNum(bagItemId,1)], luckyFlowerNum(2), freeInfos(3)=SINGLE, group1ExtractNum(5),
    debris(6)} + Cmd_Card_SyncFullInfo_SC{addCardList, actionFrom=CardExtract(25)} + currency/plant syncs."""
    gid = parse_varint_fields(cmd_data).get(1, 0)
    if gid not in _CARD_MARKET_COUNT:
        return []
    uin = player["uin"]
    load_battle_cards()
    pay_msgs = _card_market_pay(player, gid)
    if pay_msgs is None:
        log.info("    card extract group %d REJECTED: can't afford", gid)
        return []                                            # client normally blocks this
    pool = card_market_pool()
    owned_tds = {(_BATTLE_CARDS.get(cid) or {}).get("tdId")
                 for _u, cid, _l, _e in store.get_cards(uin)}
    items, add_dtos, plant_msgs, dupe_coins = [], [], [], 0
    for _ in range(_CARD_MARKET_COUNT[gid]):
        bag_id, card_id = random.choice(pool)
        td = _BATTLE_CARDS[card_id].get("tdId")
        items.append(bag_id)                                 # the reveal renders this BAG-ITEM id
        if td in owned_tds:                                  # duplicate plant -> debris coins
            dupe_coins += _CARD_DUPE_COIN
        else:
            owned_tds.add(td)
            uid = _CARD_UID_BASE + card_id
            store.add_card(uin, uid, card_id, 1)
            add_dtos.append(build_card_full_info(uid, card_id, 1, card_stats_at_level(card_id, 1)))
            # A drawn card is adventure-only: it does NOT unlock the TD plant (no leak into player['plants']).
    coin_msgs = grant_fuben_reward(player, [(1, dupe_coins)]) if dupe_coins else []
    free = _card_market_freeinfo_dto(gid)                     # freeInfos(3) is a SINGLE msg here (not repeated)
    extract = (_wrap_repeated(1, [pb_varint_field(1, bid) + pb_varint_field(2, 1) for bid in items])
               + pb_varint_field(2, 0)                       # luckyFlowerNum
               + pb_tag(3, 2) + uvarint(len(free)) + free    # freeInfos (single)
               + pb_varint_field(5, 0))                      # group1ExtractNum
    if dupe_coins:
        debris = pb_varint_field(1, 1) + pb_varint_field(2, dupe_coins)   # Dto_IdNum{coin, num}
        extract += pb_tag(6, 2) + uvarint(len(debris)) + debris
    messages = []
    if add_dtos:                                             # Cmd_Card_SyncFullInfo_SC{addCardList(2), actionFrom(4)}
        sync = _wrap_repeated(2, add_dtos) + pb_varint_field(4, 25)
        messages.append(("PVZ.Cmd.Cmd_Card_SyncFullInfo_SC", sync))
    messages.append(("PVZ.Cmd.Cmd_Card_Extract_SC", extract))
    messages += plant_msgs + coin_msgs + pay_msgs
    log.info("    card extract group %d: %d drawn, %d new, %d dupe (+%d coin)",
             gid, len(items), len(add_dtos), len(items) - len(add_dtos), dupe_coins)
    return messages


# --- Mystery Card Pack (神秘卡包, the 卡吧/CardBar = ModuleCardBar, Building_CardBar) ---------
# A mystery-card board: a featured weekly card + 3 daily cards (all shown as BAG-ITEM icons) + a
# refresh cost + a luck/pity value. Buying spends a MysteriousTicket (item 1103) and reveals a random
# plant card (pity: at max luck the pull is a guaranteed >=3-star). Reuses the card-pack pool/adder.
_MYSTERY_TICKET_ITEM = 1103
_MYSTERY_STARTER_TICKETS = 10
_MYSTERY_REFRESH_COST = 5000                     # coins to reroll the daily board
_MYSTERY_LUCK_MAX = 100                          # matches iMysteryCardLuckValueMax override


def _draw_card_items(player, count, owned_tds, min_star=1):
    """Roll `count` card BAG-ITEMS from the pack pool (>= min_star). Adds NEW plants to the collection
    (+ TD unlock), counts duplicates as coin debris. Mutates owned_tds. Returns
    (bag_ids, add_dtos, plant_msgs, dupe_coins). Shared by the Brewery gacha style + Mystery pack."""
    pool = [(b, c) for b, c in card_market_pool() if _BATTLE_CARDS[c].get("star", 1) >= min_star]
    if not pool:
        pool = card_market_pool()
    uin = player["uin"]
    bag_ids, add_dtos, plant_msgs, dupe_coins = [], [], [], 0
    for _ in range(count):
        bag_id, card_id = random.choice(pool)
        td = _BATTLE_CARDS[card_id].get("tdId")
        bag_ids.append(bag_id)
        if td in owned_tds:
            dupe_coins += _CARD_DUPE_COIN
        else:
            owned_tds.add(td)
            uid = _CARD_UID_BASE + card_id
            store.add_card(uin, uid, card_id, 1)
            add_dtos.append(build_card_full_info(uid, card_id, 1, card_stats_at_level(card_id, 1)))
            # A drawn card is adventure-only: it does NOT unlock the TD plant (no leak into player['plants']).
    return bag_ids, add_dtos, plant_msgs, dupe_coins


def _mystery_gen_weekly():
    """A random featured weekly card bag-item (>=3 star if possible)."""
    pool = card_market_pool()
    hi = [b for b, c in pool if _BATTLE_CARDS[c].get("star", 1) >= 3] or [b for b, _ in pool]
    return random.choice(hi)


def _mystery_gen_dailies():
    """3 random daily card bag-items."""
    pool = card_market_pool()
    return [random.choice(pool)[0] for _ in range(3)]


def _mystery_save_board(player, parts):
    player["mystery_board"] = ",".join(str(x) for x in parts)
    store.save_player(player["uin"], mystery_board=player["mystery_board"])


def _mystery_get_board(player):
    """(weekly, [3 dailies]) — PERSISTED per player so the board is stable across visits; generated +
    saved on first open (only the refresh button rerolls it)."""
    raw = (player.get("mystery_board") or "").strip()
    parts = [int(x) for x in raw.split(",") if x.strip().isdigit()] if raw else []
    if len(parts) != 4:
        parts = [_mystery_gen_weekly()] + _mystery_gen_dailies()
        _mystery_save_board(player, parts)
    return parts[0], parts[1:]


def _mystery_board_dto(weekly, dailies):
    """Dto_MysteryCard{weeklyCard(1)=bagItemId, dailyCard(2, repeated)=[3 bagItemIds],
    refreshNeedItem(3)=Dto_IdNum(coin, cost)}."""
    d = pb_varint_field(1, weekly)
    for x in dailies:
        d += pb_varint_field(2, x)                               # dailyCard (repeated, unpacked)
    refresh = pb_varint_field(1, 1) + pb_varint_field(2, _MYSTERY_REFRESH_COST)   # Dto_IdNum{coin, cost}
    d += pb_tag(3, 2) + uvarint(len(refresh)) + refresh
    return d


def handle_card_getmysterycardinfo(cmd_data, player):
    """Cmd_Card_GetMysteryCardInfo_CS -> Cmd_Card_GetMysteryCardInfo_SC{card(1)=Dto_MysteryCard,
    luckValue(2)}. Renders the board (a null refreshNeedItem would #1009 the tooltip) and hands out a
    one-time MysteriousTicket stash so buying is testable."""
    uin = player["uin"]
    extra = []
    if not int(player.get("mystery_granted") or 0):
        upd = grant_items(player, [(_MYSTERY_TICKET_ITEM, _MYSTERY_STARTER_TICKETS)])
        player["mystery_granted"] = 1
        store.save_player(uin, mystery_granted=1)
        if upd:
            extra.append(upd)
        log.info("    mystery pack: granted %d MysteriousTickets to uin=%d", _MYSTERY_STARTER_TICKETS, uin)
    weekly, dailies = _mystery_get_board(player)                 # persisted -> stable across visits
    card = _mystery_board_dto(weekly, dailies)
    body = pb_tag(1, 2) + uvarint(len(card)) + card + pb_varint_field(2, int(player.get("mystery_luck") or 0))
    return [("PVZ.Cmd.Cmd_Card_GetMysteryCardInfo_SC", body)] + extra


def handle_card_buymysterycard(cmd_data, player):
    """Cmd_Card_BuyMysteryCard_CS -> spend one MysteriousTicket, reveal a random plant card (pity: at
    max luck the pull is a guaranteed >=3-star and luck resets). Reply Cmd_Card_BuyMysteryCard_SC
    {items(1)=[Dto_IdNum(bagItemId,1)], luckValue(2)} + SyncFullInfo (new cards) + item/coin syncs."""
    uin = player["uin"]
    load_battle_cards()
    if store.get_item_count(uin, _MYSTERY_TICKET_ITEM) < 1:
        log.info("    mystery buy REJECTED: no MysteriousTicket")
        return []                                                # client normally buys a ticket first
    ticket_upd = grant_items(player, [(_MYSTERY_TICKET_ITEM, -1)])
    luck = int(player.get("mystery_luck") or 0) + 1
    jackpot = luck >= _MYSTERY_LUCK_MAX
    owned_tds = {(_BATTLE_CARDS.get(cid) or {}).get("tdId")
                 for _u, cid, _l, _e in store.get_cards(uin)}
    bag_ids, add_dtos, plant_msgs, dupe_coins = _draw_card_items(
        player, 1, owned_tds, min_star=3 if jackpot else 1)
    player["mystery_luck"] = 0 if jackpot else luck
    store.save_player(uin, mystery_luck=player["mystery_luck"])
    coin_msgs = grant_fuben_reward(player, [(1, dupe_coins)]) if dupe_coins else []
    body = (_wrap_repeated(1, [pb_varint_field(1, b) + pb_varint_field(2, 1) for b in bag_ids])
            + pb_varint_field(2, player["mystery_luck"]))
    messages = []
    if add_dtos:
        messages.append(("PVZ.Cmd.Cmd_Card_SyncFullInfo_SC", _wrap_repeated(2, add_dtos) + pb_varint_field(4, 25)))
    messages.append(("PVZ.Cmd.Cmd_Card_BuyMysteryCard_SC", body))
    messages += plant_msgs + coin_msgs + ([ticket_upd] if ticket_upd else [])
    log.info("    mystery buy: %d new, %d dupe (+%d coin), luck=%d%s",
             len(add_dtos), len(bag_ids) - len(add_dtos), dupe_coins, player["mystery_luck"],
             " JACKPOT" if jackpot else "")
    return messages


def handle_card_refreshmysterycard(cmd_data, player):
    """Cmd_Card_RefreshMysteryCard_CS -> spend coins to reroll the daily board. Reply
    Cmd_Card_RefreshMysteryCard_SC{card(1)=Dto_MysteryCard} + a coin sync."""
    uin = player["uin"]
    if int(player.get("coin") or 0) < _MYSTERY_REFRESH_COST:
        log.info("    mystery refresh REJECTED: need %d coin", _MYSTERY_REFRESH_COST)
        return []                                                # client checks coins first
    coin_msgs = grant_fuben_reward(player, [(1, -_MYSTERY_REFRESH_COST)])
    weekly, _ = _mystery_get_board(player)                       # keep the weekly feature, reroll dailies
    dailies = _mystery_gen_dailies()
    _mystery_save_board(player, [weekly] + dailies)
    card = _mystery_board_dto(weekly, dailies)
    log.info("    mystery refresh: -%d coin, rerolled dailies", _MYSTERY_REFRESH_COST)
    return [("PVZ.Cmd.Cmd_Card_RefreshMysteryCard_SC", pb_tag(1, 2) + uvarint(len(card)) + card)] + coin_msgs


def handle_card_levelup(cmd_data, player):
    """Cmd_Card_LevelUp_CS{cardUId(1,I64), itemBaseId(2)} -> feed ONE exp bean to a card. Consume the
    item, add its plant XP, recompute the card's level (capped by maxLv + account level), and push
    Cmd_Card_SyncFullInfo_SC{changeCardList=[card], actionFrom=CardLevelUp(32)} + Cmd_Item_Update_SC.
    No-op if the card/item is unknown or the player owns none of the bean."""
    f = parse_varint_fields(cmd_data)
    uid = f.get(1, 0)
    item_id = f.get(2, 0)
    uin = player["uin"]
    gain = card_exp_items().get(item_id, 0)
    card = next((c for c in store.get_cards(uin) if c[0] == uid), None)
    if not card or gain <= 0 or store.get_item_count(uin, item_id) < 1:
        log.info("    card level-up REJECTED: uid=%d item=%d gain=%d owns=%s",
                 uid, item_id, gain, bool(card))
        return []
    card_id = card[1]
    item_upd = grant_items(player, [(item_id, -1)])       # consume 1 bean
    old_lv, new_lv, total, _within = add_card_exp(player, uid, card_id, gain)
    messages = []
    sync = build_card_sync_sc(uin, uid, card_id, 32)      # ActionFrom_CardLevelUp
    if sync:
        messages.append(sync)
    if item_upd:
        messages.append(item_upd)
    log.info("    CARD LEVEL-UP: uid=%d card=%d fed item %d (+%d exp) lvl %d->%d (totalExp=%d)",
             uid, card_id, item_id, gain, old_lv, new_lv, total)
    return messages


def handle_card_fasterlevelup(cmd_data, player):
    """Cmd_Card_FasterLevelUp_CS{cardUId(1,I64), costItemList(2,repeated Dto_ItemInfo{uid,id,num})}
    = 一键升级 (one-click): feed ALL the listed exp beans to a card at once. Consume them, add their
    combined XP, recompute the level, and reply Cmd_Card_FasterLevelUp_SC{cardUId} + a
    Cmd_Card_SyncFullInfo_SC (updated card) + Cmd_Item_Update_SC (beans consumed)."""
    uid = parse_varint_fields(cmd_data).get(1, 0)
    uin = player["uin"]
    card = next((c for c in store.get_cards(uin) if c[0] == uid), None)
    if not card:
        log.info("    card FAST level-up REJECTED: uid=%d not owned", uid)
        return []
    card_id = card[1]
    total_exp, consume = 0, []
    for sub in parse_repeated_submessages(cmd_data, 2):        # costItemList (repeated Dto_ItemInfo)
        it = parse_varint_fields(sub)
        item_id, num = it.get(2, 0), it.get(3, 0)
        per = card_exp_items().get(item_id, 0)
        have = store.get_item_count(uin, item_id)
        use = min(num, have) if (per and num) else 0
        if use > 0:
            total_exp += per * use
            consume.append((item_id, -use))
    if total_exp <= 0:
        log.info("    card FAST level-up REJECTED: uid=%d no usable beans (list=%s)", uid, consume)
        return []
    item_upd = grant_items(player, consume)
    old_lv, new_lv, tot, _within = add_card_exp(player, uid, card_id, total_exp)
    messages = [("PVZ.Cmd.Cmd_Card_FasterLevelUp_SC", pb_int64_field(1, uid))]   # SC echoes cardUId
    sync = build_card_sync_sc(uin, uid, card_id, 20)          # ActionFrom_AddExpLevelUp
    if sync:
        messages.append(sync)
    if item_upd:
        messages.append(item_upd)
    log.info("    CARD FAST LEVEL-UP: uid=%d card=%d +%d exp (%s) lvl %d->%d",
             uid, card_id, total_exp, consume, old_lv, new_lv)
    return messages


# --- card enhancement slots / puzzle exchange / star upgrade ----------------------
# Puzzle board dimensions and tier counts come from clientDB cardPuzzle.txt.
_CARD_PUZZLE = None


def load_card_puzzle():
    """Load puzzle completion attributes from the client's cardPuzzle table."""
    global _CARD_PUZZLE
    if _CARD_PUZZLE is None:
        _CARD_PUZZLE = {}
        rows = _read_clientdb_table("cardPuzzle.txt")
        if rows:
            header = {name: index for index, name in enumerate(rows[0])}
            for row in rows[1:]:
                try:
                    puzzle_id = int(row[header["id"]])
                    finish = {}
                    for field, stat in (("1", "atk"), ("2", "def_"),
                                        ("3", "hp"), ("5", "ability")):
                        value = row[header["originalFinishAttribute"]]
                        for item in value.split(";"):
                            kind, amount = item.split(":", 1)
                            if kind == field:
                                # ClientDB card attributes use centi-units.
                                finish[stat] = int(amount) // 100
                                break
                    _CARD_PUZZLE[puzzle_id] = {
                        "quality": int(row[header["quality"]]),
                        "rank": int(row[header["rank"]]),
                        "width": int(row[header["puzzleWidth"]]),
                        "height": int(row[header["puzzleHeight"]]),
                        "finish": finish,
                    }
                except (KeyError, IndexError, ValueError):
                    continue
        log.info("loaded %d card puzzle stages", len(_CARD_PUZZLE))
    return _CARD_PUZZLE


def card_puzzle_finish_bonus(stage):
    """Return cumulative attributes from puzzle boards completed before `stage`."""
    stage = max(1, int(stage))
    bonus = {"atk": 0, "def_": 0, "hp": 0, "ability": 0}
    for puzzle_id in range(1, stage):
        for field, amount in load_card_puzzle().get(puzzle_id, {}).get("finish", {}).items():
            bonus[field] += amount
    return bonus


def card_puzzle_stage_for_display(quality, rank):
    """Map a puzzle quality/rank pair back to its cardPuzzle row id."""
    for stage, puzzle in load_card_puzzle().items():
        if puzzle["quality"] == int(quality) and puzzle["rank"] == int(rank):
            return stage
    return 1


def _card_fill_display(stage):
    """Map internal board stage to (colour quality, +evolve level, material band)."""
    stage = max(1, int(stage))
    puzzle = load_card_puzzle().get(stage)
    if puzzle:
        return puzzle["quality"], puzzle["rank"]
    # Keep a safe fallback if a clientDB is incomplete.
    color = 1 if stage == 1 else 2 + (stage - 2) // 4
    evolve = 0 if color == 1 else (stage - 2) % 4
    return color, evolve


def _card_fill_cell_count(stage):
    """Number of puzzle cells for an internal board stage."""
    stage = max(1, int(stage))
    puzzle = load_card_puzzle().get(stage)
    if puzzle:
        return puzzle["width"] * puzzle["height"]
    color, _evolve = _card_fill_display(stage)
    side = color + 2
    return side * side


def _card_fill_max_index(uin, uid):
    return _card_fill_cell_count(store.get_card_fill_quality(uin, uid)) - 1


def _card_fill_power(stage):
    """Aggregate fill power exposed through Dto_CardPower.ele=fill."""
    stage = max(1, int(stage))
    return _card_fill_cell_count(stage) * (40 + stage * 10)


_CARD_FORGE = None
_CARD_FORGE_CHANCES = None


def load_card_forge_chances():
    """Load forge material success chances keyed by (card star, material item)."""
    global _CARD_FORGE_CHANCES
    if _CARD_FORGE_CHANCES is None:
        _CARD_FORGE_CHANCES = {}
        rows = _read_clientdb_table("CardForgeChance.txt")
        if rows:
            header = {name: index for index, name in enumerate(rows[0])}
            for row in rows[1:]:
                try:
                    key = (int(row[header["forgeCardStarLv"]]),
                           int(row[header["costItemID"]]))
                    _CARD_FORGE_CHANCES[key] = int(row[header["successChance"]])
                except (KeyError, IndexError, ValueError):
                    continue
        log.info("loaded %d card forge chance entries", len(_CARD_FORGE_CHANCES))
    return _CARD_FORGE_CHANCES


def load_card_forge():
    global _CARD_FORGE
    if _CARD_FORGE is None:
        _CARD_FORGE = {}
        for row in _read_clientdb_table("CardForgeTemplate.txt")[1:]:
            try:
                _CARD_FORGE.setdefault(int(row[1]), []).append({
                    "level": int(row[2]), "cost": int(row[3]),
                    "atk": int(row[4]) // 100, "def_": int(row[5]) // 100,
                    "hp": int(row[6]) // 100, "ability": int(row[8]) // 100})
            except (IndexError, TypeError, ValueError):
                continue
        for rows in _CARD_FORGE.values():
            rows.sort(key=lambda value: value["level"])
        log.info("loaded %d card forge templates", sum(map(len, _CARD_FORGE.values())))
    return _CARD_FORGE


def _owned_card(player, uid):
    return next((card for card in store.get_cards(player["uin"]) if card[0] == uid), None)


def _card_piece_item(card_id):
    """pieceDrop.txt uses 51xxx ids: 50000 + the card family's TD plant id."""
    load_battle_cards()
    td_id = (_BATTLE_CARDS.get(card_id) or {}).get("tdId", 0)
    return 50000 + int(td_id) if td_id else 0


def _ensure_card_fill_materials(player, uid, card):
    """Keep enough matching puzzle pieces available to finish the local puzzle board.

    The private-server starter data used to grant only five pieces. Once those were consumed,
    later slots looked permanently locked even though the card still had unfilled indexes.
    Top up only the missing amount, preserving already-filled indexes and any pieces the player
    already owns.
    """
    quality = store.get_card_fill_quality(player["uin"], uid)
    filled = store.get_card_filled_indices(player["uin"], uid)
    granted = []
    for index in range(_card_fill_cell_count(quality)):
        if index in filled:
            continue
        color, evolve = _card_fill_display(quality)
        item_id = 60000 + color * 1000 + evolve * 100 + index + 1
        if store.get_item_count(player["uin"], item_id) < 1:
            store.add_item(player["uin"], item_id, 1)
            granted.append(item_id)
    return granted


def handle_card_getfillinfo(cmd_data, player):
    uid = parse_varint_fields(cmd_data).get(1, 0)
    card = _owned_card(player, uid)
    if not card:
        return []
    granted = _ensure_card_fill_materials(player, uid, card)
    body = pb_int64_field(1, uid)
    for index in store.get_card_filled_indices(player["uin"], uid):
        body += pb_varint_field(2, index)
    if granted:
        updates = b""
        for item_id in granted:
            item = build_item_dto(item_id, store.get_item_count(player["uin"], item_id))
            updates += pb_tag(1, 2) + uvarint(len(item)) + item
        return [("PVZ.Cmd.Cmd_Card_GetFillInfo_SC", body),
                ("PVZ.Cmd.Cmd_Item_Update_SC", updates)]
    return body


def handle_card_getplantseedinfo(cmd_data, player):
    uid = parse_varint_fields(cmd_data).get(1, 0)
    card = _owned_card(player, uid)
    if not card:
        return []
    load_battle_cards()
    fruit_type = int((_BATTLE_CARDS.get(card[1]) or {}).get("fruitType", 0))
    if not fruit_type:
        return pb_int64_field(1, uid)
    templates = load_card_fruit_info()
    seeds = b""
    for slot, level in store.get_card_fruits(player["uin"], uid).items():
        if (fruit_type, int(slot), int(level)) not in templates:
            continue
        seed = pb_varint_field(1, int(slot)) + pb_varint_field(2, int(level))
        seeds += pb_tag(2, 2) + uvarint(len(seed)) + seed
    return pb_int64_field(1, uid) + seeds


def handle_card_upgradeplantseed(cmd_data, player):
    """Upgrade one fruit slot using the exact clientDB recipe and persist the new level."""
    fields = parse_varint_fields(cmd_data)
    uid, slot = fields.get(1, 0), fields.get(2, 0)
    card = _owned_card(player, uid)
    if not card:
        log.info("    fruit upgrade rejected: uin=%s unknown card uid=%d", player.get("uin"), uid)
        return []
    load_battle_cards()
    card_info = _BATTLE_CARDS.get(card[1]) or {}
    fruit_type = int(card_info.get("fruitType", 0))
    if not fruit_type or int(card_info.get("type", 0)) != 2:
        log.info("    fruit upgrade rejected: uid=%d is not a fruit-bearing plant", uid)
        return []

    templates = load_card_fruit_info()
    current_level = int(store.get_card_fruits(player["uin"], uid).get(slot, 0))
    next_info = templates.get((fruit_type, int(slot), current_level + 1))
    if not next_info:
        log.info("    fruit upgrade rejected: uid=%d slot=%d at max/invalid level %d",
                 uid, slot, current_level)
        return []
    if int(player.get("level", 1)) < next_info["openLevel"]:
        log.info("    fruit upgrade rejected: uid=%d slot=%d requires role level %d",
                 uid, slot, next_info["openLevel"])
        return []

    costs = parse_bonus_items(next_info["needItems"])
    if not costs or any(store.get_item_count(player["uin"], item_id) < amount
                        for item_id, amount in costs):
        log.info("    fruit upgrade rejected: uid=%d slot=%d insufficient materials %s",
                 uid, slot, costs)
        return []

    store.set_card_fruit_level(player["uin"], uid, slot, current_level + 1)
    seed = pb_varint_field(1, int(slot)) + pb_varint_field(2, current_level + 1)
    response = (pb_int64_field(1, uid) + pb_tag(2, 2) + uvarint(len(seed)) + seed)
    messages = [("PVZ.Cmd.Cmd_Card_UpgradePlantSeed_SC", response)]
    card_sync = build_card_sync_sc(player["uin"], uid, card[1], 266)  # CardUpgradePlantSeed
    if card_sync:
        messages.append(card_sync)
    item_update = grant_items(player, [(item_id, -amount) for item_id, amount in costs])
    if item_update:
        messages.append(item_update)
    log.info("    fruit upgraded: uid=%d card=%d type=%d slot=%d %d->%d cost=%s",
             uid, card[1], fruit_type, slot, current_level, current_level + 1, costs)
    return messages


def handle_card_fill(cmd_data, player):
    fields = parse_varint_fields(cmd_data)
    uid, index = fields.get(1, 0), fields.get(2, -1)
    card = _owned_card(player, uid)
    filled = store.get_card_filled_indices(player["uin"], uid) if card else []
    quality = store.get_card_fill_quality(player["uin"], uid) if card else 0
    fill_quality, fill_evolve = _card_fill_display(quality) if card else (0, 0)
    piece_item = (60000 + fill_quality * 1000 + fill_evolve * 100 + index + 1
                  if card and index >= 0 else 0)
    if (not card or index < 0 or index > _card_fill_max_index(player["uin"], uid) or index in filled
            or not piece_item or store.get_item_count(player["uin"], piece_item) < 1):
        log.info("    card fill REJECTED: uid=%d index=%d", uid, index)
        return []
    store.add_item(player["uin"], piece_item, -1)
    store.add_card_filled_index(player["uin"], uid, index)
    body = pb_int64_field(1, uid) + pb_varint_field(2, index)
    item = build_item_dto(piece_item, store.get_item_count(player["uin"], piece_item))
    return [("PVZ.Cmd.Cmd_Card_Fill_SC", body),
            ("PVZ.Cmd.Cmd_Item_Update_SC", pb_tag(1, 2) + uvarint(len(item)) + item)]


def handle_card_finishfill(cmd_data, player):
    uid = parse_varint_fields(cmd_data).get(1, 0)
    card = _owned_card(player, uid)
    filled = store.get_card_filled_indices(player["uin"], uid) if card else []
    if not card or not filled:
        return []
    complete = len(set(filled)) >= _card_fill_cell_count(store.get_card_fill_quality(player["uin"], uid))
    if not complete:
        log.info("    card puzzle not complete: uid=%d filled=%d/%d", uid, len(set(filled)),
                 _card_fill_cell_count(store.get_card_fill_quality(player["uin"], uid)))
        return []
    if complete:
        quality = store.get_card_fill_quality(player["uin"], uid) + 1
        store.set_card_fill_quality(player["uin"], uid, quality)
    # The client builds the completion dialog from its current card model when it
    # handles FinishFill_SC.  Send the updated card first, otherwise the dialog
    # still reads the old white 0-stage card and only changes after the dialog is
    # already on screen.
    messages = []
    store.clear_card_filled_indices(player["uin"], uid)
    sync = build_card_sync_sc(player["uin"], uid, card[1], 84)
    if sync:
        messages.append(sync)
    log.info("    card puzzle complete: uid=%d quality %d->%d", uid, quality - 1, quality)
    messages.append(("PVZ.Cmd.Cmd_Card_FinishFill_SC", pb_int64_field(1, uid)))
    return messages


def handle_card_batchfill(cmd_data, player):
    fields = parse_varint_fields(cmd_data)
    uid = fields.get(1, 0)
    indexes = parse_repeated_varint(cmd_data, 2)
    accepted = []
    for index in indexes:
        body = pb_int64_field(1, uid) + pb_varint_field(2, index)
        if handle_card_fill(body, player):
            accepted.append(index)
    if not accepted:
        return []
    body = pb_int64_field(1, uid)
    for index in accepted:
        body += pb_varint_field(2, index)
    # handle_card_fill persists each consumed piece, but its per-piece item
    # updates are intentionally folded into this batch response.  Send the
    # final counts too, otherwise the server save changes while the bag UI
    # continues showing the pre-batch quantities.
    quality = store.get_card_fill_quality(player["uin"], uid)
    fill_quality, fill_evolve = _card_fill_display(quality)
    item_updates = b""
    for index in accepted:
        item_id = 60000 + fill_quality * 1000 + fill_evolve * 100 + index + 1
        item = build_item_dto(item_id, store.get_item_count(player["uin"], item_id))
        item_updates += pb_tag(1, 2) + uvarint(len(item)) + item
    messages = [("PVZ.Cmd.Cmd_Card_BatchFill_SC", body)]
    if item_updates:
        messages.append(("PVZ.Cmd.Cmd_Item_Update_SC", item_updates))
    return messages


def handle_card_forge(cmd_data, player):
    fields = parse_varint_fields(cmd_data)
    uid = fields.get(1, 0)
    materials = parse_repeated_varint(cmd_data, 2)
    card = _owned_card(player, uid)
    if not card:
        log.info("    card forge rejected: uin=%s unknown card uid=%d materials=%s",
                 player.get("uin"), uid, materials)
        return []
    rows = load_card_forge().get(card[1], [])
    forge_level = store.get_card_forge_level(player["uin"], uid)
    row = next((value for value in rows if value["level"] == forge_level + 1), None)
    # The client decides whether the Enhance button is enabled from the card's
    # star-specific forge template.  Keep the server-side boundary identical:
    # once the current star has no next template, only star-up may proceed.
    max_forge_level = max((value["level"] for value in rows), default=0)
    if not row or forge_level >= max_forge_level:
        log.info("    card forge rejected: uid=%d card=%d forge=%d/%d (no next template)",
                 uid, card[1], forge_level, max_forge_level)
        return [("PVZ.Cmd.Cmd_Card_Forge_SC", pb_bool(1, False) + pb_int64_field(2, uid))]
    if int(player.get("coin", 0)) < row["cost"]:
        log.info("    card forge rejected: uid=%d card=%d forge=%d needs coin=%d has=%d",
                 uid, card[1], forge_level, row["cost"], int(player.get("coin", 0)))
        return [("PVZ.Cmd.Cmd_Card_Forge_SC", pb_bool(1, False) + pb_int64_field(2, uid))]
    load_battle_cards()
    star = int(_BATTLE_CARDS.get(card[1], {}).get("star", 1))
    counts = {}
    for item_id in materials:
        counts[item_id] = counts.get(item_id, 0) + 1
    # The client lets the player combine several chlorophyll items to raise the
    # displayed success rate.  consumeItemList is the repeated list of each item
    # consumed, so every entry contributes its own chance (including duplicates).
    # Using only materials[0] made the server roll at e.g. 4% while the client
    # showed 100%, which looked like the card was capped at forge +1.
    chance_table = load_card_forge_chances()
    material_chances = [chance_table.get((star, item_id), 0) for item_id in materials]
    chance = min(10000, sum(material_chances)) if materials else 10000
    log.info("    card forge attempt: uin=%s uid=%d card=%d star=%d forge=%d->%d "
             "coin=%d cost=%d materials=%s materialChances=%s chance=%.2f%%",
             player["uin"], uid, card[1], star, forge_level, row["level"],
             int(player.get("coin", 0)), row["cost"], materials,
             material_chances, chance / 100)
    if any(store.get_item_count(player["uin"], item_id) < count
           for item_id, count in counts.items()):
        log.info("    card forge rejected: uid=%d forge=%d insufficient materials=%s",
                 uid, forge_level, counts)
        return [("PVZ.Cmd.Cmd_Card_Forge_SC", pb_bool(1, False) + pb_int64_field(2, uid))]
    success = chance >= 10000 or random.randint(1, 10000) <= chance
    for item_id, count in counts.items():
        store.add_item(player["uin"], item_id, -count)
    if not success:
        log.info("    card forge failed roll: uid=%d card=%d forge remains %d; consumed=%s",
                 uid, card[1], forge_level, counts)
        item_updates = b""
        for item_id in counts:
            item = build_item_dto(item_id, store.get_item_count(player["uin"], item_id))
            item_updates += pb_tag(1, 2) + uvarint(len(item)) + item
        messages = [("PVZ.Cmd.Cmd_Card_Forge_SC",
                     pb_bool(1, False) + pb_int64_field(2, uid))]
        if item_updates:
            messages.append(("PVZ.Cmd.Cmd_Item_Update_SC", item_updates))
        return messages
    player["coin"] = int(player["coin"]) - row["cost"]
    store.save_player(player["uin"], coin=player["coin"])
    store.set_card_forge_level(player["uin"], uid, row["level"])
    log.info("    card forge success: uid=%d card=%d forge=%d coin=%d",
             uid, card[1], row["level"], player["coin"])
    result = pb_bool(1, True) + pb_int64_field(2, uid)
    # Refresh both the selected card and the collection before the success
    # event.  The Flash handler looks up its CardItemVO when Forge_SC arrives;
    # delivering the package afterward leaves the +1 card using a stale cached
    # forge template/state until another interaction.
    messages = []
    sync = build_card_sync_sc(player["uin"], uid, card[1], 28)
    if sync:
        messages.append(sync)
    messages.append(("PVZ.Cmd.Cmd_Card_GetPackage_SC", handle_card_getpackage(b"", player)))
    messages.append(("PVZ.Cmd.Cmd_Card_Forge_SC", result))
    messages.extend([
                ("PVZ.Cmd.Cmd_SyncCoin_SC", pb_varint_field(1, player["coin"]))]
    )
    item_updates = b""
    for item_id in counts:
        item = build_item_dto(item_id, store.get_item_count(player["uin"], item_id))
        item_updates += pb_tag(1, 2) + uvarint(len(item)) + item
    if item_updates:
        messages.append(("PVZ.Cmd.Cmd_Item_Update_SC", item_updates))
    return messages


_CARD_UPGRADE_RECIPES = None


def load_card_upgrade_recipes():
    """Load CardUpgradeTemplate: cardId -> star-up requirements.

    The table is found in two clientDB revisions.  The current one uses
    ``id, levelNeed, forgeLvNeed, costItemID, costItemNum, costCoinNum,
    newCardId`` where ``id`` is the source card ID; some revisions include a
    separate ``cardId`` column.  Read by header so both remain compatible.
    """
    global _CARD_UPGRADE_RECIPES
    if _CARD_UPGRADE_RECIPES is None:
        _CARD_UPGRADE_RECIPES = {}
        rows = _read_clientdb_table("CardUpgradeTemplate.txt")
        if rows:
            header = [name.lstrip("\ufeff") for name in rows[0]]
            ci = {name: i for i, name in enumerate(header)}

            def col(row, name, pos):
                i = ci.get(name, pos)
                return row[i] if i < len(row) else "0"

            for row in rows[1:]:
                try:
                    source = int(col(row, "cardId", 0)) if "cardId" in ci else int(col(row, "id", 0))
                    _CARD_UPGRADE_RECIPES[source] = (
                        int(col(row, "levelNeed", 2 if "cardId" in ci else 1)),
                        int(col(row, "forgeLvNeed", 3 if "cardId" in ci else 2)),
                        int(col(row, "costItemID", 4 if "cardId" in ci else 3)),
                        int(col(row, "costItemNum", 5 if "cardId" in ci else 4)),
                        int(col(row, "costCoinNum", 6 if "cardId" in ci else 5)),
                        int(col(row, "newCardId", 7 if "cardId" in ci else 6)))
                except (TypeError, ValueError):
                    continue
        log.info("loaded %d card star-up recipes", len(_CARD_UPGRADE_RECIPES))
    return _CARD_UPGRADE_RECIPES


def handle_card_evolve(cmd_data, player):
    uid = parse_varint_fields(cmd_data).get(1, 0)
    card = _owned_card(player, uid)
    recipe = load_card_upgrade_recipes().get(card[1]) if card else None
    if not recipe:
        return []
    need_level, need_forge, item_id, item_num, coin_num, new_card_id = recipe
    forge_level = store.get_card_forge_level(player["uin"], uid)
    if (int(player.get("level", 1)) < need_level
            or forge_level < need_forge
            or store.get_item_count(player["uin"], item_id) < item_num
            or int(player.get("coin", 0)) < coin_num):
        log.info("    card evolve REJECTED: uid=%d card=%d accountLv=%d/%d forge=%d/%d",
                 uid, card[1], int(player.get("level", 1)), need_level,
                 forge_level, need_forge)
        return []
    load_battle_cards()
    # newCardId=0 marks the final star and must never be upgraded further.
    if not new_card_id or new_card_id not in _BATTLE_CARDS:
        return []
    # Keep one stable client object.  This Flash build retains the old card
    # object when a different UID is returned, causing duplicate plants and a
    # stale +5 forge state.  Update the existing UID in place and send a full
    # info sync for that same UID.
    new_uid = uid
    store.add_item(player["uin"], item_id, -item_num)
    player["coin"] = int(player.get("coin", 0)) - coin_num
    store.save_player(player["uin"], coin=player["coin"])
    store.replace_card(player["uin"], uid, new_uid, new_card_id)
    # Star-up consumes the current enhancement, while the card's level/exp remain intact.
    store.set_card_forge_level(player["uin"], new_uid, 0)
    level = card[2]
    # Build the normal full-card sync so the client also receives forge=0 and the
    # recalculated post-star attributes/power in the same response.
    sync = build_card_sync_sc(player["uin"], new_uid, new_card_id, 26)
    stats = card_stats_at_level(new_card_id, level)
    player["_last_card_evolve_old_uid"] = uid
    player["_last_card_evolve_new_uid"] = new_uid
    result = pb_int64_field(1, new_uid) + pb_varint_field(2, stats.get("star", 1))
    item = build_item_dto(item_id, store.get_item_count(player["uin"], item_id))
    return [("PVZ.Cmd.Cmd_Card_Evolve_SC", result),
            sync,
            ("PVZ.Cmd.Cmd_Item_Update_SC", pb_tag(1, 2) + uvarint(len(item)) + item),
            ("PVZ.Cmd.Cmd_SyncCoin_SC", pb_varint_field(1, player["coin"]))]


def handle_card_usecardupgrade(cmd_data, player):
    """Handle the actual star-up request emitted by the client UI.

    The client does not send Cmd_Card_Evolve_CS when the star-up button is
    pressed; it sends Cmd_Card_UseCardUpgrade_CS{oldUId}.  Keep the existing
    evolve implementation as the single validation/mutation path, but replace
    its response with the protocol that CardProxy listens for.
    """
    uid = parse_varint_fields(cmd_data).get(1, 0)
    messages = handle_card_evolve(cmd_data, player)
    if not messages:
        return []
    # The server keeps the same UID so formations and the selected card remain
    # valid.  The cardId changes inside the full-info sync sent alongside this.
    new_uid = int(player.pop("_last_card_evolve_new_uid", uid))
    player.pop("_last_card_evolve_old_uid", None)
    messages[0] = (
        "PVZ.Cmd.Cmd_Card_UseCardUpgrade_SC",
        pb_int64_field(1, uid) + pb_int64_field(2, new_uid),
    )
    # As with forge, CardProxy handles this event by immediately looking up
    # the card by UID.  Deliver the new full card first so it sees the new
    # star and forgeLevel=0 instead of the pre-upgrade +5 object.
    if len(messages) > 1 and messages[1][0] == "PVZ.Cmd.Cmd_Card_SyncFullInfo_SC":
        messages[0], messages[1] = messages[1], messages[0]
    # UID is intentionally stable, so refresh the complete package before the
    # star-up event asks the client to resolve the card. This also rebuilds the
    # star-specific forge template with forgeLevel=0 instead of the old star's
    # cached state.
    messages.insert(1, ("PVZ.Cmd.Cmd_Card_GetPackage_SC", handle_card_getpackage(b"", player)))
    return messages


def handle_card_exchangepiece(cmd_data, player):
    fields = parse_varint_fields(cmd_data)
    uid, index, amount = fields.get(3, 0), fields.get(1, -1), fields.get(2, 0)
    card = _owned_card(player, uid)
    piece_item = _card_piece_item(card[1]) if card else 0
    if (not card or index < 0 or index > _card_fill_max_index(player["uin"], uid)
            or amount <= 0 or not piece_item):
        return []
    amount = min(int(amount), 100)
    store.add_item(player["uin"], piece_item, amount)
    item = build_item_dto(piece_item, store.get_item_count(player["uin"], piece_item))
    return [("PVZ.Cmd.Cmd_Card_ExchangePiece_SC", pb_varint_field(1, index)),
            ("PVZ.Cmd.Cmd_Item_Update_SC", pb_tag(1, 2) + uvarint(len(item)) + item)]


# ---- card avatars (wardrobe / 时装) --------------------------------------------
_CARD_AVATARS = None  # {tdPlantId(int): [avatarId(int), ...] ascending}


def load_card_avatars():
    """Parse cardChestAvatar.txt out of the clientDB archive once; cache it.
    Returns {tdPlantId: [avatarId, ...]} sorted ascending. The client treats the lowest-id
    avatar of a plant as its default 'Using' skin (getPlantAvatarsByPlantId sorts ascending
    and getPlantDefaultAvatarID returns [0])."""
    global _CARD_AVATARS
    if _CARD_AVATARS is not None:
        return _CARD_AVATARS
    _CARD_AVATARS = {}
    if not os.path.isfile(_CLIENTDB_PATH):
        return _CARD_AVATARS
    data = open(_CLIENTDB_PATH, "rb").read()
    pos = 0
    while pos + 4 <= len(data):                       # big-endian [len][name][len][tsv] archive
        nlen = int.from_bytes(data[pos:pos + 4], "big"); pos += 4
        name = data[pos:pos + nlen].decode("utf-8", "replace"); pos += nlen
        dlen = int.from_bytes(data[pos:pos + 4], "big"); pos += 4
        chunk = data[pos:pos + dlen]; pos += dlen
        if name != "cardChestAvatar.txt":
            continue
        rows = [r for r in chunk.decode("utf-8", "replace").replace("\r", "").split("\n") if r.strip()]
        hdr = rows[0].split("\t"); ci = {c: i for i, c in enumerate(hdr)}
        ii, pi = ci.get("id"), ci.get("tdPlantId")
        for r in rows[1:]:
            c = r.split("\t")
            try:
                aid, pid = int(c[ii]), int(c[pi])
            except (ValueError, IndexError):
                continue
            _CARD_AVATARS.setdefault(pid, []).append(aid)
        break
    for pid in _CARD_AVATARS:
        _CARD_AVATARS[pid].sort()
    return _CARD_AVATARS


def _encode_avatar_all_attr():
    """Dto_AvatarAllAttr with hp+shield present (they're UInt64 objects the client dereferences via
    .hp.toNumber() -> null-crash if unset) and the rest 0. This is the aggregate avatar bonus; a plant
    wearing no forged avatar contributes nothing, so all zeros is correct."""
    return (pb_varint_field(1, 0)     # attack (uint)
            + pb_varint_field(2, 0)   # defense (uint)
            + pb_varint_field(3, 0)   # hp     (UInt64 - MUST be present)
            + pb_varint_field(4, 0)   # shield (UInt64 - MUST be present)
            + pb_varint_field(5, 0))  # ability (uint)


def handle_card_getavatarinfo(cmd_data, player):
    """Cmd_Card_GetAvatarInfo_CS{cardUId(1,I64)} -> Cmd_Card_GetAvatarInfo_SC{avatarList(1)=[Dto_AvatarInfo],
    avatarAllAttr(2)=Dto_AvatarAllAttr}. The wardrobe (时装) screen sends this when it opens.

    The client REQUIRES a non-empty avatarList that contains exactly one avatar in the Using(4) state
    (that becomes CardItemVO.curUsedAvatar) AND a present avatarAllAttr, or it #1009s in two places:
    CardChestAvatarView.setSelected (indexes cardList[0] / getPlantAvatarByAvatarId) and
    CardChestPropCtMediator.updateHandler (curUsedAvatar.avatarId, avatarAttr.hp.toNumber()). The empty
    generic reply left curUsedAvatar null. We hand back the plant's real avatars (cardChestAvatar.txt),
    marking the default (lowest id) Using and the rest Locked. Dto_AvatarInfo needs only avatarId(1) +
    avatarStatus(2); omitting currAddAttr(6) makes updateHandler skip its attr-diff block."""
    uid = parse_varint_fields(cmd_data).get(1, 0)
    uin = player.get("uin")
    card = next((c for c in store.get_cards(uin) if c[0] == uid), None) if uin else None
    avatars = load_card_avatars().get(card[1], []) if card else []
    avatar_list = b""
    for i, aid in enumerate(avatars):
        status = 4 if i == 0 else 1               # Using(4) for the default skin, Locked(1) for the rest
        dto = pb_varint_field(1, aid) + pb_varint_field(2, status)
        avatar_list += pb_tag(1, 2) + uvarint(len(dto)) + dto
    attr = _encode_avatar_all_attr()
    body = avatar_list + pb_tag(2, 2) + uvarint(len(attr)) + attr
    log.info("    CARD AVATAR INFO: uid=%d card=%s -> %d avatars",
             uid, card[1] if card else None, len(avatars))
    return body


def grant_battle_card_exp(player, exp_each):
    """After a win, add `exp_each` plant XP to EVERY card in the player's formation (this is the
    植物经验 the battle rewards, which the client animates onto each card's bar). Returns the
    Cmd_Card_SyncFullInfo_SC messages for the cards that changed."""
    if exp_each <= 0:
        return []
    uin = player["uin"]
    placements = default_formation_placements(player)
    card_by_uid = {uid: cid for uid, cid, _l, _e in store.get_cards(uin)}
    messages = []
    for uid in placements.values():
        cid = card_by_uid.get(uid)
        if cid is None:
            continue
        res = add_card_exp(player, uid, cid, exp_each)
        if res:
            sync = build_card_sync_sc(uin, uid, cid, 20)  # ActionFrom_AddExpLevelUp
            if sync:
                messages.append(sync)
    if messages:
        log.info("    battle exp: +%d to %d formation card(s)", exp_each, len(messages))
    return messages


# --- skill/rage bar --------------------------------------------------------------
# The bar under each unit's HP is the SKILL (rage) bar: the client draws `maxRage` pips and fills
# `rage` of them. Design (from the player): 3 pips, start filled 2/3, +1 each round; at full the unit
# casts its special skill. The fill/reset is driven by per-round buffEffect changeRage ticks in the
# replay (a Dto_FightDamage with changeHp=0 + a non-Dodge damageType -> CostarChangeHP animates only
# the rage bar, no attack anim / no damage number).
RAGE_MAX = 3
RAGE_START = 2
# battleCard.skillId2 = a card's SPECIAL (ability); skillId1 = its basic. A unit casts skillId2 when its
# rage bar is full (any kind), else uses skillId1. Each skill runs its REAL effect (see _SKILL_INFO) so
# the replay matches the client's plan-tree and HP stays in sync.
# CAST damage = basic x this (footage: peashooter basic 270, ability 810 = 3x). AoE abilities hit each
# target for basic x _AOE_MULT. Heals restore a fraction of the ally's max HP.
_SKILL_DMG_MULT = 3
_AOE_MULT = 1.6
_HEAL_FRAC_BASIC = 0.04     # a basic heal restores this fraction of the ally's max HP (kept modest so
_HEAL_FRAC_CAST = 0.08      # flag-mummy healers don't out-sustain the plants and drag the fight out)

# Skill kind + target count, parsed from BattleLineupCardSkillTemplate.txt (name+desc). This is what
# makes every skill actually WORK: the sim executes the real effect and the client's plan-tree matches
# (attack/aoe -> InjuredPlan damage; heal -> CurePlan heal; charge -> self-buff, no enemy damage). Only
# damage skills (attack/aoe) ever deal a KILLING blow (isDead) — heal/charge target allies/self, so the
# client never stalls on a heal/charge death (the old bug). kinds: 'attack'(1 enemy), 'aoe'(N enemies),
# 'heal'(N lowest-HP% allies), 'charge'(self, 0-damage swing).
_SKILL_INFO = None


def load_skill_info():
    """{skillId: (kind, nTargets)} classified from the skill template's name+desc keywords."""
    global _SKILL_INFO
    if _SKILL_INFO is None:
        _SKILL_INFO = {}
        rows = _read_clientdb_table("BattleLineupCardSkillTemplate.txt")
        if rows:
            hdr = rows[0]; ci = {c: i for i, c in enumerate(hdr)}
            for r in rows[1:]:
                def col(k):
                    i = ci.get(k)
                    return r[i] if i is not None and i < len(r) else ""
                try:
                    sid = int(col("id"))
                except ValueError:
                    continue
                text = col("name") + col("desc")
                if "治疗" in text or "治療" in text:            # heal N lowest-HP allies
                    n = 3 if any(k in text for k in ("3个", "三个", "3個", "三個")) else 1
                    _SKILL_INFO[sid] = ("heal", n)
                elif "蓄力" in text or "攻击加成" in text:       # self charge/buff
                    _SKILL_INFO[sid] = ("charge", 0)
                elif any(k in text for k in ("阵首", "阵中", "阵尾", "周围", "全体", "所有敌")):  # AoE
                    _SKILL_INFO[sid] = ("aoe", 3)
                else:                                          # single-target attack
                    _SKILL_INFO[sid] = ("attack", 1)
        log.info("loaded skill info for %d skills", len(_SKILL_INFO))
    return _SKILL_INFO


def build_fight_card(pos, card_id, hp, level=1, is_leader=False, max_rage=RAGE_MAX, rage=RAGE_START,
                     power=0, exp=0):
    """Dto_FightCardInfo{posIndex(1),cardId(2),hp(3,U64),rage(4),shield(5,U64),maxHp(6,U64),
    maxRage(7),maxShield(8,U64),isLeader(9),level(11),cardPower(16,U64),isLive(17)}.
    maxRage(7) = the number of SEGMENTS the client draws in the skill bar (UnitProgressCtr.changeRageMax
    divides the bar into maxRage pips) -> 3 pips; rage(4) = how many are filled at battle start -> 2/3.
    The replay's per-round buffEffect ticks it +1 (see simulate_battle).
    CRITICAL: maxShield(8) and cardPower(16) are U64 OBJECTS. An UNSET U64 reads back as NULL on the
    client, and UnitFactory.updateUnit does `maxShield.toNumber()` (line ~115) -> #1009, plus the report
    coerces cardPower -> #1034. That crash halts the per-unit UpdateUnitPlan, which never setComplete()s,
    so the plan machine stalls on a timeout = the visible battle GAPS. Both MUST be present (0 is fine)."""
    return (pb_varint_field(1, pos) + pb_varint_field(2, card_id)
            + pb_varint_field(3, hp) + pb_varint_field(4, rage) + pb_varint_field(5, 0)
            + pb_varint_field(6, hp) + pb_varint_field(7, max_rage) + pb_varint_field(8, 0)  # maxShield
            + pb_varint_field(9, 1 if is_leader else 0)
            + pb_varint_field(10, exp)                                     # exp WITHIN the level (bar fill)
            + pb_varint_field(11, level) + pb_varint_field(16, power)      # cardPower
            + pb_varint_field(17, 1))


# Odd posIndex = left/plants, even = right/zombies (BattleConst.isLeft = idx%2==1); 9 slots/side.
_LEFT_POS = [1, 3, 5, 7, 9, 11, 13, 15, 17]
_RIGHT_POS = [2, 4, 6, 8, 10, 12, 14, 16, 18]
# The player's team occupies THESE posIndexes only. The city home-team view (EmbattleCommand.
# addBattleCardViewToCity) creates DragableEmbattlePlant slots at posIndex 3,7,9,11,13,15,17 (7 slots);
# posIndex 1 is reserved for the puppet/dummy and 5 is skipped — a card placed there has no slot and
# the view null-derefs. So formation cardPos MUST use this set (odd = left/plants in the battle too).
_FORMATION_POS = [3, 7, 9, 11, 13, 15, 17]
_FORMATION_MAX = 6                # how many cards we auto-place in the default team
# The ENEMY/zombie side has the SAME reserved-slot rule mirrored: the pre-fight lineup window
# (BattleLineupWindow.initEnemyCardvessel) creates enemy vessels at posIndex 4,8,10,12,14,16,18 only —
# posIndex 2 and 6 are the invisible/reserved slots (like plant 1 and 5). An enemy card at 2/6 has no
# vessel, so lineupUpdateHandler's getCardVesselByPosIndex(false, pos).setData() null-derefs (#1009).
# So zombies MUST use this set (even = right/zombies in the battle too).
_ENEMY_POS = [4, 8, 10, 12, 14, 16, 18]

# REAL per-level enemy composition transcribed from the wiki
# (plantsvszombies.wiki.gg/wiki/Zphinx_-_Day_N). Egypt zombie cards: 111 Mummy, 121 Conehead,
# 131 Buckethead, 141 Flag. Each entry = (cardId, count, wikiHP, power); the FIRST entry's first
# zombie is the leader/boss. Validation: sum of powers == the level's required Fighting Power, and
# wikiHP == power*9 (mummy/flag) or power*10.8 (conehead/buckethead, 1.2x tankier).
_ADVENTURE_LEVELS = {
    1: {   # chapter 1 = Zphinx (Egypt), NORMAL mode. 10 days.
        1:  [(111, 3, 2970, 330)],
        2:  [(111, 3, 2970, 330)],
        3:  [(111, 3, 2970, 330), (141, 1, 2970, 330)],
        4:  [(121, 1, 3888, 360), (141, 2, 3240, 360)],
        5:  [(121, 1, 4212, 390), (111, 2, 3510, 390)],   # conehead leader
        6:  [(121, 2, 3888, 360), (111, 2, 3240, 360)],
        7:  [(121, 2, 4212, 390), (141, 2, 3510, 390)],
        8:  [(121, 1, 4536, 420), (141, 1, 3780, 420), (111, 2, 3780, 420)],
        9:  [(121, 2, 4536, 420), (111, 2, 3780, 420)],
        10: [(131, 1, 5832, 540), (111, 2, 4860, 540)],   # buckethead boss
    },
}
# NOTE: per-stage end-of-battle rewards (Plant EXP item 5 + Coins item 1 every clear; TD Key 4001 + Town
# Prosperity item 2 + plants/items on first clear) come straight from clientDB fuben.txt via
# fuben_stage_reward() — for EVERY chapter, matching the level-select tooltip exactly. (An older
# hand-transcribed ch1-only _ADVENTURE_REWARDS was removed: it duplicated fuben.txt and, merged on top,
# double-granted ch1 loot while giving ch2+ a 0 result-screen exp animation.)


# PACING knob (cosmetic only now): divide the wiki HP by this so the win animation resolves quickly. The
# outcome is decided by POWER (resolve_battle), not by grinding HP, so this only affects how long the
# replay plays. Set to 1 for the real wiki HP.
_ZOMBIE_HP_TEST_DIVISOR = 3
# Enemy atk/def are derived from the zombie's Fighting Power so tougher stages visibly hit harder in the
# replay. These feed the ANIMATION only (win/loss is power-decided), so they're tuned for believable
# on-screen damage, not balance.
_ENEMY_ATK_FROM_POWER = 1.0
_ENEMY_DEF_FROM_POWER = 0.10
# Difficulty (BALANCED): the team WINS when its effective Fighting Power (card levels + Lab + World Tree)
# reaches this fraction of the enemy's total power. 1.0 = you must out-power the enemy; a little under 1
# gives slack so a marginal team can still squeak a win. Raise toward/over 1 for a harder game.
_WIN_POWER_RATIO = 0.95
# Within-chapter Fighting-Power ramp (per stage past 1) for untranscribed chapters. ~0.07 matches the
# spread the wiki shows across chapter 1 (stage1 990 -> stage10 ~1620, ~1.63x over 10 stages).
_FALLBACK_STAGE_SCALE = 0.07


def _chapter_base_power(chapter):
    """Total enemy Fighting Power at STAGE 1 of a chapter, calibrated to the wiki (user-supplied,
    2026-07-14): ch1-4 = 990 / 2550 / 5220 / 9000. Those fit the EXACT quadratic 555*ch^2 - 105*ch + 540
    (constant 2nd difference 1110), which we extrapolate for the deeper untranscribed chapters."""
    return max(1, 555 * chapter * chapter - 105 * chapter + 540)


def _enemy_atk_def(power):
    """(atk, def_) for a zombie of the given Fighting Power — replay-damage only, scaled off power."""
    return max(1, int(power * _ENEMY_ATK_FROM_POWER)), max(0, int(power * _ENEMY_DEF_FROM_POWER))
# Themed zombie families by WORLD (star-1 base cardIds from battleCard.txt), so a chapter's fallback
# enemies fit its setting instead of the generic 小偷僵尸 (thief) placeholder. Chapter->world is from the
# FubenChapterTemplate names: ch1-6 Ancient Egypt / Egyptian Market, 7-8 Great Wall, 9-12 Pirate Seas,
# 13-15 Far Future / Mecha. (Egypt mummies are proven in ch1; the later-world families exist in
# battleCard.txt but their in-battle assets are unverified — swap any that fail to render.)
_WORLD_ZOMBIES = {
    "egypt":     [111, 121, 131, 141, 150, 161, 171, 181, 190],  # 木乃伊/路障/铁桶/摇旗/太阳神/骆驼/火炬/造墓/法老
    "greatwall": [310, 320, 330, 350, 370, 380, 400, 410],        # 军士/顶碗/铁盔/弓箭/盾卫/推车/骑兵/令牌
    "pirate":    [430, 440, 450, 460, 470, 480, 490, 500],        # 醉酒/滚筒/海鸥/海盗巨人/小鬼/杂耍/猴子/摇旗水手
    "future":    [200, 202, 201, 206, 204, 207, 254],             # 喷射器/机甲路障/电磁盾/机甲橄榄球/迪斯科/机甲巨人/喷射器舞者
    "sea":       [771, 781, 791, 801, 817, 818, 820, 841, 851, 861, 871, 881, 891],  # 海带/虾兵/螺兵/海马/蚌仙/龟丞相/河豚/水母/海夜叉/分裂/深海力士
}
_CHAPTER_WORLD = {
    1: "egypt", 2: "egypt", 3: "egypt", 4: "egypt", 5: "egypt", 6: "egypt",
    7: "greatwall", 8: "greatwall",
    9: "pirate", 10: "pirate", 11: "pirate", 12: "pirate",
    13: "future", 14: "future", 15: "future",
    16: "sea", 17: "sea", 18: "sea", 19: "sea", 20: "sea",   # 海底龙宫
}
_DEFAULT_ENEMY_CARDS = [111, 121, 131, 141]   # Egypt mummies — default for deeper/unmapped chapters


def chapter_enemy_cards(chapter):
    """Themed zombie cardIds for a chapter's world (Egypt mummies if the chapter isn't mapped)."""
    return _WORLD_ZOMBIES.get(_CHAPTER_WORLD.get(chapter, "egypt"), _DEFAULT_ENEMY_CARDS)


# --- formation / lineup (the backyard team editor) --------------------------------
def default_formation_placements(player):
    """{posIndex: uid} for the player's battle team (team 1). Their SAVED layout if it uses valid slots,
    else auto-place their collection cards on _FORMATION_POS and persist it, so the backyard lineup +
    adventure battles start with a real team instead of empty."""
    uin = player["uin"]
    saved = store.get_formation(uin, 1)
    # Keep a saved layout only if every slot is valid (an old default used posIndex 1/5 -> regenerate).
    if saved and all(pos in _FORMATION_POS for pos in saved):
        return saved
    placements = {}
    for i, (uid, _cid, _lvl, _exp) in enumerate(store.get_cards(uin)[:_FORMATION_MAX]):
        placements[_FORMATION_POS[i]] = uid
    if placements:
        store.set_formation(uin, 1, placements)
    return placements


def build_card_pos(pos, uid, role_id, hp, power):
    """Dto_CardPosInfo{posIndex(1), uid(2,I64), ownerRoleId(3,I64), curHp(4,U64), maxHp(5,U64),
    powerEle(6)=[Dto_CardPower{ele=total(0), value(2,I64)=power, speed(3,I64)=0}]}.
    - ownerRoleId is OMITTED (null): a card with a null owner is treated as the PLAYER'S OWN. Setting it
      (even to the real roleId) risks the client reading the card as a borrowed/help card -> "该植物不在
      家园中，不能移动他" (can't move a plant that isn't in your home). Note Int64(0) would still read as
      "someone else's" (the check is `if(ownerRoleId && ...)` and an Int64 object is truthy), so we must
      truly omit the field, not send 0.
    - powerEle needs BOTH value (totalPower) AND speed (totalSpeed) or BattleCardFormationVO.totalSpeed
      does .toNumber() on a null Int64 and #1009-crashes the backyard every frame."""
    power_ele = (pb_varint_field(1, 0) + pb_int64_field(2, power)     # Dto_CardPower{ele=total, value}
                 + pb_int64_field(3, 0))                             # speed (present, non-null)
    return (pb_varint_field(1, pos) + pb_int64_field(2, uid)          # posIndex, uid (NO ownerRoleId)
            + pb_varint_field(4, hp) + pb_varint_field(5, hp)
            + pb_tag(6, 2) + uvarint(len(power_ele)) + power_ele)


def build_formation_info(player, team_id, placements):
    """Dto_FormationInfo{cardPos(1)=[Dto_CardPosInfo], formationId(2), leaderUid(3,I64),
    totalPower(4,U64), teamId(5), status(6)=home(1,editable), isDefend(8)=0}."""
    load_battle_cards()
    uin = player["uin"]; role_id = player.get("role_id", uin)
    card_by_uid = {uid: (cid, lvl) for uid, cid, lvl, _exp in store.get_cards(uin)}
    bonus = deployed_stat_bonus(player)             # Lab + World Tree boost on every deployed plant
    cardpos_b, total_power, leader_uid = b"", 0, 0
    for pos in sorted(placements):
        uid = placements[pos]
        cid, lvl = card_by_uid.get(uid, (uid, 1))
        st = effective_card_stats(player, cid, lvl, bonus, uid=uid) if cid in _BATTLE_CARDS else {}
        power = card_power(st) if st else 0
        total_power += power
        if leader_uid == 0:
            leader_uid = uid
        cp = build_card_pos(pos, uid, role_id, st.get("hp", 0), power)
        cardpos_b += pb_tag(1, 2) + uvarint(len(cp)) + cp
    return (cardpos_b + pb_varint_field(2, 1)                # formationId
            + pb_int64_field(3, leader_uid)                  # leaderUid
            + pb_varint_field(4, total_power)                # totalPower (U64)
            + pb_varint_field(5, team_id)                    # teamId
            + pb_varint_field(6, 0)      # status = E_TeamStatus_home(0), EDITABLE. status=1 = _out =
                                         # "出征中" -> client blocks moving plants / editing formation.
            + pb_varint_field(8, 0))                         # isDefend = 0 (attack team)


def handle_battle_getformation(cmd_data, player):
    """Cmd_Battle_GetFormation_CS -> Cmd_Battle_GetFormation_SC{formation(1), team(2)=[Dto_FormationInfo],
    teamMaxNum(3), defaultTeamId(4)}. The player's battle team, loaded into battleCardModel at login
    (updateEmbattleCardTeam) and shown/edited in the backyard lineup. Pre-filled with the player's cards
    so the lineup isn't empty and the pre-fight lineup window can render the player side."""
    ensure_player_cards(player)
    placements = default_formation_placements(player)
    formation = build_formation_info(player, 1, placements)
    team = pb_tag(2, 2) + uvarint(len(formation)) + formation        # team (field 2, repeated)
    log.info("    battle GET formation: %d cards %s", len(placements), placements)
    return (pb_tag(1, 2) + uvarint(len(formation)) + formation       # formation (field 1)
            + team + pb_varint_field(3, 1) + pb_varint_field(4, 1))   # teamMaxNum=1, defaultTeamId=1


def handle_battle_setformation(cmd_data, player):
    """Cmd_Battle_SetFormation_CS{formation(1)=Dto_FormationInfo} -> persist the player's chosen team.
    Parse cardPos -> {posIndex: uid}. There's no Cmd_Battle_SetFormation_SC; setLineup does NOT update
    the local formation VO, so the client only refreshes the lineup once the server SENDS the updated
    team back — so we re-push Cmd_Battle_GetFormation_SC (its handler = updateEmbattleCardTeam + dispatch
    LINEUP_UPDATE, which rebuilds the backyard view). Without this the drag appears to do nothing."""
    placements, team_id = {}, 1
    fsub = parse_repeated_submessages(cmd_data, 1)
    if fsub:
        team_id = parse_varint_fields(fsub[0]).get(5, 1) or 1
        for cp in parse_repeated_submessages(fsub[0], 1):            # cardPos
            c = parse_varint_fields(cp)
            pos, uid = c.get(1, 0), c.get(2, 0)
            if pos and uid:
                placements[pos] = uid
    store.set_formation(player["uin"], team_id, placements)
    log.info("    battle SET formation team=%d: %s", team_id, placements)
    return [("PVZ.Cmd.Cmd_Battle_GetFormation_SC", handle_battle_getformation(b"", player))]


def handle_fuben_getformation(cmd_data, player):
    """Cmd_Fuben_GetFormation_CS -> Cmd_Fuben_GetFormation_SC{formation(1)=Dto_FormationInfo}.
    The ADVENTURE (fuben) lineup window requests THIS (not Cmd_Battle_GetFormation) and stores it as
    getTargetVo(MODE_FUBEN). Without it BattleLineupWindowMediator.lineupUpdateHandler null-derefs
    (#1009) at getTargetVo(embattleType).totalPower, and the lawn spawns only the leader plant. Same
    team as the town backyard (team 1)."""
    ensure_player_cards(player)
    placements = default_formation_placements(player)
    formation = build_formation_info(player, 1, placements)
    log.info("    fuben GET formation: %d cards %s", len(placements), placements)
    return pb_tag(1, 2) + uvarint(len(formation)) + formation        # formation (field 1)


def handle_fuben_setformation(cmd_data, player):
    """Cmd_Fuben_SetFormation_CS{formation(1)=Dto_FormationInfo} -> persist the adventure lineup (same
    team 1 as the backyard) + echo Cmd_Fuben_GetFormation_SC so the window refreshes. Only persists a
    non-empty parse (guards against wiping the team on a field mismatch)."""
    placements = {}
    fsub = parse_repeated_submessages(cmd_data, 1)
    if fsub:
        for cp in parse_repeated_submessages(fsub[0], 1):            # cardPos
            c = parse_varint_fields(cp)
            pos, uid = c.get(1, 0), c.get(2, 0)
            if pos and uid:
                placements[pos] = uid
    if placements:
        store.set_formation(player["uin"], 1, placements)
    log.info("    fuben SET formation: %s", placements)
    return [("PVZ.Cmd.Cmd_Fuben_GetFormation_SC", handle_fuben_getformation(b"", player))]


def build_player_units(player):
    """The player's LINEUP (their saved formation) as battle-card units (first placed = leader), with each
    plant's effective stats (card level + Lab + World Tree). Shared by adventure AND Trial Road, so both
    fight with the same team + investment. Returns [{pos,card_id,hp,atk,def_,skill1,skill2,level,is_leader,
    name,power,uid,exp}]."""
    load_battle_cards()
    left = []
    placements = default_formation_placements(player)
    card_by_uid = {uid: (cid, lvl, exp) for uid, cid, lvl, exp in store.get_cards(player["uin"])}
    bonus = deployed_stat_bonus(player)             # Lab + World Tree boost on every deployed plant
    for pos in sorted(placements):
        uid = placements[pos]
        card_id, level, exp = card_by_uid.get(uid, (uid, 1, 0))
        if card_id not in _BATTLE_CARDS:
            continue
        st = effective_card_stats(player, card_id, level, bonus, uid=uid)
        left.append({"pos": pos, "card_id": card_id, "hp": st["hp"], "atk": st["atk"],
                     "def_": st["def_"], "skill1": st["skill1"], "skill2": st.get("skill2", 0),
                     "level": level, "is_leader": len(left) == 0, "name": st["name"],
                     "power": card_power(st),            # effective power (feeds the win/loss decision)
                     "uid": uid, "exp": exp})            # uid + total exp -> result-screen bar before/after
    return left


def build_battle_units(player, chapter, mode, stage):
    """Fabricate the two teams. left = the player's LINEUP; right = a few stage zombies. Returns
    (left_units, right_units). Battle == the backyard lineup."""
    left = build_player_units(player)
    # Right: the stage's zombies. If we have the REAL wiki composition for this (chapter, stage) use it
    # (exact types/counts/HP/power); HP is divided by _ZOMBIE_HP_TEST_DIVISOR for testing. Otherwise
    # fall back to a themed, adaptive-HP squad so un-transcribed chapters still play.
    right = _build_wiki_enemies(chapter, stage) or _build_fallback_enemies(chapter, stage)
    return left, right


def _build_wiki_enemies(chapter, stage):
    """Real per-level enemies from _ADVENTURE_LEVELS, or None if this level isn't transcribed yet."""
    level = _ADVENTURE_LEVELS.get(chapter, {}).get(stage)
    if not level:
        return None
    right, i = [], 0
    for card_id, count, wiki_hp, power in level:
        zst = _BATTLE_CARDS.get(card_id, {"skill1": 0, "skill2": 0, "name": "Zombie"})
        hp = max(1, wiki_hp // _ZOMBIE_HP_TEST_DIVISOR)
        atk, dfn = _enemy_atk_def(power)
        for _ in range(count):
            if i >= len(_ENEMY_POS):
                break
            right.append({"pos": _ENEMY_POS[i], "card_id": card_id, "hp": hp, "atk": atk, "def_": dfn,
                          "skill1": zst.get("skill1", 0), "skill2": zst.get("skill2", 0), "level": 1,
                          "is_leader": i == 0, "power": power, "name": zst.get("name", "Zombie")})
            i += 1
    return right


def _build_fallback_enemies(chapter, stage):
    enemy_cards = [c for c in chapter_enemy_cards(chapter) if c in _BATTLE_CARDS] \
        or [c for c in _DEFAULT_ENEMY_CARDS if c in _BATTLE_CARDS] \
        or [next(iter(_BATTLE_CARDS), 111)]
    total_power = _chapter_base_power(chapter) * (1 + _FALLBACK_STAGE_SCALE * (stage - 1))
    zombie_count = max(1, min(3 + (stage - 1) // 2, len(_ENEMY_POS)))
    z_power = max(1, int(total_power / zombie_count))
    z_hp = max(1, z_power * 9 // _ZOMBIE_HP_TEST_DIVISOR)
    atk, dfn = _enemy_atk_def(z_power)
    # 随机抽，同场不重复；卡池不够再从头补
    picks = random.sample(enemy_cards, min(zombie_count, len(enemy_cards)))
    while len(picks) < zombie_count:
        picks.append(random.choice(enemy_cards))
    right = []
    for i in range(zombie_count):
        zc = picks[i]
        zst = _BATTLE_CARDS.get(zc, {"skill1": 0, "name": "Zombie"})
        right.append({"pos": _ENEMY_POS[i], "card_id": zc, "hp": z_hp, "atk": atk, "def_": dfn,
                      "skill1": zst.get("skill1", 0), "skill2": zst.get("skill2", 0), "level": 1,
                      "is_leader": i == 0, "power": z_power, "name": zst.get("name", "Zombie")})
    return right


def _col_of_pos(pos):
    """Grid column of a posIndex (1=front .. 3=back), per BattleConst.getColIndexByPosIndex."""
    if pos in (1, 2, 7, 8, 13, 14):
        return 1
    if pos in (3, 4, 9, 10, 15, 16):
        return 2
    return 3


# Extra empty rounds appended after the last kill. Each round the client plays a built-in ~1s delay,
# and DiePlanNomal starts a ~2s death fade but completes its plan immediately (doesn't hold the round),
# so without a buffer battleEnd() pops the result while the final zombie is still mid-fade = "zombies
# left when the stage finishes". Two empty rounds (~2s) let the last death fade finish first.
_DEATH_FADE_BUFFER_ROUNDS = 2


def simulate_battle(left_units, right_units, won, max_rounds=60):
    """Deterministic replay the client animates, with REAL per-skill effects (see load_skill_info). The
    OUTCOME is decided upstream by Fighting Power (resolve_battle) and passed in as `won` — this only
    animates it, because the client trusts report.result/winSide and treats the replay as theatre.
    The LOSER's units are mortal and get routed; the WINNER's units are protected (any hit on them is
    clamped to leave >= 1 HP) so the replay always ends with the loser wiped and the winner standing,
    regardless of the raw stat scales. So on a WIN the zombies die and the plants survive (the original,
    confirmed-good animation); on a LOSS the plants are overwhelmed and the zombies survive.
    Each round every living unit casts its ability (skillId2) when its rage bar is full, else its basic
    (skillId1): attack -> the front-most enemy; aoe -> the front-most N; heal -> the N lowest-HP% allies;
    charge -> a 0-damage self swing. The winner FOCUS-fires the loser (kills them one at a time); the
    loser SPREADS a tuned chip onto the healthiest winner unit (so none is pinned at 1 HP = the old
    silent-unit bug). Returns [(actions, buffs), ...]: actions=[{actor,skill,cast,damages:[{target,dmg,
    dead}]}] (dmg>0 damage / dmg<0 heal). A fail-safe finishing round guarantees the loser is wiped even
    if healers keep it alive, then _DEATH_FADE_BUFFER_ROUNDS empty rounds let the last death fade play."""
    load_skill_info()
    hp = {u["pos"]: u["hp"] for u in left_units + right_units}
    maxhp = dict(hp)
    atk = {u["pos"]: u["atk"] for u in left_units + right_units}
    skill1 = {u["pos"]: (u.get("skill1") or 0) for u in left_units + right_units}
    skill2 = {u["pos"]: (u.get("skill2") or 0) for u in left_units + right_units}
    rage = {u["pos"]: RAGE_START for u in left_units + right_units}
    left_pos = [u["pos"] for u in left_units]
    right_pos = [u["pos"] for u in right_units]
    # The protected (winner) side never dies in the replay; the loser side is routed. Which side is which
    # is the power-decided outcome, so plants-immortal/zombies-die on a win, and the mirror on a loss.
    winner_pos = left_pos if won else right_pos
    loser_pos = right_pos if won else left_pos

    def alive(ps):
        return [p for p in ps if hp[p] > 0]

    def front_n(ps, n):
        return sorted(alive(ps), key=lambda p: (_col_of_pos(p), p))[:n]

    def kind_of(pos, casting):
        sid = skill2[pos] if casting else skill1[pos]
        return sid, _SKILL_INFO.get(sid, ("attack", 1))

    def is_damager(pos):
        return kind_of(pos, False)[1][0] in ("attack", "aoe")

    # Loser chip tuned so the immortal winner sheds ~40% of its combined HP over the fight (cosmetic).
    # Based on the winner's DPS vs the loser's total HP (how long the rout takes).
    winner_dps = sum(atk[p] for p in winner_pos if is_damager(p)) or 1
    loser_total_hp = sum(hp[z] for z in loser_pos)
    est_rounds = max(1, -(-loser_total_hp // winner_dps))
    winner_total_hp = sum(hp[p] for p in winner_pos) or 1
    per_hit = max(1, int(0.4 * winner_total_hp / max(1, len(loser_pos) * est_rounds)))

    def act(pos, allies, enemies):
        casting = rage[pos] >= RAGE_MAX and skill2[pos] != 0
        sid, (kind, ntgt) = kind_of(pos, casting)
        damages = []
        if kind == "heal":
            frac = _HEAL_FRAC_CAST if casting else _HEAL_FRAC_BASIC
            for t in sorted((a for a in alive(allies) if hp[a] < maxhp[a]),
                            key=lambda a: hp[a] / maxhp[a])[:max(1, ntgt)]:
                h = min(int(maxhp[t] * frac), maxhp[t] - hp[t])
                if h > 0:
                    hp[t] += h
                    damages.append({"target": t, "dmg": -h, "dead": False})   # -dmg => +changeHp (heal)
        elif kind != "charge":                                                # attack / aoe -> damage
            immortal = enemies is winner_pos                                  # a hit on the protected side
            n = ntgt if kind == "aoe" else 1
            if immortal:                                # the loser spreads its chip onto the healthiest
                targets = sorted(alive(enemies), key=lambda p: -hp[p])[:n]
                per = per_hit
            else:                                       # the winner focus-fires the front-most loser unit
                dmg_mult = _AOE_MULT if kind == "aoe" else _SKILL_DMG_MULT
                targets = front_n(enemies, n)
                per = int(atk[pos] * dmg_mult) if casting else atk[pos]
            per = max(1, per)
            for t in targets:
                d = min(per, (hp[t] - 1) if immortal else hp[t])
                if d <= 0:
                    continue
                hp[t] -= d
                damages.append({"target": t, "dmg": d, "dead": (not immortal) and hp[t] <= 0})
        if not damages:
            if kind in ("heal", "charge"):    # a support with nothing to do: cosmetic self-swing
                damages = [{"target": pos, "dmg": 0, "dead": False}]
            else:                             # an attacker with no living enemy: don't swing at nothing
                return None, casting
        # Skill-bar (rage) change for THIS action, applied by the tree's ActorChangeHP node so it
        # animates AS the unit acts: a cast drains to 0, any other action fills +1 (capped). This is
        # the actor's own changeRage (Dto_FightActor field 5) — no round-end buffEffect, so the bar
        # drains exactly when the skill fires instead of a round late.
        rage_delta = -rage[pos] if casting else (1 if rage[pos] < RAGE_MAX else 0)
        rage[pos] += rage_delta
        return {"actor": pos, "skill": sid, "cast": casting, "rage": rage_delta,
                "damages": damages}, casting

    rounds = []
    for _ in range(max_rounds):
        if not alive(loser_pos):
            break
        actions = []
        # Left side acts first; STOP the moment the loser is wiped so no later unit swings at an empty
        # field (the "repeater attacks a target that just died" bug).
        for pos in alive(left_pos):
            if not alive(loser_pos):
                break
            a, _casting = act(pos, left_pos, right_pos)
            if a is not None:
                actions.append(a)
        # Right side retaliates (only those still alive, and only if the loser isn't already wiped).
        for pos in alive(right_pos):
            if not alive(loser_pos):
                break
            a, _casting = act(pos, right_pos, left_pos)
            if a is not None:
                actions.append(a)
        rounds.append((actions, []))
    # Fail-safe: healers can keep a survivor alive — finish any surviving loser with a winner attacker's
    # basic (a damage skill, safe for the death handling) so the replay always resolves to the outcome.
    survivors = alive(loser_pos)
    if survivors:
        killer = next((p for p in alive(winner_pos) if is_damager(p)), None)
        if killer:
            fk = [{"target": z, "dmg": hp[z], "dead": True} for z in survivors]
            for z in survivors:
                hp[z] = 0
            rounds.append(([{"actor": killer, "skill": skill1[killer], "cast": False, "rage": 0,
                             "damages": fk}], []))
    # Trailing buffer rounds (no actions) so the final unit's death fade finishes before battleEnd.
    for _ in range(_DEATH_FADE_BUFFER_ROUNDS):
        rounds.append(([], []))
    return rounds


def resolve_battle(left_units, right_units):
    """Decide the battle by effective Fighting Power (the game's own balance metric — enemy HP is even
    defined as power x 9 on the wiki). The team's power already folds in card levels + the Lab + World
    Tree deployed bonus (build_battle_units), so investment is exactly what tips a fight. Returns
    (won, left_power, right_power). BALANCED: the team wins at >= _WIN_POWER_RATIO of the enemy power."""
    left_power = sum(u.get("power", 0) for u in left_units)
    right_power = sum(u.get("power", 0) for u in right_units)
    if not left_units:
        return False, left_power, right_power       # no plants deployed -> can't win
    if right_power <= 0:
        return True, left_power, right_power
    won = left_power >= right_power * _WIN_POWER_RATIO
    return won, left_power, right_power


def encode_fight_replay(rounds):
    """Repeated Dto_FightRound (report field 4) from simulate_battle output (list of (actions, buffs)).
    Dto_FightRound{round(1), action(2)=[Dto_FightAction]}. Dto_FightAction{actor(1)=Dto_FightActor,
    damage(2)=[Dto_FightDamage], actionType(5)=Attack(0)}. Dto_FightActor{actorIndex(1),targetIndex(2),
    skillId(3),changeRage(5,int32)}. Dto_FightDamage{targetIndex(1),changeHp(2,int64),damageType(3),
    isDead(7)}. skillId picks basic vs cast; actor.changeRage = the unit's OWN skill-bar change, applied
    by the tree's ActorChangeHP node so the bar fills/drains AS the unit acts (drain on cast, +1 else).
    A damage's dmg>0 -> changeHp NEGATIVE (damage); dmg<0 -> POSITIVE (heal)."""
    d = b""
    for i, (actions, _buffs) in enumerate(rounds, 1):
        round_b = pb_varint_field(1, i)
        for a in actions:
            dmgs = a["damages"]
            primary = dmgs[0]["target"] if dmgs else a["actor"]
            rd = a.get("rage", 0)                                    # actor's own skill-bar change
            actor = (pb_varint_field(1, a["actor"]) + pb_varint_field(2, primary)
                     + pb_varint_field(3, a["skill"])                # skillId picks basic vs special
                     + (pb_varint_field(5, rd) if rd >= 0 else pb_int64_field(5, rd)))  # changeRage
            dmg_bytes = b""
            for dd in dmgs:      # dmg>0 -> changeHp NEGATIVE (damage); dmg<0 -> POSITIVE (heal)
                one = (pb_varint_field(1, dd["target"]) + pb_int64_field(2, -dd["dmg"])
                       + pb_varint_field(3, 1)                                # damageType Normal
                       + pb_bool(7, dd["dead"]))
                dmg_bytes += pb_tag(2, 2) + uvarint(len(one)) + one           # damage[] (repeated)
            action_b = (pb_tag(1, 2) + uvarint(len(actor)) + actor           # actor
                        + dmg_bytes                                          # damage[] (1..N targets)
                        + pb_varint_field(5, 0))                             # actionType = Attack
            round_b += pb_tag(2, 2) + uvarint(len(action_b)) + action_b       # action[]
        d += pb_tag(4, 2) + uvarint(len(round_b)) + round_b              # fightReplay[] (report field 4)
    return d


def encode_before_card_list(units):
    """Repeated Dto_FightCardInfo (field 2) bytes for one side, from build_battle_units dicts."""
    d = b""
    for u in units:
        power = u.get("power") or card_power({"atk": u.get("atk", 0), "def_": u.get("def_", 0),
                                              "hp": u.get("hp", 0)})
        card = build_fight_card(u["pos"], u["card_id"], u["hp"], u["level"], u["is_leader"], power=power)
        d += pb_tag(2, 2) + uvarint(len(card)) + card
    return d


def encode_left_card_lists(player, units, card_exp_gain):
    """Build the SELF side's beforeCardList (field 2) AND afterCardList (field 4). The result screen
    (FightResultWDMediator.update_res_bar) animates each plant's exp bar from before[i].exp/level to
    after[i].exp/level. before = the plant's CURRENT level + within-level exp; after = after adding
    `card_exp_gain` (capped by the account level). Same order both lists so the client pairs them."""
    acct = int(player.get("level", 1))
    before = after = b""
    for u in units:
        power = u.get("power") or card_power({"atk": u.get("atk", 0), "def_": u.get("def_", 0),
                                              "hp": u.get("hp", 0)})
        old_total = int(u.get("exp", 0))
        old_lv = int(u.get("level", 1))
        old_within = card_exp_within_level(old_total, old_lv)
        new_lv, new_total = card_level_from_exp(old_total + max(0, card_exp_gain), u["card_id"], acct)
        new_within = card_exp_within_level(new_total, new_lv)
        bc = build_fight_card(u["pos"], u["card_id"], u["hp"], old_lv, u["is_leader"],
                              power=power, exp=old_within)
        ac = build_fight_card(u["pos"], u["card_id"], u["hp"], new_lv, u["is_leader"],
                              power=power, exp=new_within)
        before += pb_tag(2, 2) + uvarint(len(bc)) + bc
        after += pb_tag(4, 2) + uvarint(len(ac)) + ac
    return before, after


def build_fight_report(player, chapter, mode, stage, won=True, reward_items=None, is_first=False,
                       left_units=None, right_units=None, replay_bytes=b"", card_exp_gain=0,
                       fight_type=1):
    """A Dto_FightReport that resolves to a WIN or a LOSS (`won`). left_units/right_units populate each
    side's beforeCardList (the plants/zombies on the field + result screen). replay_bytes = the encoded
    fightReplay (report field 4): non-empty -> the units play out the fight round-by-round; empty ->
    isOver() is true immediately. On a LOSS: result=Loss, winSide=Right (the client's isRoleWin() is then
    false, so FightChestsWDMedator routes to showLoseWD() instead of the win chest), and NO reward block.
    Dto_FightReport{result(1),leftSide(2),rightSide(3),fightReplay(4),fightType(5),winSide(7)}.
    Dto_FightSide{sideType(1),beforeCardList(2),reward(3),roleName(6),totalPower(7),roleLevel(8)}."""
    # fight_type = BattleTargetType (routing): 1=Fuben (adventure), 11=ScrewUp (Trial Road) — decides
    # which result window FightChestsWDMedator opens for this report.
    E_FIGHTRESULT_WIN, E_FIGHTRESULT_LOSS = 0, 1
    E_WINSIDE_LEFT, E_WINSIDE_RIGHT = 1, 2
    if not won:                                       # a loss grants nothing + no card XP
        reward_items, card_exp_gain = None, 0
    lvl = int(player.get("level", 1))
    # The win/result window (FightResultWDMediator) reads the self side's role-exp + card-exp;
    # nulls crash it. Dto_RoleAttr{oldRoleLevel(1),oldExpPercent(2),newRoleLevel(3),newExpPercent(4)}
    # (old==new -> no bar animation). Dto_CardExp{oldCardExp(1),oldExpBeanNum(2),expOverflow(3)}.
    role_attr = (pb_varint_field(1, lvl) + pb_varint_field(2, 0)
                 + pb_varint_field(3, lvl) + pb_varint_field(4, 0))
    card_exp = pb_varint_field(1, 0) + pb_varint_field(2, 0) + pb_varint_field(3, 0)
    # reward (field 3, repeated Dto_FightReward): the win chest reads getSelfSide().reward ->
    # rewardItem (Dto_ItemInfo{uid,id,num}). One Add block holds the whole stage's loot. Exp-type
    # items (2/5) are auto-hidden from the chest grid by the client; the rest show as icons.
    reward_block = b""
    if reward_items:
        items_b = b""
        for iid, num in reward_items:
            dto = build_item_dto(iid, num)
            items_b += pb_tag(4, 2) + uvarint(len(dto)) + dto           # rewardItem (field 4)
        fr = (pb_varint_field(1, 0)                                     # changeType = Add
              + pb_varint_field(2, 1 if is_first else 0)                # isFirstFullStar
              + items_b)
        reward_block = pb_tag(3, 2) + uvarint(len(fr)) + fr            # reward (field 3)
    # Real per-side totals so the result screen's 战斗力 matches the lineup + enemy preview (not a
    # placeholder 100). Each unit's power = its carried power, else derived from its scaled stats.
    def _side_power(units):
        return sum((u.get("power") or card_power({"atk": u.get("atk", 0), "def_": u.get("def_", 0),
                                                  "hp": u.get("hp", 0)})) for u in (units or []))
    left_power = _side_power(left_units)
    right_power = _side_power(right_units)
    # beforeCardList (field 2) + afterCardList (field 4): the result screen fills each plant's exp bar
    # from before -> after. card_exp_gain = the 植物经验 (Plant EXP) this level awards each plant.
    before_cards, after_cards = encode_left_card_lists(player, left_units or [], card_exp_gain)
    left = (pb_varint_field(1, 0)                       # sideType = Self
            + before_cards                              # beforeCardList (field 2)
            + reward_block                              # reward (field 3)
            + after_cards                               # afterCardList (field 4)
            + pb_varint_field(5, int(player.get("face_id") or 1))   # roleFaceId
            + pb_string(6, player.get("name", "Player"))   # roleName
            + pb_varint_field(7, left_power)            # totalPower
            + pb_varint_field(8, lvl)                   # roleLevel
            + pb_tag(9, 2) + uvarint(len(card_exp)) + card_exp    # cardExp
            + pb_tag(10, 2) + uvarint(len(role_attr)) + role_attr  # roleAttr
            + pb_string(13, "/image/head/%d.png" % int(player.get("face_id") or 1)))  # roleQQFaceURL ← 左边头像
    right = (pb_varint_field(1, mode or 1)              # sideType = Normal
             + encode_before_card_list(right_units or [])  # beforeCardList (field 2)
             + pb_varint_field(5, 0)                    # roleFaceId = 0
             + pb_string(6, "Zombies")                  # roleName
             + pb_varint_field(7, right_power)          # totalPower
            + pb_string(13, "http://127.0.0.1:8080/image/head/zombie.png"))  # roleQQFaceURL ← 指向僵尸图
    return (pb_varint_field(1, E_FIGHTRESULT_WIN if won else E_FIGHTRESULT_LOSS)    # result
            + pb_tag(2, 2) + uvarint(len(left)) + left                # leftSide
            + pb_tag(3, 2) + uvarint(len(right)) + right              # rightSide
            + replay_bytes                                            # fightReplay (field 4, repeated)
            + pb_varint_field(5, fight_type)                          # fightType -> routing
            + pb_varint_field(7, E_WINSIDE_LEFT if won else E_WINSIDE_RIGHT))   # winSide


def build_enemy_card(pos, card_id, hp, level=1, is_leader=False, power=0):
    """Dto_EnemyCardInfo{posIndex(1),cardId(2),level(3),isLeader(4),power(5),hp(7,U64),maxhp(8,U64)}.
    The pre-fight enemy preview reads these to SHOW + PRELOAD the zombie assets before the fight."""
    return (pb_varint_field(1, pos) + pb_varint_field(2, card_id) + pb_varint_field(3, level)
            + pb_varint_field(4, 1 if is_leader else 0) + pb_varint_field(5, power)
            + pb_varint_field(7, hp) + pb_varint_field(8, hp))


def handle_battle_getfightinfo(cmd_data, player):
    """Cmd_Battle_GetFightInfo_CS{target(1)=Dto_BattleTarget} -> Cmd_Battle_GetFightInfo_SC
    {formation(1), enemyCard(4)=[Dto_EnemyCardInfo], enemyTotalPower(5)}. preFight_PVE sends this
    to fetch the ENEMY lineup so it can preview + PRELOAD the zombie assets BEFORE the fight — without
    it enemyCards is empty, the zombies aren't preloaded, and the replay cold-loads them mid-fight and
    crashes on the first play. We return the SAME zombies build_battle_units puts in the report so the
    preload matches. (Player-side plant preload needs the card collection — separate/next.)"""
    tgt = parse_repeated_submessages(cmd_data, 1)
    chapter = mode = stage = 0
    if tgt:
        t = parse_varint_fields(tgt[0])
        chapter, mode, stage = t.get(2, 0), t.get(3, 0), t.get(4, 0)
    _left, right = build_battle_units(player, chapter, mode, stage)
    log.info("    battle fight-info (preload): chapter=%d mode=%d stage=%d -> %d enemy cards",
             chapter, mode, stage, len(right))
    # formation (field 1) = the player's OWN plants. The pre-fight preview preloads BOTH sides' unit
    # bone-animations from the fight info; without our own formation here only the ENEMY assets get
    # preloaded, so on first play the player's plants cold-load mid-spawn and UnitFactory.updateUnit
    # crashes (#1009) partway through -> only the first few plants spawn and the rest + all zombies never do.
    placements = default_formation_placements(player)
    formation = build_formation_info(player, 1, placements)
    d = pb_tag(1, 2) + uvarint(len(formation)) + formation  # formation (field 1) — preload our plants
    for u in right:
        ec = build_enemy_card(u["pos"], u["card_id"], u["hp"], u["level"], u["is_leader"],
                              power=u.get("power", 0))
        d += pb_tag(4, 2) + uvarint(len(ec)) + ec           # enemyCard (field 4, repeated)
    d += pb_varint_field(5, sum(u.get("power", 0) for u in right))   # enemyTotalPower (战力)
    return d


def handle_battle_fight(cmd_data, player):
    """Cmd_Battle_Fight_CS{target(1)=Dto_BattleTarget, isTryAgain(2)} -> Cmd_Battle_Fight_SC
    {report(1)=Dto_FightReport, type(2)}. Fuben target carries fubenChapterId(2)/fubenModeId(3)/
    fubenStageId(4). The outcome is decided by Fighting Power (resolve_battle): a WIN grants the loot +
    marks the stage cleared; a LOSS grants NOTHING, does NOT clear the stage, and the client shows a
    defeat screen the player can retry from. So Lab/World-Tree/card-level investment decides progress."""
    chapter = mode = stage = 0
    tgt = parse_repeated_submessages(cmd_data, 1)
    if tgt:
        t = parse_varint_fields(tgt[0])
        chapter, mode, stage = t.get(2, 0), t.get(3, 0), t.get(4, 0)
    uin = player["uin"]
    # Energy: the client already gates the fight on currEnergy >= energyCost, so spend it (win or lose —
    # you used stamina attempting). fuben.txt energyCost (5 for ch1). We sync the new value below.
    energy_cost = fuben_energy_cost(chapter, mode, stage) if (chapter and stage) else 0
    if energy_cost:
        consume_energy(player, energy_cost)
    # First clear? (bonusFirst is granted once.) Check BEFORE we record this win. The whole reward —
    # every-clear Plant EXP(5) + Coins(1) + first-clear TD Key(4001)/Town Prosperity(2)/plants/items —
    # comes straight from clientDB fuben.txt (fuben_stage_reward), so the granted amounts EXACTLY match
    # the level-select tooltip, for every chapter (not just hand-transcribed ch1).
    is_first = bool(chapter and stage) and stage not in store.get_fuben_passed(uin, chapter, mode)
    reward_items = list(fuben_stage_reward(chapter, mode, stage, is_first)) if (chapter and stage) else []
    # 植物经验 (item 5) is the plant/card XP: it's what each formation plant gains AND the amount the
    # result screen animates onto their bars, so both must read from the SAME reward (matches the tooltip).
    battle_exp = sum(num for iid, num in reward_items if iid == 5)
    # Real units: player's plants (left) vs stage zombies (right), placed on the field + result screen.
    left_units, right_units = build_battle_units(player, chapter, mode, stage)
    # Decide the outcome by effective Fighting Power, then animate the replay to match it.
    won, left_power, right_power = resolve_battle(left_units, right_units)
    rounds = simulate_battle(left_units, right_units, won) if (left_units and right_units) else []
    replay_bytes = encode_fight_replay(rounds)
    log.info("    battle: %d plants (%d 战力) vs %d zombies (%d 战力) -> %s, %d rounds (left=%s right=%s)",
             len(left_units), left_power, len(right_units), right_power, "WIN" if won else "LOSS",
             len(rounds), [(u["pos"], u["card_id"], u["name"]) for u in left_units],
             [(u["pos"], u["card_id"]) for u in right_units])
    report = build_fight_report(player, chapter, mode, stage, won, reward_items, is_first,
                                left_units, right_units, replay_bytes, card_exp_gain=battle_exp)
    fight_sc = (pb_tag(1, 2) + uvarint(len(report)) + report   # report (field 1)
                + pb_varint_field(2, 1))                        # type = Fuben (field 2)
    messages = [("PVZ.Cmd.Cmd_Battle_Fight_SC", fight_sc)]
    if energy_cost:
        messages.append(energy_sync_msg(player))   # HUD 体力 bar reflects the spend
    if not (chapter and stage):
        log.info("    BATTLE fight (fuben): chapter=%d mode=%d stage=%d (not saved)", chapter, mode, stage)
        return messages
    if not won:
        # A defeat: no clear, no rewards, no exp. The client shows the lose screen; retrying re-fights.
        # Earlier stages stay winnable, so the player grinds those for card/role XP, then comes back.
        log.info("    BATTLE LOSS: fuben chapter=%d mode=%d stage=%d (%d < %d*%.2f 战力) — no reward, retry",
                 chapter, mode, stage, left_power, right_power, _WIN_POWER_RATIO)
        return messages
    # A win: record it + tell the client (Cmd_Fuben_SyncStageInfo_SC): star>0 marks the stage cleared and
    # unlocks the next. Client caches it during battle, applies it on return.
    star = 3
    store.pass_fuben_stage(uin, chapter, mode, stage, star)
    si = (pb_varint_field(1, chapter) + pb_varint_field(2, mode)
          + pb_varint_field(3, stage) + pb_varint_field(4, star))   # Dto_Fuben_StageInfo
    sync = pb_tag(1, 2) + uvarint(len(si)) + si                     # stageinfo (field 1)
    messages.append(("PVZ.Cmd.Cmd_Fuben_SyncStageInfo_SC", sync))
    # Grant the loot server-side (currencies -> HUD sync, everything else -> bag) so the
    # win chest's display matches the player's real balances/bag.
    messages += grant_fuben_reward(player, reward_items)
    # 植物经验 (item 5, computed above) is CARD XP, not a bag item — feed it to each formation plant so
    # they level up (the client animates the SAME amount onto their bars). grant_fuben_reward skips item 5.
    messages += grant_battle_card_exp(player, battle_exp)
    # ROLE exp: every adventure stage clear levels the ACCOUNT too (first-clear full, replay
    # reduced), scaled by chapter -> unlocks town buildings by playing. Pushes SyncExp/SyncLevel
    # + live building unlocks on level-up.
    role_exp = role_exp_for_clear(chapter, is_first)
    messages += grant_role_exp(player, role_exp)
    log.info("    BATTLE WIN & SAVED: fuben chapter=%d mode=%d stage=%d star=%d first=%s "
             "reward=%s cardXP=%d roleXP=%d", chapter, mode, stage, star, is_first,
             reward_items, battle_exp, role_exp)
    return messages


def gate_template(stage, gate_id):
    """{'needStars': int, 'needItems': 'id:num;...'} for a gate, or {}."""
    global _GATE_TEMPLATES
    if _GATE_TEMPLATES is None:
        _GATE_TEMPLATES = {}
        rows = _read_clientdb_table("levelselectGateInfo.txt")
        if rows:
            hdr = rows[0]; ci = {c: i for i, c in enumerate(hdr)}

            def col(c, k, d=""):
                i = ci.get(k)
                return c[i] if i is not None and i < len(c) else d
            for c in rows[1:]:
                try:
                    key = (int(col(c, "stageId", "0")), int(col(c, "gateId", "0")))
                except ValueError:
                    continue
                _GATE_TEMPLATES[key] = {
                    "needStars": int(col(c, "needStars", "0") or 0),
                    "needItems": col(c, "needItems", ""),
                }
        log.info("loaded %d gate templates", len(_GATE_TEMPLATES))
    return _GATE_TEMPLATES.get((stage, gate_id), {})


# --- request-driven handlers: read the request, respond with real data -----------
def handle_td_request_tdinfo(cmd_data, player):
    """Cmd_TD_RequestTDInfo_CS -> Cmd_TD_RequestTDInfo_SC. Echo the requested level and
    hand back the player's plants as unlockPlantList so startTD can build the lawn."""
    f = parse_varint_fields(cmd_data)
    # Stage 0 is the client's real tutorial map (conf/td/map/0-1-1.bl). Do not
    # use `or 1` here: it converts the explicit tutorial request into stage 1
    # and silently sends the player to the normal TD flow.
    stage = f[1] if 1 in f else 1
    level = f[2] if 2 in f else 1
    sub = f[3] if 3 in f else 1
    chal = f.get(4, 0)
    log.info("    TD enter: stage=%d level=%d sub=%d plants=%s",
             stage, level, sub, player.get("plants", []))
    d = pb_varint_field(1, stage) + pb_varint_field(2, level) + pb_varint_field(3, sub)
    # Only real TD plants go in the lawn chooser — a non-TD (adventure-only) plant here #1009s
    # TDBasicChooseCard. player['plants'] is cleaned at login, but guard here too.
    for pid in player.get("plants", []):
        if pid not in valid_td_plants():
            continue
        pl = pb_varint_field(1, pid) + pb_varint_field(2, 0)   # Dto_PlantInfo{plantId, isNew}
        d += pb_tag(4, 2) + uvarint(len(pl)) + pl               # unlockPlantList (field 4)
    # field 6: talentIdList (repeated UINT32) — the player's studied Greenhouse talents.
    # TDLoadMediator copies this into TDGameInfo.talentList, then startBackToWarfield calls
    # TalentManager.createTalentEffect(id) for each, so the talents actually APPLY in the level.
    talents = store.get_talents(player["uin"])
    for tid in talents:
        d += pb_varint_field(6, tid)
    if talents:
        log.info("    TD talents applied: %s", talents)
    d += pb_varint_field(7, chal)                               # challengeLevelId
    return d


def handle_td_report_result(cmd_data, player):
    """Cmd_TD_ReportLevelResult_CS -> save the passed level + grant rewards, persist, reply.
    CS: stageId(1) levelId(2) subLevelId(3) passResult(4). SC: level echo + expReward(5)
    star(6) firstPassCoinReward(7) (must be !=0 on first pass for the client to advance)."""
    f = parse_varint_fields(cmd_data)
    stage, level, sub, pass_result = f.get(1, 0), f.get(2, 0), f.get(3, 1), f.get(4, 0)
    # field 5 = achievementList: the achievement ids the client says you earned this run.
    achievements = parse_repeated_varint(cmd_data, 5)
    uin = player["uin"]
    # The tutorial is the distinct stage 0 map. It is not normal TD progress, but
    # completing it is the authoritative hand-off from the new-player flow to town.
    if pass_result != 0 and stage == 0 and player.get("tutorial_active"):
        player["tutorial_active"] = 0
        player["td_stage"], player["td_level"], player["td_sub"] = 1, 1, 1
        store.save_player(uin, tutorial_active=0, td_stage=1, td_level=1, td_sub=1)
        log.info("    tutorial completed for uin=%d", uin)
    elif pass_result != 0 and stage > 0 and player.get("tutorial_active"):
        # Defensive repair: reaching and clearing any ordinary stage means the
        # tutorial has already handed control to the normal campaign.
        player["tutorial_active"] = 0
        store.save_player(uin, tutorial_active=0)
    if pass_result != 0 and stage and level:
        first = not store.is_level_passed(uin, stage, level, sub)
        store.pass_level(uin, stage, level, sub, achievements)
        # Real per-level rewards from clientDB: firstCoin + bonusExp (+ plant) on first clear,
        # bonusCoin on a repeat. Fall back to a small amount if the template is missing.
        rw = level_reward(stage, level, sub)
        # Role exp is server-computed (clientDB bonusExp is empty for ~all levels). Every clear
        # grants it — first clears full, replays reduced — so you keep leveling by playing.
        if first:
            coin_reward = rw.get("firstCoin") or 100
        else:
            coin_reward = rw.get("bonusCoin") or 0
        exp_reward = role_exp_for_clear(stage, first)
        new_stage = max(stage, player.get("td_stage", 1))
        new_level = max(level, player.get("td_level", 1)) if stage == player.get("td_stage", 1) else level
        player["coin"] += coin_reward
        player["exp"] += exp_reward
        player["td_stage"], player["td_level"] = new_stage, new_level
        # Apply role leveling: fold the gained exp into level-ups (exp becomes in-level progress).
        old_level = int(player.get("level", 1))
        leveled = normalize_level(player)
        store.save_player(uin, td_stage=new_stage, td_level=new_level, td_sub=sub,
                          coin=player["coin"], exp=player["exp"], level=player["level"])
        total = store.total_stars(uin, stage)   # star field is the running TOTAL, not the +3

        messages = []
        d = pb_varint_field(1, stage) + pb_varint_field(2, level) + pb_varint_field(3, sub)
        # field 6 `star` = the player's NEW TOTAL stage stars (client shows the delta vs its
        # cached total and updates the map HUD). Sending a constant 3 froze the HUD at 3.
        d += pb_varint_field(5, exp_reward) + pb_varint_field(6, total)  # expReward, totalStars
        d += pb_varint_field(7, coin_reward)                          # firstPassCoinReward
        messages.append(("PVZ.Cmd.Cmd_TD_ReportLevelResult_SC", d))

        # bonusItems (card fragments etc.) — granted every clear (farmable). Push an item
        # update so the bag reflects the new counts.
        gained_items = parse_bonus_items(rw.get("bonusItems", ""))
        if gained_items:
            upd = grant_items(player, gained_items)
            if upd:
                messages.append(upd)

        # First-clear plant unlock (bonusPlant): add to the save + push the sync so the client
        # adds it to the actor's unlockPlantList (actorModel.updateUnlockPlant).
        plant = rw.get("bonusPlant") if first else 0
        if plant:
            store.unlock_plant(uin, plant)
            if plant not in player.setdefault("plants", []):
                player["plants"].append(plant)
            dto = pb_varint_field(1, plant) + pb_varint_field(2, 1)   # Dto_PlantInfo{plantId, isNew=1}
            body = pb_tag(1, 2) + uvarint(len(dto)) + dto             # unlockPlant (field 1)
            messages.append(("PVZ.Cmd.Cmd_SyncUnlockPlant_SC", body))

        # Live HUD updates (the report handler doesn't apply coin/exp itself). On a level-up
        # push Cmd_SyncLevel_SC too (client updates actorLevel, shows the level-up, and
        # re-evaluates feature/town locks — the town opens at level 2).
        messages.append(("PVZ.Cmd.Cmd_SyncCoin_SC", pb_varint_field(1, player["coin"])))
        messages.append(("PVZ.Cmd.Cmd_SyncExp_SC", pb_varint_field(1, player["exp"])))
        if leveled:
            messages.append(("PVZ.Cmd.Cmd_SyncLevel_SC", pb_varint_field(1, player["level"])))
            # Reveal any buildings the new level unlocks, LIVE (no restart needed).
            messages += building_unlock_messages(old_level, player["level"])
        log.info("    LEVEL PASSED & SAVED: stage=%d level=%d sub=%d (first=%s) stars=%d %s"
                 " +%dcoin +%dexp%s%s -> coin=%d exp=%d lvl=%d%s totalStars=%d", stage, level, sub,
                 first, len(set(achievements)), sorted(set(achievements)), coin_reward, exp_reward,
                 (" +plant %d" % plant) if plant else "",
                 (" +items %s" % gained_items) if gained_items else "", player["coin"],
                 player["exp"], player["level"], " LEVEL UP!" if leveled else "", total)
        return messages
    log.info("    level result NOT saved: stage=%d level=%d passResult=%d", stage, level, pass_result)
    d = pb_varint_field(1, stage) + pb_varint_field(2, level) + pb_varint_field(3, sub)
    return [("PVZ.Cmd.Cmd_TD_ReportLevelResult_SC", d)]


def handle_td_getstageinfo(cmd_data, player):
    """Cmd_TD_GetStageInfo_CS -> Cmd_TD_GetStageInfo_SC.

    stageId (so the client builds the stage's levels) + levelInfoList of PASSED levels
    (unlocks the next) + gateList of UNLOCKED gates (field 3) + star = the stage's TOTAL
    star count (field 4, drives the map HUD star number and the gate needStars checks)."""
    f = parse_varint_fields(cmd_data)
    # Preserve an explicit stageId=0 for the new-player tutorial. For requests
    # without a stage id, continue to use the account's normal TD position.
    stage = f[1] if 1 in f else player.get("td_stage", 1)
    uin = player["uin"]
    passed = store.get_passed_levels(uin, stage)
    gates = store.get_unlocked_gates(uin, stage)
    total = store.total_stars(uin, stage)
    log.info("    TD stage info: stage=%d passed=%s gates=%s totalStars=%d",
             stage, passed, gates, total)
    d = pb_varint_field(1, stage)  # stageId
    for level, sub, star, ach in passed:
        li = pb_varint_field(1, level) + pb_varint_field(2, sub)  # Dto_TD_LevelInfo{levelId, subLevelId}
        # starsGot = achievementList.length -> send the ACTUAL earned achievement ids.
        for a in ach:
            li += pb_varint_field(3, a)                           # achievementList (repeated)
        d += pb_tag(2, 2) + uvarint(len(li)) + li                 # levelInfoList (field 2)
    for gid in gates:
        d += pb_varint_field(3, gid)          # gateList (field 3, repeated uint) — unlocked gates
    d += pb_varint_field(4, total)            # star (field 4) — total stage stars for the HUD
    return d


def handle_card_rawattribute(cmd_data, player):
    """Cmd_Card_RawAttribute_CS -> Cmd_Card_RawAttribute_SC.

    The plant almanac (图鉴) asks for the full stats of EVERY plant card in one batch
    (allCard = repeated Dto_CardIdLevel{baseId, level}). It expects one Dto_CardFullInfo
    back per requested card to fill its display cache. An empty allCardInfo leaves that
    cache empty, so the almanac re-fires the whole batch every frame -> flood + freeze.
    We return the card's REAL stats from battleCard.txt (baseId = cardId) so the almanac shows
    true attack/defense/hp/power instead of placeholders."""
    load_battle_cards()
    cards = parse_repeated_submessages(cmd_data, 1)  # repeated Dto_CardIdLevel
    out = b""
    n = 0
    for raw in cards:
        f = parse_varint_fields(raw)
        base_id = f.get(1, 0)
        level = f.get(2, 1)
        if not base_id:
            continue
        known = base_id in _BATTLE_CARDS
        st = card_stats_at_level(base_id, level) if known else None  # almanac shows stats at that level
        # Dto_CardBaseInfo: uid(1,Int64), cardId(2), exp(3), level(4), quality(10). A non-null uid
        # keeps the uid-keyed lookups in CardItemVO (isEmbattle/teamId) from dereferencing null.
        base = (pb_int64_field(1, base_id)       # uid (Int64) — reuse baseId, unique+nonzero
                + pb_varint_field(2, base_id)    # cardId -> looks up the plant template
                + pb_varint_field(4, level)      # level
                + pb_varint_field(10, st["quality"] if st else 1))   # quality (rarity colour)
        # Dto_CardFullInfo: base(1) + REAL scalar stats (from battleCard.txt). hp(5)/shield(6) are
        # UInt64 objects that null-crash when a tooltip calls .toNumber(), so always set them present.
        if st:
            info = (pb_tag(1, 2) + uvarint(len(base)) + base
                    + pb_varint_field(2, card_power(st))    # power
                    + pb_varint_field(3, st["atk"])         # attack
                    + pb_varint_field(4, st["def_"])        # defense
                    + pb_varint_field(5, st["hp"])          # hp   (UInt64)
                    + pb_varint_field(6, 0)                 # shield (UInt64)
                    + pb_varint_field(7, st["ability"])     # ability
                    + pb_float_field(8, st.get("hit", 0))
                    + pb_float_field(9, st.get("dodge", 0))
                    + pb_float_field(10, st.get("critical", 0))
                    + pb_float_field(11, st.get("tough", 0)))
        else:
            info = (pb_tag(1, 2) + uvarint(len(base)) + base
                    + pb_varint_field(2, 0) + pb_varint_field(3, 0) + pb_varint_field(4, 0)
                    + pb_varint_field(5, 0) + pb_varint_field(6, 0) + pb_varint_field(7, 0)
                    + pb_float_field(8, 0) + pb_float_field(9, 0)
                    + pb_float_field(10, 0) + pb_float_field(11, 0))
        out += pb_tag(1, 2) + uvarint(len(info)) + info  # allCardInfo (field 1)
        n += 1
    log.info("    almanac raw-attr: %d cards requested -> %d returned (real stats)", len(cards), n)
    return out


def handle_unlock_gate(cmd_data, player):
    """Cmd_TD_UnlockLevelGate_CS -> Cmd_TD_UnlockLevelGate_SC. The player clicked a locked
    map gate; the client already checked the star/item requirement (checkUnlockable) before
    sending, so we record the gate as unlocked and reply. The SC's `star` is the (unchanged)
    total — gates are a star THRESHOLD, not a cost. onCmd_TD_UnlockLevelGate_SC then flips the
    gate + the level behind it to unlocked and re-syncs the HUD."""
    f = parse_varint_fields(cmd_data)
    stage, gate_id = f.get(1, 0), f.get(2, 0)
    uin = player["uin"]
    store.unlock_gate(uin, stage, gate_id)
    total = store.total_stars(uin, stage)
    messages = [("PVZ.Cmd.Cmd_TD_UnlockLevelGate_SC",
                 pb_varint_field(1, stage) + pb_varint_field(2, gate_id)
                 + pb_varint_field(3, total))]   # stageId, gateId, star(total)
    # Item-gates cost keys/items (e.g. 4001:10). The client already verified the player has
    # them before sending; deduct here and sync the new bag counts.
    need = parse_bonus_items(gate_template(stage, gate_id).get("needItems", ""))
    if need:
        upd = grant_items(player, [(iid, -n) for iid, n in need])
        if upd:
            messages.append(upd)
    log.info("    GATE UNLOCKED & SAVED: stage=%d gate=%d (totalStars=%d, spent %s)",
             stage, gate_id, total, need or "no items")
    return messages


def handle_friend_getlist(cmd_data, player):
    """Cmd_Friend_GetList_CS -> Cmd_Friend_GetList_SC.

    The choose-seeds flow, after you confirm your own plants, loads the 'friend plant
    card' screen (TDChooseCardPanelMediator -> loadFriendCardInfo). Its response handler
    TDProxy.onCmd_TD_RequestFriendCard_SC EARLY-RETURNS unless moduleType matches the
    request, and only past that check does it call enterChooseFriendCardScreen() +
    unlockScreen(). An empty SC has moduleType=0 -> the handler bails -> the screen never
    unlocks -> the level freezes. Echo moduleType/friendType/page/pageSize back with an
    empty friends list (you have no friends yet) and totalCount=0 so it proceeds.

    With GM-added friends (store.get_friends), each friend is sent as a Dto_FriendInfo
    carrying a helpPlant (Dto_CardFullInfo built from the friend's plant_id+level) so the
    TD choose-seeds screen shows the friend-card chooser, and a diamond (Dto_DiamondInfo)
    so each friend's 钻石卡 shows in the friend list / world map."""
    f = parse_varint_fields(cmd_data)
    module_type = f.get(1, 0)
    friend_type = f.get(2, 0)
    page = f.get(3, 0)
    page_size = f.get(4) or 8   # non-zero so Math.ceil(totalCount/pageSize) isn't NaN
    friends = store.get_friends(player["uin"])
    d = (pb_varint_field(1, module_type) + pb_varint_field(2, friend_type)
         + pb_varint_field(3, page) + pb_varint_field(4, page_size)
         + pb_varint_field(5, len(friends)))              # totalCount
    for idx, fr in enumerate(friends, start=1):
        dto = build_friend_info_dto(fr, idx)
        d += pb_tag(7, 2) + uvarint(len(dto)) + dto
    log.info("    friend list: moduleType=%d friendType=%d page=%d -> %d friend(s)",
             module_type, friend_type, page, len(friends))
    return d


# --- Dto_DiamondInfo (钻石卡 / QQ 蓝钻) --------------------------------------
# E_DiamondType (Assets/src/PVZ/Cmd/E_DiamondType.as): Blue=1, Yellow=3, XinYue=4.
_DIAMOND_TYPES = (1, 3, 4)


def build_diamond_info(flag, blue_lvl, yellow_lvl, xinyue_lvl):
    """Dto_DiamondInfo{flag(1), diamondLevel(2)=[Dto_DiamondLevel{type(1), level(2)}]}.
    A 0 level omits that diamond entirely (the client reads an absent entry as 'not granted')."""
    levels = {1: blue_lvl, 3: yellow_lvl, 4: xinyue_lvl}
    d = pb_varint_field(1, int(flag))                      # flag (1 = show the card)
    for t in _DIAMOND_TYPES:
        lv = int(levels.get(t, 0) or 0)
        if lv > 0:
            sub = pb_varint_field(1, t) + pb_varint_field(2, lv)   # type, level
            d += pb_tag(2, 2) + uvarint(len(sub)) + sub
    return d


def build_player_diamond(player):
    """The player's OWN Dto_DiamondInfo (read from the save's diamond_* columns)."""
    return build_diamond_info(player.get("diamond_flag", 1),
                              player.get("diamond_blue_lvl", 0),
                              player.get("diamond_yellow_lvl", 0),
                              player.get("diamond_xinyue_lvl", 0))


def build_friend_diamond(fr):
    """A friend's Dto_DiamondInfo (read from the friend row's diamond_* columns)."""
    return build_diamond_info(fr.get("diamond_flag", 1),
                              fr.get("diamond_blue_lvl", 0),
                              fr.get("diamond_yellow_lvl", 0),
                              fr.get("diamond_xinyue_lvl", 0))


def build_friend_info_dto(fr, index=1):
    """Dto_FriendInfo{type(1), roleId(2,I64), zoneId(3), name(4), faceId(5), rank(6),
    roleLevel(7), plantInfo(8), passTDNum(9), status(10), helpPlant(11)=Dto_CardFullInfo,
    isFree(13), diamond(15)=Dto_DiamondInfo, isQQFriend(16), qqName(17)}.

    helpPlant is built from the friend row's help_plant_id (a tdPlantId) via td_plant_to_card;
    if unmapped we still send a minimal card so the friend-card slot stays non-null (the client
    null-derefs otherwise). diamond is the friend's 钻石卡 from the friend row."""
    role_id = int(fr["friend_role_id"])
    name = fr.get("friend_name") or ("Player%d" % (role_id % 100000))
    plant_id = int(fr.get("help_plant_id") or 0)
    plant_level = int(fr.get("help_plant_level") or 1)
    # helpPlant (Dto_CardFullInfo): use the TD plant's base battle card + level-1 stats if mapped.
    cid, _stats = td_plant_to_card(plant_id) if plant_id else (None, None)
    if cid:
        st = card_stats_at_level(cid, plant_level)
        help_plant = build_card_full_info(role_id, cid, plant_level, st)
    else:
        # No card mapping — still send a placeholder Dto_CardFullInfo so the field is non-null.
        help_plant = build_card_full_info(role_id, 0, 1, {"hp": 1, "atk": 0, "def_": 0,
                                                          "ability": 0, "quality": 1})
    diamond = build_friend_diamond(fr)
    avatar_id = ((index - 1) % 2) + 1
    plant_info = (
        pb_varint_field(1, plant_id)         # plantId
        + pb_varint_field(2, 0)              # isNew = false
        + pb_varint_field(3, avatar_id)      # avatarId ← 新增，客户端读这个
        + pb_varint_field(4, 0)              # strengthLevel = 0
    )   # Dto_PlantInfo{plantId, isNew}
    return (pb_varint_field(1, 1)                          # type = 1 (FRIEND_TYPE_SNS)
            + pb_int64_field(2, role_id)                  # roleId
            + pb_varint_field(3, 0)                       # zoneId
            + pb_string(4, name)                          # name
            + pb_varint_field(5, (int(role_id) % 3) + 1)   # faceId: 1/2/3 轮换，让好友头像不全是 unknow
            + pb_varint_field(6, 0)                       # rank
            + pb_varint_field(7, plant_level)             # roleLevel (cosmetic)
            + pb_tag(8, 2) + uvarint(len(plant_info)) + plant_info    # plantInfo
            + pb_varint_field(9, 0)                       # passTDNum
            + pb_varint_field(10, 3)                      # status = E_FriendStatus_Friend
            + pb_tag(11, 2) + uvarint(len(help_plant)) + help_plant  # helpPlant (Dto_CardFullInfo)
            + pb_bool(13, True)                           # isFree (free to borrow)
            + pb_tag(15, 2) + uvarint(len(diamond)) + diamond        # diamond (Dto_DiamondInfo)
            + pb_bool(16, False)                          # isQQFriend
            + pb_string(17, name)                        # qqName
            + pb_string(14, "http://127.0.0.1:8080/image/head/%d.png" % index))   # qqFaceURL 放最后


# --- TD privilege (塔防特权) --------------------------------------------------
_TD_PRIV_ENDTIME = 4102444800     # 2100-01-01 UTC — far future, so the privilege never reads as expired


def td_privilege_active(player):
    """True if the player's TD privilege is currently on (and not expired)."""
    if not int(player.get("td_privilege") or 0):
        return False
    end = int(player.get("td_privilege_endtime") or 0)
    return end == 0 or end > int(time.time())


_DIAMOND_CARD_TD_PLANTS = (
    3900,  # Fire Snapdragon / 火龙草
    4100,  # Spikeweed / 地刺
    4200,  # Spikerock / 地刺王
    4500,  # Threepeater / 三发豌豆
    4600,  # Coconut Cannon / 椰子加农炮
    6300,  # Laser Bean / 激光豆子
    6400,  # Citron / 充能柚子
    6500,  # Infi-nut / 全息坚果
    6600,  # Prism Grass / 棱镜草
)


def td_privilege_plants(player):
    """The fixed plantId list supplied by the Diamond Card TD privilege.

    This entitlement is separate from the player's owned plants: synchronizing the
    account roster here exposes every earned plant through the Diamond Card.
    """
    return _DIAMOND_CARD_TD_PLANTS


def build_td_open_privilege_sc(player):
    """Cmd_TD_OpenPrivilege_SC{hasPrivilege(1), remainTime(2)} — the login push that tells the
    client the TD privilege is active. remainTime = seconds remaining (far-future when on)."""
    if not td_privilege_active(player):
        return pb_bool(1, False) + pb_varint_field(2, 0)
    end = int(player.get("td_privilege_endtime") or 0) or _TD_PRIV_ENDTIME
    remain = max(0, end - int(time.time()))
    return pb_bool(1, True) + pb_varint_field(2, remain)


def handle_td_privilege_info(cmd_data, player):
    """Cmd_TD_PrivilegeInfo_CS{stageId(1), levelId(2), subLevelId(3), challengeLevelId(4)} ->
    Cmd_TD_PrivilegeInfo_SC{stageId(1), levelId(2), subLevelId(3), hasPrivilege(4),
    plantId(5)=[...], remainTime(6), challengeLevelId(7)}. Sent on entry to a TD level — the
    client unlocks the listed plants for that level when hasPrivilege=true."""
    f = parse_varint_fields(cmd_data)
    stage = f.get(1, 0); level = f.get(2, 0); sub = f.get(3, 0); chl = f.get(4, 0)
    active = td_privilege_active(player)
    end = int(player.get("td_privilege_endtime") or 0) or _TD_PRIV_ENDTIME
    remain = max(0, end - int(time.time())) if active else 0
    d = (pb_varint_field(1, stage) + pb_varint_field(2, level) + pb_varint_field(3, sub)
         + pb_bool(4, active))
    for pid in td_privilege_plants(player):
        d += pb_varint_field(5, pid)                      # plantId (repeated)
    d += pb_varint_field(6, remain)                       # remainTime
    d += pb_varint_field(7, chl)                          # challengeLevelId
    log.info("    TD privilege info: stage=%d-%d-%d hasPrivilege=%s plants=%d",
             stage, level, sub, active, len(td_privilege_plants(player)))
    return d


def td_privilege_login_messages(player):
    """Pushed right after Cmd_Init_SC when the player's TD privilege is on: the
    Cmd_TD_OpenPrivilege_SC notification populates the client's TD-privilege state for every
    TD activity (Daily / Endless / SnowMan / per-level query) at once."""
    if not td_privilege_active(player):
        return []
    return [("PVZ.Cmd.Cmd_TD_OpenPrivilege_SC", build_td_open_privilege_sc(player))]


def build_vip_syncvipinfo_sc(player):
    """Cmd_Vip_SyncVipInfo_SC{diamond(1)=Dto_DiamondInfo} — the player's OWN diamond card.
    ModuleBlueDiamond.swf listens for this and renders the 钻石卡 UI from it."""
    return pb_tag(1, 2) + uvarint(len(build_player_diamond(player))) + build_player_diamond(player)


def diamond_login_messages(player):
    """Push the player's own diamond card right after Cmd_Init_SC so ModuleBlueDiamond has its
    state from the very start. Always sent (even all-zero) so a previously-shown card clears
    when the GM turns it off."""
    return [("PVZ.Cmd.Cmd_Vip_SyncVipInfo_SC", build_vip_syncvipinfo_sc(player))]


# --- Daily Sign-in (Welfare Hall "签到" tab) ----------------------------------
# The sign-in tab is a monthly reward calendar: one claimable cell per day. The reward
# list is server-defined (no clientDB table backs it), so we fabricate a sensible
# escalating calendar. Rewards are granted FOR REAL via grant_fuben_reward (same
# currency/bag routing as fuben loot) — the client only animates the item-fly.
# Dto_Reward_Info{date=day#, itemId, itemNum, vipLevel}; vipLevel=0 => no VIP doubling.
# Item ids route through _CURRENCY_SYNC/bag: 1=coin 3=sun 4=gift diamond,
# 2002/2003/2004=exp beans, 4001=TD key.  30 entries = a full month calendar.
_SIGN_IN_REWARDS = [
    (1, 2000, 0),  (3, 20, 0),    (2002, 2, 0),  (1, 3000, 0),  (4001, 1, 0),
    (3, 30, 0),    (4, 5, 0),     (1, 4000, 0),  (2003, 1, 0),  (1, 5000, 0),
    (3, 40, 0),    (4001, 2, 0),  (1, 5000, 0),  (4, 10, 0),    (2003, 2, 0),
    (1, 6000, 0),  (3, 50, 0),    (4001, 2, 0),  (1, 6000, 0),  (2004, 1, 0),
    (4, 15, 0),    (1, 8000, 0),  (3, 60, 0),    (4001, 3, 0),  (1, 8000, 0),
    (2003, 3, 0),  (3, 60, 0),    (4, 20, 0),    (1, 10000, 0), (2004, 2, 0),
]


def _sign_today():
    t = time.localtime()
    return t.tm_year * 10000 + t.tm_mon * 100 + t.tm_mday


def _sign_month():
    t = time.localtime()
    return t.tm_year * 100 + t.tm_mon


def _signin_rollover(player):
    """Reset the month's sign count when the calendar month changes; persist."""
    m = _sign_month()
    if int(player.get("sign_month") or 0) != m:
        player["sign_month"] = m
        player["sign_total"] = 0
        store.save_player(player["uin"], sign_month=m, sign_total=0)


def _encode_signin_info(total, signed_today, remain=0, used_free=0, used_vip=0):
    """Dto_SignIn_Info{totalSignNum(1), remainSignNum(2), usedfreeTimes(3),
    usedVipFreeTimes(4), bIsSigned(5)}."""
    return (pb_varint_field(1, total) + pb_varint_field(2, remain)
            + pb_varint_field(3, used_free) + pb_varint_field(4, used_vip)
            + pb_bool(5, signed_today))


def handle_signin_getrewardlist(cmd_data, player):
    """Cmd_SignIn_GetRewardList_CS -> the monthly reward calendar (per-day rewards)."""
    d = b""
    for day, (iid, num, vip) in enumerate(_SIGN_IN_REWARDS, start=1):
        dto = (pb_varint_field(1, day) + pb_varint_field(2, iid)
               + pb_varint_field(3, num) + pb_varint_field(4, vip))
        d += pb_tag(1, 2) + uvarint(len(dto)) + dto      # rewardList (repeated Dto_Reward_Info)
    return d


def handle_signin_getinfo(cmd_data, player):
    """Cmd_SignIn_GetInfo_CS -> the player's current sign-in state (days signed, signed-today)."""
    _signin_rollover(player)
    total = int(player.get("sign_total") or 0)
    signed = int(player.get("sign_last") or 0) == _sign_today()
    info = _encode_signin_info(total, signed)
    return pb_tag(1, 2) + uvarint(len(info)) + info      # signInInfo (field 1, Dto_SignIn_Info)


def handle_signin_setinfo(cmd_data, player):
    """Cmd_SignIn_SetInfo_CS (doSignIn) -> claim today's sign-in: bump the day count, grant
    that day's reward, persist, reply with the updated info. Idempotent per calendar day
    (a second sign-in the same day just re-sends state, no double grant). The client flies
    rewardList[total-1] == the same item we grant here."""
    _signin_rollover(player)
    today = _sign_today()
    uin = player["uin"]
    if int(player.get("sign_last") or 0) == today:
        total = int(player.get("sign_total") or 0)
        log.info("    sign-in: uin=%s already signed today (day %d)", uin, total)
        info = _encode_signin_info(total, True)
        return pb_tag(1, 2) + uvarint(len(info)) + info
    total = min(int(player.get("sign_total") or 0) + 1, len(_SIGN_IN_REWARDS))
    player["sign_total"] = total
    player["sign_last"] = today
    store.save_player(uin, sign_total=total, sign_last=today, sign_month=_sign_month())
    iid, num, vip = _SIGN_IN_REWARDS[total - 1]
    log.info("    sign-in: uin=%s -> day %d, reward item %d x%d", uin, total, iid, num)
    grant_msgs = grant_fuben_reward(player, [(iid, num)])   # actually grants (coin/bag) + syncs
    info = _encode_signin_info(total, True)
    body = pb_tag(1, 2) + uvarint(len(info)) + info
    return [("PVZ.Cmd.Cmd_SignIn_SetInfo_SC", body)] + grant_msgs


# --- FlexibleActivity list (limited-time events framework) --------------------
# The Welfare Hall's "Daily Activity" tab loads ModuleDodgeAndCat, whose
# DodgeAndCatService.initActivity() does getGroupByViewType(v)[0] (NO null check) for
# view types DODGE(2)/CAT(3)/CARD_PLANT_ARMOR(62)/CARD_FRUIT_ADV(63). On an empty
# activity list that throws #1125 "index 0 out of range 0", which aborts the whole
# Welfare Hall window (registerPanel) — so the sign-in tab is unreachable. Fix: feed one
# minimal activity per needed view type so those [0] lookups resolve. viewType ==
# Dto_FlexibleActivityCommon.activityPanelId (field 4); the client requests this list at
# login (InitActivityTask) so m_vecActivity is populated before the window ever opens.
# Activities carry no icon (iconId=0) / no time window, so they add no HUD icon and stay
# inert (a closed event). Add more view types here if other event modules #1125 the same way.
_FLEX_ACTIVITY_VIEWTYPES = [2, 3, 62, 63]   # DODGE, CAT, CARD_PLANT_ARMOR, CARD_FRUIT_ADV


def _activity_fuben_limit(activity_id):
    """Encode the legacy activity-fuben limit used by DodgeAndCatService.

    The level list itself is client data (hdfuben.txt).  The server still has to identify the
    activity as FlexibleActivity type 1 and provide the six stage ids; without this payload the
    client opens ActFubenWindow with an empty `fuben` vector, which is the blank panel users see.
    Activity 1 is catch-thief (1..6), activity 2 is protect-farm (7..12),
    activity 3 is the armor/alloy mine (18..22), and activity 4 is the fruit
    deep-sea dungeon (13..17; its rewards are energy stones).
    """
    stage_ids = {
        1: range(1, 7),       # 捉小偷
        2: range(7, 13),      # 护农田
        3: range(18, 23),     # 植物装甲 / 合金矿场
        4: range(13, 18),     # 果实 / 深渊海域（能量石）
    }
    ids = list(stage_ids.get(int(activity_id), ()))
    if not ids:
        return b""
    limit = (pb_varint_field(3, 6) + pb_varint_field(4, 6)
             + pb_varint_field(5, 0) + b"".join(pb_varint_field(6, i) for i in ids)
             + pb_varint_field(7, 0))
    # FlexibleActivity_1{activityId(1), limit(2)=Dto_FlexibleActivityLimitFuben}.
    nested = (pb_varint_field(1, int(activity_id))
              + pb_tag(2, 2) + uvarint(len(limit)) + limit)
    return nested


def _activity_common(activity_id, panel_id):
    nested = _activity_fuben_limit(activity_id)
    # Dto_FlexibleActivityCommon: activityType=1 selects FlexibleActivity_1; serverParams is the
    # serialized FlexibleActivity_1 payload. The fuben ids and daily limit live in that payload.
    # Explicitly bound the event lifetime too: the Flash ActivityProxy filters expired/unbounded
    # records before DodgeAndCatService builds its tab's stage list.
    now = int(time.time())
    dto = (pb_varint_field(1, int(activity_id)) + pb_varint_field(2, 1)
           + pb_varint_field(4, int(panel_id))
           + pb_varint_field(5, max(1, now - 86400))
           + pb_varint_field(6, 2145916800)  # 2038-01-01 UTC; within protobuf uint32
           + pb_bytes(10, nested))
    return pb_tag(1, 2) + uvarint(len(dto)) + dto


def handle_flexactivity_getlist(cmd_data, player):
    """Cmd_FlexibleActivity_GetActivityList_CS -> a minimal activity list whose entries
    cover the view types the event services index [0] of, so the town/Welfare Hall don't
    #1125. Dto_FlexibleActivityCommon{activityId(1), activityPanelId(4)=viewType}."""
    d = (_activity_common(1, 2) + _activity_common(2, 3)
         + _activity_common(3, 62) + _activity_common(4, 63))
    return d


def handle_flexactivity_getstat(cmd_data, player):
    """Cmd_FlexibleActivity_GetActivityStat_CS -> FlexibleActivity_1.

    DodgeAndCatService requests the per-activity stat after the activity list arrives. Its
    ActivityProxy parses FlexibleActivity_1.limit into ActivityModuleInfo.openList; without this
    response openList remains null and ActFubenWindowMediator.refreshList crashes with #1009.
    """
    activity_id = parse_varint_fields(cmd_data).get(1, 0)
    response = _activity_fuben_limit(activity_id)
    if not response:
        log.warning("    activity stat: unsupported activity id=%d", activity_id)
        return []
    log.info("    activity stat: activity=%d -> hdfubenIds=%s", activity_id,
             [fid for fid in range(1, 23) if _activity_id_for_fuben(fid) == activity_id])
    return [("PVZ.Cmd.FlexibleActivity_1", response)]


def _activity_id_for_fuben(fuben_id):
    """Translate the authoritative hdfuben id ranges to their FlexibleActivity panel."""
    fuben_id = int(fuben_id)
    if 1 <= fuben_id <= 6:
        return 1
    if 7 <= fuben_id <= 12:
        return 2
    if 13 <= fuben_id <= 17:
        return 4
    if 18 <= fuben_id <= 22:
        return 3
    return 0


def _activity_enemy_units(fuben_id):
    """Build an activity lineup from the faction assigned to this hdfuben id.

    hdfuben.txt groups the stages as 1-6 (thief), 7-12 (cart peddler),
    13-17 (sea/Dragon Palace), and 18-22 (Future World/alloy mine). The
    table's headIcon and battleMapId confirm the last two groups' worlds.
    11-15 are only five star variants of the same thief card, not five
    different zombies; the old implementation made every event look like
    the thief event regardless of its map.
    """
    load_battle_cards()
    try:
        fuben_id = int(fuben_id)
    except (TypeError, ValueError):
        fuben_id = 1

    if 1 <= fuben_id <= 6:
        stage, roster = fuben_id, [11]
    elif 7 <= fuben_id <= 12:
        stage, roster = fuben_id - 6, [381, 389]  # 推车小贩 / 推车小贩首领
    elif 13 <= fuben_id <= 17:
        # hdfuben headIcon=809 is 海马僵尸首领 and map 190011 is the sea dungeon.
        stage, roster = fuben_id - 12, [771, 781, 791, 801, 817, 818, 820, 841, 851, 861, 871, 881, 891]
    elif 18 <= fuben_id <= 22:
        # hdfuben headIcon=1041 is 机甲路障僵尸首领 and map 290011 is Future World.
        stage, roster = fuben_id - 17, [250, 252, 200, 202, 201, 204, 206, 207, 254]
    else:
        # Keep unknown/legacy ids safe and visibly distinct from the other factions.
        stage, roster = max(1, min(6, fuben_id)), [11]

    # Progressively introduce more enemy slots as the activity difficulty rises.
    count = min(len(_ENEMY_POS), 2 + (stage - 1) // 2)
    cards = [roster[i % len(roster)] for i in range(count)]
    cards = [cid if cid in _BATTLE_CARDS else roster[0] for cid in cards]
    units = []
    for pos, cid in zip(_ENEMY_POS, cards):
        st = card_stats_at_level(cid, max(1, stage)) or _BATTLE_CARDS.get(cid, {})
        power = card_power(st)
        units.append({"pos": pos, "card_id": cid, "hp": max(1, int(st.get("hp", 1000))),
                      "maxhp": max(1, int(st.get("hp", 1000))), "atk": max(1, int(st.get("atk", 1))),
                      "def_": int(st.get("def_", 0)), "skill1": int(st.get("skill1", 0)),
                      "skill2": int(st.get("skill2", 0)), "level": stage,
                      "is_leader": pos == _ENEMY_POS[0], "name": st.get("name", "小偷僵尸"),
                      "power": power})
    return units


def handle_activity_getformation(cmd_data, player):
    ensure_player_cards(player)
    formation = build_formation_info(player, 1, default_formation_placements(player))
    return pb_tag(1, 2) + uvarint(len(formation)) + formation


def handle_activity_setformation(cmd_data, player):
    # Activity formation uses the same team as the normal battle lineup.  Echoing it is important:
    # the activity window waits for this SC before enabling its challenge button.
    return [("PVZ.Cmd.Cmd_Battle_GetActivityFubenFormation_SC",
             handle_activity_getformation(cmd_data, player))]


def handle_activity_getfightinfo(cmd_data, player):
    fuben_id = parse_varint_fields(cmd_data).get(1, 1)
    formation = build_formation_info(player, 1, default_formation_placements(player))
    d = pb_tag(1, 2) + uvarint(len(formation)) + formation
    enemies = _activity_enemy_units(fuben_id)
    for unit in enemies:
        ec = build_enemy_card(unit["pos"], unit["card_id"], unit["hp"], unit["level"],
                              unit["is_leader"], unit["power"])
        d += pb_tag(4, 2) + uvarint(len(ec)) + ec
    return d + pb_varint_field(5, sum(u["power"] for u in enemies))


_HDFUBEN_CONFIG = None


def load_hdfuben_config():
    """Read the activity fight/reward setup directly from hdfuben.txt."""
    global _HDFUBEN_CONFIG
    if _HDFUBEN_CONFIG is None:
        _HDFUBEN_CONFIG = {}
        rows = _read_clientdb_table("hdfuben.txt")
        if rows:
            hdr = rows[0]; ci = {c: i for i, c in enumerate(hdr)}
            for row in rows[1:]:
                try:
                    fid = int(row[ci["id"]])
                    _HDFUBEN_CONFIG[fid] = {
                        "level": int(row[ci["level"]]),
                        "headIcon": int(row[ci["headIcon"]]),
                        "bonusRequired": row[ci["bonusRequired"]],
                        "bonusOptional": row[ci["bonusOptional"]],
                        "battleMapId": int(row[ci["battleMapId"]]),
                    }
                except (KeyError, IndexError, TypeError, ValueError):
                    continue
        log.info("loaded %d activity-fuben templates", len(_HDFUBEN_CONFIG))
    return _HDFUBEN_CONFIG


def _activity_fuben_rewards(fuben_id):
    """Return guaranteed activity rewards and enabled bonusOptional items.

    In hdfuben.txt the third component is an enable flag (1=drop this item), unlike
    the regular fuben.txt table where the third component is a 0..10000 probability.
    """
    config = load_hdfuben_config().get(int(fuben_id))
    if not config:
        stage = max(0, min(5, (int(fuben_id) - 1) % 6))
        return [(5, 88 + stage * 78)]
    rewards = parse_bonus_items(config["bonusRequired"])
    for entry in (config["bonusOptional"] or "").split(";"):
        parts = entry.split(":")
        try:
            item_id, amount = int(parts[0]), int(parts[1])
            enabled = int(parts[2]) if len(parts) > 2 else 1
        except (IndexError, TypeError, ValueError):
            continue
        if amount > 0 and enabled:
            rewards.append((item_id, amount))
    return rewards


def handle_activity_startfight(cmd_data, player):
    fields = parse_varint_fields(cmd_data)
    activity_id, fuben_id = fields.get(1, 1), fields.get(2, 1)
    expected_activity_id = _activity_id_for_fuben(fuben_id)
    if expected_activity_id and activity_id != expected_activity_id:
        log.warning("    activity/fuben mismatch: got activity=%d fuben=%d; config expects activity=%d",
                    activity_id, fuben_id, expected_activity_id)
    left = build_player_units(player)
    right = _activity_enemy_units(fuben_id)
    won, _, _ = resolve_battle(left, right)
    replay = encode_fight_replay(simulate_battle(left, right, won)) if left and right else b""
    reward = _activity_fuben_rewards(fuben_id)
    card_exp_gain = next((amount for item_id, amount in reward if item_id == 5), 0)
    report = build_fight_report(player, 0, activity_id, fuben_id, won, reward, False, left, right,
                                replay, card_exp_gain=card_exp_gain, fight_type=5)
    body = pb_tag(1, 2) + uvarint(len(report)) + report
    log.info("    activity fuben: activity=%d fuben=%d -> %s", activity_id, fuben_id,
             "WIN" if won else "LOSS")
    messages = [("PVZ.Cmd.Cmd_Battle_StartActivityFubenFight_SC", body)]
    if won:
        messages += grant_fuben_reward(player, reward)
        if card_exp_gain:
            messages += grant_battle_card_exp(player, card_exp_gain)
    return messages


# --- Greenhouse / Plant Talent (植物研究所, Building_Reasearch) ----------------
# A per-plant talent CHAIN (plantTalentInfo.txt): 112 talents in 4 stages, each plant has a
# linear chain (talentIndex 1..5, parentTalentId links them). Studying a talent boosts that
# plant in normal-mode TD. The greenhouse requests one STAGE at a time; the plant cards come
# from the client's own plantTalentInfo, the SC's talentList just flags each talent
# studied/available. We let talents be freely studiable (satisfyPower/satisfyCondition=true)
# but the client still enforces the parent-chain order; studied talents persist.
# CRASH NOTE: PlantTalentModel.setUnlockPlantList does getPlantTalentSetById(talentId).plantId
# with no null check -> every talentId we send MUST exist in plantTalentInfo.txt (they do).
_PLANT_TALENTS = None


def load_plant_talents():
    """{'by_stage': {stageId: [talentId,...]}, 'talent': {talentId: {plantId, stage, parent}}}."""
    global _PLANT_TALENTS
    if _PLANT_TALENTS is None:
        by_stage, talent = {}, {}
        rows = _read_clientdb_table("plantTalentInfo.txt")
        if rows:
            hdr = rows[0]; ci = {c: i for i, c in enumerate(hdr)}

            def col(c, k):
                i = ci.get(k)
                return c[i] if i is not None and i < len(c) else ""
            for c in rows[1:]:
                try:
                    tid = int(col(c, "id")); stage = int(col(c, "stageId"))
                    pid = int(col(c, "plantId")); parent = int(col(c, "parentTalentId") or 0)
                except ValueError:
                    continue
                talent[tid] = {"plantId": pid, "stage": stage, "parent": parent,
                               "power": int(col(c, "power") or 0),
                               "cond": col(c, "advancedCond")}
                by_stage.setdefault(stage, []).append(tid)
        _PLANT_TALENTS = {"by_stage": by_stage, "talent": talent}
        log.info("loaded %d plant talents across %d stages",
                 len(talent), len(by_stage))
    return _PLANT_TALENTS


def plant_card_power(player, plant_id):
    """The player's current 战力 (battle power) for a TD plant = the strongest owned card whose
    tdId == plant_id, at its card level (0 if the plant isn't owned)."""
    load_battle_cards()
    best = 0
    for _uid, card_id, level, _exp in store.get_cards(player["uin"]):
        b = _BATTLE_CARDS.get(card_id)
        if b and b.get("tdId") == int(plant_id):
            best = max(best, card_power(card_stats_at_level(card_id, level)))
    return best


def _eval_talent_condition(player, advanced_cond):
    """True if a talent's advancedCond ('type:params:value') is met. We check the systems that
    exist (TOWN_LEVEL(2)->role level, beat-adventure(14), PLANT_LEVEL(5), PLANT_STAR(8)); every
    other condition is tied to a building we haven't built yet (trial road, nutrition, world tree,
    zen garden, equipment, zombie island, arena, union, mines, awaken, avatar, quest...) and
    returns True so the tree stays completable — wire real checks in here as those come online.
    Types = TalentAdvancedConditionType."""
    parts = (advanced_cond or "").split(":")
    if not parts or not parts[0].isdigit():
        return True
    ctype = int(parts[0])
    params = parts[1] if len(parts) > 1 else ""
    value = parts[2] if len(parts) > 2 else ""
    uin = player["uin"]
    try:
        if ctype == 2:                    # TOWN_LEVEL -> role level (our progression metric)
            return int(player.get("level", 1)) >= int(value or 0)
        if ctype == 14:                   # beat an adventure stage: params = chapter,stage,mode
            ch, st, md = [int(x) for x in (params.split(",") + ["1", "1", "1"])[:3]]
            return st in store.get_fuben_passed(uin, ch, md)
        if ctype == 5:                    # PLANT_LEVEL: params=targetLevel, value=count
            target, count = int(params), int(value)
            return sum(1 for _u, _c, lv, _e in store.get_cards(uin) if int(lv) >= target) >= count
        if ctype == 8:                    # PLANT_STAR: params=star, value=count
            load_battle_cards()
            target, count = int(params), int(value)
            return sum(1 for _u, cid, _lv, _e in store.get_cards(uin)
                       if (_BATTLE_CARDS.get(cid) or {}).get("star", 1) >= target) >= count
    except (ValueError, IndexError):
        return True
    return True                           # unbuilt-system condition -> allow (keep tree completable)


def _talent_gates(player, info, power_cache):
    """(satisfyPower, satisfyCondition) for a talent. The clientDB power req is on the ORIGINAL
    stat scale, so compare against our card power scaled the same way (// _ADV_STAT_SCALE)."""
    pid = info["plantId"]
    if pid not in power_cache:
        power_cache[pid] = plant_card_power(player, pid)
    sat_power = power_cache[pid] >= (int(info.get("power", 0)) // _ADV_STAT_SCALE)
    sat_cond = _eval_talent_condition(player, info.get("cond", ""))
    return sat_power, sat_cond


def handle_talent_getlist(cmd_data, player):
    """Cmd_Talent_GetList_CS{stageId} -> Cmd_Talent_GetList_SC{stageId(1),
    unlockPlantList(3)=[Dto_PlantInfo], talentList(4)=[Dto_TalentInfo]}. satisfyPower/Condition
    now reflect the REAL requirements (plant power + advancedCond task)."""
    stage = parse_varint_fields(cmd_data).get(1, 0)
    tal = load_plant_talents()
    studied = set(store.get_talents(player["uin"]))
    if stage == 0:
        # Login (InitTalentTask) requests stage 0. Respond AS stage 1 (a REAL stage): the client
        # sets curStageId from our echoed stageId, and the greenhouse's onRegister immediately runs
        # updateCardBox -> getPlantByStageId(curStageId) + PTBar updates against m_talentDic. Echoing
        # stageId=0 makes those empty/inconsistent and PTBarMediator.updateHandler #1009s on
        # getTalentInfoById(id).hasStudy (null). Studied talents apply in TD via
        # Cmd_TD_RequestTDInfo_SC field 6 (not this model), so we don't need to seed them here.
        stage = 1
        stage_talents = tal["by_stage"].get(1, [])
    else:
        stage_talents = tal["by_stage"].get(stage, [])
    out = pb_varint_field(1, stage)
    # unlockPlantList (field 3) = distinct plants that have talents in this stage
    seen = set()
    for tid in stage_talents:
        pid = tal["talent"][tid]["plantId"]
        if pid in seen:
            continue
        seen.add(pid)
        dto = pb_varint_field(1, pid) + pb_varint_field(2, 0)   # Dto_PlantInfo{plantId, isNew}
        out += pb_tag(3, 2) + uvarint(len(dto)) + dto
    # talentList (field 4) — real gates; a studied talent already met them (send True).
    power_cache = {}
    n_ready = 0
    for tid in stage_talents:
        info = tal["talent"][tid]
        if tid in studied:
            sat_power = sat_cond = True
        else:
            sat_power, sat_cond = _talent_gates(player, info, power_cache)
            if sat_power and sat_cond:
                n_ready += 1
        dto = (pb_varint_field(1, tid)          # talentId
               + pb_bool(2, tid in studied)     # hasStudy
               + pb_bool(3, sat_power)          # satisfyPower
               + pb_bool(4, sat_cond))          # satisfyCondition
        out += pb_tag(4, 2) + uvarint(len(dto)) + dto
    log.info("    talent list stage %d: %d talents, %d plants, %d studied, %d studiable-now",
             stage, len(stage_talents), len(seen),
             len(studied & set(stage_talents)), n_ready)
    return out


def handle_talent_study(cmd_data, player):
    """Cmd_Talent_Study_CS{talentId} -> study it (persist) + Cmd_Talent_Study_SC{talentId}.
    Enforces: real talent, parent studied, not already studied, AND the power + task requirements
    (defense — the client already greys out talents whose gates aren't met)."""
    tid = parse_varint_fields(cmd_data).get(1) or 0
    tal = load_plant_talents()
    info = tal["talent"].get(tid)
    if not info:
        log.info("    talent study: unknown talent %s -> ignored", tid)
        return []
    studied = set(store.get_talents(player["uin"]))
    if tid in studied:
        return []                                    # already studied
    if info["parent"] and info["parent"] not in studied:
        log.info("    talent study: talent %d parent %d not studied -> deny", tid, info["parent"])
        return []                                    # must study the chain in order
    sat_power, sat_cond = _talent_gates(player, info, {})
    if not (sat_power and sat_cond):
        log.info("    talent study: talent %d gates unmet (power=%s cond=%s) -> deny",
                 tid, sat_power, sat_cond)
        return []                                    # requirements not met
    store.study_talent(player["uin"], tid)
    log.info("    talent study: uin=%s studied talent %d (plant %d)",
             player["uin"], tid, info["plantId"])
    return pb_varint_field(1, tid)                    # Cmd_Talent_Study_SC{talentId}


# --- Ranking (排行榜, Building_Rank) — leaderboards -----------------------------
# A defunct MMO leaderboard: offline there are no other players, so we show the PLAYER at
# rank #1 in the tabs we can compute (fight power / achievement / trial-stage / plant-star)
# and leave guild/arena/all-server tabs empty. CRITICAL: the SC MUST echo the requested
# `ranktype` (field 1) — RankProxy switches on it, and a mismatched/absent type (the generic
# empty reply sends 0) never fires EVENT_RANK_LIST_UPDATE, so the window stays blank.
def _player_fight_power(player):
    """The player's 战力 = sum of card power over their whole collection (>=100)."""
    load_battle_cards()
    total = sum(card_power(card_stats_at_level(cid, lv))
                for _u, cid, lv, _e in store.get_cards(player["uin"]))
    return total or 100


def _player_plant_stars(player):
    """Total plant stars across owned cards (Dto_RolePlantStar.starnum)."""
    load_battle_cards()
    return sum((_BATTLE_CARDS.get(cid) or {}).get("star", 1)
               for _u, cid, _l, _e in store.get_cards(player["uin"]))


def _rank_dto_fightpower(player, rank):   # Dto_RoleFightPower
    return (pb_varint_field(1, rank) + pb_string(2, player["name"]) + pb_varint_field(3, player["level"])
            + pb_string(4, "") + pb_varint_field(5, _player_fight_power(player))
            + pb_varint_field(6, player["role_id"]))


def _rank_dto_achievement(player, rank):  # Dto_RoleAchievement
    return (pb_varint_field(1, rank) + pb_string(2, player["name"]) + pb_varint_field(3, player["level"])
            + pb_varint_field(4, 0) + pb_varint_field(5, 0) + pb_varint_field(6, player["role_id"]))


def _rank_dto_screwup(player, rank):      # Dto_ScrewUpStage / NewScrewUpStage
    return (pb_varint_field(1, rank) + pb_string(2, player["name"]) + pb_varint_field(3, player["level"])
            + pb_varint_field(4, _player_fight_power(player)) + pb_varint_field(5, 0)
            + pb_varint_field(6, player["role_id"]))


def _rank_dto_plantstar(player, rank):    # Dto_RolePlantStar
    return (pb_varint_field(1, rank) + pb_string(2, player["name"]) + pb_varint_field(3, player["level"])
            + pb_varint_field(4, _player_plant_stars(player)) + pb_varint_field(5, player["role_id"]))


# ranktype -> (GetRankList_SC list field, GetSelfRank_SC self field, dto builder). Types not
# here (guild/arena/all-server) still echo ranktype -> the tab opens, just empty.
_RANK_TYPES = {
    1:  (4, 2, _rank_dto_fightpower),    # RoleFightPower
    2:  (5, 3, _rank_dto_achievement),   # RoleAchievement
    4:  (7, 5, _rank_dto_screwup),       # ScrewUpStage
    6:  (9, 7, _rank_dto_plantstar),     # PlantStar
    12: (15, 11, _rank_dto_screwup),     # NewScrewUpStage
}


def handle_getranklist(cmd_data, player):
    """Cmd_GetRankList_CS{ranktype, page} -> Cmd_GetRankList_SC{ranktype(1), ranknum(3),
    <typefield>=[Dto]}. Player at rank #1 for computable tabs; empty otherwise."""
    ranktype = parse_varint_fields(cmd_data).get(1, 1)
    out = pb_varint_field(1, ranktype)
    entry = _RANK_TYPES.get(ranktype)
    if entry:
        list_field, _self, builder = entry
        dto = builder(player, 1)
        out += pb_varint_field(3, 1)                          # ranknum = 1 (just you)
        out += pb_tag(list_field, 2) + uvarint(len(dto)) + dto
    else:
        out += pb_varint_field(3, 0)                          # no offline data for this board
    return out


def handle_getselfrank(cmd_data, player):
    """Cmd_GetSelfRank_CS{ranktype} -> Cmd_GetSelfRank_SC{ranktype(1), <typefield>=Dto}."""
    ranktype = parse_varint_fields(cmd_data).get(1, 1)
    out = pb_varint_field(1, ranktype)
    entry = _RANK_TYPES.get(ranktype)
    if entry:
        _list, self_field, builder = entry
        dto = builder(player, 1)
        out += pb_tag(self_field, 2) + uvarint(len(dto)) + dto
    return out


# --- King of the Hill (巅峰王者 / TopFight, Building_TopKing) — multiplayer-only stub -----
# A cross-zone PvP betting tournament with no offline equivalent. The window (TopKingWindowMediator)
# early-returns cleanly when the model is "not_inited" (getStageState). The model is inited only if
# curStageInfo != null = getStageInfoByID(stageId) resolves (valid ids are 100..900; stageId==0 gets
# remapped to 900). So we reply with an INVALID non-zero stageId (1) -> curStageInfo=null ->
# not_inited -> onInfoUpdate returns early -> a clean empty tournament (no crash on the empty roster).
def handle_topfight_info(cmd_data, player):
    """Cmd_TopFight_Info_CS -> Cmd_TopFight_Info_SC forced to the uninitialised state so the
    King-of-the-Hill window opens empty instead of trying to render a live tournament."""
    return pb_varint_field(5, 1)          # stageId = 1 (not a real stage) -> model stays not_inited


# --- Zen Garden (阳光房 / Building_GARDEN) — plant/grow/harvest idle-farm -------------
# 16 pots. GardenSeed.txt: type1 = sunflower (produces exp over time -> garden exp -> beans),
# type2 = crop (grows over `time` sec -> one harvest of coins/items). We persist each unlocked
# pot's seed + plant_time, compute yields server-side on harvest, and grant them for real.
_GARDEN_SEEDS = None
_GARDEN_UNLOCK = None
_GARDEN_SUNFLOWER_EXP = 12          # base exp per production cycle (desc: "12点基础经验/20秒")
_GARDEN_MAX_IDLE_CYCLES = 4320      # cap idle accrual at ~24h (24*3600/20) so it can't runaway
_GARDEN_BEAN_EXP = 10000            # exp per 小经验豆 (item 2002 use-effect) -> bean conversion
_GARDEN_EXP_BEAN_ITEM = 2002


def load_garden_seeds():
    """{seedId: {type, itemid, time, plantid, desc}} from GardenSeed.txt."""
    global _GARDEN_SEEDS
    if _GARDEN_SEEDS is None:
        _GARDEN_SEEDS = {}
        rows = _read_clientdb_table("GardenSeed.txt")
        if rows:
            hdr = rows[0]; ci = {c: i for i, c in enumerate(hdr)}

            def col(c, k):
                i = ci.get(k)
                return c[i] if i is not None and i < len(c) else ""
            for c in rows[1:]:
                try:
                    sid = int(col(c, "id"))
                except ValueError:
                    continue
                _GARDEN_SEEDS[sid] = {
                    "type": int(col(c, "type") or 1), "itemid": int(col(c, "itemID") or 0),
                    "time": int(col(c, "time") or 60), "plantid": int(col(c, "plantID") or 0),
                    "desc": col(c, "desc")}
        log.info("loaded %d garden seeds", len(_GARDEN_SEEDS))
    return _GARDEN_SEEDS


_GARDEN_PETS = None
_GARDEN_PET_IDS = (2, 3, 4, 5)      # the 4 buyable pets shown in the pet house (id 1 = free base)


def load_garden_pets():
    """{petId: {trial, forever, unlock}} from GardenPet.txt (prices + 好感度 unlock threshold)."""
    global _GARDEN_PETS
    if _GARDEN_PETS is None:
        _GARDEN_PETS = {}
        rows = _read_clientdb_table("GardenPet.txt")
        if rows:
            hdr = rows[0]; ci = {c: i for i, c in enumerate(hdr)}

            def col(c, k):
                i = ci.get(k)
                return int(c[i]) if i is not None and i < len(c) and c[i].isdigit() else 0
            for c in rows[1:]:
                try:
                    pid = int(c[ci["id"]])
                except (ValueError, KeyError, IndexError):
                    continue
                _GARDEN_PETS[pid] = {"trial": col(c, "priceTrial"),
                                     "forever": col(c, "priceForever"), "unlock": col(c, "unlockExp")}
    return _GARDEN_PETS


def _encode_garden_pet(pid, owned=False, used=False, forever=False, expire=0, start=0):
    """Dto_Pet{petid(1), owned(2), forever(3), expiretime(4), startworktime(5), inuse(6),
    dayprice(7), foreverprice(8)}. Prices come from GardenPet.txt so the shop renders real costs."""
    p = load_garden_pets().get(pid, {"trial": 0, "forever": 0})
    return (pb_varint_field(1, pid) + pb_varint_field(2, 1 if owned else 0)
            + pb_varint_field(3, 1 if forever else 0) + pb_varint_field(4, int(expire))
            + pb_varint_field(5, int(start)) + pb_varint_field(6, 1 if used else 0)
            + pb_varint_field(7, p["trial"]) + pb_varint_field(8, p["forever"]))


def load_garden_unlock():
    """{fieldId: levelRequired} from GardenUnlock.txt (fields 1-4 are free)."""
    global _GARDEN_UNLOCK
    if _GARDEN_UNLOCK is None:
        _GARDEN_UNLOCK = {}
        rows = _read_clientdb_table("GardenUnlock.txt")
        if rows:
            hdr = rows[0]; ci = {c: i for i, c in enumerate(hdr)}
            for c in rows[1:]:
                try:
                    _GARDEN_UNLOCK[int(c[ci["id"]])] = int(c[ci["levelRequired"]])
                except (ValueError, KeyError, IndexError):
                    pass
    return _GARDEN_UNLOCK


def ensure_garden(player):
    """Unlock every garden field whose levelRequired <= the player's level (coin cost waived for
    the single-player sandbox), so pots open up as you level. Returns the {field:(seed,time)} map."""
    level = int(player.get("level", 1))
    have = store.get_garden_pots(player["uin"])
    for fid, need in load_garden_unlock().items():
        if fid not in have and need <= level:
            store.unlock_garden_field(player["uin"], fid)
    return store.get_garden_pots(player["uin"])


def _garden_crop_reward(desc):
    """Parse a type-2 crop's harvest reward from its desc -> (itemId, num). 金币->coin, 钻石->gift
    diamond, 合金元素->armor mat; 土壤 (soil, no bag item) -> a token coin amount."""
    m = re.search(r"(\d+)", desc or "")
    n = int(m.group(1)) if m else 0
    if "金币" in desc:
        return (1, n)                    # coin
    if "钻石" in desc:
        return (4, max(1, n))            # gift diamond
    if "合金元素" in desc:
        return (40003, max(1, n))        # armor material
    if "土壤" in desc:
        return (1, n * 100)              # soil has no bag item -> small coin payout
    return (1, n)


_GARDEN_SEED_TYPE_COLOR = 1        # E_Garden_SeedType.SevenColor / GardenGlobal.SEED_TYPE_COLOR
_GARDEN_SEED_TYPE_ITEM = 2         # E_Garden_SeedType.Item        / GardenGlobal.SEED_TYPE_ITEM

# One-time starter crop seeds (bag items, subType 232) so the seed picker isn't empty and the
# crop -> coins path is testable: 坚果 (fast 30s test), 胡萝卜 (100k coin), 蒲公英 (200k coin).
_GARDEN_STARTER_SEEDS = [(1041, 5), (1045, 5), (1046, 3)]


def _garden_seven_color_seed():
    """The seed id to store for a seven-color sunflower (any type-1 seed; they're identical:
    time 20, plantID 1101, 12 exp / cycle). Seeds 1-7 are the seven colours."""
    return min((sid for sid, s in load_garden_seeds().items() if s["type"] == 1), default=1)


def _garden_seed_by_itemid(itemid):
    """The crop seed id whose GardenSeed.itemID == the planted bag item (type-2 crops)."""
    for sid, s in load_garden_seeds().items():
        if s["type"] == _GARDEN_SEED_TYPE_ITEM and s["itemid"] == int(itemid or 0):
            return sid
    return 0


def _garden_pending_exp(seed, plant_time, now):
    """Whole-cycle exp a sunflower pot has produced since plant_time (capped)."""
    if not plant_time:
        return 0
    period = max(1, seed["time"])
    cycles = min((now - int(plant_time)) // period, _GARDEN_MAX_IDLE_CYCLES)
    return max(0, cycles) * _GARDEN_SUNFLOWER_EXP


def _encode_garden_pot(seed_id, plant_time, now):
    """Dto_Pot{level(1), issevencolor(2), seedid(3), planttime(4), nextharvesttime(5),
    needfertilize(7), exp(9)}. An empty pot (seed_id=0) is just level=1.

    For a seven-color sunflower nextharvesttime = plant_time + cycle: once it's in the past the
    client shows an exp ball whose roll-over fires Cmd_Garden_Harvest_CS (banking the pot's
    accrued exp into the garden pool). needfertilize=0 + a SevenColor seed are what make the
    client's '+N经验/时' rate (getTotalExpByPotVO) non-zero. For a crop it's the maturity clock."""
    d = pb_varint_field(1, 1)                              # level
    if not seed_id:
        return d
    seed = load_garden_seeds().get(seed_id, {"type": 1, "time": 60})
    is_sun = seed["type"] == _GARDEN_SEED_TYPE_COLOR
    if is_sun:
        d += pb_varint_field(2, 1)                         # issevencolor
    d += pb_varint_field(3, seed_id) + pb_varint_field(4, int(plant_time))
    d += pb_varint_field(5, int(plant_time) + seed["time"])   # nextharvesttime
    d += pb_varint_field(7, 0)                                # needfertilize = false
    if is_sun:
        d += pb_varint_field(9, _garden_pending_exp(seed, plant_time, now))   # pot's pending exp
    return d


def _garden_fields_blob(player, now):
    """The repeated Dto_Field(1)=[fieldid(1), pot(2)] portion — identical in the GetInfo and Sync
    messages (only the exp/bean field NUMBERS differ between them)."""
    d = b""
    for fid, (seed_id, plant_time) in sorted(store.get_garden_pots(player["uin"]).items()):
        pot = _encode_garden_pot(seed_id, plant_time, now)
        field = pb_varint_field(1, fid) + pb_tag(2, 2) + uvarint(len(pot)) + pot   # Dto_Field{fieldid, pot}
        d += pb_tag(1, 2) + uvarint(len(field)) + field                            # fields (repeated)
    return d


def make_garden_getinfo(player, now):
    """Cmd_Garden_GetInfo_SC {fields(1), exp(2), bean(3), pets(4)=[Dto_Pet], petExp(8)=好感度}. The
    garden exp POOL (banked via per-pot harvest) drives the bar: exp = pool % 10000 (progress),
    bean = pool // 10000 (whole 小经验豆). We also send the 4 buyable pets (so the pet house opens
    without a null-crash) and the 好感度 goodwill total that gates them."""
    pool = int(player.get("garden_exp") or 0)
    d = (_garden_fields_blob(player, now)
         + pb_varint_field(2, pool % _GARDEN_BEAN_EXP)      # bar progress toward next bean
         + pb_varint_field(3, pool // _GARDEN_BEAN_EXP))    # whole beans waiting to be taken
    for pid in _GARDEN_PET_IDS:                             # pets(4) — un-owned; shop renders prices
        pet = _encode_garden_pet(pid)
        d += pb_tag(4, 2) + uvarint(len(pet)) + pet
    d += pb_varint_field(8, int(player.get("garden_goodwill") or 0))   # petExp = 好感度 goodwill
    return d


def _garden_sync(player, now):
    """A Cmd_Sync_Garden_Info_SC push so the exp bar / pots refresh LIVE after a plant/harvest/
    takebean (not only on garden re-entry). NOTE its field NUMBERS differ from GetInfo:
    fields(1), pets(2), exp(3), bean(4) — so exp/bean go at 3/4, not 2/3."""
    pool = int(player.get("garden_exp") or 0)
    body = (_garden_fields_blob(player, now)
            + pb_varint_field(3, pool % _GARDEN_BEAN_EXP)
            + pb_varint_field(4, pool // _GARDEN_BEAN_EXP))
    return ("PVZ.Cmd.Cmd_Sync_Garden_Info_SC", body)


def handle_garden_getinfo(cmd_data, player):
    """Cmd_Garden_GetInfo_CS -> the whole garden (unlocking new pots for the player's level, and
    handing out the one-time starter crop seeds so the seed picker has crops to plant)."""
    ensure_garden(player)
    now = int(time.time())
    extra = []
    if not int(player.get("garden_seeds_granted") or 0):
        upd = grant_items(player, _GARDEN_STARTER_SEEDS)
        player["garden_seeds_granted"] = 1
        store.save_player(player["uin"], garden_seeds_granted=1)
        if upd:
            extra.append(upd)
        log.info("    garden: granted starter crop seeds to uin=%s", player["uin"])
    pool = int(player.get("garden_exp") or 0)
    log.info("    garden: %d pots, pool=%d exp(bar)=%d beans=%d",
             len(store.get_garden_pots(player["uin"])), pool, pool % _GARDEN_BEAN_EXP, pool // _GARDEN_BEAN_EXP)
    return [("PVZ.Cmd.Cmd_Garden_GetInfo_SC", make_garden_getinfo(player, now))] + extra


def handle_garden_plant(cmd_data, player):
    """Cmd_Garden_Plant_CS{fieldid(1), seedtype(2), itemid(3)} -> plant a seed. seedtype is a
    TYPE, not a seed id: 1=seven-color sunflower (the exp producer, from the always-present colour
    slot), 2=a crop chosen by its bag itemid. Reply Cmd_Garden_Plant_SC{field(3)=Dto_Field} plus a
    Sync so the pot shows up immediately."""
    f = parse_varint_fields(cmd_data)
    fid, seedtype, itemid = f.get(1, 0), f.get(2, 0), f.get(3, 0)
    now = int(time.time())
    if fid not in store.get_garden_pots(player["uin"]):
        return []                                            # field locked / nonexistent
    consume = None
    if seedtype == _GARDEN_SEED_TYPE_ITEM:
        seed_id = _garden_seed_by_itemid(itemid)
        if not seed_id or store.get_item_count(player["uin"], itemid) <= 0:
            return []                                        # unknown / unowned crop seed item
        consume = grant_items(player, [(itemid, -1)])        # planting a crop uses one seed
    else:                                                    # SEED_TYPE_COLOR (or default)
        seed_id = _garden_seven_color_seed()
    store.set_garden_pot(player["uin"], fid, seed_id, now)
    pot = _encode_garden_pot(seed_id, now, now)
    field = pb_varint_field(1, fid) + pb_tag(2, 2) + uvarint(len(pot)) + pot
    plant_sc = pb_tag(3, 2) + uvarint(len(field)) + field    # Cmd_Garden_Plant_SC.field(3)
    log.info("    garden plant: field %d seed %d (seedtype %d itemid %d)", fid, seed_id, seedtype, itemid)
    msgs = [("PVZ.Cmd.Cmd_Garden_Plant_SC", plant_sc), _garden_sync(player, now)]
    if consume:
        msgs.append(consume)
    return msgs


def handle_garden_harvest(cmd_data, player):
    """Cmd_Garden_Harvest_CS{fieldid(1)} -> collect the pot. Sunflower: bank its accrued exp into
    the garden pool (bar grows); crop: grant its coin/item reward (for real) and empty the pot.
    Reply Cmd_Garden_Harvest_SC{result(1)=Dto_Harvest_Result{fieldid,type,exp,crit,items}} + a
    Sync so the exp bar / pot state update live."""
    fid = parse_varint_fields(cmd_data).get(1, 0)
    now = int(time.time())
    pots = store.get_garden_pots(player["uin"])
    if fid not in pots:
        return []
    seed_id, plant_time = pots[fid]
    seed = load_garden_seeds().get(seed_id)
    if not seed_id or not seed:
        return []                                            # empty pot
    uin = player["uin"]
    grant_msgs = []
    result = pb_varint_field(1, fid) + pb_varint_field(2, seed["type"])
    if seed["type"] == _GARDEN_SEED_TYPE_COLOR:
        exp_gain = _garden_pending_exp(seed, plant_time, now)
        if exp_gain <= 0:
            return []                                        # nothing produced yet
        player["garden_exp"] = int(player.get("garden_exp") or 0) + exp_gain
        player["garden_goodwill"] = int(player.get("garden_goodwill") or 0) + exp_gain   # lifetime 好感度
        store.save_player(uin, garden_exp=player["garden_exp"], garden_goodwill=player["garden_goodwill"])
        store.set_garden_pot(uin, fid, seed_id, now)         # reset the production timer
        result += pb_varint_field(3, exp_gain) + pb_varint_field(4, 1)   # exp, crit=1 (no crit)
        log.info("    garden harvest: field %d sunflower +%d exp (pool=%d, goodwill=%d)",
                 fid, exp_gain, player["garden_exp"], player["garden_goodwill"])
    else:                                                     # crop -> one-time reward when mature
        if now < int(plant_time) + seed["time"]:
            return []                                        # not mature
        item_id, num = _garden_crop_reward(seed["desc"])
        grant_msgs = grant_fuben_reward(player, [(item_id, num)])
        store.set_garden_pot(uin, fid, 0, 0)                 # crop consumed -> empty pot
        item = pb_varint_field(1, item_id) + pb_varint_field(2, num)     # Dto_IdNum{id,num}
        result += pb_tag(5, 2) + uvarint(len(item)) + item              # items(5)
        log.info("    garden harvest: field %d crop -> item %d x%d", fid, item_id, num)
    harvest_sc = pb_tag(1, 2) + uvarint(len(result)) + result           # Cmd_Garden_Harvest_SC.result(1)
    return [("PVZ.Cmd.Cmd_Garden_Harvest_SC", harvest_sc), _garden_sync(player, now)] + grant_msgs


def handle_garden_takebean(cmd_data, player):
    """Cmd_Garden_TakeBean_CS -> move the whole beans sitting in the pool (pool // 10000) into the
    bag as 小经验豆 (item 2002); keep the remainder as the bar progress. Reply
    Cmd_Garden_TakeBean_SC{beannum(1)=beans taken, exp(2)=remaining} + a Sync to refresh."""
    uin = player["uin"]
    now = int(time.time())
    pool = int(player.get("garden_exp") or 0)
    beans = pool // _GARDEN_BEAN_EXP
    grant_msgs = []
    if beans > 0:
        player["garden_exp"] = pool - beans * _GARDEN_BEAN_EXP
        store.save_player(uin, garden_exp=player["garden_exp"])
        grant_msgs = grant_fuben_reward(player, [(_GARDEN_EXP_BEAN_ITEM, beans)])
    remainder = int(player.get("garden_exp") or 0)
    log.info("    garden takebean: %d beans (exp left %d)", beans, remainder)
    body = pb_varint_field(1, beans) + pb_varint_field(2, remainder)
    return [("PVZ.Cmd.Cmd_Garden_TakeBean_SC", body), _garden_sync(player, now)] + grant_msgs


def _garden_speed_price(remaining):
    """Diamonds to instantly finish `remaining` seconds — mirrors GardenUtils.getSpeedPrice: 1 per
    started 10 min under 4h, then 2 per started hour beyond."""
    if remaining <= 0:
        return 0
    if remaining < 14400:
        return -(-remaining // 600)                          # ceil(remaining / 600)
    return 24 + -(-(remaining - 14400) // 3600) * 2          # 14400/600 + ceil(rest/3600)*2


def _spend_diamonds(player, cost):
    """Spend `cost` diamonds, gift (present_ticket) first then gold (ticket) — the standard order,
    preserving paid currency. Returns the HUD sync messages, or None if the player can't afford it."""
    if cost <= 0:
        return []
    gift, gold = int(player.get("present_ticket") or 0), int(player.get("ticket") or 0)
    if gift + gold < cost:
        return None                                          # client normally blocks this
    msgs = []
    from_gift = min(gift, cost)
    if from_gift:
        player["present_ticket"] = gift - from_gift
        store.save_player(player["uin"], present_ticket=player["present_ticket"])
        msgs.append(("PVZ.Cmd.Cmd_SyncPresentTicket_SC", pb_varint_field(1, player["present_ticket"])))
    from_gold = cost - from_gift
    if from_gold:
        player["ticket"] = gold - from_gold
        store.save_player(player["uin"], ticket=player["ticket"])
        msgs.append(("PVZ.Cmd.Cmd_SyncTicket_SC", pb_varint_field(1, player["ticket"])))
    return msgs


def handle_garden_speedup(cmd_data, player):
    """Cmd_Garden_TicketSpeedUp_CS{fieldid} -> spend diamonds to instantly mature a growing crop.
    We charge the same getSpeedPrice the client's confirm dialog showed (gift diamonds first, then
    gold), backdate plant_time so it's ripe, and reply Cmd_Garden_TicketSpeedUp_SC{fieldid(1),
    result(2)=1} + a Sync (pot flips to 'reward ready') + the diamond HUD syncs. (Sunflowers have no
    maturity clock, so this only applies to crops.)"""
    fid = parse_varint_fields(cmd_data).get(1, 0)
    now = int(time.time())
    pots = store.get_garden_pots(player["uin"])
    if fid not in pots:
        return []
    seed_id, plant_time = pots[fid]
    seed = load_garden_seeds().get(seed_id)
    if not seed_id or not seed or seed["type"] != _GARDEN_SEED_TYPE_ITEM:
        return []                                            # empty pot or a sunflower (no timer)
    remaining = int(plant_time) + seed["time"] - now
    if remaining <= 0:
        return []                                            # already mature — nothing to speed up
    diamond_msgs = _spend_diamonds(player, _garden_speed_price(remaining))
    if diamond_msgs is None:
        return []                                            # can't afford (client should've blocked)
    store.set_garden_pot(player["uin"], fid, seed_id, now - seed["time"])   # backdate -> mature now
    log.info("    garden speedup: field %d crop matured (-%d diamonds)", fid, _garden_speed_price(remaining))
    body = pb_varint_field(1, fid) + pb_varint_field(2, 1)   # fieldid, result=success
    return [("PVZ.Cmd.Cmd_Garden_TicketSpeedUp_SC", body), _garden_sync(player, now)] + diamond_msgs


def handle_garden_dig(cmd_data, player):
    """Cmd_Garden_DigPlant_CS{fieldid} -> shovel up whatever's planted, leaving an empty (plantable)
    pot. Reply Cmd_Garden_DigPlant_SC{fieldid(1), field(2)=Dto_Field} + a Sync so the pot re-renders
    with the 'click to plant' prompt. (The dug seed/crop is lost — no refund, matching the original.)"""
    fid = parse_varint_fields(cmd_data).get(1, 0)
    now = int(time.time())
    pots = store.get_garden_pots(player["uin"])
    if fid not in pots or not pots[fid][0]:
        return []                                            # locked field or already empty
    store.set_garden_pot(player["uin"], fid, 0, 0)           # clear the pot
    pot = _encode_garden_pot(0, 0, now)                       # empty pot (level only)
    dto_field = pb_varint_field(1, fid) + pb_tag(2, 2) + uvarint(len(pot)) + pot   # Dto_Field
    body = pb_varint_field(1, fid) + pb_tag(2, 2) + uvarint(len(dto_field)) + dto_field
    log.info("    garden dig: field %d cleared", fid)
    return [("PVZ.Cmd.Cmd_Garden_DigPlant_SC", body), _garden_sync(player, now)]


# --- Idle heartbeat (server-time sync) -----------------------------------------
# The client's IdleMessageSendManager sends Cmd_Idle_CS every 30s and feeds the reply's
# serverTime straight into DateUtils.setServerTime(). If serverTime is 0 (the generic empty
# reply) the client's whole clock collapses to epoch 0 -> every absolute-time countdown (garden
# crop maturity, activity/cooldown/pet timers, ...) reads as a ~55-year value. So the heartbeat
# MUST echo the real Unix time in SECONDS (same units as Cmd_Init_SC.now). Verified via the
# compiled Game_n.swf P-code: the client really does send this (the Assets/src decompile that
# showed the send commented-out is a stale/other build).
def handle_idle(cmd_data, player):
    """Cmd_Idle_CS -> Cmd_Idle_SC{serverTime(2)=now} (heartbeat keeps the client clock correct). Also push
    a fresh energy value if it regenerated since the last sync, so the 体力 bar visibly ticks up while the
    player idles/plays (the client has no local regen timer)."""
    msgs = [("PVZ.Cmd.Cmd_Idle_SC", pb_varint_field(2, int(time.time())))]
    if player:
        before = int(player.get("energy") or 0)
        if current_energy(player) != before:
            msgs.append(energy_sync_msg(player))
    return msgs


# CS name -> function(cmd_data, player) -> response body bytes.
# ============================ Laboratory (实验室, Building_Lab) ============================
# The lab is a shelf of "science bottles" (labId == Lab.txt bottleId). Two client modes:
#   PRODUCE (制作): shows ALL bottles; a locked (NoProduce) one is unlocked by paying its base
#                   level's unlockCost -> becomes HaveProduce at that base level.
#   UPGRADE (升级): shows produced bottles; each upgrade pays the current level's upgradeCost and
#                   bumps labLevel by 1 (until maxLevel). Basic bottles 1-4 (type 1) are
#                   pre-produced at level 0; every other bottle (type 2) starts locked at level 1.
# Wire: Cmd_Lab_GetLabInfo_SC{allLab[](Dto_LabItem), hasNewLab}, Cmd_Lab_ProduceLab_SC{changeLab},
#       Cmd_Lab_UpgradeLab_SC{changeLab}.  Dto_LabItem = {1:labId, 2:labLevel, 3:labStatus}.
_LAB_STATUS_NOPRODUCE = 1   # E_LabStatus_NoProduce   (locked / not yet made)
_LAB_STATUS_HAVEPRODUCE = 2  # E_LabStatus_HaveProduce (made -> upgradeable)
_LAB = None

# One-time starter lab-material stash so PRODUCE mode is usable out of the box. These are the star-1
# 'sand' materials (ItemInfo type 8) that unlock the first four producible bottles 5-8
# (crit/dodge/hit/tenacity): 40001 普通砂 (5+10+15+20=50 across the four) + one each of 40003-40006.
# Higher-tier bottles still need the themed materials that drop from adventure chapters. Note: the
# bottle ICON art (image/lab/*.png) isn't in this build, so unproduced bottles are invisible on the
# shelf — but with the materials in-bag they GLOW on hover (isMeetCondition) and their tooltip shows
# the name + unlock cost, so they're findable by hovering the produce-mode grid.
_LAB_STARTER_MATS = [(40001, 100), (40003, 2), (40004, 2), (40005, 2), (40006, 2)]


def load_lab():
    """{bottleId: {minLevel,maxLevel,type,star,sort, levels:{lvl:{unlockCost,upgradeCost,upgradeLvNeed}}}}
    parsed once from clientDB Lab.txt. Cost strings 'id,cnt:id,cnt' -> [(itemId, count)]."""
    global _LAB
    if _LAB is None:
        _LAB = {}
        rows = _read_clientdb_table("Lab.txt")
        if rows:
            hdr = rows[0]; ci = {c: i for i, c in enumerate(hdr)}

            def col(c, k):
                i = ci.get(k)
                return c[i] if i is not None and i < len(c) else ""

            def cost(s):
                out = []
                for p in (s or "").split(":"):
                    b = p.split(",")
                    if len(b) == 2:
                        try:
                            out.append((int(b[0]), int(b[1])))
                        except ValueError:
                            pass
                return out
            for c in rows[1:]:
                try:
                    bid, lvl = int(col(c, "bottleId")), int(col(c, "level"))
                except ValueError:
                    continue
                b = _LAB.setdefault(bid, {"minLevel": lvl, "maxLevel": lvl, "type": 1,
                                          "star": 1, "sort": bid, "levels": {}})
                b["minLevel"] = min(b["minLevel"], lvl)

                def num(k, d):
                    try:
                        return int(float(col(c, k) or d))
                    except ValueError:
                        return d
                b["maxLevel"] = num("maxLevel", b["maxLevel"])
                b["type"] = num("type", b["type"])
                b["star"] = num("starLv", b["star"])
                b["sort"] = num("sort", b["sort"])
                b["levels"][lvl] = {"unlockCost": cost(col(c, "unlockCost")),
                                    "upgradeCost": cost(col(c, "upgradeCost")),
                                    "upgradeLvNeed": num("upgradeLvNeed", 0),
                                    "stat": _lab_stat_pair(col(c, "upgradeResult"))}
        log.info("loaded %d lab bottles", len(_LAB))
    return _LAB


# upgradeResult "statType,value" -> (statType, value). value is the DISPLAYED bonus x100 (e.g. "1,1000"
# reads "攻击+10"), so /_LAB_STAT_SCALE gives the in-battle number, on the same scale as card stats.
_LAB_STAT_SCALE = 100
# statType -> the effective-stat field it buffs on every DEPLOYED plant. 1=atk 2=def 3=hp 5=技力(ability);
# 6-9 (命中/闪避/暴击/韧性 = hit/dodge/crit/tenacity) aren't modelled in the power sim yet, so ignored.
_LAB_STAT_FIELDS = {1: "atk", 2: "def_", 3: "hp", 5: "ability"}


def _lab_stat_pair(s):
    """'statType,value' -> (int type, int value), or None."""
    b = (s or "").split(",")
    if len(b) == 2:
        try:
            return (int(b[0]), int(b[1]))
        except ValueError:
            return None
    return None


def lab_stat_bonus(player):
    """The Lab's all-deployed-plant stat bonus: sum, over every PRODUCED bottle at its current level, of
    that level's upgradeResult (÷_LAB_STAT_SCALE) keyed by stat. {atk,def_,hp,ability} of ints (>=0).
    Level 0 (base) has no upgradeResult, so an un-upgraded produced bottle contributes nothing."""
    bonus = {"atk": 0, "def_": 0, "hp": 0, "ability": 0}
    for lid, (level, status) in _lab_load_state(player).items():
        if status != _LAB_STATUS_HAVEPRODUCE:
            continue
        pair = load_lab().get(lid, {}).get("levels", {}).get(level, {}).get("stat")
        if not pair:
            continue
        field = _LAB_STAT_FIELDS.get(pair[0])
        if field:
            bonus[field] += pair[1] // _LAB_STAT_SCALE
    return bonus


def _lab_default_state():
    """Fresh {labId: (level, status)}: type-1 basics produced at their level-0 base; all type-2
    bottles locked (NoProduce) at their minimum (base) level so their template still resolves."""
    state = {}
    for bid, b in load_lab().items():
        state[bid] = (b["minLevel"],
                      _LAB_STATUS_HAVEPRODUCE if b["type"] == 1 else _LAB_STATUS_NOPRODUCE)
    return state


def _lab_load_state(player):
    """Fresh defaults with the player's saved produce/upgrade overrides ('labId:level:status;...')."""
    state = _lab_default_state()
    for part in (player.get("lab_bottles") or "").split(";"):
        bits = part.split(":")
        if len(bits) == 3:
            try:
                lid, lvl, st = int(bits[0]), int(bits[1]), int(bits[2])
            except ValueError:
                continue
            state[lid] = (lvl, st)
    return state


def _lab_save_bottle(player, lab_id, level, status):
    """Record one bottle's new (level, status); persist only bottles that deviate from default."""
    state = _lab_load_state(player)
    state[lab_id] = (level, status)
    defaults = _lab_default_state()
    parts = ["%d:%d:%d" % (lid, state[lid][0], state[lid][1])
             for lid in sorted(state) if state[lid] != defaults.get(lid)]
    player["lab_bottles"] = ";".join(parts)
    store.save_player(player["uin"], lab_bottles=player["lab_bottles"])


def _encode_lab_item(lab_id, level, status):
    """Dto_LabItem{1:labId, 2:labLevel, 3:labStatus}."""
    return pb_varint_field(1, lab_id) + pb_varint_field(2, level) + pb_varint_field(3, status)


def _lab_afford(player, pairs):
    """True if the player holds every (itemId, count) — coin/gift-diamond via HUD fields, else bag."""
    for iid, cnt in pairs:
        if iid in _CURRENCY_SYNC:
            field, _ = _CURRENCY_SYNC[iid]
            if int(player.get(field, 0)) < cnt:
                return False
        elif iid in _UNMODELED_CURRENCIES:
            continue
        else:
            if store.get_item_count(player["uin"], iid) < cnt:
                return False
    return True


def _lab_charge(player, pairs):
    """Deduct [(itemId, count)] (assumes _lab_afford passed); return the HUD/bag sync messages."""
    return grant_fuben_reward(player, [(iid, -cnt) for iid, cnt in pairs])


def make_lab_getinfo(player):
    """Cmd_Lab_GetLabInfo_SC: every bottle as a Dto_LabItem + hasNewLab=false."""
    state = _lab_load_state(player)
    d = b""
    for lid in sorted(state, key=lambda x: load_lab().get(x, {}).get("sort", x)):
        lvl, st = state[lid]
        dto = _encode_lab_item(lid, lvl, st)
        d += pb_tag(1, 2) + uvarint(len(dto)) + dto      # allLab (field 1, repeated message)
    d += pb_varint_field(2, 0)                           # hasNewLab (field 2) = false
    return d


def handle_lab_getlabinfo(cmd_data, player):
    """Cmd_Lab_GetLabInfo_CS{from} -> the whole shelf. On the FIRST open, also drop the one-time
    starter lab-material stash (item update sent BEFORE the shelf so isHaveAllItems is already true
    when the board first renders and the producible bottles glow on hover)."""
    msgs = []
    if not int(player.get("lab_mats_granted") or 0):
        upd = grant_items(player, _LAB_STARTER_MATS)
        if upd:
            msgs.append(upd)
        player["lab_mats_granted"] = 1
        store.save_player(player["uin"], lab_mats_granted=1)
        log.info("    lab: granted one-time starter materials %s", _LAB_STARTER_MATS)
    msgs.append(("PVZ.Cmd.Cmd_Lab_GetLabInfo_SC", make_lab_getinfo(player)))
    return msgs


def handle_lab_produce(cmd_data, player):
    """Cmd_Lab_ProduceLab_CS{labId}: unlock a locked bottle by paying its base-level unlockCost."""
    lab_id = parse_varint_fields(cmd_data).get(1, 0)
    b = load_lab().get(lab_id)
    if not b:
        return []
    level, status = _lab_load_state(player).get(lab_id, (b["minLevel"], _LAB_STATUS_NOPRODUCE))
    if status != _LAB_STATUS_NOPRODUCE:
        return []                                        # already produced
    cost = b["levels"].get(b["minLevel"], {}).get("unlockCost", [])
    if not _lab_afford(player, cost):
        return []                                        # client greys the button; guard anyway
    charge = _lab_charge(player, cost)
    _lab_save_bottle(player, lab_id, b["minLevel"], _LAB_STATUS_HAVEPRODUCE)
    dto = _encode_lab_item(lab_id, b["minLevel"], _LAB_STATUS_HAVEPRODUCE)
    body = pb_tag(1, 2) + uvarint(len(dto)) + dto        # changeLab (field 1, message)
    log.info("    lab: produced bottle %d (cost %s)", lab_id, cost)
    return [("PVZ.Cmd.Cmd_Lab_ProduceLab_SC", body)] + charge


def handle_lab_upgrade(cmd_data, player):
    """Cmd_Lab_UpgradeLab_CS{labId}: pay the current level's upgradeCost, bump labLevel by 1."""
    lab_id = parse_varint_fields(cmd_data).get(1, 0)
    b = load_lab().get(lab_id)
    if not b:
        return []
    level, status = _lab_load_state(player).get(lab_id, (b["minLevel"], _LAB_STATUS_NOPRODUCE))
    if status != _LAB_STATUS_HAVEPRODUCE or level >= b["maxLevel"]:
        return []                                        # not produced / already maxed
    lv = b["levels"].get(level, {})
    if int(player.get("level", 1)) < lv.get("upgradeLvNeed", 0):
        return []                                        # actor level too low
    cost = lv.get("upgradeCost", [])
    if not cost or not _lab_afford(player, cost):
        return []
    charge = _lab_charge(player, cost)
    new_level = level + 1
    _lab_save_bottle(player, lab_id, new_level, _LAB_STATUS_HAVEPRODUCE)
    dto = _encode_lab_item(lab_id, new_level, _LAB_STATUS_HAVEPRODUCE)
    body = pb_tag(1, 2) + uvarint(len(dto)) + dto        # changeLab (field 1, message)
    log.info("    lab: upgraded bottle %d -> lv %d (cost %s)", lab_id, new_level, cost)
    return [("PVZ.Cmd.Cmd_Lab_UpgradeLab_SC", body)] + charge


# ============================ World Tree (世界树/树屋, Building_WORLD_TREE=220) ============================
# A "tree of wisdom": you FOSTER (培养) it to gain exp; when exp fills needExp the server auto-levels it,
# and every level grants +atk/def/hp/power to all deployed plants (client reads the props from clientDB).
# Three foster tiers (FosterType): Normal(1)=free for the first 5/day then costs fosterTicket, Free(3)=VIP's
# way to spend those same 5 free/day, Advanced(2)=gift-diamonds (half-price for the first 5/day). Each foster
# rolls a CRIT for bonus exp. One-key Upgrade (Cmd_WorldTree_Upgrade) buys +1 level with diamonds, but only
# unlocks at the first level whose oneKeyCost>0 (level 200). Wire: Dto_WorldTree_Info{1:level, 2:exp,
# 3:freeTimes(used), 4:advancedTimes(used)}; GetInfo_SC.info=f1, Foster_SC{1:fosterType,2:isCrit,3:addExp,
# 4:info}, Upgrade_SC.info=f1. freeTimes/advancedTimes are USED counts (client shows 5-used remaining).
_WT = None
_WT_CRIT_CHANCE = 0.20            # foster crit chance -> bonus exp
_WT_CRIT_MULT = 2                 # crit multiplies the foster's addExp
_WT_FREE_PER_DAY = 5             # normal/free fosters free per day (matches WTData: 5 - freeTimes)
_WT_ADV_HALF_PER_DAY = 5         # advanced fosters at half price per day
_WT_STARTER_FOSTER_TICKET = 500  # one-time stash so the paid normal-foster path is testable
_WT_FOSTERTYPE_NORMAL = 1
_WT_FOSTERTYPE_ADVANCED = 2
_WT_FOSTERTYPE_FREE = 3


def load_wt():
    """{level: {needExp, norAddExp, advAddExp, costNor, costAdv, oneKeyCost}} from WTTemplateCE.txt.
    norCost/advCost are 'itemId:amount' -> we keep the amount (costNor=fosterTicket, costAdv=gift diamonds)."""
    global _WT
    if _WT is None:
        _WT = {}
        rows = _read_clientdb_table("WTTemplateCE.txt")
        if rows:
            hdr = rows[0]; ci = {c: i for i, c in enumerate(hdr)}

            def col(r, k):
                i = ci.get(k)
                return r[i] if i is not None and i < len(r) else ""

            def amt(s):
                p = (s or "").split(":")
                try:
                    return int(p[1]) if len(p) > 1 else 0
                except ValueError:
                    return 0
            for r in rows[1:]:
                try:
                    lid = int(col(r, "id"))
                except ValueError:
                    continue

                def num(k):
                    try:
                        return int(float(col(r, k) or 0))
                    except ValueError:
                        return 0
                _WT[lid] = {"needExp": num("needExp"), "norAddExp": num("norAddExp"),
                            "advAddExp": num("advAddExp"), "costNor": amt(col(r, "norCost")),
                            "costAdv": amt(col(r, "advCost")), "oneKeyCost": num("oneKeyCost"),
                            "atk": num("atk"), "def_": num("def"), "hp": num("hp"),
                            "power": num("power")}
        log.info("loaded %d world-tree levels", len(_WT))
    return _WT


# WTTemplate atk/def/hp/power are per-level DELTAS on the x100 display scale (level 1 atk 1000 = +10); the
# client sums 1..currentLevel (getLevelProp is cumulative). So the tree bonus at level L = sum of the deltas
# for levels 1..L, ÷ this scale — same units as the Lab bonus and card stats.
_WT_STAT_SCALE = 100
_WT_CUM_CACHE = None            # {level: {atk,def_,hp,power}} cumulative through that level


def wt_stat_bonus(player):
    """The World Tree's all-deployed-plant stat bonus at the player's tree level: cumulative atk/def/hp
    (÷_WT_STAT_SCALE) summed over levels 1..wt_level. {atk,def_,hp} of ints (>=0)."""
    global _WT_CUM_CACHE
    if _WT_CUM_CACHE is None:
        _WT_CUM_CACHE = {}
        a = d = h = p = 0
        for lv in sorted(load_wt()):
            r = _WT[lv]
            a += r.get("atk", 0); d += r.get("def_", 0); h += r.get("hp", 0); p += r.get("power", 0)
            _WT_CUM_CACHE[lv] = {"atk": a // _WT_STAT_SCALE, "def_": d // _WT_STAT_SCALE,
                                 "hp": h // _WT_STAT_SCALE, "power": p // _WT_STAT_SCALE}
    level = int(player.get("wt_level") or 1)
    cum = _WT_CUM_CACHE.get(level) or _WT_CUM_CACHE.get(max(_WT_CUM_CACHE) if _WT_CUM_CACHE else 0, {})
    return {"atk": cum.get("atk", 0), "def_": cum.get("def_", 0), "hp": cum.get("hp", 0)}


def _wt_max_level():
    lv = load_wt()
    return max(lv) if lv else 1


def _wt_daily_reset(player):
    """Reset the per-day free/half-price foster counters when the calendar day rolls over."""
    today = time.strftime("%Y%m%d")
    if (player.get("wt_day") or "") != today:
        player["wt_free_used"], player["wt_adv_used"], player["wt_day"] = 0, 0, today
        store.save_player(player["uin"], wt_free_used=0, wt_adv_used=0, wt_day=today)


def _encode_wt_info(player):
    """Dto_WorldTree_Info{1:level, 2:exp, 3:freeTimes(used), 4:advancedTimes(used)}."""
    return (pb_varint_field(1, int(player.get("wt_level") or 1))
            + pb_varint_field(2, int(player.get("wt_exp") or 0))
            + pb_varint_field(3, int(player.get("wt_free_used") or 0))
            + pb_varint_field(4, int(player.get("wt_adv_used") or 0)))


def _wt_info_field(player, field):
    """The tree info wrapped as message field `field` (GetInfo/Upgrade use 1, Foster uses 4)."""
    info = _encode_wt_info(player)
    return pb_tag(field, 2) + uvarint(len(info)) + info


def _wt_apply_exp(player, add_exp):
    """Add exp and auto-level while it fills needExp (stops at max level)."""
    level = int(player.get("wt_level") or 1)
    exp = int(player.get("wt_exp") or 0) + add_exp
    maxlv = _wt_max_level()
    while level < maxlv:
        need = load_wt().get(level, {}).get("needExp", 0)
        if need > 0 and exp >= need:
            exp -= need
            level += 1
        else:
            break
    player["wt_level"], player["wt_exp"] = level, exp


def handle_wt_getinfo(cmd_data, player):
    """Cmd_WorldTree_GetInfo_CS -> the tree state. First open also drops the one-time fosterTicket stash."""
    _wt_daily_reset(player)
    msgs = []
    if not int(player.get("wt_granted") or 0):
        player["foster_ticket"] = int(player.get("foster_ticket") or 0) + _WT_STARTER_FOSTER_TICKET
        player["wt_granted"] = 1
        store.save_player(player["uin"], foster_ticket=player["foster_ticket"], wt_granted=1)
        msgs.append(("PVZ.Cmd.Cmd_SyncFosterTicket_SC", pb_varint_field(1, player["foster_ticket"])))
        log.info("    world-tree: granted %d starter fosterTicket", _WT_STARTER_FOSTER_TICKET)
    msgs.append(("PVZ.Cmd.Cmd_WorldTree_GetInfo_SC", _wt_info_field(player, 1)))
    return msgs


def handle_wt_foster(cmd_data, player):
    """Cmd_WorldTree_Foster_CS{fosterType} -> charge the tier, add exp (with a crit roll), auto-level."""
    ftype = parse_varint_fields(cmd_data).get(1, _WT_FOSTERTYPE_NORMAL)
    _wt_daily_reset(player)
    tpl = load_wt().get(int(player.get("wt_level") or 1))
    if not tpl:
        return []
    free_used = int(player.get("wt_free_used") or 0)
    adv_used = int(player.get("wt_adv_used") or 0)
    syncs = []
    if ftype == _WT_FOSTERTYPE_ADVANCED:
        base = tpl["advAddExp"]
        if adv_used < _WT_ADV_HALF_PER_DAY:
            cost, adv_used = tpl["costAdv"] // 2, adv_used + 1
        else:
            cost = tpl["costAdv"]
        spent = _spend_diamonds(player, cost)
        if spent is None:
            return []                                        # can't afford (client normally blocks)
        syncs += spent
        player["wt_adv_used"] = adv_used
    else:                                                    # Normal(1) or Free(3)
        base = tpl["norAddExp"]
        if free_used < _WT_FREE_PER_DAY:
            player["wt_free_used"] = free_used + 1            # a free daily foster
        elif ftype == _WT_FOSTERTYPE_FREE:
            return []                                        # no free times left (client blocks)
        else:
            cost = tpl["costNor"]
            if int(player.get("foster_ticket") or 0) < cost:
                return []
            player["foster_ticket"] = int(player["foster_ticket"]) - cost
            store.save_player(player["uin"], foster_ticket=player["foster_ticket"])
            syncs.append(("PVZ.Cmd.Cmd_SyncFosterTicket_SC", pb_varint_field(1, player["foster_ticket"])))
    is_crit = 1 if random.random() < _WT_CRIT_CHANCE else 0
    add_exp = base * (_WT_CRIT_MULT if is_crit else 1)
    _wt_apply_exp(player, add_exp)
    store.save_player(player["uin"], wt_level=player["wt_level"], wt_exp=player["wt_exp"],
                      wt_free_used=int(player.get("wt_free_used") or 0),
                      wt_adv_used=int(player.get("wt_adv_used") or 0))
    body = (pb_varint_field(1, ftype) + pb_varint_field(2, is_crit)
            + pb_varint_field(3, add_exp) + _wt_info_field(player, 4))
    log.info("    world-tree: foster type=%d crit=%d +%d exp -> lv%d exp%d",
             ftype, is_crit, add_exp, player["wt_level"], player["wt_exp"])
    return [("PVZ.Cmd.Cmd_WorldTree_Foster_SC", body)] + syncs


def handle_wt_upgrade(cmd_data, player):
    """Cmd_WorldTree_Upgrade_CS -> one-key: spend the level's oneKeyCost diamonds for +1 level
    (only levels with oneKeyCost>0, i.e. 200+, allow this; client greys the button otherwise)."""
    _wt_daily_reset(player)
    level = int(player.get("wt_level") or 1)
    tpl = load_wt().get(level)
    if not tpl or level >= _wt_max_level() or tpl["oneKeyCost"] <= 0:
        return []
    spent = _spend_diamonds(player, tpl["oneKeyCost"])
    if spent is None:
        return []
    player["wt_level"] = level + 1
    store.save_player(player["uin"], wt_level=player["wt_level"])
    log.info("    world-tree: one-key upgrade -> lv%d (cost %d diamonds)",
             player["wt_level"], tpl["oneKeyCost"])
    return [("PVZ.Cmd.Cmd_WorldTree_Upgrade_SC", _wt_info_field(player, 1))] + spent


# ===== Trial Road (试炼之路, Building_TrialRoad=200) — SAFE-OPEN STUB, full build deferred =====
# ===================== Trial Road (试炼之路, ScrewUp=Normal / NewScrewUp=Hard, Building unlocks @L15) =====================
# A 150-stage adventure-style battle CLIMB. Progress is PERSISTENT (tr_max = best stage reached); DAILY you
# farm Upgrade/Equipment materials — the higher you've climbed, the bigger the daily haul (wiki). Wire (both
# modes share the layout): GetInfo_SC{1:currentStage,2:maxStage,3:restartNum,4:boxTaken[],5:boxTotal[],
# 6:remainTime(=leftBattleTimes),7:vipRestartNum}; Fight_CS{1:stageId,2:isSweep}->Fight_SC{1:stageId,2:isSweep,
# 3:report(Dto_FightReport),4:firstPass,5:win,6:rewardList[]}; TakeReward_CS{1:stageId}->TakeReward_SC{1:stageId,
# 2:rewardList[]}; SendFormation_SC{1:formation}; SetFormation_CS{1:formation}; Restart_SC{1:result,2:restartNum,
# 3:vipRestartNum}; Sweep_SC{1:currentStageId,2:rewardList[]}. The client fights currentStage+1 (onClickPt); the
# report carries fightType=ScrewUp(11) so FightChestsWDMedator opens FightResultWD_TrialLoad (win AND loss).
# Model: a WIN advances currentStage. A NEW-frontier win (stage>maxStage) raises maxStage, costs one daily
# battle time, and grants firstReward. A re-clear (stage<=maxStage, after a Restart) grants sweepReward for
# free. Restart resets currentStage to 0 to re-run the ladder. Chests at milestone stages give the big bundles.
# Hard mode (NewScrewUp) is kept a safe empty stub for now (opens, no climb) — see the memory.
_TR_NORMAL = None
_TR_DAILY_BATTLES = 10        # NEW-stage climbs allowed per day (leftBattleTimes)
_TR_DAILY_RESTARTS = 5        # free restarts per day (re-run the ladder for materials)


def load_trial_road():
    """{stage: {power, first:[(id,n)], sweep:[(id,n)], chest:[(id,n)]}} from clientDB trialRoad.txt."""
    global _TR_NORMAL
    if _TR_NORMAL is None:
        _TR_NORMAL = {}
        rows = _read_clientdb_table("trialRoad.txt")
        if rows:
            hdr = rows[0]; ci = {c: i for i, c in enumerate(hdr)}

            def col(r, k):
                i = ci.get(k)
                return r[i] if i is not None and i < len(r) else ""
            for r in rows[1:]:
                try:
                    sid = int(col(r, "id"))
                except ValueError:
                    continue
                _TR_NORMAL[sid] = {
                    "power": int(float(col(r, "power") or 0)),
                    "first": _tr_parse_reward(col(r, "firstRewardStr")),
                    "sweep": _tr_parse_reward(col(r, "sweepReardStr")),
                    "chest": _tr_parse_reward(col(r, "chestItemsStr")),
                }
        log.info("loaded %d trial-road stages", len(_TR_NORMAL))
    return _TR_NORMAL


def _tr_parse_reward(spec):
    """'id:num,id:num' (Trial Road uses COMMA separators, unlike fuben's ';') -> [(itemId, num)]."""
    out = []
    for part in re.split(r"[,;]", spec or ""):
        if ":" in part:
            a, b = part.split(":", 1)
            try:
                out.append((int(a), int(b)))
            except ValueError:
                pass
    return out


def _tr_chest_stages():
    """Sorted stageIds that award a milestone chest (non-empty chestItemsStr)."""
    return sorted(s for s, d in load_trial_road().items() if d["chest"])


def _tr_daily_reset(player):
    """Reset the per-day climb/restart counters when the calendar day rolls over (currentStage persists)."""
    today = time.strftime("%Y%m%d")
    if (player.get("tr_day") or "") != today:
        player["tr_battles_used"], player["tr_restarts_used"], player["tr_day"] = 0, 0, today
        store.save_player(player["uin"], tr_battles_used=0, tr_restarts_used=0, tr_day=today)


def _tr_boxes_taken(player):
    return [int(x) for x in (player.get("tr_boxes") or "").split(",") if x.strip().isdigit()]


def _tr_reward_bytes(field, reward_items):
    """Repeated Dto_ItemInfo reward list as message `field` (rewardList) bytes."""
    d = b""
    for iid, num in reward_items:
        dto = build_item_dto(iid, num)
        d += pb_tag(field, 2) + uvarint(len(dto)) + dto
    return d


def make_trialroad_getinfo(player):
    """GetInfo_SC body from the player's Trial Road state (currentStage/maxStage, daily battles/restarts
    left, milestone chests unlocked/claimed)."""
    cur, mx = int(player.get("tr_current") or 0), int(player.get("tr_max") or 0)
    restarts_left = max(0, _TR_DAILY_RESTARTS - int(player.get("tr_restarts_used") or 0))
    battles_left = max(0, _TR_DAILY_BATTLES - int(player.get("tr_battles_used") or 0))
    d = pb_varint_field(1, cur) + pb_varint_field(2, mx) + pb_varint_field(3, restarts_left)
    for s in _tr_boxes_taken(player):
        d += pb_varint_field(4, s)                              # boxTaken[]
    for s in _tr_chest_stages():
        if s <= mx:
            d += pb_varint_field(5, s)                          # boxTotal[] (chests unlocked by progress)
    d += pb_varint_field(6, battles_left) + pb_varint_field(7, 0)   # remainTime(leftBattleTimes), vipRestartNum
    return d


def _trialroad_formation_msg(player, sc_name):
    """The player's team as a (sc_name, SendFormation_SC{formation}) message — same team as adventure."""
    ensure_player_cards(player)
    formation = build_formation_info(player, 1, default_formation_placements(player))
    return (sc_name, pb_tag(1, 2) + uvarint(len(formation)) + formation)


def handle_screwup_getinfo(cmd_data, player):
    """Cmd_ScrewUp_GetInfo_CS (Trial Road, Normal) -> the real climb + daily state, and PUSH the formation
    so the scene has the team without a separate request."""
    _tr_daily_reset(player)
    return [("PVZ.Cmd.Cmd_ScrewUp_GetInfo_SC", make_trialroad_getinfo(player)),
            _trialroad_formation_msg(player, "PVZ.Cmd.Cmd_ScrewUp_SendFormation_SC")]


def handle_screwup_getformation(cmd_data, player):
    """Cmd_ScrewUp_GetFormation_CS -> Cmd_ScrewUp_SendFormation_SC{formation} (same team as adventure)."""
    return [_trialroad_formation_msg(player, "PVZ.Cmd.Cmd_ScrewUp_SendFormation_SC")]


def handle_screwup_setformation(cmd_data, player):
    """Cmd_ScrewUp_SetFormation_CS{formation} -> persist the team (team 1) + echo SendFormation_SC."""
    placements = {}
    fsub = parse_repeated_submessages(cmd_data, 1)
    if fsub:
        for cp in parse_repeated_submessages(fsub[0], 1):
            c = parse_varint_fields(cp)
            pos, uid = c.get(1, 0), c.get(2, 0)
            if pos and uid:
                placements[pos] = uid
    if placements:
        store.set_formation(player["uin"], 1, placements)
    log.info("    trial road SET formation: %s", placements)
    return [_trialroad_formation_msg(player, "PVZ.Cmd.Cmd_ScrewUp_SendFormation_SC")]


def _tr_enemy_squad(power, stage):
    """A themed zombie squad totalling ~`power` Fighting Power for a trial stage (world rotates by tier so
    the climb changes scenery: Egypt -> Great Wall -> Pirate -> Future across the 150 stages)."""
    world = ("egypt", "greatwall", "pirate", "future")[min(3, (stage - 1) // 38)]
    cards = [c for c in _WORLD_ZOMBIES.get(world, _DEFAULT_ENEMY_CARDS) if c in _BATTLE_CARDS] \
        or [c for c in _DEFAULT_ENEMY_CARDS if c in _BATTLE_CARDS] or [next(iter(_BATTLE_CARDS), 111)]
    count = max(1, min(3 + (stage - 1) // 15, len(_ENEMY_POS)))
    z_power = max(1, power // count)
    z_hp = max(1, z_power * 9 // _ZOMBIE_HP_TEST_DIVISOR)
    atk, dfn = _enemy_atk_def(z_power)
    right = []
    for i in range(count):
        zc = cards[i % len(cards)]
        zst = _BATTLE_CARDS.get(zc, {"skill1": 0, "name": "Zombie"})
        right.append({"pos": _ENEMY_POS[i], "card_id": zc, "hp": z_hp, "atk": atk, "def_": dfn,
                      "skill1": zst.get("skill1", 0), "skill2": zst.get("skill2", 0), "level": 1,
                      "is_leader": i == 0, "power": z_power, "name": zst.get("name", "Zombie")})
    return right


def handle_screwup_fight(cmd_data, player):
    """Cmd_ScrewUp_Fight_CS{stageId,isSweep} -> Cmd_ScrewUp_Fight_SC{stageId,isSweep,report,firstPass,win,
    rewardList}. Fights stageId (= currentStage+1) with the losable combat. A WIN advances the climb; a
    first-clear (stage>maxStage) costs a daily battle time + grants firstReward, a re-clear grants
    sweepReward for free; a LOSS advances nothing and grants nothing (retry). Reward -> report.leftSide.
    reward (FightResultWD_TrialLoad reads that) + granted server-side."""
    f = parse_varint_fields(cmd_data)
    stage_id = f.get(1, 0)
    _tr_daily_reset(player)
    lvl_data = load_trial_road().get(stage_id)
    if not lvl_data:
        return []
    uin = player["uin"]
    cur, mx = int(player.get("tr_current") or 0), int(player.get("tr_max") or 0)
    is_new = stage_id > mx
    battles_left = max(0, _TR_DAILY_BATTLES - int(player.get("tr_battles_used") or 0))
    # The client only lets you fight currentStage+1, and gates a NEW stage on leftBattleTimes; guard both.
    if stage_id != cur + 1 or (is_new and battles_left <= 0):
        log.info("    trial road fight REJECTED: stage=%d cur=%d max=%d battlesLeft=%d",
                 stage_id, cur, mx, battles_left)
        return []
    left_units = build_player_units(player)
    right_units = _tr_enemy_squad(lvl_data["power"], stage_id)
    won, lp, rp = resolve_battle(left_units, right_units)
    rounds = simulate_battle(left_units, right_units, won) if (left_units and right_units) else []
    replay_bytes = encode_fight_replay(rounds)
    reward_items = (lvl_data["first"] if is_new else lvl_data["sweep"]) if won else []
    report = build_fight_report(player, 0, 0, stage_id, won, reward_items, is_new,
                                left_units, right_units, replay_bytes, card_exp_gain=0,
                                fight_type=11)   # BattleTargetType_ScrewUp -> FightResultWD_TrialLoad
    fight_sc = (pb_varint_field(1, stage_id) + pb_varint_field(2, 0)          # stageId, isSweep=false
                + pb_tag(3, 2) + uvarint(len(report)) + report                # report
                + pb_bool(4, won and is_new) + pb_bool(5, won)                # firstPass, win
                + _tr_reward_bytes(6, reward_items))                          # rewardList[]
    msgs = [("PVZ.Cmd.Cmd_ScrewUp_Fight_SC", fight_sc)]
    if won:
        player["tr_current"] = stage_id
        if is_new:
            player["tr_max"] = stage_id
            player["tr_battles_used"] = int(player.get("tr_battles_used") or 0) + 1
        store.save_player(uin, tr_current=player["tr_current"], tr_max=int(player.get("tr_max") or mx),
                          tr_battles_used=int(player.get("tr_battles_used") or 0))
        msgs += grant_fuben_reward(player, reward_items)
        # Push a fresh GetInfo so the scene unlocks the next stage IMMEDIATELY: the client's proxy never
        # advances its own currentStage on a win (only the server does) — onCmd_Fight_SC just re-renders
        # from cached data — so without this the next level stays locked until you leave and re-enter.
        msgs.append(("PVZ.Cmd.Cmd_ScrewUp_GetInfo_SC", make_trialroad_getinfo(player)))
        log.info("    TRIAL ROAD %s: stage=%d WIN (team %d vs %d 战力) reward=%s -> cur=%d max=%d",
                 "CLIMB" if is_new else "RECLEAR", stage_id, lp, rp, reward_items,
                 player["tr_current"], int(player.get("tr_max") or 0))
    else:
        log.info("    TRIAL ROAD FIGHT: stage=%d LOSS (team %d vs %d 战力) — no advance, retry",
                 stage_id, lp, rp)
    return msgs


def handle_screwup_sweep(cmd_data, player):
    """Cmd_ScrewUp_Sweep_CS -> Cmd_ScrewUp_Sweep_SC{currentStageId,rewardList}. Bulk re-clears every beaten
    stage from currentStage+1..maxStage for their sweepReward (the daily material haul), jumping
    currentStage to maxStage."""
    _tr_daily_reset(player)
    tr = load_trial_road()
    cur, mx = int(player.get("tr_current") or 0), int(player.get("tr_max") or 0)
    merged = {}
    for s in range(cur + 1, mx + 1):
        for iid, num in tr.get(s, {}).get("sweep", []):
            merged[iid] = merged.get(iid, 0) + num
    reward_items = sorted(merged.items())
    player["tr_current"] = mx
    store.save_player(player["uin"], tr_current=mx)
    msgs = [("PVZ.Cmd.Cmd_ScrewUp_Sweep_SC", pb_varint_field(1, mx) + _tr_reward_bytes(2, reward_items))]
    msgs += grant_fuben_reward(player, reward_items)
    log.info("    TRIAL ROAD SWEEP: stages %d..%d -> currentStage=%d reward=%s", cur + 1, mx, mx, reward_items)
    return msgs


def handle_screwup_takereward(cmd_data, player):
    """Cmd_ScrewUp_TakeReward_CS{stageId} -> Cmd_ScrewUp_TakeReward_SC{stageId,rewardList}. Claim the
    one-time milestone chest at stageId (chestItemsStr), if unlocked (stageId<=maxStage) and not taken."""
    stage_id = parse_varint_fields(cmd_data).get(1, 0)
    lvl = load_trial_road().get(stage_id)
    mx = int(player.get("tr_max") or 0)
    taken = _tr_boxes_taken(player)
    if not lvl or not lvl["chest"] or stage_id > mx or stage_id in taken:
        return []
    taken.append(stage_id)
    player["tr_boxes"] = ",".join(str(s) for s in sorted(taken))
    store.save_player(player["uin"], tr_boxes=player["tr_boxes"])
    reward_items = lvl["chest"]
    msgs = [("PVZ.Cmd.Cmd_ScrewUp_TakeReward_SC",
             pb_varint_field(1, stage_id) + _tr_reward_bytes(2, reward_items))]
    msgs += grant_fuben_reward(player, reward_items)
    log.info("    TRIAL ROAD CHEST: stage=%d reward=%s", stage_id, reward_items)
    return msgs


def handle_screwup_restart(cmd_data, player):
    """Cmd_ScrewUp_Restart_CS -> Cmd_ScrewUp_Restart_SC{result,restartNum,vipRestartNum}. Reset the climb
    position to 0 (to re-run/sweep the ladder), consuming one daily restart."""
    _tr_daily_reset(player)
    used = int(player.get("tr_restarts_used") or 0)
    if used >= _TR_DAILY_RESTARTS:
        return [("PVZ.Cmd.Cmd_ScrewUp_Restart_SC", pb_varint_field(1, 0)          # result=0 (out of restarts)
                 + pb_varint_field(2, 0) + pb_varint_field(3, 0))]
    player["tr_restarts_used"], player["tr_current"] = used + 1, 0
    store.save_player(player["uin"], tr_restarts_used=player["tr_restarts_used"], tr_current=0)
    left = max(0, _TR_DAILY_RESTARTS - player["tr_restarts_used"])
    log.info("    TRIAL ROAD RESTART: currentStage->0 (%d restarts left today)", left)
    # Restart_SC only updates restartNum client-side (not currentStage), so push a fresh GetInfo to
    # re-render the ladder at currentStage=0 (otherwise the scene keeps the old position until re-entry).
    return [("PVZ.Cmd.Cmd_ScrewUp_Restart_SC", pb_varint_field(1, 1)              # result=1
             + pb_varint_field(2, left) + pb_varint_field(3, 0)),
            ("PVZ.Cmd.Cmd_ScrewUp_GetInfo_SC", make_trialroad_getinfo(player))]


def handle_newscrewup_getinfo(cmd_data, player):
    """Cmd_NewScrewUp_GetInfo_CS (Trial Road, HARD) -> empty-tower state (safe open; Hard climb deferred).
    remainTime=0 blocks the fight path; also push the formation so the Hard scene renders the team."""
    return [("PVZ.Cmd.Cmd_NewScrewUp_GetInfo_SC",
             pb_varint_field(1, 0) + pb_varint_field(2, 0) + pb_varint_field(3, 0)
             + pb_varint_field(6, 0) + pb_varint_field(7, 0)),
            _trialroad_formation_msg(player, "PVZ.Cmd.Cmd_NewScrewUp_SendFormation_SC")]


def handle_newscrewup_getformation(cmd_data, player):
    """Cmd_NewScrewUp_GetFormation_CS -> Cmd_NewScrewUp_SendFormation_SC{formation} (Hard, same team)."""
    return [_trialroad_formation_msg(player, "PVZ.Cmd.Cmd_NewScrewUp_SendFormation_SC")]


# ================================ VIP (会员, 3 tiers — GM-set on this private server) ================================
# VIP is a membership that grants a BUNDLE of privileges (VipInfo.txt privilegeString "id:param;..."). The
# client's PrivilegeProxy.hasPrivilege(id) simply checks the list the server sends in Cmd_PVZPrivilege_SC, and
# the badge/UI reads Cmd_VipInfo_SC (Dto_VipInfo.cardId=tier). So VIP is fully server-driven: set vip_level
# (0-3) and push both messages at login. Most privileges then work CLIENT-side (4x battle speed, sweeps, UI);
# the server delivers the rest: the exclusive Winter Melon plant (priv 41), the deployed-plant stat boosts
# (priv 25-28), and the daily energy(13)/diamond(24) gifts. Tiers: 1 阳光VIP1, 2 财富VIP2, 3 金壶VIP3.
_VIP_PLANT = 6900              # 冰冻西瓜 (Winter Melon) — the VIP3 exclusive TD plant (priv 41)
_VIP_PRIV_ENDTIME = 4102444800  # 2100-01-01 UTC — far future so privileges never read as expired
# Deployed-plant stat boost per VIP stat privilege (25-28 = the "VIP exclusive Lab tech"). Values from the
# VipPrivilegeInfo names (+atk/def/hp/ability); applied server-side like the Lab / World Tree bonuses.
_VIP_STAT_PRIV = {25: ("atk", 100), 26: ("def_", 50), 27: ("hp", 300), 28: ("ability", 50)}
_VIP_ENERGY_PRIV = 13          # daily energy gift (privilege param = amount)
_VIP_DIAMOND_PRIV = 24         # daily diamond gift (privilege param = amount)
_VIP_PLANT_PRIV = 41           # TD exclusive plant (Winter Melon)
_VIP_TIERS = None


def load_vip_tiers():
    """{level: {cardId, name, price, privileges:{id:param}, gift:[(id,n)]}} for the 3 PAID VIP tiers
    (vipType=1) from clientDB VipInfo.txt. privilegeString 'id:param;...' -> {id:param}."""
    global _VIP_TIERS
    if _VIP_TIERS is None:
        _VIP_TIERS = {}
        rows = _read_clientdb_table("VipInfo.txt")
        if rows:
            hdr = rows[0]; ci = {c: i for i, c in enumerate(hdr)}

            def col(r, k):
                i = ci.get(k)
                return r[i] if i is not None and i < len(r) else ""

            def parse_privs(s):
                out = {}
                for p in (s or "").split(";"):
                    if ":" in p:
                        a, b = p.split(":", 1)
                        try:
                            out[int(a)] = int(b)
                        except ValueError:
                            pass
                return out
            for r in rows[1:]:
                if col(r, "vipType") != "1":       # paid tiers only (levels 1/2/3)
                    continue
                try:
                    lvl = int(col(r, "level"))
                except ValueError:
                    continue
                _VIP_TIERS[lvl] = {
                    "cardId": int(col(r, "id")), "name": col(r, "name"),
                    "price": int(float(col(r, "price") or 0)),
                    "privileges": parse_privs(col(r, "privilegeString")),
                    "gift": _tr_parse_reward(col(r, "giftString")),   # giftString also uses ; / , item lists
                }
        log.info("loaded %d VIP tiers", len(_VIP_TIERS))
    return _VIP_TIERS


def vip_tier(player):
    """The tier dict for the player's vip_level, or None (no VIP)."""
    lvl = int(player.get("vip_level") or 0)
    return load_vip_tiers().get(lvl) if lvl else None


def vip_privileges(player):
    """{privilegeId: param} the player currently has from their VIP tier ({} if not VIP)."""
    t = vip_tier(player)
    return t["privileges"] if t else {}


def vip_stat_bonus(player):
    """Deployed-plant stat boost from the player's VIP stat privileges (25-28). {atk,def_,hp,ability}."""
    bonus = {"atk": 0, "def_": 0, "hp": 0, "ability": 0}
    privs = vip_privileges(player)
    for pid, (field, val) in _VIP_STAT_PRIV.items():
        if pid in privs:
            bonus[field] += val
    return bonus


def _vip_daily_reset(player):
    """Reset the per-day VIP gift flags (energy/diamond) when the calendar day rolls over."""
    today = time.strftime("%Y%m%d")
    if (player.get("vip_day") or "") != today:
        player["vip_energy_taken"], player["vip_ticket_taken"], player["vip_day"] = 0, 0, today
        store.save_player(player["uin"], vip_energy_taken=0, vip_ticket_taken=0, vip_day=today)


def build_pvzprivilege_sc(player):
    """Cmd_PVZPrivilege_SC{privilege(1)=[Dto_PVZPrivilege{privilegeId(1),privilegeParam(2),endTime(3)}]}.
    The list the client's hasPrivilege() checks — send the whole tier's privilege set. Empty for non-VIP."""
    d = b""
    for pid, param in sorted(vip_privileges(player).items()):
        dto = (pb_varint_field(1, pid) + pb_varint_field(2, param)
               + pb_varint_field(3, _VIP_PRIV_ENDTIME))
        d += pb_tag(1, 2) + uvarint(len(dto)) + dto
    return d


def build_vipinfo_sc(player):
    """Cmd_VipInfo_SC{vipInfo(1)=Dto_VipInfo}. Dto_VipInfo{cardId(1),endTime(2),gotGift(3),todayEnergy(4),
    renewalPrice(5),type(6),bHasVip3Privilege(7),todayTicket(8),hasTakenEnergy(9),hasTakenTicket(10),
    hasRenewGift(11)}. cardId=0 => no VIP."""
    _vip_daily_reset(player)
    t = vip_tier(player)
    if not t:
        info = pb_varint_field(1, 0) + pb_varint_field(6, 0)
        return pb_tag(1, 2) + uvarint(len(info)) + info
    privs = t["privileges"]
    lvl = int(player.get("vip_level") or 0)
    info = (pb_varint_field(1, t["cardId"])                            # cardId (the tier)
            + pb_varint_field(2, _VIP_PRIV_ENDTIME)                    # endTime
            + pb_varint_field(3, int(player.get("vip_gift_taken") or 0))       # gotGift (activation gift)
            + pb_varint_field(4, privs.get(_VIP_ENERGY_PRIV, 0))              # todayEnergy amount
            + pb_varint_field(5, t["price"])                          # renewalPrice
            + pb_varint_field(6, 1)                                   # type = paid
            + pb_varint_field(7, 1 if lvl >= 3 else 0)                # bHasVip3Privilege
            + pb_varint_field(8, privs.get(_VIP_DIAMOND_PRIV, 0))            # todayTicket amount
            + pb_varint_field(9, int(player.get("vip_energy_taken") or 0))    # hasTakenEnergy
            + pb_varint_field(10, int(player.get("vip_ticket_taken") or 0))   # hasTakenTicket
            + pb_varint_field(11, 0))                                 # hasRenewGift
    return pb_tag(1, 2) + uvarint(len(info)) + info


def vip_login_messages(player):
    """The VIP state pushed right after Cmd_Init_SC: the privilege list (populates hasPrivilege) + the VIP
    info (badge/tier UI). Sent for everyone (non-VIP gets an empty list + cardId 0)."""
    _vip_daily_reset(player)
    return [("PVZ.Cmd.Cmd_PVZPrivilege_SC", build_pvzprivilege_sc(player)),
            ("PVZ.Cmd.Cmd_VipInfo_SC", build_vipinfo_sc(player))]


def handle_vip_getinfo(cmd_data, player):
    """Cmd_VipInfo_CS -> Cmd_VipInfo_SC (when the VIP window opens / refreshes)."""
    return [("PVZ.Cmd.Cmd_VipInfo_SC", build_vipinfo_sc(player))]


def handle_pvzprivilege_getinfo(cmd_data, player):
    """Cmd_PVZPrivilege_CS -> Cmd_PVZPrivilege_SC (client re-requesting the privilege list)."""
    return [("PVZ.Cmd.Cmd_PVZPrivilege_SC", build_pvzprivilege_sc(player))]


def handle_vip_getgift(cmd_data, player):
    """Cmd_VipGetGift_CS -> Cmd_VipGetGift_SC{itemList} — the one-time first-activation gift (giftString)."""
    t = vip_tier(player)
    if not t or not t["gift"] or int(player.get("vip_gift_taken") or 0):
        return []
    player["vip_gift_taken"] = 1
    store.save_player(player["uin"], vip_gift_taken=1)
    body = b""
    for iid, num in t["gift"]:
        dto = build_item_dto(iid, num)
        body += pb_tag(1, 2) + uvarint(len(dto)) + dto              # itemList
    msgs = [("PVZ.Cmd.Cmd_VipGetGift_SC", body)]
    msgs += grant_fuben_reward(player, t["gift"])
    msgs.append(("PVZ.Cmd.Cmd_VipInfo_SC", build_vipinfo_sc(player)))
    log.info("    VIP activation gift claimed (uin=%d tier=%d): %s", player["uin"], player["vip_level"], t["gift"])
    return msgs


def handle_vip_gettodayenergy(cmd_data, player):
    """Cmd_Vip_GetTodayEnergy_CS -> claim the daily VIP energy gift (priv 13 param) + SyncEnergy + VipInfo."""
    _vip_daily_reset(player)
    amt = vip_privileges(player).get(_VIP_ENERGY_PRIV, 0)
    if not amt or int(player.get("vip_energy_taken") or 0):
        return [("PVZ.Cmd.Cmd_Vip_GetTodayEnergy_SC", b"")]
    player["vip_energy_taken"] = 1
    player["energy"] = current_energy(player) + amt        # fold regen in first, then add (may overflow cap)
    store.save_player(player["uin"], vip_energy_taken=1, energy=player["energy"])
    log.info("    VIP daily energy gift: +%d energy (uin=%d)", amt, player["uin"])
    return [("PVZ.Cmd.Cmd_Vip_GetTodayEnergy_SC", b""),
            ("PVZ.Cmd.Cmd_SyncEnergy_SC", pb_varint_field(1, player["energy"])),
            ("PVZ.Cmd.Cmd_VipInfo_SC", build_vipinfo_sc(player))]


def handle_vip_gettodayticket(cmd_data, player):
    """Cmd_Vip_GetTodayTicket_CS -> claim the daily VIP diamond gift (priv 24 param, item 4) + VipInfo."""
    _vip_daily_reset(player)
    amt = vip_privileges(player).get(_VIP_DIAMOND_PRIV, 0)
    if not amt or int(player.get("vip_ticket_taken") or 0):
        return [("PVZ.Cmd.Cmd_Vip_GetTodayTicket_SC", b"")]
    player["vip_ticket_taken"] = 1
    store.save_player(player["uin"], vip_ticket_taken=1)
    log.info("    VIP daily diamond gift: +%d diamond (uin=%d)", amt, player["uin"])
    msgs = [("PVZ.Cmd.Cmd_Vip_GetTodayTicket_SC", b"")]
    msgs += grant_fuben_reward(player, [(4, amt)])   # item 4 = gift diamond (present_ticket)
    msgs.append(("PVZ.Cmd.Cmd_VipInfo_SC", build_vipinfo_sc(player)))
    return msgs


# ============================ Nutrition Room (营养室, Building_Nutrition=170) ============================
# A reagent (试剂) system that grants flat combat stats to the deployed team, like the Lab/World Tree.
# TWO entry points, both driving ModuleNutrition/ModuleNutritionExchange:
#   - Building 170 (gotoNutrition, L22): the full room = OBTAIN view (click a "dietician plant" to CALL a
#     reagent into a temp bag, then collect it) + USE view (equip owned reagents onto the 7 plant positions).
#   - The Player's House 营养 button (NutritionExchangeViewCmd): a "Fast Exchange" that bulk-swaps all the
#     reagents equipped on one plant position with another (Cmd_Nutrition_ExchangePosition).
# Reagent baseId = 60<tier><stat> (tier 1..5 = quality 2..6/green..red; stat 1..8 = ATK/DEF/HP/ABILITY/
# HIT/DODGE/CRIT/TOUGH). nutritionProperty.txt maps (baseId, level) -> propertyType(=buffType)/quality/
# propertyValue(=buffValue). buffValue is /_NUTRITION_SCALE(100) to a stat point, same scale as the Lab, so
# equipping a green ATK reagent = +220 atk on every deployed plant. 7 positions x 8 grids (grids 5-8 unlock
# at role level 20/25/30/35). A plant can't hold two reagents of the same stat type.
_NUTRITION_SCALE = 100
_NUTRITION_POSITIONS = [3, 7, 9, 11, 13, 15, 17]     # the 7 left/plant embattle positions
_NUTRITION_SLOT_LEVELS = {5: 20, 6: 25, 7: 30, 8: 35}  # grids 1-4 free; 5-8 role-level gated
_NUTRITION_TEMP_MAX = 14                              # CONST_TEMP_BAG_BOUNDS
_NUTRITION_BAG_MAX = 18                               # NUTRITION_USE_BAG_MAX (unequipped reagents)
_NUTRITION_GOLD_REAGENT = 60000                       # CONST_GOLD_REAGENT (exchange currency)
_NUTRITION_WHITE_RESIDUAL = 60001                     # CONST_WHITE_RESIDUAL (junk -> bottle exp)
_NUTRITION_STAT_FIELDS = {1: "atk", 2: "def_", 3: "hp", 5: "ability"}   # buffType -> combat stat
# Per-dietician quality tier weights (higher dietician/cost -> better reagents). tier -> baseId 60<tier>0<stat>.
_NUTRITION_DIETICIAN_TIERS = {
    1: [(1, 90), (2, 10)],
    2: [(1, 55), (2, 40), (3, 5)],
    3: [(2, 50), (3, 40), (4, 10)],
    4: [(3, 50), (4, 40), (5, 10)],
    5: [(4, 45), (5, 55)],
    6: [(4, 30), (5, 70)],
}
_NUTRITION_OBTAIN = None
_NUTRITION_PROP = None


def _nut_cost(spec):
    """Parse an 'id:num;id:num' cost/need string into [(itemId, num)]."""
    out = []
    for part in (spec or "").replace(" ", "").split(";"):
        if ":" in part:
            a, b = part.split(":", 1)
            try:
                out.append((int(a), int(b)))
            except ValueError:
                pass
    return out


def load_nutrition_obtain():
    """{dieticianId: {cost:[(iid,num)], spCost:[(iid,num)]}} from nutritionObtain.txt (6 dieticians)."""
    global _NUTRITION_OBTAIN
    if _NUTRITION_OBTAIN is None:
        _NUTRITION_OBTAIN = {}
        rows = _read_clientdb_table("nutritionObtain.txt")
        if rows:
            hdr = rows[0]; ci = {c: i for i, c in enumerate(hdr)}

            def col(r, k):
                i = ci.get(k)
                return r[i] if i is not None and i < len(r) else ""
            for r in rows[1:]:
                try:
                    did = int(col(r, "id"))
                except ValueError:
                    continue
                _NUTRITION_OBTAIN[did] = {"cost": _nut_cost(col(r, "originalCost")),
                                          "spCost": _nut_cost(col(r, "originalSpCost"))}
        log.info("loaded %d nutrition dieticians", len(_NUTRITION_OBTAIN))
    return _NUTRITION_OBTAIN


def load_nutrition_property():
    """{baseId: {type, quality, levels:{lv:(value,exp,needExp)}, maxlv}} from nutritionProperty.txt."""
    global _NUTRITION_PROP
    if _NUTRITION_PROP is None:
        _NUTRITION_PROP = {}
        rows = _read_clientdb_table("nutritionProperty.txt")
        if rows:
            hdr = rows[0]; ci = {c: i for i, c in enumerate(hdr)}

            def col(r, k):
                i = ci.get(k)
                return r[i] if i is not None and i < len(r) else "0"
            for r in rows[1:]:
                try:
                    bid = int(col(r, "itemID")); lv = int(col(r, "level"))
                    pt = int(col(r, "propertyType")); q = int(col(r, "quality"))
                    pv = int(col(r, "propertyValue")); ex = int(col(r, "exp")); ne = int(col(r, "needExp"))
                except ValueError:
                    continue
                d = _NUTRITION_PROP.setdefault(bid, {"type": pt, "quality": q, "levels": {}, "maxlv": 1})
                d["type"] = pt; d["quality"] = q
                d["levels"][lv] = (pv, ex, ne)
                d["maxlv"] = max(d["maxlv"], lv)
        log.info("loaded %d nutrition reagent bases", len(_NUTRITION_PROP))
    return _NUTRITION_PROP


def _reagent_props(base_id, level):
    """(buffType, buffValue, quality) for a reagent at `level` (clamped to its maxlv)."""
    d = load_nutrition_property().get(base_id)
    if not d:
        return (0, 0, 1)
    lv = max(1, min(int(level), d["maxlv"]))
    pv = d["levels"].get(lv, d["levels"].get(1, (0, 0, 0)))[0]
    return (d["type"], pv, d["quality"])


def _reagent_fight_power(base_id, level):
    """A reagent's contribution to the 战力 display (buffValue folded to the stat-point scale)."""
    _, bv, _ = _reagent_props(base_id, level)
    return max(1, bv // _NUTRITION_SCALE)


def _is_real_reagent(base_id):
    """True for an equippable reagent (not the gold/white-residual currencies, and a known stat type)."""
    if base_id in (_NUTRITION_GOLD_REAGENT, _NUTRITION_WHITE_RESIDUAL):
        return False
    d = load_nutrition_property().get(base_id)
    return bool(d) and d["type"] != 0


def _encode_reagent_dto(r):
    """Dto_Reagent from a stored {uid, base_id, level, position, slot_id}."""
    bt, bv, q = _reagent_props(r["base_id"], r["level"])
    body = pb_int64_field(1, r["uid"])
    body += pb_varint_field(2, r["base_id"])
    body += pb_varint_field(3, q)
    body += pb_varint_field(4, max(1, int(r["level"])))
    body += pb_varint_field(5, 0)                               # exp progress (leveling deferred)
    body += pb_varint_field(6, bt)                              # buffType
    body += pb_varint_field(7, bv)                              # buffValue
    body += pb_varint_field(8, r["position"])
    body += pb_varint_field(9, r["slot_id"])
    body += pb_varint_field(10, _reagent_fight_power(r["base_id"], r["level"]))
    return body


def nutrition_stat_bonus(player):
    """The all-deployed-plant stat bonus from EQUIPPED reagents. {atk,def_,hp,ability} (buffValue/100).
    Only ATK/DEF/HP/ABILITY feed combat; HIT/DODGE/CRIT/TOUGH reagents still show in the room UI."""
    bonus = {"atk": 0, "def_": 0, "hp": 0, "ability": 0}
    uin = player.get("uin")
    if not uin:
        return bonus
    for r in store.get_reagents(uin):
        if r["slot_id"] <= 0 or r["position"] <= 0:
            continue
        bt, bv, _ = _reagent_props(r["base_id"], r["level"])
        field = _NUTRITION_STAT_FIELDS.get(bt)
        if field:
            bonus[field] += bv // _NUTRITION_SCALE
    return bonus


def _nutrition_roll(dietician_id):
    """Roll one reagent baseId from a dietician: pick a quality tier by that dietician's weights, then a
    uniform stat type. baseId = 60<tier>0<stat>."""
    tiers = _NUTRITION_DIETICIAN_TIERS.get(dietician_id, [(1, 100)])
    total = sum(w for _, w in tiers)
    pick = random.randint(1, total)
    tier, acc = tiers[-1][0], 0
    for t, w in tiers:
        acc += w
        if pick <= acc:
            tier = t
            break
    stat = random.randint(1, 8)
    return 60000 + tier * 100 + stat


def _nutrition_temp_list(player):
    return [int(p) for p in (player.get("nutrition_temp") or "").split(",") if p.strip().isdigit()]


def _nutrition_save_temp(player, lst):
    player["nutrition_temp"] = ",".join(str(x) for x in lst)
    store.save_player(player["uin"], nutrition_temp=player["nutrition_temp"])


def _nutrition_bag_count(player):
    return sum(1 for r in store.get_reagents(player["uin"]) if r["slot_id"] == 0 and r["position"] == 0)


def _nutrition_bank_reagent(player, base_id):
    """Move one collected temp-bag baseId into permanent state: real reagent -> a new owned reagent
    (level 1, in the bag); gold (60000) -> gold pool; white residual/junk -> bottle-exp pool."""
    if base_id == _NUTRITION_GOLD_REAGENT:
        player["nutrition_gold"] = int(player.get("nutrition_gold") or 0) + 1
        store.save_player(player["uin"], nutrition_gold=player["nutrition_gold"])
        return
    if not _is_real_reagent(base_id):
        add = load_nutrition_property().get(base_id, {}).get("levels", {}).get(1, (0, 5, 0))[1] or 5
        player["nutrition_bottle_exp"] = int(player.get("nutrition_bottle_exp") or 0) + add
        store.save_player(player["uin"], nutrition_bottle_exp=player["nutrition_bottle_exp"])
        return
    uid = store.next_reagent_uid(player["uin"])
    store.add_reagent(player["uin"], uid, base_id, level=1, position=0, slot_id=0)


def handle_nutrition_gettempbag(cmd_data, player):
    """Cmd_Nutrition_GetTempBag_CS -> the obtain view's state. activateList MUST be non-empty or the
    obtain view's onListChange null-derefs the "last activatable" plant (#1009), so send every dietician."""
    load_nutrition_obtain()
    body = b"".join(pb_varint_field(1, bid) for bid in _nutrition_temp_list(player))   # reagentList (baseIds)
    body += pb_varint_field(2, int(player.get("nutrition_bottle_exp") or 0))            # bottleExp
    for did in sorted(load_nutrition_obtain()):                                         # activateList
        body += pb_varint_field(3, did)
    body += pb_varint_field(4, int(player.get("nutrition_gold") or 0))                  # goldReagentNum
    return [("PVZ.Cmd.Cmd_Nutrition_GetTempBag_SC", body)]


def handle_nutrition_normalcall(cmd_data, player):
    """Cmd_Nutrition_NormalCall_CS{dieticianId} -> spend that dietician's coin cost, roll a reagent into
    the temp bag. Can't-afford / full temp bag = silent no-op (the client's auto-call already stops broke)."""
    did = parse_varint_fields(cmd_data).get(1, 0)
    dinfo = load_nutrition_obtain().get(did)
    if not dinfo:
        return []
    temp = _nutrition_temp_list(player)
    if len(temp) >= _NUTRITION_TEMP_MAX or not _lab_afford(player, dinfo["cost"]):
        return []
    charge = _lab_charge(player, dinfo["cost"])
    base_id = _nutrition_roll(did)
    temp.append(base_id)
    _nutrition_save_temp(player, temp)
    body = pb_varint_field(1, did)                                                      # dieticianId
    for d2 in sorted(load_nutrition_obtain()):                                          # activateList
        body += pb_varint_field(2, d2)
    body += pb_varint_field(3, base_id)                                                 # reagent
    body += pb_varint_field(4, int(player.get("nutrition_gold") or 0))                  # goldReagentNum
    log.info("    nutrition: dietician %d call -> reagent %d (uin=%d)", did, base_id, player["uin"])
    return [("PVZ.Cmd.Cmd_Nutrition_NormalCall_SC", body)] + charge


def handle_nutrition_collect(cmd_data, player):
    """Cmd_Nutrition_Collect_CS{baseId, bagIndex} -> bank one temp-bag reagent into the owned bag."""
    f = parse_varint_fields(cmd_data)
    base_id, bag_index = f.get(1, 0), f.get(2, 0)
    temp = _nutrition_temp_list(player)
    if bag_index < 0 or bag_index >= len(temp) or temp[bag_index] != base_id:
        return []                                          # stale index (client resyncs on reopen)
    temp.pop(bag_index)
    _nutrition_save_temp(player, temp)
    _nutrition_bank_reagent(player, base_id)
    body = (pb_varint_field(1, base_id) + pb_varint_field(2, bag_index) +
            pb_varint_field(3, int(player.get("nutrition_gold") or 0)))
    return [("PVZ.Cmd.Cmd_Nutrition_Collect_SC", body)]


def handle_nutrition_collectall(cmd_data, player):
    """Cmd_Nutrition_CollectAll_CS -> bank every temp-bag reagent (up to the 18-reagent bag cap; leftover
    stays in the temp bag). remainReagent = the baseIds not collected."""
    temp = _nutrition_temp_list(player)
    remain, count = [], _nutrition_bag_count(player)
    for base_id in temp:
        if _is_real_reagent(base_id):
            if count >= _NUTRITION_BAG_MAX:
                remain.append(base_id)
                continue
            _nutrition_bank_reagent(player, base_id)
            count += 1
        else:
            _nutrition_bank_reagent(player, base_id)
    _nutrition_save_temp(player, remain)
    body = pb_varint_field(1, int(player.get("nutrition_gold") or 0))                   # goldReagentNum
    for bid in remain:
        body += pb_varint_field(2, bid)                                                 # remainReagent
    body += pb_varint_field(3, 0)                                                       # stopReason (no popup)
    return [("PVZ.Cmd.Cmd_Nutrition_CollectAll_SC", body)]


def handle_nutrition_getreagentall(cmd_data, player):
    """Cmd_Nutrition_GetReagentAll_CS -> the full owned-reagent list (used by the Use view AND the house
    Fast Exchange window)."""
    body = b""
    for r in store.get_reagents(player["uin"]):
        dto = _encode_reagent_dto(r)
        body += pb_tag(1, 2) + uvarint(len(dto)) + dto                                  # reagentList (message)
    body += pb_varint_field(2, int(player.get("nutrition_bottle_exp") or 0))            # bottleExp
    return [("PVZ.Cmd.Cmd_Nutrition_GetReagentAll_SC", body)]


def handle_nutrition_equipreagent(cmd_data, player):
    """Cmd_Nutrition_EquipReagent_CS{reagentUID, position, slotId} -> equip a reagent onto a plant slot.
    Guards: valid position/slot, slot level-unlocked, slot free, no duplicate stat type on that plant."""
    f = parse_varint_fields(cmd_data)
    uid, position, slot_id = f.get(1, 0), f.get(2, 0), f.get(3, 0)
    if position not in _NUTRITION_POSITIONS or not (1 <= slot_id <= 8):
        return []
    if int(player.get("level", 1)) < _NUTRITION_SLOT_LEVELS.get(slot_id, 0):
        return []                                          # grid still level-locked
    reagents = {r["uid"]: r for r in store.get_reagents(player["uin"])}
    r = reagents.get(uid)
    if not r:
        return []
    bt, _, _ = _reagent_props(r["base_id"], r["level"])
    for other in reagents.values():
        if other["uid"] == uid or other["position"] != position:
            continue
        if other["slot_id"] == slot_id:
            return []                                      # target grid occupied
        if _reagent_props(other["base_id"], other["level"])[0] == bt:
            return []                                      # same stat type already on this plant
    store.set_reagent_pos(player["uin"], uid, position, slot_id)
    slot = pb_varint_field(1, position) + pb_int64_field(2, uid) + pb_varint_field(3, slot_id)
    body = pb_tag(1, 2) + uvarint(len(slot)) + slot                                     # slotInfo (message)
    body += pb_varint_field(2, int(player.get("nutrition_bottle_exp") or 0))            # bottleExp
    log.info("    nutrition: equip reagent %d -> pos %d slot %d (uin=%d)", uid, position, slot_id, player["uin"])
    return [("PVZ.Cmd.Cmd_Nutrition_EquipReagent_SC", body)]


def handle_nutrition_unequipreagent(cmd_data, player):
    """Cmd_Nutrition_UnEquipReagent_CS{reagentUID, ...} -> move a reagent back to the bag."""
    uid = parse_varint_fields(cmd_data).get(1, 0)
    if not any(r["uid"] == uid for r in store.get_reagents(player["uin"])):
        return []
    store.set_reagent_pos(player["uin"], uid, 0, 0)
    body = pb_int64_field(1, uid) + pb_varint_field(2, 1)                               # reagentUID + result
    return [("PVZ.Cmd.Cmd_Nutrition_UnEquipReagent_SC", body)]


def handle_nutrition_noop(cmd_data, player):
    """Deferred Nutrition sub-actions (分解/合成/升级/兑换/提取经验/VIP超级召唤/门票召唤). Reply with NOTHING
    so the button is cleanly inert — a generic empty SC would instead insert a phantom reagent (TicketActivate)
    or clear the temp-bag display (ChangeAll). The core call/collect/equip loop + Fast Exchange are real."""
    return []


def handle_nutrition_exchangeposition(cmd_data, player):
    """Cmd_Nutrition_ExchangePosition_CS{srcPosition, destPosition} (Player's House Fast Exchange) ->
    swap every equipped reagent between the two plant positions (slotIds preserved)."""
    f = parse_varint_fields(cmd_data)
    src, dst = f.get(1, 0), f.get(2, 0)
    if src == dst or src not in _NUTRITION_POSITIONS or dst not in _NUTRITION_POSITIONS:
        return []
    moved = []
    for r in store.get_reagents(player["uin"]):            # snapshot: writes below don't affect the loop
        if r["position"] == src:
            store.set_reagent_pos(player["uin"], r["uid"], dst, r["slot_id"]); moved.append((r["uid"], dst))
        elif r["position"] == dst:
            store.set_reagent_pos(player["uin"], r["uid"], src, r["slot_id"]); moved.append((r["uid"], src))
    body = b""
    for uid, pos in moved:
        dto = pb_int64_field(1, uid) + pb_varint_field(2, pos)
        body += pb_tag(1, 2) + uvarint(len(dto)) + dto                                  # reagent (message)
    log.info("    nutrition: fast-exchange pos %d <-> %d (%d reagents, uin=%d)", src, dst, len(moved), player["uin"])
    return [("PVZ.Cmd.Cmd_Nutrition_ExchangePosition_SC", body)]


def _guide_keys(player):
    """Decode the compact, persistent guide-key representation from the player row."""
    out = {}
    for row in (player.get("guide_keys") or "").split("\n"):
        if "\t" in row:
            key, value = row.split("\t", 1)
            out[key] = value
    return out


def _guide_finish_ids(player):
    return sorted({int(value) for value in (player.get("guide_finish_ids") or "").split(",")
                   if value.isdigit()})


def handle_guide_getkeys(cmd_data, player):
    """Restore guide state before the client evaluates which tutorial step to show."""
    body = b""
    for key, value in _guide_keys(player).items():
        dto = pb_string(1, key) + pb_string(2, value)
        body += pb_tag(1, 2) + uvarint(len(dto)) + dto
    for finish_id in _guide_finish_ids(player):
        body += pb_varint_field(3, finish_id)
    return body


def handle_guide_setkey(cmd_data, player):
    entries = parse_repeated_submessages(cmd_data, 1)
    if not entries:
        return b""
    key = parse_string_field(entries[0], 1)
    value = parse_string_field(entries[0], 2)
    if not key:
        return b""
    # Preserve the protocol's free-form strings without allowing the on-disk delimiter through.
    key, value = key.replace("\t", " ").replace("\n", " "), value.replace("\t", " ").replace("\n", " ")
    keys = _guide_keys(player)
    keys[key] = value
    encoded = "\n".join("%s\t%s" % item for item in sorted(keys.items()))
    player["guide_keys"] = encoded
    store.save_player(player["uin"], guide_keys=encoded)
    dto = pb_string(1, key) + pb_string(2, value)
    return pb_tag(1, 2) + uvarint(len(dto)) + dto


def handle_guide_setfinish(cmd_data, player):
    completed = set(_guide_finish_ids(player))
    completed.update(parse_repeated_varint(cmd_data, 1))
    encoded = ",".join(str(value) for value in sorted(completed))
    player["guide_finish_ids"] = encoded
    store.save_player(player["uin"], guide_finish_ids=encoded)
    # The protocol has no Cmd_Guide_SetFinish_SC; completion is acknowledged by
    # broadcasting the canonical accumulated list.
    return [("PVZ.Cmd.Cmd_Guide_SyncFinishId_SC",
             b"".join(pb_varint_field(1, value) for value in sorted(completed)))]

# ======================= 玩家信息 / 头像 =======================
# Dto_PlantInfo{plantId(1), isNew(2), avatarId(3), strengthLevel(4)}
def _build_plant_info_dto(plant_id, avatar_id=0, strength_level=0, is_new=False):
    d = pb_varint_field(1, int(plant_id))
    if is_new:
        d += pb_bool(2, True)
    if avatar_id:
        d += pb_varint_field(3, int(avatar_id))
    if strength_level:
        d += pb_varint_field(4, int(strength_level))
    return d


# Dto_FriendInfo 完整构造，字段编号按 AS：
# 1:type 2:roleId 3:zoneId 4:name 5:faceId 6:rank 7:roleLevel
# 8:plantInfo 9:passTDNum 10:status 11:helpPlant 12:leftTimes
# 13:isFree 14:qqFaceURL 15:diamond 16:isQQFriend 17:qqName
def build_friend_info_dto_from_player(target):
    """从玩家存档构造 Dto_FriendInfo（含头像 faceId）。"""
    role_id = int(target.get("role_id") or target.get("uin") or 0)
    name = target.get("name") or "Player"
    level = int(target.get("level") or 1)
    face_id = int(target.get("face_id") or 0)          # 头像 ID
    qq_face = target.get("qq_face_url") or ""
    diamond = build_player_diamond(target)             # 你已有的函数

    d = (pb_varint_field(1, 1)                         # type = 1 (FRIEND_TYPE_SNS)
         + pb_int64_field(2, role_id)                  # roleId (Int64)
         + pb_varint_field(3, int(target.get("zone_id") or 0))   # zoneId
         + pb_string(4, name)                          # name
         + pb_varint_field(5, face_id)                 # faceId ← 头像关键
         + pb_varint_field(6, 0)                       # rank
         + pb_varint_field(7, level)                   # roleLevel
         + pb_varint_field(9, 0)                       # passTDNum
         + pb_varint_field(10, 3)                      # status = E_FriendStatus_Friend
         + pb_bool(13, True)                           # isFree
         + pb_string(14, "http://127.0.0.1:8080/image/head/1.png")   # qqFaceURL 写死测试         + pb_tag(15, 2) + uvarint(len(diamond)) + diamond    # diamond
         + pb_bool(16, False)                          # isQQFriend
         + pb_string(17, name))                        # qqName
    return d


def handle_farm_getmyinfo(cmd_data, player):
    """Cmd_Farm_GetMyInfo_CS（空请求）-> Cmd_Farm_GetMyInfo_SC{blocks, plantInfo}。
    看自己：名字/等级/头像由登录时的 Cmd_Init_SC 提供，客户端从 ActorModel 读。
    这里只需要给农场方块 + 植物列表。你没实现农场系统 -> 可以只发植物列表，
    blocks 留空。plantInfo 就是玩家已解锁的植物（Dto_PlantInfo）。"""
    d = b""
    # plantInfo (field 2, repeated Dto_PlantInfo)
    for pid in player.get("plants", []):
        dto = _build_plant_info_dto(pid)
        d += pb_tag(2, 2) + uvarint(len(dto)) + dto
    # blocks (field 1) 留空
    log.info("    farm myinfo: %d plants, 0 blocks", len(player.get("plants", [])))
    return d


def handle_farm_getotherinfo(cmd_data, player):
    """Cmd_Farm_GetOtherInfo_CS{friendInfo=Dto_FriendInfo} -> _SC{friendInfo, blocks}。
    看别人：从请求的 friendInfo.roleId 取出目标 roleId，查目标存档，回 Dto_FriendInfo。"""
    # CS 的 friendInfo 是 field 1 (Dto_FriendInfo)
    subs = parse_repeated_submessages(cmd_data, 1)
    target_role_id = 0
    if subs:
        f = parse_varint_fields(subs[0])
        target_role_id = f.get(2, 0)     # Dto_FriendInfo.roleId 是 field 2
    if not target_role_id:
        log.info("    farm otherinfo: no roleId in request")
        return b""

    # 按 roleId 查玩家（player_store.get_player_by_role_id）
    target = store.get_player_by_role_id(target_role_id)
    if not target:
        log.info("    farm otherinfo: roleId=%d not found", target_role_id)
        # 至少回一个空的 friendInfo，避免客户端 null
        empty = build_friend_info_dto_from_player({
            "role_id": target_role_id, "uin": 0, "name": "?", "level": 1,
            "face_id": 0, "zone_id": 0, "diamond_flag": 0,
            "diamond_blue_lvl": 0, "diamond_yellow_lvl": 0, "diamond_xinyue_lvl": 0,
        })
        return pb_tag(1, 2) + uvarint(len(empty)) + empty

    friend_dto = build_friend_info_dto_from_player(target)
    log.info("    farm otherinfo: roleId=%d name=%s lvl=%d faceId=%d",
             target_role_id, target.get("name"), target.get("level"), target.get("face_id", 0))
    # friendInfo (field 1) + blocks (field 2) 留空
    return pb_tag(1, 2) + uvarint(len(friend_dto)) + friend_dto


def handle_chat_getobjinfo(cmd_data, player):
    """Cmd_Chat_GetObjInfo_CS{type(1),uid(2),roleid(3)} -> _SC{type,uid,roleid,card,item,role}。
    聊天点某人：type 决定显示 card/item/role。最常见 type=3(E_ObjInfoType_ChatRoleInfo)。"""
    f = parse_varint_fields(cmd_data)
    otype = f.get(1, 0)
    uid = f.get(2, 0)
    role_id = f.get(3, 0)
    out = pb_varint_field(1, otype)
    if uid:
        out += pb_int64_field(2, uid)
    if role_id:
        out += pb_int64_field(3, role_id)

    if otype == 3 and role_id:                       # ChatRoleInfo
        target = store.get_player_by_role_id(role_id)
        if target:
            # Dto_ChatRoleInfo{roleId(3), roleNick(4)}
            dto = pb_int64_field(3, int(role_id)) + pb_string(4, target.get("name") or "")
            out += pb_tag(6, 2) + uvarint(len(dto)) + dto
            log.info("    chat objinfo: roleId=%d -> %s", role_id, target.get("name"))
    return out


def handle_roleguildinfo(cmd_data, player):
    """Cmd_RoleGuildInfo_CS（空）-> Cmd_RoleGuildInfo_SC{roleGuildInfo=Dto_Role_GuildInfo}。
    没实现公会 -> 回一个字段全在的空 Dto_Role_GuildInfo，防 null 崩。"""
    # Dto_Role_GuildInfo：guildId(1,Int64) guildName(2) 是 message 字段
    # 客户端读 guildId 时若为 null 会崩；给它一个 Int64(0)
    dto = pb_int64_field(1, 0) + pb_string(2, "")
    return pb_tag(1, 2) + uvarint(len(dto)) + dto
def _dna_owned_card(player, uid):
    return next((row for row in store.get_cards(player["uin"]) if int(row[0]) == int(uid)), None)


def _dna_card_info(card):
    load_battle_cards()
    return _BATTLE_CARDS.get(int(card[1]), {}) if card else {}


def _dna_action_ready(player, card, card_info):
    if not card or not card_info or int(card_info.get("type", 0)) != 2:
        return False
    if int(player.get("level") or 1) < 60 or int(card_info.get("star", 1)) < 5:
        return False
    return int(card_info.get("fruitType", 0)) > 0


def _dna_cost_with_fragment(card_info, costs, clip_num=0):
    scale = _dna_scale(card_info)
    out = _dna_scaled_cost(costs, scale)
    fragment_id = int(card_info.get("recycleItemId", 0))
    fragment_num = int(int(clip_num) * scale)
    if fragment_id and fragment_num:
        out.append((fragment_id, fragment_num))
    merged = {}
    for iid, amount in out:
        merged[iid] = merged.get(iid, 0) + amount
    return [(iid, amount) for iid, amount in merged.items() if amount > 0]


def _dna_can_pay(uin, costs):
    return all(store.get_item_count(uin, iid) >= amount for iid, amount in costs)


def _dna_change_cost(player, costs):
    return grant_items(player, [(iid, -amount) for iid, amount in costs]) if costs else None


def _dna_recycle_factor_multiplier(gene_id):
    """Multiplier from sRecycleGeneFactorPercent, defaulting to a full refund if unset."""
    raw = _cfg_value("sRecycleGeneFactorPercent")
    values = re.findall(r"\d+(?:\.\d+)?", raw or "")
    try:
        return float(values[int(gene_id) - 1]) if len(values) >= int(gene_id) else 1.0
    except (TypeError, ValueError, IndexError):
        return 1.0


def _dna_card_gene_body(uin, uid, card):
    return _dna_gene_info_body(uid, card, store.get_card_genes(uin, uid))


def handle_card_get_gene_info(cmd_data, player):
    uid = parse_varint_fields(cmd_data).get(1, 0)
    card = _dna_owned_card(player, uid)
    if not card:
        return []
    card_info = _dna_card_info(card)
    if not card_info.get("fruitType"):
        log.info("    gene info unavailable: card uid=%d has no configured plant type", uid)
        return []
    body = _dna_card_gene_body(player["uin"], uid, card)
    log.info("    gene info uin=%s uid=%d stages=%d", player["uin"], uid,
             len(store.get_card_genes(player["uin"], uid)))
    return body


def handle_card_upgrade_gene_factor(cmd_data, player):
    fields = parse_varint_fields(cmd_data)
    uid, gene_id = fields.get(1, 0), fields.get(2, 0)
    card = _dna_owned_card(player, uid)
    card_info = _dna_card_info(card)
    if not _dna_action_ready(player, card, card_info) or not 1 <= gene_id <= 5:
        log.info("    gene factor rejected: uin=%s uid=%d gene=%d eligibility/card", player.get("uin"), uid, gene_id)
        return []
    dna = load_card_dna()
    gene = store.get_card_genes(player["uin"], uid).get(gene_id, _dna_default_gene(gene_id))
    if gene["factor_level"] >= 10:
        return []
    card_type = int(card_info["fruitType"])
    next_factor = dna["factor"].get((card_type, gene_id, gene["factor_level"] + 1))
    if not next_factor or int(card[2]) < next_factor["plant_level"]:
        log.info("    gene factor rejected: uid=%d needs card level %s", uid,
                 next_factor.get("plant_level") if next_factor else "template")
        return []
    costs = _dna_scaled_cost(next_factor["items"], _dna_scale(card_info))
    if not costs or not _dna_can_pay(player["uin"], costs):
        log.info("    gene factor rejected: uid=%d insufficient items %s", uid, costs)
        return []

    # factorExp is the client's visible pity meter (0..maxProbability); every failed attempt
    # adds failExp, and each point increases the success chance by one percentage point.
    chance = min(10000, next_factor["probability"] + int(
        gene["factor_exp"] * 10000 / max(1, next_factor["max_probability"])))
    success = random.randint(1, 10000) <= chance
    if success:
        gene["factor_level"] += 1
        gene["factor_exp"] = 0
    else:
        gene["factor_exp"] = min(next_factor["max_probability"],
                                  gene["factor_exp"] + next_factor["fail_exp"])
    store.set_card_gene(player["uin"], uid, gene_id, gene["factor_level"], gene["factor_exp"],
                        gene["attribute"], gene["level"])
    dto = _dna_gene_proto(gene_id, gene)
    body = (pb_int64_field(1, uid) + pb_bytes(2, dto) + pb_bool(3, success))
    messages = [("PVZ.Cmd.Cmd_Card_UpgradeGeneFactor_SC", body)]
    item_update = _dna_change_cost(player, costs)
    if item_update:
        messages.append(item_update)
    card_update = build_card_sync_sc(player["uin"], uid, card[1], 274)
    if card_update:
        messages.append(card_update)
    log.info("    gene factor %s: uid=%d stage=%d factor=%d/10 pity=%d cost=%s",
             "success" if success else "failed", uid, gene_id, gene["factor_level"],
             gene["factor_exp"], costs)
    return messages


def handle_card_activate_gene(cmd_data, player):
    fields = parse_varint_fields(cmd_data)
    uid, gene_id, attribute = fields.get(1, 0), fields.get(2, 0), fields.get(3, 0)
    card = _dna_owned_card(player, uid)
    card_info = _dna_card_info(card)
    if not _dna_action_ready(player, card, card_info) or not 1 <= gene_id <= 5:
        return []
    dna = load_card_dna()
    card_type = int(card_info["fruitType"])
    options = dna["info"].get((card_type, gene_id), [])
    gene = store.get_card_genes(player["uin"], uid).get(gene_id, _dna_default_gene(gene_id))
    if (attribute not in options or gene["factor_level"] < 10 or gene["level"] > 0
            or (gene_id > 1 and store.get_card_genes(player["uin"], uid).get(
                gene_id - 1, _dna_default_gene(gene_id - 1))["level"] == 0)):
        log.info("    gene activation rejected: uid=%d stage=%d attr=%d factor=%d options=%s",
                 uid, gene_id, attribute, gene["factor_level"], options)
        return []
    choice = dna["choose"].get((attribute, 1))
    if not choice or int(card[2]) < choice["plant_level"]:
        return []
    costs = _dna_cost_with_fragment(card_info, choice["items"], choice["clip"])
    if not _dna_can_pay(player["uin"], costs):
        log.info("    gene activation rejected: uid=%d insufficient items %s", uid, costs)
        return []
    gene["attribute"], gene["level"] = attribute, 1
    store.set_card_gene(player["uin"], uid, gene_id, gene["factor_level"], gene["factor_exp"],
                        attribute, 1)
    messages = [("PVZ.Cmd.Cmd_Card_ActivateGene_SC",
                 pb_int64_field(1, uid) + pb_bytes(2, _dna_gene_proto(gene_id, gene)))]
    item_update = _dna_change_cost(player, costs)
    if item_update:
        messages.append(item_update)
    card_update = build_card_sync_sc(player["uin"], uid, card[1], 275)
    if card_update:
        messages.append(card_update)
    log.info("    gene activated: uid=%d stage=%d attr=%d cost=%s", uid, gene_id, attribute, costs)
    return messages


def handle_card_upgrade_gene(cmd_data, player):
    fields = parse_varint_fields(cmd_data)
    uid, gene_id = fields.get(1, 0), fields.get(2, 0)
    card = _dna_owned_card(player, uid)
    card_info = _dna_card_info(card)
    if not _dna_action_ready(player, card, card_info) or not 1 <= gene_id <= 5:
        return []
    dna = load_card_dna()
    gene = store.get_card_genes(player["uin"], uid).get(gene_id)
    if not gene or gene["factor_level"] < 10 or not gene["attribute"]:
        return []
    if gene_id > 1 and store.get_card_genes(player["uin"], uid).get(
            gene_id - 1, _dna_default_gene(gene_id - 1))["level"] == 0:
        return []
    next_level = gene["level"] + 1
    choice = dna["choose"].get((gene["attribute"], next_level))
    if not choice or int(card[2]) < choice["plant_level"]:
        return []
    costs = _dna_cost_with_fragment(card_info, choice["items"], choice["clip"])
    if not _dna_can_pay(player["uin"], costs):
        log.info("    gene improvement rejected: uid=%d insufficient items %s", uid, costs)
        return []
    gene["level"] = next_level
    store.set_card_gene(player["uin"], uid, gene_id, gene["factor_level"], gene["factor_exp"],
                        gene["attribute"], gene["level"])
    messages = [("PVZ.Cmd.Cmd_Card_UpgradeGene_SC",
                 pb_int64_field(1, uid) + pb_bytes(2, _dna_gene_proto(gene_id, gene)))]
    item_update = _dna_change_cost(player, costs)
    if item_update:
        messages.append(item_update)
    card_update = build_card_sync_sc(player["uin"], uid, card[1], 276)
    if card_update:
        messages.append(card_update)
    log.info("    gene improved: uid=%d stage=%d path=%d level=%d cost=%s",
             uid, gene_id, gene["attribute"], next_level, costs)
    return messages


def handle_card_reset_gene(cmd_data, player):
    fields = parse_varint_fields(cmd_data)
    uid, gene_id, attribute = fields.get(1, 0), fields.get(2, 0), fields.get(3, 0)
    card = _dna_owned_card(player, uid)
    card_info = _dna_card_info(card)
    if not _dna_action_ready(player, card, card_info) or not 1 <= gene_id <= 5:
        return []
    dna = load_card_dna()
    gene = store.get_card_genes(player["uin"], uid).get(gene_id)
    choices = dna["info"].get((int(card_info["fruitType"]), gene_id), [])
    if not gene or not gene["attribute"] or attribute not in choices:
        return []
    if attribute == gene["attribute"]:
        return []
    costs = dna["reset"].get(gene_id, [])
    bag_costs, coin_cost = [], 0
    for item_id, amount in costs:
        if item_id == 1:
            coin_cost += amount
        else:
            bag_costs.append((item_id, amount))
    if int(player.get("coin") or 0) < coin_cost or not _dna_can_pay(player["uin"], bag_costs):
        return []
    if coin_cost:
        player["coin"] = int(player.get("coin") or 0) - coin_cost
        store.save_player(player["uin"], coin=player["coin"])
    gene["attribute"], gene["level"] = attribute, 1
    store.set_card_gene(player["uin"], uid, gene_id, gene["factor_level"], gene["factor_exp"],
                        gene["attribute"], gene["level"])
    messages = [("PVZ.Cmd.Cmd_Card_ResetGene_SC",
                 pb_int64_field(1, uid) + pb_bytes(2, _dna_gene_proto(gene_id, gene)))]
    item_update = _dna_change_cost(player, bag_costs)
    if item_update:
        messages.append(item_update)
    if coin_cost:
        messages.append(("PVZ.Cmd.Cmd_SyncCoin_SC", pb_varint_field(1, player["coin"])))
    card_update = build_card_sync_sc(player["uin"], uid, card[1], 277)
    if card_update:
        messages.append(card_update)
    return messages


def handle_card_recycle_gene(cmd_data, player):
    uid = parse_varint_fields(cmd_data).get(1, 0)
    card = _dna_owned_card(player, uid)
    card_info = _dna_card_info(card)
    if not _dna_action_ready(player, card, card_info):
        return []
    dna = load_card_dna()
    scale = _dna_scale(card_info)
    refunds = {}
    rarity_param = dna["param"].get(int(card_info.get("rarity", 1)), {})
    for gene_id, gene in store.get_card_genes(player["uin"], uid).items():
        for level in range(1, min(gene["factor_level"], 10) + 1):
            factor = dna["factor"].get((int(card_info["fruitType"]), gene_id, level))
            if factor:
                multiplier = _dna_recycle_factor_multiplier(gene_id)
                for iid, amount in _dna_scaled_cost(factor["items"], scale):
                    refunds[iid] = refunds.get(iid, 0) + int(amount * multiplier)
        for level in range(1, gene["level"] + 1):
            choice = dna["choose"].get((gene["attribute"], level))
            if choice:
                for iid, amount in _dna_cost_with_fragment(card_info, choice["items"], choice["clip"]):
                    refunds[iid] = refunds.get(iid, 0) + amount
        if gene["factor_level"]:
            for iid, amount in rarity_param.get("recycle_factor", []):
                refunds[iid] = refunds.get(iid, 0) + int(amount) * int(gene["factor_level"])
        if gene["level"]:
            for iid, amount in rarity_param.get("recycle_dna", []):
                refunds[iid] = refunds.get(iid, 0) + int(amount)
    store.delete_card_genes(player["uin"], uid)
    changes = sorted(refunds.items())
    for iid, amount in changes:
        store.add_item(player["uin"], iid, amount)
    item_dtos = b"".join(pb_bytes(2, pb_varint_field(1, iid) + pb_varint_field(2, amount))
                         for iid, amount in changes)
    body = pb_int64_field(1, uid) + item_dtos
    messages = [("PVZ.Cmd.Cmd_Card_RecycleGene_SC", body)]
    if changes:
        updates = b"".join(pb_bytes(1, build_item_dto(iid, store.get_item_count(player["uin"], iid)))
                            for iid, _ in changes)
        messages.append(("PVZ.Cmd.Cmd_Item_Update_SC", updates))
    card_update = build_card_sync_sc(player["uin"], uid, card[1], 313)
    if card_update:
        messages.append(card_update)
    log.info("    genes recycled: uid=%d returned=%s", uid, changes)
    return messages


def _gene_test_daily_reset(player):
    today = time.strftime("%Y%m%d")
    if player.get("gene_test_day") != today:
        player.update(gene_test_day=today, gene_test_remain=3, gene_test_restart_num=0,
                      gene_test_sweep_day="")
        store.save_player(player["uin"], gene_test_day=today, gene_test_remain=3,
                          gene_test_restart_num=0, gene_test_sweep_day="")


def _gene_test_stage_is_open(player, stage, mode):
    if mode not in (0, 1) or not 1 <= stage <= 5:
        return False
    if mode == 0:
        return stage <= max(1, min(5, int(player.get("gene_test_pass_stage") or 0) + 1))
    return (stage <= int(player.get("gene_test_pass_stage") or 0)
            and stage <= max(1, min(5, int(player.get("gene_test_pass_elite") or 0) + 1)))


def handle_gene_test_getinfo(cmd_data, player):
    _gene_test_daily_reset(player)
    pass_stage = min(5, int(player.get("gene_test_pass_stage") or 0))
    pass_elite = min(5, int(player.get("gene_test_pass_elite") or 0))
    opened = max(1, min(5, pass_stage + 1))
    opened_elite = max(1, min(5, pass_elite + 1))
    last = max(1, min(5, int(player.get("gene_test_last_stage") or opened)))
    return (pb_varint_field(1, opened) + pb_varint_field(2, int(player.get("gene_test_restart_num") or 0))
            + pb_varint_field(3, last) + pb_varint_field(4, opened_elite)
            + pb_varint_field(5, pass_stage) + pb_varint_field(6, pass_elite))


def _gene_test_reward(mode, stage):
    scale = 2 if mode == 1 else 1
    return [(92106, 100 * scale), (92100 + int(stage), 10 * scale)]


def _gene_test_stage_info_body(player, stage, mode):
    progress = store.get_gene_test_stage(player["uin"], mode, stage)
    d = (pb_varint_field(1, stage) + pb_varint_field(2, progress["current_sub"])
         + pb_varint_field(3, progress["max_sub"])
         + pb_varint_field(4, int(player.get("gene_test_remain") or 0)))
    for iid, count in sorted(progress["rewards"].items()):
        d += pb_bytes(5, pb_varint_field(1, iid) + pb_varint_field(2, count))
    d += pb_string(7, "基因试炼") + pb_varint_field(8, mode)
    return d


def handle_gene_test_get_stage_info(cmd_data, player):
    f = parse_varint_fields(cmd_data)
    stage, mode = f.get(1, 1), f.get(2, 0)
    _gene_test_daily_reset(player)
    if not _gene_test_stage_is_open(player, stage, mode):
        stage, mode = max(1, min(5, int(player.get("gene_test_last_stage") or 1))), 0
    player["gene_test_last_stage"] = stage
    store.save_player(player["uin"], gene_test_last_stage=stage)
    return _gene_test_stage_info_body(player, stage, mode)


def handle_gene_test_restart(cmd_data, player):
    f = parse_varint_fields(cmd_data)
    stage, mode = f.get(1, 1), f.get(2, 0)
    _gene_test_daily_reset(player)
    if not _gene_test_stage_is_open(player, stage, mode):
        return []
    restart_num = int(player.get("gene_test_restart_num") or 0)
    reset_price = load_card_dna()["test_reset"].get(restart_num + 1)
    if reset_price is None:
        return []
    item_id, amount = reset_price
    if amount and store.get_item_count(player["uin"], item_id) < amount:
        return []
    if amount:
        store.add_item(player["uin"], item_id, -amount)
    progress = store.get_gene_test_stage(player["uin"], mode, stage)
    store.set_gene_test_stage(player["uin"], mode, stage, 0, progress["max_sub"], progress["rewards"])
    player["gene_test_restart_num"] = restart_num + 1
    player["gene_test_remain"] = 3
    store.save_player(player["uin"], gene_test_restart_num=restart_num + 1, gene_test_remain=3)
    body = pb_varint_field(1, stage) + pb_varint_field(2, 3) + pb_varint_field(3, mode)
    messages = [("PVZ.Cmd.Cmd_GeneTest_RestartStage_SC", body)]
    if amount:
        messages.append(("PVZ.Cmd.Cmd_Item_Update_SC", pb_bytes(1,
            build_item_dto(item_id, store.get_item_count(player["uin"], item_id)))))
    return messages


def handle_gene_test_get_formation(cmd_data, player):
    ensure_player_cards(player)
    formation = build_formation_info(player, 1, default_formation_placements(player))
    return pb_bytes(1, formation)


def handle_gene_test_set_formation(cmd_data, player):
    fsub = parse_repeated_submessages(cmd_data, 1)
    placements = {}
    if fsub:
        for cp in parse_repeated_submessages(fsub[0], 1):
            c = parse_varint_fields(cp)
            pos, uid = c.get(1, 0), c.get(2, 0)
            if pos and uid and _dna_owned_card(player, uid):
                placements[pos] = uid
    if placements:
        store.set_formation(player["uin"], 1, placements)
    log.info("    gene trial formation set: %s", placements)
    return []


def handle_gene_test_fight(cmd_data, player):
    f = parse_varint_fields(cmd_data)
    stage, mode, sub = f.get(1, 0), f.get(3, 0), f.get(2, 0)
    _gene_test_daily_reset(player)
    dna = load_card_dna()
    level_info = dna["test"].get((mode, stage, sub))
    if (not level_info or not _gene_test_stage_is_open(player, stage, mode)
            or (mode == 1 and stage > int(player.get("gene_test_pass_stage") or 0))
            or int(player.get("gene_test_remain") or 0) <= 0):
        return []
    progress = store.get_gene_test_stage(player["uin"], mode, stage)
    if sub != progress["current_sub"] + 1 or sub > 50:
        return []
    if not build_player_units(player):
        ensure_player_cards(player)
    left_units = build_player_units(player)
    left_power = sum(int(u.get("power") or card_power(u)) for u in left_units)
    # ClientDB stores this encounter power in its full-card scale; combat cards use the local
    # adventure scale (1/80). Keep the authored chapter curve, but cap the preview opponent at
    # 60% of the player's current team so a freshly restored local account can test the loop.
    target_power = max(1, int(level_info["power"] / _ADV_STAT_SCALE))
    if left_power:
        target_power = min(target_power, max(1, left_power * (55 if mode == 0 else 70) // 100))
    enemy_card_id = next((cid for cid in _DEFAULT_ENEMY_CARDS if cid in _BATTLE_CARDS),
                         next(iter(_BATTLE_CARDS), 111))
    enemy_info = _BATTLE_CARDS.get(enemy_card_id, {})
    right_units = [{"pos": _ENEMY_POS[0], "card_id": enemy_card_id, "hp": max(1, target_power * 5),
                    "atk": max(1, target_power // 3), "def_": max(0, target_power // 10),
                    "skill1": enemy_info.get("skill1", 0), "skill2": enemy_info.get("skill2", 0),
                    "level": max(1, stage * 10 + sub), "is_leader": True,
                    "power": target_power, "name": enemy_info.get("name", "Zombie")}]
    won, _lp, _rp = resolve_battle(left_units, right_units)
    rewards = _gene_test_reward(mode, stage) if won else []
    rounds = simulate_battle(left_units, right_units, won) if left_units else []
    replay = encode_fight_replay(rounds)
    report = build_fight_report(player, stage, mode, sub, won, rewards, sub == 1,
                                left_units, right_units, replay, card_exp_gain=0, fight_type=20)
    if won:
        new_sub = max(progress["current_sub"], sub)
        max_sub = max(progress["max_sub"], sub)
        reward_totals = dict(progress["rewards"])
        for iid, count in rewards:
            reward_totals[iid] = reward_totals.get(iid, 0) + count
        store.set_gene_test_stage(player["uin"], mode, stage, new_sub, max_sub, reward_totals)
        if sub == 50:
            if mode == 0:
                player["gene_test_pass_stage"] = max(int(player.get("gene_test_pass_stage") or 0), stage)
                store.save_player(player["uin"], gene_test_pass_stage=player["gene_test_pass_stage"])
            else:
                player["gene_test_pass_elite"] = max(int(player.get("gene_test_pass_elite") or 0), stage)
                store.save_player(player["uin"], gene_test_pass_elite=player["gene_test_pass_elite"])
        for iid, count in rewards:
            store.add_item(player["uin"], iid, count)
    else:
        player["gene_test_remain"] = max(0, int(player.get("gene_test_remain") or 0) - 1)
        store.save_player(player["uin"], gene_test_remain=player["gene_test_remain"])
    body = (pb_varint_field(1, stage) + pb_varint_field(2, sub) + pb_bytes(3, report)
            + pb_bool(4, won))
    for iid, count in rewards:
        body += pb_bytes(5, pb_varint_field(1, iid) + pb_varint_field(2, count))
    body += pb_varint_field(6, mode)
    messages = [("PVZ.Cmd.Cmd_GeneTest_Fight_SC", body)]
    if rewards:
        updates = b"".join(pb_bytes(1, build_item_dto(iid, store.get_item_count(player["uin"], iid)))
                            for iid, _ in rewards)
        messages.append(("PVZ.Cmd.Cmd_Item_Update_SC", updates))
    log.info("    gene test fight: uin=%s mode=%d chapter=%d level=%d win=%s rewards=%s",
             player["uin"], mode, stage, sub, won, rewards)
    return messages


def handle_gene_test_sweep(cmd_data, player):
    f = parse_varint_fields(cmd_data)
    stage, mode = f.get(1, 0), f.get(2, 0)
    _gene_test_daily_reset(player)
    if player.get("gene_test_sweep_day") == time.strftime("%Y%m%d"):
        return []
    if not _gene_test_stage_is_open(player, stage, mode):
        return []
    progress = store.get_gene_test_stage(player["uin"], mode, stage)
    sweep_count = progress["max_sub"] - progress["current_sub"]
    if sweep_count <= 0:
        return []
    rewards = [(iid, count * sweep_count) for iid, count in _gene_test_reward(mode, stage)]
    for iid, count in rewards:
        store.add_item(player["uin"], iid, count)
    totals = dict(progress["rewards"])
    for iid, count in rewards:
        totals[iid] = totals.get(iid, 0) + count
    store.set_gene_test_stage(player["uin"], mode, stage, progress["max_sub"],
                              progress["max_sub"], totals)
    player["gene_test_sweep_day"] = time.strftime("%Y%m%d")
    store.save_player(player["uin"], gene_test_sweep_day=player["gene_test_sweep_day"])
    body = pb_varint_field(1, stage)
    for iid, count in rewards:
        body += pb_bytes(2, pb_varint_field(1, iid) + pb_varint_field(2, count))
    body += pb_varint_field(3, progress["max_sub"]) + pb_varint_field(4, mode)
    messages = [("PVZ.Cmd.Cmd_GeneTest_Sweep_SC", body)]
    updates = b"".join(pb_bytes(1, build_item_dto(iid, store.get_item_count(player["uin"], iid)))
                        for iid, _ in rewards)
    messages.append(("PVZ.Cmd.Cmd_Item_Update_SC", updates))
    return messages


def handle_worldmap_getcityinfo(cmd_data, player):
    """Cmd_WorldMap_GetCityInfo_CS{roleId(1,Int64)} -> _SC{roleId, roleName, roleLevel, faceId, ...}。
    点自己头像 / 看别人城池，都走这个。roleId 为空则用当前玩家。"""
    f = parse_varint_fields(cmd_data)
    role_id = f.get(1, 0)
    log.info("    worldmap cityinfo: requested roleId=%s, own roleId=%s",
             role_id, player.get("role_id"))
    if not role_id:
        target = player
    else:
        target = store.get_player_by_role_id(role_id)
        if not target:
            target = player
            log.info("    worldmap cityinfo: roleId=%d not found, fallback to self", role_id)

    role_id_val = int(target.get("role_id") or target.get("uin") or 0)
    diamond = build_player_diamond(target)
    d = (pb_int64_field(1, role_id_val)                          # roleId (Int64)
         + pb_string(2, target.get("name") or "")                # roleName
         + pb_varint_field(3, int(target.get("level") or 1))     # roleLevel
         + pb_varint_field(4, int(target.get("face_id") or 0))   # faceId
         + pb_int64_field(5, 0)                                  # guildId
         + pb_string(6, "")                                      # guildName
         # warHistory(7) 留空
         + pb_string(8, target.get("qq_face_url") or "")         # qqFaceURL
         + pb_tag(9, 2) + uvarint(len(diamond)) + diamond        # diamond
         + pb_varint_field(10, 0)                                # firendStatus
         + pb_string(11, ""))                                    # signature
    log.info("    worldmap cityinfo -> roleId=%d name=%s lvl=%d faceId=%d",
             role_id_val, target.get("name"), target.get("level"), target.get("face_id", 0))
    return d


def handle_worldmap_getcellinfo(cmd_data, player):
    """Cmd_WorldMap_GetCellInfo_CS{roleId(1,Int64)} -> _SC{cellInfo=Dto_WorldMap_CellInfo}。
    Dto_WorldMap_CellInfo 字段(按 AS)：
      1:type(uint32) 2:pos(msg Dto_WorldMap_Pos) 3:roleId(I64) 4:roleName(str)
      5:warState(u32) 6:stateEndTime(u32) 7:avatar(u32) 8:warFree(u32)
      9:warFreeEndTime(u32) 10:mineCar(rep msg) 11:guildId(I64) 12:guildName(str)
      13:guildFlag(msg) 14:enemyFlag(msg) 15:area(u32) 16:diamond(msg)
      30:mineState(u32) 50:templeId(u32)
    关键：pos(2)、guildFlag(13)、enemyFlag(14) 都是 message 字段，客户端读它们时
    若为 null 会 #1009。必须发"空 message"（tag + 长度 0 + 内容 0），不能省略。
    """
    f = parse_varint_fields(cmd_data)
    role_id = f.get(1, 0)
    target = store.get_player_by_role_id(role_id) if role_id else player
    if not target:
        target = player

    # Dto_WorldMap_Pos 最小空 message（具体结构等 AS 确认；先发空 message 防 null）
    pos_dto = pb_varint_field(1, 0) + pb_varint_field(2, 0)
    guild_flag_dto = b""            # Dto_Guild_FlagInfo 最小空 message
    enemy_flag_dto = b""
    diamond_dto = build_player_diamond(target)

    cell = (pb_varint_field(1, 0)                                   # type
            + pb_tag(2, 2) + uvarint(len(pos_dto)) + pos_dto        # pos
            + pb_int64_field(3, int(target.get("role_id") or 0))    # roleId
            + pb_string(4, target.get("name") or "")                # roleName
            + pb_varint_field(5, 0)                                 # warState
            + pb_varint_field(6, 0)                                 # stateEndTime
            + pb_varint_field(7, int(target.get("face_id") or 0))   # avatar ← 头像
            + pb_varint_field(8, 1)                                 # warFree = E_WarFreeType_None
            + pb_varint_field(9, 0)                                 # warFreeEndTime
            # 10:mineCar 留空
            + pb_int64_field(11, 0)                                 # guildId
            + pb_string(12, "")                                     # guildName
            + pb_tag(13, 2) + uvarint(len(guild_flag_dto)) + guild_flag_dto   # guildFlag
            + pb_tag(14, 2) + uvarint(len(enemy_flag_dto)) + enemy_flag_dto   # enemyFlag
            + pb_varint_field(15, 0)                                # area
            + pb_tag(16, 2) + uvarint(len(diamond_dto)) + diamond_dto         # diamond
            + pb_varint_field(30, 0)                                # mineState
            + pb_varint_field(50, 0))                               # templeId
    log.info("    worldmap cellinfo: roleId=%d name=%s avatar=%d",
             int(target.get("role_id") or 0), target.get("name"), target.get("face_id", 0))
    return pb_tag(1, 2) + uvarint(len(cell)) + cell

