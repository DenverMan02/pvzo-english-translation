    ("sun", "阳光", "number", 0, 2_000_000_000),
    ("energy", "体力", "number", 0, 2_000_000_000),
    ("ticket", "蓝钻", "number", 0, 2_000_000_000),
    ("present_ticket", "金钻", "number", 0, 2_000_000_000),
