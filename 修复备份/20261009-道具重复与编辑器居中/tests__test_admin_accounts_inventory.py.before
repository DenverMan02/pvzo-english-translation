import http.client
import http.server
import sys
import tempfile
import threading
import unittest
from pathlib import Path
from urllib.parse import parse_qs, urlencode, urlsplit

ROOT = Path(__file__).resolve().parents[1]
sys.path.insert(0, str(ROOT))

import admin_server as admin
import player_store as store


class QuietHandler(admin.AdminHandler):
    def log_message(self, *_args):
        pass


class AdminAccountsInventoryTests(unittest.TestCase):
    def setUp(self):
        self.tmp = tempfile.TemporaryDirectory()
        self.old_db = store.DB_PATH
        store.set_db_path(str(Path(self.tmp.name) / "players.db"))
        store.init_db()
        self.server = http.server.ThreadingHTTPServer(("127.0.0.1", 0), QuietHandler)
        self.thread = threading.Thread(target=self.server.serve_forever, daemon=True)
        self.thread.start()

    def tearDown(self):
        self.server.shutdown()
        self.thread.join(3)
        self.server.server_close()
        store.set_db_path(self.old_db)
        self.tmp.cleanup()

    def request(self, path, fields=None):
        client = http.client.HTTPConnection("127.0.0.1", self.server.server_port, timeout=5)
        try:
            if fields is None:
                client.request("GET", path)
            else:
                body = urlencode(dict(fields, csrf=admin.CSRF_TOKEN))
                client.request("POST", path, body,
                               {"Content-Type": "application/x-www-form-urlencoded"})
            response = client.getresponse()
            return response.status, dict(response.getheaders()), response.read().decode("utf-8")
        finally:
            client.close()

    def assert_home_error(self, result):
        status, headers, _body = result
        self.assertEqual(status, 303)
        redirect = urlsplit(headers["Location"])
        self.assertEqual(redirect.path, "/")
        self.assertEqual(parse_qs(redirect.query)["kind"], ["error"])

    def test_home_has_separate_open_and_new_account_forms(self):
        status, _headers, body = self.request("/")
        self.assertEqual(status, 200)
        self.assertIn("打开已有账号", body)
        self.assertIn('action="/player/create"', body)
        self.assertIn('action="/player/new"', body)
        self.assertIn("新建账号", body)
        self.assertNotIn("若不存在，会", body)

    def test_new_account_creates_independent_starter_save(self):
        store.get_or_create_player(101)
        store.save_player(101, coin=87654)
        before = admin._player(101)
        status, headers, _body = self.request("/player/new", {"uin": "00102"})
        self.assertEqual(status, 303)
        redirect = urlsplit(headers["Location"])
        self.assertEqual(redirect.path, "/player")
        self.assertEqual(parse_qs(redirect.query)["uin"], ["102"])
        self.assertEqual(admin._player(101), before)
        new = admin._player(102)
        self.assertEqual(new["level"], 1)
        self.assertEqual(new["coin"], store.DEFAULTS["coin"])
        self.assertTrue(store.get_player_plants(102))

    def test_duplicate_new_account_preserves_progress_and_returns_home(self):
        store.get_or_create_player(101)
        store.save_player(101, name="已有角色", level=20, coin=87654)
        store.add_item(101, 4001, 123)
        before, bag = admin._player(101), store.get_items(101)
        self.assert_home_error(self.request("/player/new", {"uin": "000101"}))
        self.assertEqual(admin._player(101), before)
        self.assertEqual(store.get_items(101), bag)

    def test_invalid_new_account_identifiers_create_no_players(self):
        for raw in ("", "0", "-1", "abc", "１２", "1&uin=2", "9223372036854775808"):
            with self.subTest(raw=raw):
                self.assert_home_error(self.request("/player/new", {"uin": raw}))
        with admin._connection() as con:
            self.assertEqual(con.execute("SELECT COUNT(*) FROM players").fetchone()[0], 0)

    def test_open_account_requires_existing_save(self):
        self.assert_home_error(self.request("/player/create", {"uin": "101"}))
        self.assertIsNone(admin._player(101))
        store.get_or_create_player(101)
        before = admin._player(101)
        status, headers, _body = self.request("/player/create", {"uin": "101"})
        self.assertEqual(status, 303)
        self.assertEqual(urlsplit(headers["Location"]).path, "/player")
        self.assertEqual(admin._player(101), before)

    def test_legacy_bag_names_and_undefined_ids_are_displayed_without_mutation(self):
        store.get_or_create_player(101)
        for item_id in (1140, 1220, 51240, 61010, 66002):
            store.add_item(101, item_id, 3)
        before = store.get_items(101)
        status, _headers, body = self.request("/player?uin=101")
        self.assertEqual(status, 200)
        self.assertIn("南瓜小巫", body)
        self.assertIn("闪电蓝莓", body)
        self.assertIn("月光花", body)
        self.assertIn("塔防植物编号 · 旧背包记录", body)
        self.assertIn("植物卡原型编号 · 旧背包记录", body)
        self.assertIn("无效拼图编号（ID 61010）", body)
        self.assertIn("无效拼图编号（ID 66002）", body)
        self.assertIn("保留原始数量", body)
        self.assertNotIn("未知物品", body)
        self.assertEqual(store.get_items(101), before)

    def test_authoritative_items_win_over_other_id_namespaces(self):
        self.assertEqual(admin._inventory_item_details(1100), (admin.ITEM_NAMES[1100], ""))
        self.assertEqual(admin._inventory_item_details(4001), (admin.ITEM_NAMES[4001], ""))
        self.assertNotEqual(admin.ITEM_NAMES[1100], admin.PLANT_NAMES[1100])

    def test_invalid_white_green_puzzles_explain_current_legal_ranges(self):
        for item_id, color, allowed in ((61010, "白色", "61001–61009"),
                                        (61016, "白色", "61001–61009"),
                                        (62013, "绿色", "62001–62012"),
                                        (62016, "绿色", "62001–62012")):
            with self.subTest(item_id=item_id):
                name, detail = admin._inventory_item_details(item_id)
                self.assertEqual(name, "无效拼图编号（ID %s）" % item_id)
                self.assertIn(color + "拼图", detail)
                self.assertIn("当前合法编号 " + allowed, detail)
                self.assertIn("保留原始数量", detail)
        self.assertEqual(admin._inventory_item_details(61001), (admin.ITEM_NAMES[61001], ""))
        self.assertEqual(admin._inventory_item_details(62012), (admin.ITEM_NAMES[62012], ""))
        self.assertIn("未收录物品", admin._inventory_item_details(61017)[0])

    def test_invalid_gold_red_puzzles_identify_real_shared_material(self):
        for item_id, base_id in ((66002, 66001), (66925, 66901),
                                 (67002, 67001), (67925, 67901)):
            with self.subTest(item_id=item_id):
                name, detail = admin._inventory_item_details(item_id)
                self.assertEqual(name, "无效拼图编号（ID %s）" % item_id)
                self.assertIn(admin.ITEM_NAMES[base_id], detail)
                self.assertIn("本阶 25 格共用 ID %s" % base_id, detail)
                self.assertIn("保留原始数量", detail)
                self.assertNotIn(item_id, admin.ITEM_CATALOG_BY_ID)
        self.assertEqual(admin._inventory_item_details(67601), (admin.ITEM_NAMES[67601], ""))
        self.assertIn("未收录物品", admin._inventory_item_details(68002)[0])

    def test_legacy_and_undefined_entries_cannot_be_granted_as_ordinary_items(self):
        store.get_or_create_player(101)
        before = store.get_items(101)
        for item_id in (1140, 51240, 61010, 66002):
            with self.subTest(item_id=item_id):
                self.assertNotIn(item_id, admin.ITEM_CATALOG_BY_ID)
                status, headers, _body = self.request("/player/item", {
                    "uin": "101", "item_id": str(item_id), "delta": "1"})
                self.assertEqual(status, 303)
                self.assertEqual(parse_qs(urlsplit(headers["Location"]).query)["kind"], ["error"])
                self.assertEqual(store.get_items(101), before)


if __name__ == "__main__":
    unittest.main(verbosity=2)
