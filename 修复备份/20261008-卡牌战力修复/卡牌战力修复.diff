+    prop = cfg["props"].get((zombie["type"], zombie["rarity"], quality))
+    if not prop:
+        return None
+    fields = ("atk", "def", "hp", "ab", "hit", "dodge", "critical", "tough")
+    level = max(1, int(row.get("level") or 1))
+    star = cfg["stars"].get(max(1, int(row.get("star") or 1)), {})
+    buff = int(star.get("buff", 10000))
+    # DummyZombieInfo.getPropList truncates BEFORE multiplying by 6.
+    values = {field: ((prop[field] + level * prop["g_" + field]) * buff // 10000) * 6
+              for field in fields}
